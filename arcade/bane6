    function drawOVACharacter(c, p, cx, cy, timeSec, scOverride = 1.0, isTarget = false, alpha = 1.0) {
      const sub = getSubraceMeta(p);
      const sc = sub.scale * scOverride;
      const facing = p.facing || 1;
      const legSwing = p.isMoving ? Math.sin(timeSec * 12) * 0.5 : 0;

      c.save(); c.globalAlpha = alpha; c.translate(cx, cy);
      c.fillStyle = 'rgba(0,0,0,0.7)'; c.beginPath(); c.ellipse(0, 5, 18 * sc, 8 * sc, 0, 0, Math.PI * 2); c.fill();

      c.save(); c.scale(facing * sc, sc);
      c.strokeStyle = '#040306'; c.lineWidth = 2.2;

      // Cloak
      c.fillStyle = p.armorColor || '#2b3d54';
      c.beginPath(); c.moveTo(-9, -28); c.lineTo(9, -28); c.lineTo(13, 2); c.lineTo(-13, 2); c.closePath();
      c.fill(); c.stroke();

      // Legs
      c.fillStyle = '#17141f';
      c.save(); c.translate(-4, -12); c.rotate(-legSwing); c.fillRect(-3, 0, 6, 14); c.strokeRect(-3, 0, 6, 14); c.restore();
      c.save(); c.translate(4, -12); c.rotate(legSwing); c.fillRect(-3, 0, 6, 14); c.strokeRect(-3, 0, 6, 14); c.restore();

      // Torso
      c.fillStyle = p.hitFlash > 0 ? '#fff' : '#334155';
      c.beginPath(); c.roundRect(-10, -29, 20, 19, 3); c.fill(); c.stroke();

      // Head
      c.fillStyle = p.hitFlash > 0 ? '#fff' : sub.skin;
      c.beginPath(); c.arc(0, -38, 10, 0, Math.PI * 2); c.fill(); c.stroke();

      c.fillStyle = p.hairColor || '#eab308';
      c.beginPath(); c.moveTo(-10, -32); c.lineTo(-6, -46); c.lineTo(6, -46); c.lineTo(10, -32); c.closePath(); c.fill();

      // Weapon
      const wpn = getActiveWeapon();
      c.save(); c.translate(9, -20);
      if (wpn.dmgType === 'PIERCE') {
        c.strokeStyle = '#d97706'; c.lineWidth = 2.5;
        c.beginPath(); c.arc(0, 0, 15, -Math.PI * 0.45, Math.PI * 0.45); c.stroke();
      } else if (wpn.dmgType === 'BLUNT') {
        c.fillStyle = '#78350f'; c.fillRect(-2, -32, 4, 30);
        c.fillStyle = '#fbbf24'; c.fillRect(-9, -38, 18, 10); c.strokeRect(-9, -38, 18, 10);
      } else {
        c.fillStyle = '#e2e8f0';
        c.beginPath(); c.moveTo(-2, 0); c.lineTo(-3, -36); c.lineTo(2, -40); c.lineTo(3, 0); c.closePath(); c.fill(); c.stroke();
      }
      c.restore();

      c.restore(); c.restore();
    }

