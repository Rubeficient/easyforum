    function renderStage1Minimap() {
      mapCtx.clearRect(0, 0, mapCanvas.width, mapCanvas.height);
      const myGx = Math.floor(localPlayer.x / TILE_SIZE);
      const myGy = Math.floor(localPlayer.y / TILE_SIZE);
      const cellW = 44, cellH = 34;
      const offX = 28, offY = 12;

      for (let gy = -1; gy <= 1; gy++) {
        for (let gx = -1; gx <= 1; gx++) {
          const sec = STAGE_SECTORS[sectorKey(gx, gy)];
          const rx = offX + (gx + 1) * (cellW + 4);
          const ry = offY + (gy + 1) * (cellH + 4);

          mapCtx.fillStyle = sec.safe ? '#166534' : (sec.isBossRoom ? '#7f1d1d' : '#1e293b');
          mapCtx.strokeStyle = (gx === myGx && gy === myGy) ? '#fde047' : '#4a3520';
          mapCtx.lineWidth = (gx === myGx && gy === myGy) ? 2 : 1;
          mapCtx.fillRect(rx, ry, cellW, cellH);
          mapCtx.strokeRect(rx, ry, cellW, cellH);

          mapCtx.font = '8px Cinzel, serif';
          mapCtx.fillStyle = '#fff';
          mapCtx.textAlign = 'center';
          if (sec.isBossRoom) mapCtx.fillText('☠️ ABESHU', rx + cellW/2, ry + cellH/2 + 3);
          else if (sec.sealType) mapCtx.fillText(sec.sealType.toUpperCase(), rx + cellW/2, ry + cellH/2 + 3);
          else if (sec.safe) mapCtx.fillText('HUB', rx + cellW/2, ry + cellH/2 + 3);
        }
      }
    }

    // =========================================================================
    // 10. MAIN 60 FPS GAME LOOP
    // =========================================================================
    let lastTime = performance.now();

    function gameLoop(now) {
      const dt = Math.min((now - lastTime) / 1000, 0.1);
      lastTime = now;
      const nowSec = now * 0.001;

      updatePreview(now);
      updateGatesAutoProximity(dt);
      updateStageHazards(dt);
      checkDescentPortal();

      if (localPlayer.autoAttackTimer > 0) {
        localPlayer.autoAttackTimer = Math.max(0, localPlayer.autoAttackTimer - dt);
      }

      const inSafezone = isInsideFirepitSafezone(localPlayer.x, localPlayer.y);
      if (!inSafezone && localPlayer.autoAttackTimer <= 0 && document.getElementById('char-modal').style.display === 'none') {
        const wpn = getActiveWeapon();
        const maxRange = wpn.ranged ? 380 : 125;
        let autoTarget = enemies.find(e => e.id === localPlayer.targetEntityId && Math.hypot(e.x - localPlayer.x, e.y - localPlayer.y) <= maxRange);
        if (!autoTarget) autoTarget = enemies.find(e => Math.hypot(e.x - localPlayer.x, e.y - localPlayer.y) <= maxRange);
        if (autoTarget) {
          localPlayer.targetEntityId = autoTarget.id;
          performPrimaryWeaponAttack();
        }
      }

      let moveX = 0, moveY = 0;
      if (keys['w'] || keys['arrowup']) moveY -= 1;
      if (keys['s'] || keys['arrowdown']) moveY += 1;
      if (keys['a'] || keys['arrowleft']) moveX -= 1;
      if (keys['d'] || keys['arrowright']) moveX += 1;

      if (moveX !== 0 || moveY !== 0) {
        localPlayer.targetX = null; localPlayer.targetY = null;
        const len = Math.hypot(moveX, moveY);
        resolveDungeonMovement(localPlayer, localPlayer.x + (moveX / len) * localPlayer.speed * dt, localPlayer.y + (moveY / len) * localPlayer.speed * dt);
        if (Math.abs(moveX) > 0.05) localPlayer.facing = moveX > 0 ? 1 : -1;
        localPlayer.isMoving = true;
      } else if (localPlayer.targetX !== null && localPlayer.targetY !== null) {
        const dx = localPlayer.targetX - localPlayer.x;
        const dy = localPlayer.targetY - localPlayer.y;
        const dist = Math.hypot(dx, dy);
        if (dist > 8) {
          resolveDungeonMovement(localPlayer, localPlayer.x + (dx / dist) * localPlayer.speed * dt, localPlayer.y + (dy / dist) * localPlayer.speed * dt);
          if (Math.abs(dx) > 2) localPlayer.facing = dx > 0 ? 1 : -1;
          localPlayer.isMoving = true;
        } else {
          localPlayer.targetX = null; localPlayer.targetY = null;
          localPlayer.isMoving = false;
        }
      } else {
        localPlayer.isMoving = false;
      }

      const activeSector = getWalkableSectorAt(localPlayer.x, localPlayer.y);
      if (activeSector) {
        document.getElementById('shard-status').textContent = activeSector.name;
      }

      const pvpBadge = document.getElementById('pvp-badge');
      if (inSafezone) {
        pvpBadge.textContent = '[SAFEZONE]';
        pvpBadge.style.color = '#4ade80';
        localPlayer.hp = Math.min(localPlayer.maxHp, localPlayer.hp + 15 * dt);
        localPlayer.mana = Math.min(localPlayer.maxMana, localPlayer.mana + 18 * dt);
      } else {
        pvpBadge.textContent = '[⚔️ STAGE 1 PURGATORY]';
        pvpBadge.style.color = '#ef4444';
        localPlayer.mana = Math.min(localPlayer.maxMana, localPlayer.mana + 5 * dt);
      }

      for (let i = atmanMotes.length - 1; i >= 0; i--) {
        const am = atmanMotes[i];
        const dist = Math.hypot(localPlayer.x - am.x, (localPlayer.y - 18) - am.y);
        if (dist < 240) {
          const ang = Math.atan2((localPlayer.y - 18) - am.y, localPlayer.x - am.x);
          am.x += Math.cos(ang) * 340 * dt;
          am.y += Math.sin(ang) * 340 * dt;
        }
        if (dist < 24) {
          localPlayer.atman = Math.min(localPlayer.maxAtman, localPlayer.atman + am.val);
          spawnCombatText(localPlayer.x, localPlayer.y - 34, `+${am.val} ATMAN`, '#fde047');
          atmanMotes.splice(i, 1);
        }
      }

      updateVitalsUI();
      renderStage1Minimap();

      for (let i = projectiles.length - 1; i >= 0; i--) {
        const pj = projectiles[i];
        pj.x += pj.vx * dt; pj.y += pj.vy * dt; pj.life -= dt;

        let hitWall = !getWalkableSectorAt(pj.x, pj.y);
        if (!hitWall) {
          for (const pil of SOLID_PILLARS) {
            if (Math.hypot(pj.x - pil.x, pj.y - pil.y) < pil.r) { hitWall = true; break; }
          }
        }
        if (hitWall || pj.life <= 0) {
          if (pj.explosive) spawnSpellVortex(pj.x, pj.y, pj.color, 65);
          projectiles.splice(i, 1);
          continue;
        }

        if (pj.isEnemy) {
          if (!inSafezone && localPlayer.dodgeTimer <= 0 && Math.hypot(pj.x - localPlayer.x, pj.y - (localPlayer.y - 16)) < 22 + pj.radius) {
            const taken = Math.max(1, Math.round(pj.dmg * (localPlayer.combatStance === 'bastion' ? 0.7 : 1.0)));
            localPlayer.hp = Math.max(0, localPlayer.hp - taken);
            localPlayer.hitFlash = 7;
            playSfx('slash');
            spawnCombatText(localPlayer.x, localPlayer.y, `-${taken}`, '#ef4444');
            projectiles.splice(i, 1);
            if (localPlayer.hp <= 0) handleFullLootDeath();
            continue;
          }
        } else {
          let hitMob = false;
          for (let m = enemies.length - 1; m >= 0; m--) {
            const en = enemies[m];
            if (Math.hypot(pj.x - en.x, pj.y - (en.y - 16)) < en.radius + pj.radius + 6) {
              const res = applyDamageWithTypeCheck(en, pj.dmg, pj.dmgType || 'SLASH');
              if (pj.explosive) spawnSpellVortex(en.x, en.y, pj.color, 85);
              else spawnSlashArc(en.x, en.y, pj.vx >= 0 ? 1 : -1, pj.color, 36);

              if (en.hp <= 0) {
                if (res.exploitedWeakness) spawnOvaDecapitation(en.x, en.y, pj.vx >= 0 ? 1 : -1);
                handleEnemyKilled(en, m);
              }
              hitMob = true;
              break;
            }
          }
          if (hitMob) { projectiles.splice(i, 1); continue; }
        }
      }

      let activeBoss = null;
      enemies.forEach(en => {
        if (en.hitFlash > 0) en.hitFlash--;
        const distToPlayer = Math.hypot(localPlayer.x - en.x, localPlayer.y - en.y);
        if (en.isBoss && distToPlayer < 680) activeBoss = en;

        if (distToPlayer < 520 && distToPlayer > 38 && !inSafezone) {
          const ang = Math.atan2(localPlayer.y - en.y, localPlayer.x - en.x);
          const nx = en.x + Math.cos(ang) * en.speed * dt;
          const ny = en.y + Math.sin(ang) * en.speed * dt;
          if (!isInsideFirepitSafezone(nx, ny)) resolveDungeonMovement(en, nx, ny);

          if (en.isBoss || en.ranged) {
            en.shootCooldown = (en.shootCooldown || 1.8) - dt;
            if (en.shootCooldown <= 0) {
              en.shootCooldown = en.isBoss ? 1.4 : 2.3;
              if (en.isBoss) {
                for (let b = 0; b < 8; b++) {
                  projectiles.push({
                    ownerId: en.id, isEnemy: true, x: en.x, y: en.y - 20,
                    vx: Math.cos((b / 8) * Math.PI * 2) * 330, vy: Math.sin((b / 8) * Math.PI * 2) * 330,
                    angle: (b / 8) * Math.PI * 2, speed: 330, dmg: 18, color: '#facc15', projType: 'orb', radius: 9, life: 2.0
                  });
                }
              } else {
                projectiles.push({
                  ownerId: en.id, isEnemy: true, x: en.x, y: en.y - 16,
                  vx: Math.cos(ang) * 330, vy: Math.sin(ang) * 330,
                  angle: ang, speed: 330, dmg: 14, color: en.color, projType: 'arrow', radius: 6, life: 1.5
                });
              }
            }
          }
        }
      });

      currentMusicTheme = activeBoss ? 'boss' : (inSafezone ? 'tavern' : 'labyrinth');

      const bossWrap = document.getElementById('boss-bar-wrap');
      if (activeBoss) {
        bossWrap.style.display = 'flex';
        document.getElementById('boss-bar-title').textContent = `☠️ ${activeBoss.name} [WEAKNESS: ${activeBoss.weakTo}] (${Math.max(0, Math.round(activeBoss.hp))}/${activeBoss.maxHp})`;
        document.getElementById('boss-hp-fill').style.width = `${Math.max(0, (activeBoss.hp / activeBoss.maxHp) * 100)}%`;
      } else {
        bossWrap.style.display = 'none';
      }

      if (localPlayer.swingTimer > 0) localPlayer.swingTimer--;
      if (localPlayer.dodgeTimer > 0) localPlayer.dodgeTimer--;
      if (localPlayer.hitFlash > 0) localPlayer.hitFlash--;
      if (screenShake > 0) screenShake = Math.max(0, screenShake - 40 * dt);

      renderWorld(nowSec);
      requestAnimationFrame(gameLoop);
    }

    // =========================================================================
    // 11. RENDER WORLD (ILLUMINATED WALLS, TORCHES, BONFIRE, HAZARDS)
    // =========================================================================
    function renderWorld(timeSec) {
      ctx.clearRect(0, 0, screenW, screenH);
      const camX = localPlayer.x - screenW / 2;
      const camY = localPlayer.y - screenH / 2;

      ctx.save();
      ctx.translate(-camX, -camY);

      // Deep void background
      ctx.fillStyle = '#06050a';
      ctx.fillRect(camX, camY, screenW, screenH);

      // 1. Draw Visible Stage Rooms with Beveled Stone Flagstones
      worldSectors.forEach(sec => {
        sec.rects.forEach(r => {
          ctx.fillStyle = '#0e0b14';
          ctx.fillRect(r.x - 10, r.y - 24, r.w + 20, r.h + 34);
          ctx.fillStyle = floorPatterns[sec.floor] || '#283244';
          ctx.fillRect(r.x, r.y, r.w, r.h);

          if (r.isMain) {
            ctx.strokeStyle = sec.safe ? 'rgba(212, 167, 85, 0.65)' : (sec.isBossRoom ? 'rgba(239, 68, 68, 0.75)' : 'rgba(99, 115, 140, 0.55)');
            ctx.lineWidth = 3.5;
            ctx.strokeRect(r.x, r.y, r.w, r.h);
          }
        });

        const scx = sec.gx * TILE_SIZE + 500;
        const scy = sec.gy * TILE_SIZE + 145;
        ctx.font = '900 13px Cinzel, serif';
        ctx.textAlign = 'center';
        ctx.fillStyle = sec.safe ? 'rgba(250, 232, 184, 0.75)' : (sec.isBossRoom ? 'rgba(252, 165, 165, 0.85)' : 'rgba(226, 232, 240, 0.65)');
        ctx.fillText(sec.name.toUpperCase(), scx, scy);
      });

      // 2. Draw Environmental Hazards
      activeHazards.forEach(hz => {
        if (hz.type === 'lava') {
          const flick = Math.sin(timeSec * 8 + hz.x) * 6;
          const grad = ctx.createRadialGradient(hz.x, hz.y, 10, hz.x, hz.y, hz.r + flick);
          grad.addColorStop(0, '#f97316'); grad.addColorStop(0.7, '#dc2626'); grad.addColorStop(1, 'rgba(0,0,0,0)');
          ctx.fillStyle = grad;
          ctx.beginPath(); ctx.arc(hz.x, hz.y, hz.r + flick, 0, Math.PI * 2); ctx.fill();
        } else if (hz.type === 'acid') {
          ctx.fillStyle = 'rgba(132, 204, 22, 0.45)';
          ctx.strokeStyle = '#84cc16'; ctx.lineWidth = 2.5;
          ctx.beginPath(); ctx.arc(hz.x, hz.y, hz.r, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
        } else if (hz.type === 'spikes') {
          const spikesActive = (spikeTrapTick > 1.4);
          ctx.fillStyle = spikesActive ? 'rgba(220, 38, 38, 0.4)' : 'rgba(40, 50, 70, 0.55)';
          ctx.strokeStyle = spikesActive ? '#ef4444' : '#64748b';
          ctx.lineWidth = 2;
          ctx.fillRect(hz.x - hz.w/2, hz.y - hz.h/2, hz.w, hz.h);
          ctx.strokeRect(hz.x - hz.w/2, hz.y - hz.h/2, hz.w, hz.h);
          if (spikesActive) {
            ctx.fillStyle = '#f8fafc';
            for (let sx = hz.x - hz.w/2 + 20; sx < hz.x + hz.w/2; sx += 35) {
              for (let sy = hz.y - hz.h/2 + 20; sy < hz.y + hz.h/2; sy += 35) {
                ctx.beginPath(); ctx.arc(sx, sy, 4, 0, Math.PI * 2); ctx.fill();
              }
            }
          }
        }
      });

      // 3. Draw Stage 2 Descent Portal in (-1, -1) when Boss is Defeated
      if (bossDefeated) {
        ctx.save();
        ctx.translate(stage2PortalPos.x, stage2PortalPos.y);
        ctx.rotate(timeSec * 3);
        const pGrad = ctx.createRadialGradient(0, 0, 5, 0, 0, stage2PortalPos.radius);
        pGrad.addColorStop(0, '#fde047'); pGrad.addColorStop(0.5, '#38bdf8'); pGrad.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.fillStyle = pGrad;
        ctx.beginPath(); ctx.arc(0, 0, stage2PortalPos.radius, 0, Math.PI * 2); ctx.fill();
        ctx.font = '900 11px Cinzel, serif'; ctx.fillStyle = '#fff'; ctx.textAlign = 'center';
        ctx.fillText('STAGE 2 DESCENT', 0, 4);
        ctx.restore();
      }

      // 4. Draw Central Firepit with Active Bonfire & Coiled Steel Sword
      ctx.save();
      ctx.strokeStyle = 'rgba(74, 222, 128, 0.4)'; ctx.lineWidth = 3;
      ctx.beginPath(); ctx.arc(FIREPIT_POS.x, FIREPIT_POS.y, FIREPIT_POS.safeRadius, 0, Math.PI * 2); ctx.stroke();

      const flicker = Math.sin(timeSec * 9) * 16;
      const fireGrad = ctx.createRadialGradient(FIREPIT_POS.x, FIREPIT_POS.y, 16, FIREPIT_POS.x, FIREPIT_POS.y, 350 + flicker);
      fireGrad.addColorStop(0, 'rgba(251, 146, 60, 0.65)'); fireGrad.addColorStop(0.5, 'rgba(220, 38, 38, 0.28)'); fireGrad.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = fireGrad; ctx.beginPath(); ctx.arc(FIREPIT_POS.x, FIREPIT_POS.y, 350 + flicker, 0, Math.PI * 2); ctx.fill();

      // Stone Basin & Coals
      ctx.fillStyle = '#1c1626'; ctx.strokeStyle = '#cfa354'; ctx.lineWidth = 4;
      ctx.beginPath(); ctx.arc(FIREPIT_POS.x, FIREPIT_POS.y, FIREPIT_POS.radius, 0, Math.PI * 2); ctx.fill(); ctx.stroke();

      for (let f = 0; f < 7; f++) {
        const ang = (f / 7) * Math.PI * 2 + timeSec * 2;
        const r = 24 + Math.sin(timeSec * 8 + f) * 10;
        ctx.fillStyle = f % 2 === 0 ? '#f97316' : '#facc15';
        ctx.beginPath(); ctx.arc(FIREPIT_POS.x + Math.cos(ang) * r * 0.5, FIREPIT_POS.y + Math.sin(ang) * r * 0.5, 14, 0, Math.PI * 2); ctx.fill();
      }
      ctx.strokeStyle = '#f8fafc'; ctx.lineWidth = 4;
      ctx.beginPath(); ctx.moveTo(FIREPIT_POS.x, FIREPIT_POS.y + 8); ctx.lineTo(FIREPIT_POS.x + 6, FIREPIT_POS.y - 48); ctx.stroke();
      ctx.restore();

      // 5. Draw Wall Torches with Radiating Light Pools
      WALL_TORCHES.forEach((wt, idx) => {
        const flick = Math.sin(timeSec * 10 + idx) * 12;
        const grad = ctx.createRadialGradient(wt.x, wt.y, 6, wt.x, wt.y, 180 + flick);
        grad.addColorStop(0, 'rgba(251, 146, 60, 0.42)'); grad.addColorStop(1, 'rgba(0, 0, 0, 0)');
        ctx.fillStyle = grad; ctx.beginPath(); ctx.arc(wt.x, wt.y, 180 + flick, 0, Math.PI * 2); ctx.fill();

        ctx.fillStyle = '#f97316'; ctx.beginPath(); ctx.arc(wt.x, wt.y, 6.5, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = '#fef08a'; ctx.beginPath(); ctx.arc(wt.x, wt.y, 3, 0, Math.PI * 2); ctx.fill();
      });

      // 6. Draw Portcullis Gates
      GATES.forEach(g => {
        ctx.save();
        ctx.translate(g.x, g.y);
        const openRatio = g.openAnim || 0;
        ctx.fillStyle = '#3a4454'; ctx.strokeStyle = '#040306'; ctx.lineWidth = 3;
        if (g.horiz) {
          ctx.fillRect(-140, -18, 28, 36); ctx.fillRect(112, -18, 28, 36);
          if (openRatio < 0.8) {
            ctx.fillStyle = g.isBossGate ? 'rgba(220,38,38,0.7)' : 'rgba(15,23,42,0.88)';
            ctx.fillRect(-110, -10, 220 * (1 - openRatio), 20);
          } else {
            ctx.fillStyle = 'rgba(34, 197, 94, 0.25)';
            ctx.fillRect(-110, -14, 220, 28);
          }
        } else {
          ctx.fillRect(-18, -140, 36, 28); ctx.fillRect(-18, 112, 36, 28);
          if (openRatio < 0.8) {
            ctx.fillStyle = g.isBossGate ? 'rgba(220,38,38,0.7)' : 'rgba(15,23,42,0.88)';
            ctx.fillRect(-10, -110, 20, 220 * (1 - openRatio));
          } else {
            ctx.fillStyle = 'rgba(34, 197, 94, 0.25)';
            ctx.fillRect(-14, -110, 28, 220);
          }
        }
        ctx.font = '800 9px Cinzel, serif'; ctx.textAlign = 'center';
        ctx.fillStyle = g.isOpen ? '#4ade80' : (g.isBossGate ? '#f87171' : '#facc15');
        ctx.fillText(g.label, 0, -24);
        ctx.restore();
      });

      // 7. Draw Pillars
      SOLID_PILLARS.forEach(pil => {
        ctx.fillStyle = '#263147'; ctx.strokeStyle = '#040306'; ctx.lineWidth = 3;
        ctx.beginPath(); ctx.arc(pil.x, pil.y, pil.r, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
      });

      // 8. Draw Chests
      lootChests.forEach(ch => {
        ctx.save();
        ctx.translate(ch.x, ch.y);
        ctx.fillStyle = ch.isSealChest ? '#b45309' : '#5c3a18';
        ctx.strokeStyle = ch.isSealChest ? '#fde047' : '#38bdf8';
        ctx.lineWidth = 2.5;
        ctx.fillRect(-16, -12, 32, 24); ctx.strokeRect(-16, -12, 32, 24);
        ctx.font = '800 10px Cinzel, serif'; ctx.textAlign = 'center';
        ctx.fillStyle = ch.isSealChest ? '#f
