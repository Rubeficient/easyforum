<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Tartaria - Stage 1: The Purgatory of Dilmun</title>
  <script src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;800;900&family=Crimson+Pro:ital,wght@0,500;0,700;1,400&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --ink-black: #040306;
      --tartaria-bg: #07060b;
      --tartaria-gold: #cfa354;
      --tartaria-gold-bright: #f8e2a8;
      --atman-amber: #fbbf24;
      --wiz-red: #dc2626;
      --hazard-green: #84cc16;
      --hazard-orange: #f97316;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; }
    body, html { width: 100%; height: 100%; overflow: hidden; background: var(--ink-black); font-family: 'Crimson Pro', Georgia, serif; color: #e6dcc8; }
    canvas#gameCanvas { display: block; width: 100vw; height: 100vh; background: var(--tartaria-bg); cursor: crosshair; }

    #crt-overlay {
      position: fixed; inset: 0; pointer-events: none; z-index: 90;
      background: linear-gradient(rgba(14,12,18,0) 50%, rgba(0,0,0,0.25) 50%), radial-gradient(circle at center, transparent 58%, rgba(2,1,5,0.82) 100%);
      background-size: 100% 3px, 100% 100%;
    }
    .tartaria-window {
      background: linear-gradient(180deg, rgba(18,16,26,0.94) 0%, rgba(7,6,12,0.98) 100%);
      border: 1.5px solid var(--tartaria-gold); outline: 2px solid #000;
      box-shadow: 0 6px 20px rgba(0,0,0,0.85), inset 0 0 0 1px rgba(255,230,160,0.12);
      border-radius: 3px;
    }

    /* Modal / Character Screen */
    #char-modal {
      position: absolute; inset: 0; background: radial-gradient(circle at 50% 25%, rgba(45,22,32,0.96) 0%, rgba(4,3,7,0.99) 85%);
      display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 100; padding: 12px; overflow-y: auto;
    }
    .char-card { width: 100%; max-width: 900px; padding: 18px 22px; display: grid; grid-template-columns: 1.25fr 0.75fr; gap: 16px; }
    @media (max-width: 740px) { .char-card { grid-template-columns: 1fr; } }
    .title-banner { grid-column: 1 / -1; text-align: center; border-bottom: 2px solid #3a2818; padding-bottom: 10px; }
    .wiz-logo-wrap { position: relative; display: inline-block; padding: 0 46px; }
    .wiz-logo-sword { position: absolute; top: 52%; left: 0; right: 0; height: 4px; background: linear-gradient(90deg, #ef4444 0%, #dc2626 85%, #facc15 100%); z-index: 1; }
    .wiz-logo-sword::after { content: ''; position: absolute; right: 12px; top: -9px; width: 4px; height: 22px; background: #ef4444; }
    .title-banner h1 { position: relative; z-index: 2; font-family: 'Cinzel', serif; font-size: 32px; font-weight: 900; letter-spacing: 7px; color: #ef4444; text-shadow: 2px 2px 0 #000; }
    .title-banner h2 { font-family: 'Cinzel', serif; font-size: 11px; letter-spacing: 2px; color: var(--tartaria-gold-bright); margin-top: 4px; }
    .form-col { display: flex; flex-direction: column; gap: 8px; }
    .preview-col { display: flex; flex-direction: column; align-items: center; justify-content: space-between; background: #07080d; border: 2px solid #3a2818; padding: 10px; }
    #previewCanvas { width: 240px; height: 215px; background: radial-gradient(circle at 50% 65%, #232a3b 0%, #050508 78%); border: 1px solid #2d2016; }
    .lore-box { font-size: 12px; line-height: 1.35; color: #d8c8b4; font-style: italic; text-align: center; padding: 6px 8px; background: rgba(12,10,16,0.92); border-left: 3px solid var(--tartaria-gold); width: 100%; }
    .form-group { display: flex; flex-direction: column; gap: 3px; }
    label { font-family: 'Cinzel', serif; font-size: 10px; font-weight: 800; color: var(--tartaria-gold); letter-spacing: 1px; }
    input[type="text"], select { background: #050408; border: 1.5px solid #4a3520; color: #f3ebd6; padding: 6px 10px; border-radius: 2px; font-family: 'Crimson Pro', serif; font-size: 14px; font-weight: 600; outline: none; }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .name-row { display: flex; gap: 6px; }
    .name-row input { flex: 1; }
    .swatch-row { display: flex; gap: 6px; margin-top: 2px; }
    .swatch { width: 22px; height: 22px; border: 2px solid #000; outline: 1px solid #574129; cursor: pointer; }
    .swatch.active { transform: scale(1.18); outline: 2px solid var(--tartaria-gold-bright); }
    .btn-spawn { grid-column: 1 / -1; background: linear-gradient(180deg, #991b1b 0%, #450a0a 100%); border: 2px solid var(--tartaria-gold-bright); color: #fff4db; padding: 11px; font-family: 'Cinzel', serif; font-size: 14px; font-weight: 900; letter-spacing: 2px; cursor: pointer; }

    /* HUD Layout */
    #hud { position: fixed; inset: 0; pointer-events: none; display: none; z-index: 50; }
    .interactive { pointer-events: auto; }

    .top-ribbon {
      position: absolute; top: 0; left: 0; right: 0; height: 34px;
      background: linear-gradient(180deg, rgba(12,10,18,0.96) 0%, rgba(6,5,10,0.92) 100%);
      border-bottom: 1.5px solid var(--tartaria-gold);
      display: flex; justify-content: space-between; align-items: center; padding: 0 12px;
      font-family: 'Cinzel', serif; font-size: 10.5px; z-index: 60;
    }
    .ribbon-left, .ribbon-right { display: flex; align-items: center; gap: 8px; }
    .action-btn {
      background: linear-gradient(180deg, #241b29 0%, #120d16 100%);
      border: 1px solid var(--tartaria-gold); color: var(--tartaria-gold-bright);
      padding: 3px 8px; font-family: 'Cinzel', serif; font-size: 9px; font-weight: 700;
      cursor: pointer; text-transform: uppercase; border-radius: 2px;
    }
    .action-btn:hover { background: #382833; border-color: #fff; }

    /* Top-Left Profile + Party Dock */
    #top-left-dock { position: absolute; top: 40px; left: 10px; width: 252px; display: flex; flex-direction: column; gap: 6px; }
    .profile-card { padding: 8px 10px; font-size: 10px; }
    .profile-header { display: flex; align-items: center; gap: 8px; margin-bottom: 4px; }
    .portrait-badge {
      width: 36px; height: 36px; border-radius: 50%;
      background: radial-gradient(circle at 50% 40%, #3b2838 0%, #09070d 100%);
      border: 2px solid var(--tartaria-gold-bright);
      display: flex; align-items: center; justify-content: center;
      font-family: 'Cinzel', serif; font-weight: 900; font-size: 14px; color: #fde047;
    }
    .bar-row { margin-top: 3px; }
    .bar-label { display: flex; justify-content: space-between; font-size: 8.5px; font-family: 'JetBrains Mono', monospace; }
    .bar-container { width: 100%; height: 6px; background: #050408; border: 1px solid #3d2d1f; margin-top: 1px; overflow: hidden; border-radius: 1px; }
    .bar-fill { height: 100%; width: 100%; transition: width 0.12s linear; }
    #hp-fill { background: linear-gradient(90deg, #991b1b 0%, #ef4444 100%); }
    #mana-fill { background: linear-gradient(90deg, #1e40af 0%, #38bdf8 100%); }
    #atman-fill { background: linear-gradient(90deg, #b45309 0%, #fbbf24 60%, #fef08a 100%); }
    #xp-fill { background: linear-gradient(90deg, #854d0e 0%, #f4dca6 100%); }

    #party-mates-box { padding: 6px 8px; font-size: 9.5px; display: flex; flex-direction: column; gap: 4px; }
    .party-member { display: flex; align-items: center; justify-content: space-between; gap: 6px; background: rgba(5,4,9,0.85); border: 1px solid #3a2a18; padding: 4px 6px; border-radius: 2px; }
    .mate-avatar { width: 22px; height: 22px; border-radius: 50%; border: 1.5px solid #38bdf8; background: #111827; display: flex; align-items: center; justify-content: center; font-size: 9px; font-weight: 800; color: #38bdf8; }
    .party-warp-btn { background: #1e293b; border: 1px solid #64748b; color: #e2e8f0; font-family: 'Cinzel', serif; font-size: 8px; padding: 2px 5px; cursor: pointer; }

    /* Right Dock: Stage Map & Weapon Loadout */
    #right-dock { position: absolute; top: 40px; right: 10px; width: 206px; display: flex; flex-direction: column; gap: 6px; }
    #minimap-box { padding: 6px; display: flex; flex-direction: column; align-items: center; gap: 3px; }
    #minimapCanvas { width: 188px; height: 130px; background: #050408; border: 1px solid #4a3520; }
    #stage-objective-card { padding: 6px 8px; font-size: 9px; line-height: 1.25; }

    #weapon-stance-dock { padding: 8px; display: flex; flex-direction: column; gap: 5px; }
    .stance-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; }
    .stance-btn { background: #0b0912; border: 1px solid #4a3520; color: #a89984; padding: 4px 2px; font-family: 'Cinzel', serif; font-size: 8px; font-weight: 800; text-align: center; cursor: pointer; border-radius: 2px; }
    .stance-btn.active { background: linear-gradient(180deg, #5c1919 0%, #2a0a0a 100%); border-color: var(--tartaria-gold-bright); color: #fff; }
    .weapon-slot-card { display: flex; align-items: center; justify-content: space-between; background: rgba(6,5,10,0.9); border: 1.5px solid #42301b; padding: 5px 7px; border-radius: 3px; cursor: pointer; }
    .weapon-slot-card.active { background: linear-gradient(90deg, rgba(85,48,18,0.65) 0%, rgba(16,12,22,0.95) 100%); border-color: var(--tartaria-gold-bright); box-shadow: 0 0 10px rgba(248,226,168,0.3); }
    .wpn-key-badge { font-family: 'JetBrains Mono', monospace; font-size: 8.5px; font-weight: 800; color: #000; background: var(--tartaria-gold); padding: 1px 4px; border-radius: 2px; margin-right: 5px; }
    .wpn-dmg-tag { font-family: 'Cinzel', serif; font-size: 7.5px; font-weight: 900; padding: 1px 4px; border-radius: 2px; }
    .tag-slash { background: #7f1d1d; color: #fca5a5; }
    .tag-blunt { background: #78350f; color: #fde047; }
    .tag-pierce { background: #1e3a8a; color: #93c5fd; }

    /* Top-Center Boss Bar */
    #boss-bar-wrap { position: absolute; top: 40px; left: 50%; transform: translateX(-50%); width: 440px; max-width: calc(100vw - 490px); padding: 6px 12px; display: none; flex-direction: column; gap: 3px; z-index: 70; pointer-events: none; }
    #boss-bar-title { font-family: 'Cinzel', serif; font-size: 11px; font-weight: 900; color: #fca5a5; letter-spacing: 1.5px; text-align: center; }
    .boss-hp-track { width: 100%; height: 10px; background: #090508; border: 1.5px solid #cfa354; overflow: hidden; }
    #boss-hp-fill { width: 100%; height: 100%; background: linear-gradient(90deg, #7f1d1d 0%, #ef4444 50%, #f97316 100%); transition: width 0.1s linear; }

    /* Bottom-Left Chat */
    .chat-container { position: absolute; bottom: 68px; left: 10px; width: 290px; max-width: calc(100vw - 24px); display: flex; flex-direction: column; gap: 3px; opacity: 0.86; }
    .chat-container:hover { opacity: 1.0; }
    .chat-log { height: 80px; padding: 6px 8px; overflow-y: auto; display: flex; flex-direction: column; gap: 2px; font-size: 11px; background: rgba(8,7,14,0.78); }
    .chat-msg { word-break: break-word; line-height: 1.22; }
    .chat-msg .author { color: var(--tartaria-gold-bright); font-weight: 700; font-family: 'Cinzel', serif; margin-right: 4px; }
    .chat-input-row { display: flex; gap: 4px; }
    .chat-input { flex: 1; background: rgba(5,4,8,0.92); border: 1.5px solid #4a3520; padding: 4px 8px; color: #f3ebd6; font-size: 11.5px; outline: none; }

    /* Bottom-Center Specials */
    .bottom-action-dock {
      position: absolute; bottom: 8px; left: 50%; transform: translateX(-50%);
      display: flex; align-items: center; gap: 6px; padding: 4px 8px;
      background: rgba(8,7,13,0.94); border: 1.5px solid var(--tartaria-gold); border-radius: 4px;
    }
    .special-orb-btn {
      width: 46px; height: 46px; border-radius: 50%;
      background: radial-gradient(circle at 35% 35%, #f59e0b 0%, #78350f 70%, #1c1917 100%);
      border: 2px solid var(--tartaria-gold-bright); color: #fff;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      cursor: pointer; font-family: 'Cinzel', serif; font-size: 7.5px; font-weight: 900;
    }
    .hotbar { display: flex; gap: 4px; }
    .hotkey-slot {
      width: 46px; height: 46px; background: linear-gradient(180deg, #1b1724 0%, #09080d 100%);
      border: 1.5px solid #6b532e; display: flex; flex-direction: column; align-items: center; justify-content: center;
      cursor: pointer; position: relative; border-radius: 2px; overflow: hidden;
    }
    .hotkey-slot.locked { opacity: 0.38; cursor: not-allowed; }
    .hotkey-slot:not(.locked):hover { border-color: var(--tartaria-gold-bright); }
    .hotkey-num { position: absolute; top: 1px; left: 3px; font-family: 'JetBrains Mono', monospace; font-size: 8px; font-weight: 700; color: var(--tartaria-gold); }
    .hotkey-mp { position: absolute; top: 1px; right: 3px; font-family: 'JetBrains Mono', monospace; font-size: 7px; color: #38bdf8; }
    .hotkey-icon { font-size: 15px; margin-top: 3px; }
    .hotkey-label { font-family: 'Cinzel', serif; font-size: 6.5px; color: #dfd0ba; text-transform: uppercase; margin-top: 1px; text-align: center; }
    .cd-overlay { position: absolute; bottom: 0; left: 0; right: 0; height: 0%; background: rgba(0,0,0,0.72); pointer-events: none; }

    /* Modals */
    #loot-modal, #inventory-modal, #grimoire-modal {
      position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
      width: 92%; max-width: 560px; background: rgba(10,8,15,0.94); backdrop-filter: blur(8px);
      border: 2px solid var(--tartaria-gold); outline: 2px solid #000; padding: 16px 20px;
      display: none; flex-direction: column; gap: 10px; z-index: 165;
    }
    .loot-item-row { display: flex; justify-content: space-between; align-items: center; background: rgba(5,4,8,0.9); border: 1px solid #4a3520; padding: 7px 10px; border-radius: 2px; }
    .rarity-common { color: #e2e8f0; }
    .rarity-rare { color: #38bdf8; }
    .rarity-epic { color: #facc15; }
    .rarity-legendary { color: #f87171; text-shadow: 0 0 8px rgba(248,113,113,0.4); }

    .equip-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .equip-box { background: rgba(5,4,8,0.85); border: 1px solid #574129; padding: 7px; text-align: center; cursor: pointer; }
    .bag-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
    .bag-slot { min-height: 64px; background: rgba(5,4,8,0.82); border: 1px solid #3a2a18; padding: 6px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; cursor: pointer; }
    .spell-list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; max-height: 260px; overflow-y: auto; }
    .spell-card { background: #060509; border: 1px solid #4a3520; padding: 8px 10px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; }

    #souls-banner {
      position: absolute; top: 22%; left: 0; right: 0;
      background: linear-gradient(90deg, transparent 0%, rgba(10,4,6,0.92) 25%, rgba(10,4,6,0.92) 75%, transparent 100%);
      border-top: 1px solid rgba(200,157,84,0.45); border-bottom: 1px solid rgba(200,157,84,0.45);
      padding: 12px 0; text-align: center; font-family: 'Cinzel', serif; font-size: 23px; font-weight: 900; letter-spacing: 5px; color: #fbbf24;
      display: none; z-index: 190; pointer-events: none;
    }
    #toast {
      position: absolute; top: 82px; left: 50%; transform: translateX(-50%);
      padding: 5px 16px; font-family: 'Cinzel', serif; font-size: 11px; font-weight: 800; color: var(--tartaria-gold-bright);
      display: none; z-index: 200; text-shadow: 1px 1px 0 #000;
    }
  </style>
</head>
<body>

  <div id="crt-overlay"></div>
  <div id="souls-banner">SECTOR CARVED INTO STONE</div>

  <div id="boss-bar-wrap" class="tartaria-window">
    <div id="boss-bar-title">☠️ PETRIFIED STATUE OF FATHER ABESHU</div>
    <div class="boss-hp-track"><div id="boss-hp-fill"></div></div>
  </div>

  <!-- Character Creation Modal -->
  <div id="char-modal">
    <div class="char-card tartaria-window">
      <div class="title-banner">
        <div class="wiz-logo-wrap">
          <div class="wiz-logo-sword"></div>
          <h1>TARTARIA</h1>
        </div>
        <h2>Stage 1: The Purgatory of Dilmun • Bounded Dungeon • Environmental Hazards</h2>
      </div>

      <div class="form-col">
        <div class="grid-2">
          <div class="form-group">
            <label for="char-name">Character Name</label>
            <div class="name-row">
              <input type="text" id="char-name" maxlength="18" value="Hawkwind">
              <button type="button" id="btn-roll-name" class="action-btn">🎲 Roll</button>
            </div>
          </div>
          <div class="form-group">
            <label for="shard-code-input">Party Shard Code (1-4 Players)</label>
            <input type="text" id="shard-code-input" maxlength="12" value="MAIN">
          </div>
        </div>

        <div class="grid-2">
          <div class="form-group">
            <label for="char-race">Non-Human Race</label>
            <select id="char-race"></select>
          </div>
          <div class="form-group">
            <label for="char-subrace">Sub-Race Archetype</label>
            <select id="char-subrace"></select>
          </div>
        </div>

        <div class="grid-2">
          <div class="form-group">
            <label for="char-class">Core Calling (Lv.1)</label>
            <select id="char-class">
              <option value="Rogue">Rogue (Highlander Bow / OVA Ninja)</option>
              <option value="Fighter">Fighter (Fire Giant Cleaver / Vanguard)</option>
              <option value="Mage">Mage (Sorceress Orb / Dilmun High Mage)</option>
              <option value="Cleric">Cleric (Gaiden Witch / Sun-Priest)</option>
            </select>
          </div>
          <div class="form-group">
            <label for="char-sect">Magic Sect</label>
            <select id="char-sect">
              <option value="Classic">Llylgamyn Chants (Classic Wizardry)</option>
              <option value="Sun">Dilmun Sun Magic (Dragon Wars)</option>
              <option value="West">Pillars of Zhad (Atman Cymatics)</option>
            </select>
          </div>
        </div>

        <div class="grid-2">
          <div class="form-group">
            <label>Plate Tint</label>
            <div class="swatch-row" id="armor-swatches"></div>
          </div>
          <div class="form-group">
            <label>Mane / Crest Tint</label>
            <div class="swatch-row" id="hair-swatches"></div>
          </div>
        </div>
      </div>

      <div class="preview-col">
        <span style="font-family:'Cinzel',serif; font-size:10px; color:#cfa354;">2.5D CEL SPRITE</span>
        <canvas id="previewCanvas" width="240" height="215"></canvas>
        <div class="lore-box" id="race-lore-box"></div>
      </div>

      <button id="btn-awaken" class="btn-spawn">🔥 Descend into Stage 1: Purgatory of Dilmun</button>
    </div>
  </div>

  <!-- Multi-Item Chest Loot & Appraisal Modal -->
  <div id="loot-modal">
    <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #4a3520; padding-bottom:6px;">
      <span id="loot-modal-title" style="font-family:'Cinzel',serif; font-size:15px; font-weight:900; color:var(--tartaria-gold-bright);">📦 ANCIENT COFFER</span>
      <span id="loot-modal-rarity" style="font-size:11px; color:#38bdf8;">[RARE COFFER]</span>
    </div>
    <div id="loot-items-list" style="display:flex; flex-direction:column; gap:6px; max-height:240px; overflow-y:auto;"></div>
    <div style="display:flex; justify-content:space-between; align-items:center; margin-top:4px;">
      <button class="action-btn" id="btn-take-all-loot" style="background:#166534; border-color:#4ade80; color:#fff; padding:6px 14px;">✨ Take All & Harvest</button>
      <button class="action-btn" onclick="document.getElementById('loot-modal').style.display='none'">Close</button>
    </div>
  </div>

  <!-- Inventory Modal -->
  <div id="inventory-modal">
    <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #4a3520; padding-bottom:6px;">
      <span style="font-family:'Cinzel',serif; font-size:15px; font-weight:900; color:var(--tartaria-gold-bright);">🎒 SATCHEL & ARMORY [I]</span>
      <span id="inv-gold" style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#facc15;">💰 150g</span>
    </div>
    <div class="equip-grid">
      <div class="equip-box" onclick="selectWeaponSlot(0)">
        <small>Prime 1 [Z] (SLASH)</small>
        <strong id="eq-wpn1-name">Cobold Scimitar</strong>
        <span id="eq-wpn1-stat">+18 ATK</span>
      </div>
      <div class="equip-box" onclick="selectWeaponSlot(1)">
        <small>Side 2 [X] (BLUNT)</small>
        <strong id="eq-wpn2-name">Zhad Stone-Maul</strong>
        <span id="eq-wpn2-stat">+20 ATK</span>
      </div>
      <div class="equip-box" onclick="selectWeaponSlot(2)">
        <small>Backup 3 [C] (PIERCE)</small>
        <strong id="eq-wpn3-name">Highlander Bow</strong>
        <span id="eq-wpn3-stat">+17 ATK</span>
      </div>
    </div>
    <div class="bag-grid" id="bag-grid"></div>
    <button class="action-btn" onclick="toggleInventory(false)" style="align-self:flex-end;">Close [I]</button>
  </div>

  <!-- Specials Grimoire Modal -->
  <div id="grimoire-modal" class="tartaria-window">
    <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #4a3520; padding-bottom:6px;">
      <span style="font-family:'Cinzel',serif; font-size:15px; font-weight:900; color:var(--tartaria-gold-bright);">📖 DILMUN SPECIALS GRIMOIRE [G]</span>
