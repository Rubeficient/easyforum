        items: [{ name: 'Blood Seal of Namis', slot: 'relic', isSeal: 'blood', atk: 14, hp: 50, mp: 20, rarity: 'legendary' }]
      });

      lootChests.push({
        id: 'chest-bone-seal', x: -500, y: 500,
        label: '💀 BONE SEAL COFFER', rarity: 'legendary',
        isSealChest: 'bone', isCorpse: false, gold: 120, atman: 25,
        items: [{ name: 'Bone Seal of Werdna', slot: 'relic', isSeal: 'bone', atk: 15, hp: 35, mp: 35, rarity: 'legendary' }]
      });
    }

    // =========================================================================
    // 3. COLLISION, GATES & ENVIRONMENTAL HAZARD ENGINE
    // =========================================================================
    function updateStageHazards(dt) {
      spikeTrapTick = (spikeTrapTick + dt) % 3.0;
      const spikesActive = spikeTrapTick > 1.4;

      if (isInsideFirepitSafezone(localPlayer.x, localPlayer.y) || localPlayer.dodgeTimer > 0) return;

      activeHazards.forEach(hz => {
        if (hz.type === 'lava') {
          if (Math.hypot(localPlayer.x - hz.x, localPlayer.y - hz.y) < hz.r) {
            localPlayer.hp = Math.max(0, localPlayer.hp - 16 * dt);
            localPlayer.hitFlash = 3;
            if (Math.random() < 0.1) spawnCombatText(localPlayer.x, localPlayer.y, '-16 LAVA BURN!', '#f97316');
            if (localPlayer.hp <= 0) handleFullLootDeath();
          }
        } else if (hz.type === 'acid') {
          if (Math.hypot(localPlayer.x - hz.x, localPlayer.y - hz.y) < hz.r) {
            localPlayer.hp = Math.max(0, localPlayer.hp - 11 * dt);
            localPlayer.hitFlash = 2;
            if (Math.random() < 0.1) spawnCombatText(localPlayer.x, localPlayer.y, '-11 ACID SLIME!', '#84cc16');
            if (localPlayer.hp <= 0) handleFullLootDeath();
          }
        } else if (hz.type === 'spikes' && spikesActive) {
          if (localPlayer.x >= hz.x - hz.w/2 && localPlayer.x <= hz.x + hz.w/2 &&
              localPlayer.y >= hz.y - hz.h/2 && localPlayer.y <= hz.y + hz.h/2) {
            localPlayer.hp = Math.max(0, localPlayer.hp - 24 * dt);
            localPlayer.hitFlash = 4;
            playSfx('slash');
            if (Math.random() < 0.1) spawnCombatText(localPlayer.x, localPlayer.y, '-24 SPIKE TRAP!', '#ef4444');
            if (localPlayer.hp <= 0) handleFullLootDeath();
          }
        }
      });
    }

    function updateGatesAutoProximity(dt) {
      const allSealsCollected = stage1Seals.sun && stage1Seals.blood && stage1Seals.bone;

      GATES.forEach(g => {
        if (!g.manualLock) {
          const d = Math.hypot(localPlayer.x - g.x, localPlayer.y - g.y);
          if (g.isBossGate && !allSealsCollected) {
            g.isOpen = false;
          } else if (d < 145 && !g.isOpen) {
            g.isOpen = true;
            playSfx('gate');
          } else if (d > 200 && g.isOpen) {
            g.isOpen = false;
          }
        }
        const targetAnim = g.isOpen ? 1 : 0;
        g.openAnim = (g.openAnim || 0) + (targetAnim - (g.openAnim || 0)) * Math.min(1, dt * 10);
      });
    }

    function toggleNearestGate() {
      let nearest = null, minDist = 185;
      GATES.forEach(g => {
        const d = Math.hypot(localPlayer.x - g.x, localPlayer.y - g.y);
        if (d < minDist) { minDist = d; nearest = g; }
      });
      if (nearest) {
        if (nearest.isBossGate && !(stage1Seals.sun && stage1Seals.blood && stage1Seals.bone)) {
          showToast('Archon Gate Sealed! Recover Sun, Blood, and Bone Seals first.');
          return;
        }
        nearest.isOpen = !nearest.isOpen;
        nearest.manualLock = !nearest.isOpen;
        playSfx('gate');
        showToast(`${nearest.label}: ${nearest.isOpen ? 'OPENED ⛩️' : 'LOCKED SHUT 🔒'}`);
      }
    }

    function isNearOpenGateThreshold(px, py) {
      for (const g of GATES) {
        if (!g.isOpen) continue;
        if (g.horiz) {
          if (Math.abs(px - g.x) < 130 && Math.abs(py - g.y) < 95) return true;
        } else {
          if (Math.abs(px - g.x) < 95 && Math.abs(py - g.y) < 130) return true;
        }
      }
      return false;
    }

    function isBlockedByClosedGate(px, py) {
      for (const g of GATES) {
        if (g.isOpen) continue;
        if (g.horiz) {
          if (Math.abs(px - g.x) < 120 && Math.abs(py - g.y) < 18) return true;
        } else {
          if (Math.abs(px - g.x) < 18 && Math.abs(py - g.y) < 120) return true;
        }
      }
      return false;
    }

    function getWalkableSectorAt(px, py) {
      if (isBlockedByClosedGate(px, py)) return null;

      const gx = Math.floor(px / TILE_SIZE);
      const gy = Math.floor(py / TILE_SIZE);
      const sec = STAGE_SECTORS[sectorKey(gx, gy)];
      if (!sec) return null; // Outside bounded 3x3 stage!

      if (isNearOpenGateThreshold(px, py)) return sec;

      for (let i = 0; i < sec.rects.length; i++) {
        const r = sec.rects[i];
        if (px >= r.x + 8 && px <= r.x + r.w - 8 && py >= r.y + 8 && py <= r.y + r.h - 8) {
          return sec;
        }
      }
      return null;
    }

    function resolveDungeonMovement(entity, nextX, nextY) {
      if (getWalkableSectorAt(nextX, entity.y)) entity.x = nextX;
      if (getWalkableSectorAt(entity.x, nextY)) entity.y = nextY;

      for (let i = 0; i < SOLID_PILLARS.length; i++) {
        const pil = SOLID_PILLARS[i];
        const dist = Math.hypot(entity.x - pil.x, entity.y - pil.y);
        const minR = pil.r + 14;
        if (dist < minR && dist > 0.001) {
          const ang = Math.atan2(entity.y - pil.y, entity.x - pil.x);
          entity.x = pil.x + Math.cos(ang) * minR;
          entity.y = pil.y + Math.sin(ang) * minR;
        }
      }

      const fDist = Math.hypot(entity.x - FIREPIT_POS.x, entity.y - FIREPIT_POS.y);
      if (fDist < FIREPIT_POS.radius + 14) {
        const ang = Math.atan2(entity.y - FIREPIT_POS.y, entity.x - FIREPIT_POS.x);
        entity.x = FIREPIT_POS.x + Math.cos(ang) * (FIREPIT_POS.radius + 14);
        entity.y = FIREPIT_POS.y + Math.sin(ang) * (FIREPIT_POS.radius + 14);
      }
    }

    // =========================================================================
    // 4. DAMAGE-TYPE WEAKNESS ENGINE & AUTO-ATTACK
    // =========================================================================
    function applyDamageWithTypeCheck(en, rawDmg, atkType) {
      let mult = 0.15; // 85% damage penalty for wrong attack type!
      let tag = '';
      let color = '#94a3b8';

      if (atkType === 'ARCANE' || atkType === en.weakTo) {
        mult = localPlayer.combatStance === 'precision' ? 2.15 : 1.75;
        tag = `💥 ${atkType} WEAKNESS!`;
        color = '#84cc16';
        playSfx('crush_weakness');
      } else {
        tag = `🛡️ RESISTED! (USE ${en.weakTo})`;
        color = '#94a3b8';
        playSfx('resist_clang');
      }

      const finalDmg = Math.max(2, Math.round(rawDmg * mult));
      en.hp -= finalDmg;
      en.hitFlash = 6;
      spawnCombatText(en.x, en.y, `-${finalDmg} ${tag}`, color);
      return { finalDmg, exploitedWeakness: mult > 1.0 };
    }

    function performPrimaryWeaponAttack() {
      if (localPlayer.autoAttackTimer > 0) return;
      initAudioEngine();

      const wpn = getActiveWeapon();
      const stanceCdMod = localPlayer.combatStance === 'fury' ? 0.65 : (localPlayer.combatStance === 'bastion' ? 1.15 : 0.9);
      localPlayer.autoAttackTimer = 0.42 * stanceCdMod;
      localPlayer.swingTimer = 16;

      const baseAngle = getAimAngle();
      localPlayer.aimAngle = baseAngle;
      const rawPower = 24 + localPlayer.dmgBonus;

      if (wpn.ranged || wpn.dmgType === 'PIERCE') {
        playSfx('bow');
        spawnProjectile({
          ownerId: localPlayer.id, isEnemy: false, dmgType: wpn.dmgType,
          x: localPlayer.x + Math.cos(baseAngle) * 18,
          y: localPlayer.y - 18 + Math.sin(baseAngle) * 18,
          angle: baseAngle, speed: 680, dmg: rawPower, color: '#93c5fd', projType: 'arrow', radius: 7
        });
      } else {
        playSfx('slash');
        const arcColor = wpn.dmgType === 'BLUNT' ? '#fde047' : '#fca5a5';
        spawnSlashArc(localPlayer.x + Math.cos(baseAngle) * 32, localPlayer.y + Math.sin(baseAngle) * 32, localPlayer.facing, arcColor, 54);
        spawnProjectile({
          ownerId: localPlayer.id, isEnemy: false, dmgType: wpn.dmgType,
          x: localPlayer.x + Math.cos(baseAngle) * 24,
          y: localPlayer.y - 18 + Math.sin(baseAngle) * 24,
          angle: baseAngle, speed: 440, dmg: rawPower, color: arcColor,
          projType: wpn.dmgType === 'BLUNT' ? 'orb' : 'kunai', radius: 13, life: 0.28
        });
      }
      broadcastState();
    }

    // =========================================================================
    // 5. STAGE OBJECTIVES & SEAL DISCOVERY
    // =========================================================================
    function checkCollectSeal(sealType) {
      if (sealType && !stage1Seals[sealType]) {
        stage1Seals[sealType] = true;
        playSfx('loot');
        triggerSoulsBanner(`RECOVERED: ${sealType.toUpperCase()} SEAL!`);

        document.getElementById(`seal-${sealType}-status`).textContent = `✅ ${sealType.toUpperCase()} Seal (Recovered!)`;
        document.getElementById(`seal-${sealType}-status`).style.color = '#4ade80';

        if (stage1Seals.sun && stage1Seals.blood && stage1Seals.bone) {
          triggerSoulsBanner('ALL 3 SEALS BROKEN! ARCHON GATE UNLOCKED!');
          document.getElementById('portal-status').textContent = '⛩️ Archon Gate: UNLOCKED! Slay Abeshu!';
          document.getElementById('portal-status').style.color = '#fde047';
        }
      }
    }

    function checkDescentPortal() {
      if (!bossDefeated) return;
      const d = Math.hypot(localPlayer.x - stage2PortalPos.x, localPlayer.y - stage2PortalPos.y);
      if (d < stage2PortalPos.radius + 15) {
        triggerSoulsBanner('VICTORY! DESCENDING INTO STAGE 2: THE FORBIDDEN VAULTS...');
        playSfx('atman');
        setTimeout(() => {
          showToast('Stage 1 Cleared! Preparing Stage 2 descent...');
        }, 1200);
      }
    }

    // =========================================================================
    // 6. MAIN GAME LOOP, GRAPHICS & PROCEDURAL RENDERER
    // =========================================================================
    let lastTime = performance.now();
    let netTickTimer = 0;

    function gameLoop(now) {
      const dt = Math.min((now - lastTime) / 1000, 0.1);
      lastTime = now;
      const nowSec = now * 0.001;

      updatePreview(now);
      updateGatesAutoProximity(dt);
      updateStageHazards(dt);
      checkDescentPortal();

      if (localPlayer.autoAttackTimer > 0) {
        localPlayer.autoAttackTimer = Math.max(0, localPlayer.autoAttackTimer - dt);
      }

      const inSafezone = isInsideFirepitSafezone(localPlayer.x, localPlayer.y);
      if (!inSafezone && localPlayer.autoAttackTimer <= 0 && document.getElementById('char-modal').style.display === 'none') {
        const wpn = getActiveWeapon();
        const maxRange = wpn.ranged ? 380 : 125;
        let autoTarget = enemies.find(e => e.id === localPlayer.targetEntityId && Math.hypot(e.x - localPlayer.x, e.y - localPlayer.y) <= maxRange);
        if (!autoTarget) autoTarget = enemies.find(e => Math.hypot(e.x - localPlayer.x, e.y - localPlayer.y) <= maxRange);
        if (autoTarget) {
          localPlayer.targetEntityId = autoTarget.id;
          performPrimaryWeaponAttack();
        }
      }

      // Movement Input
      let moveX = 0, moveY = 0;
      if (keys['w'] || keys['arrowup']) moveY -= 1;
      if (keys['s'] || keys['arrowdown']) moveY += 1;
      if (keys['a'] || keys['arrowleft']) moveX -= 1;
      if (keys['d'] || keys['arrowright']) moveX += 1;

      if (moveX !== 0 || moveY !== 0) {
        localPlayer.targetX = null; localPlayer.targetY = null;
        const len = Math.hypot(moveX, moveY);
        resolveDungeonMovement(localPlayer, localPlayer.x + (moveX / len) * localPlayer.speed * dt, localPlayer.y + (moveY / len) * localPlayer.speed * dt);
        if (Math.abs(moveX) > 0.05) localPlayer.facing = moveX > 0 ? 1 : -1;
        localPlayer.isMoving = true;
      } else if (localPlayer.targetX !== null && localPlayer.targetY !== null) {
        const dx = localPlayer.targetX - localPlayer.x;
        const dy = localPlayer.targetY - localPlayer.y;
        const dist = Math.hypot(dx, dy);
        if (dist > 8) {
          resolveDungeonMovement(localPlayer, localPlayer.x + (dx / dist) * localPlayer.speed * dt, localPlayer.y + (dy / dist) * localPlayer.speed * dt);
          if (Math.abs(dx) > 2) localPlayer.facing = dx > 0 ? 1 : -1;
          localPlayer.isMoving = true;
        } else {
          localPlayer.targetX = null; localPlayer.targetY = null;
          localPlayer.isMoving = false;
        }
      } else {
        localPlayer.isMoving = false;
      }

      const activeSector = getWalkableSectorAt(localPlayer.x, localPlayer.y);
      if (activeSector) {
        document.getElementById('shard-status').textContent = activeSector.name;
      }

      const pvpBadge = document.getElementById('pvp-badge');
      if (inSafezone) {
        pvpBadge.textContent = '[SAFEZONE]';
        pvpBadge.style.color = '#4ade80';
        localPlayer.hp = Math.min(localPlayer.maxHp, localPlayer.hp + 15 * dt);
        localPlayer.mana = Math.min(localPlayer.maxMana, localPlayer.mana + 18 * dt);
      } else {
        pvpBadge.textContent = '[⚔️ STAGE 1 PURGATORY]';
        pvpBadge.style.color = '#ef4444';
        localPlayer.mana = Math.min(localPlayer.maxMana, localPlayer.mana + 5 * dt);
      }

      // Collect Atman Motes
      for (let i = atmanMotes.length - 1; i >= 0; i--) {
        const am = atmanMotes[i];
        const dist = Math.hypot(localPlayer.x - am.x, (localPlayer.y - 18) - am.y);
        if (dist < 240) {
          const ang = Math.atan2((localPlayer.y - 18) - am.y, localPlayer.x - am.x);
          am.x += Math.cos(ang) * 340 * dt;
          am.y += Math.sin(ang) * 340 * dt;
        }
        if (dist < 24) {
          localPlayer.atman = Math.min(localPlayer.maxAtman, localPlayer.atman + am.val);
          spawnCombatText(localPlayer.x, localPlayer.y - 34, `+${am.val} ATMAN`, '#fde047');
          atmanMotes.splice(i, 1);
        }
      }

      updateVitalsUI();
      renderStage1Minimap();

      // Projectiles & Collision
      for (let i = projectiles.length - 1; i >= 0; i--) {
        const pj = projectiles[i];
        pj.x += pj.vx * dt; pj.y += pj.vy * dt; pj.life -= dt;

        let hitWall = !getWalkableSectorAt(pj.x, pj.y);
        if (!hitWall) {
          for (const pil of SOLID_PILLARS) {
            if (Math.hypot(pj.x - pil.x, pj.y - pil.y) < pil.r) { hitWall = true; break; }
          }
        }
        if (hitWall || pj.life <= 0) {
          if (pj.explosive) spawnSpellVortex(pj.x, pj.y, pj.color, 65);
          projectiles.splice(i, 1);
          continue;
        }

        if (pj.isEnemy) {
          if (!inSafezone && localPlayer.dodgeTimer <= 0 && Math.hypot(pj.x - localPlayer.x, pj.y - (localPlayer.y - 16)) < 22 + pj.radius) {
            const taken = Math.max(1, Math.round(pj.dmg * (localPlayer.combatStance === 'bastion' ? 0.7 : 1.0)));
            localPlayer.hp = Math.max(0, localPlayer.hp - taken);
            localPlayer.hitFlash = 7;
            playSfx('slash');
            spawnCombatText(localPlayer.x, localPlayer.y, `-${taken}`, '#ef4444');
            projectiles.splice(i, 1);
            if (localPlayer.hp <= 0) handleFullLootDeath();
            continue;
          }
        } else if (!pj.isRemote) {
          let hitMob = false;
          for (let m = enemies.length - 1; m >= 0; m--) {
            const en = enemies[m];
            if (Math.hypot(pj.x - en.x, pj.y - (en.y - 16)) < en.radius + pj.radius + 6) {
              const res = applyDamageWithTypeCheck(en, pj.dmg, pj.dmgType || 'SLASH');
              if (pj.explosive) spawnSpellVortex(en.x, en.y, pj.color, 85);
              else spawnSlashArc(en.x, en.y, pj.vx >= 0 ? 1 : -1, pj.color, 36);

              if (en.hp <= 0) {
                if (res.exploitedWeakness) spawnOvaDecapitation(en.x, en.y, pj.vx >= 0 ? 1 : -1);
                handleEnemyKilled(en, m);
              }
              hitMob = true;
              break;
            }
          }
          if (hitMob) { projectiles.splice(i, 1); continue; }
        }
      }

      // Update Enemies & Boss
      let activeBoss = null;
      enemies.forEach(en => {
        if (en.hitFlash > 0) en.hitFlash--;
        const distToPlayer = Math.hypot(localPlayer.x - en.x, localPlayer.y - en.y);
        if (en.isBoss && distToPlayer < 680) activeBoss = en;

        if (distToPlayer < 520 && distToPlayer > 38 && !inSafezone) {
          const ang = Math.atan2(localPlayer.y - en.y, localPlayer.x - en.x);
          const nx = en.x + Math.cos(ang) * en.speed * dt;
          const ny = en.y + Math.sin(ang) * en.speed * dt;
          if (!isInsideFirepitSafezone(nx, ny)) resolveDungeonMovement(en, nx, ny);

          if (en.isBoss || en.ranged) {
            en.shootCooldown = (en.shootCooldown || 1.8) - dt;
            if (en.shootCooldown <= 0) {
              en.shootCooldown = en.isBoss ? 1.4 : 2.3;
              if (en.isBoss) {
                for (let b = 0; b < 8; b++) {
                  spawnProjectile({
                    ownerId: en.id, isEnemy: true, x: en.x, y: en.y - 20,
                    angle: (b / 8) * Math.PI * 2, speed: 330, dmg: 18, color: '#facc15', projType: 'orb', radius: 9, life: 2.0
                  });
                }
              } else {
                spawnProjectile({
                  ownerId: en.id, isEnemy: true, x: en.x, y: en.y - 16,
                  angle: ang, speed: 330, dmg: 14, color: en.color, projType: 'arrow', radius: 6, life: 1.5
                });
              }
            }
          }
        }
      });

      currentMusicTheme = activeBoss ? 'boss' : (inSafezone ? 'tavern' : 'labyrinth');

      const bossWrap = document.getElementById('boss-bar-wrap');
      if (activeBoss) {
        bossWrap.style.display = 'flex';
        document.getElementById('boss-bar-title').textContent = `☠️ ${activeBoss.name} [WEAKNESS: ${activeBoss.weakTo}] (${Math.max(0, Math.round(activeBoss.hp))}/${activeBoss.maxHp})`;
        document.getElementById('boss-hp-fill').style.width = `${Math.max(0, (activeBoss.hp / activeBoss.maxHp) * 100)}%`;
      } else {
        bossWrap.style.display = 'none';
      }

      if (localPlayer.swingTimer > 0) localPlayer.swingTimer--;
      if (localPlayer.dodgeTimer > 0) localPlayer.dodgeTimer--;
      if (localPlayer.hitFlash > 0) localPlayer.hitFlash--;
      if (screenShake > 0) screenShake = Math.max(0, screenShake - 40 * dt);

      renderWorld(nowSec);
      requestAnimationFrame(gameLoop);
    }

    // =========================================================================
    // 7. RENDERER (UNIQUE ROOM MASONRY, HAZARDS, DESCENT PORTAL)
    // =========================================================================
    function renderWorld(timeSec) {
      ctx.clearRect(0, 0, screenW, screenH);
      const camX = localPlayer.x - screenW / 2;
      const camY = localPlayer.y - screenH / 2;

      ctx.save();
      ctx.translate(-camX, -camY);

      // Draw Void Bounds outside the 3x3 Stage
      ctx.fillStyle = '#040307';
      ctx.fillRect(camX, camY, screenW, screenH);

      // Draw Rooms with Unique Floor Patterns & Wall Highlights
      worldSectors.forEach(sec => {
        sec.rects.forEach(r => {
          ctx.fillStyle = '#0c0e14';
          ctx.fillRect(r.x - 10, r.y - 24, r.w + 20, r.h + 34);
          ctx.fillStyle = floorPatterns[sec.floor] || '#191d26';
          ctx.fillRect(r.x, r.y, r.w, r.h);

          if (r.isMain) {
            ctx.strokeStyle = sec.safe ? 'rgba(207, 163, 84, 0.45)' : (sec.isBossRoom ? 'rgba(220, 38, 38, 0.65)' : 'rgba(71, 85, 105, 0.4)');
            ctx.lineWidth = 3;
            ctx.strokeRect(r.x, r.y, r.w, r.h);
          }
        });

        const scx = sec.gx * TILE_SIZE + 500;
        const scy = sec.gy * TILE_SIZE + 145;
        ctx.font = '900 13px Cinzel, serif';
        ctx.textAlign = 'center';
        ctx.fillStyle = sec.safe ? 'rgba(248, 226, 168, 0.65)' : (sec.isBossRoom ? 'rgba(252, 165, 165, 0.75)' : 'rgba(203, 213, 225, 0.5)');
        ctx.fillText(sec.name.toUpperCase(), scx, scy);
      });

      // Draw Environmental Hazards
      activeHazards.forEach(hz => {
        if (hz.type === 'lava') {
          const flick = Math.sin(timeSec * 8 + hz.x) * 6;
          const grad = ctx.createRadialGradient(hz.x, hz.y, 10, hz.x, hz.y, hz.r + flick);
          grad.addColorStop(0, '#f97316'); grad.addColorStop(0.7, '#dc2626'); grad.addColorStop(1, 'rgba(0,0,0,0)');
          ctx.fillStyle = grad;
          ctx.beginPath(); ctx.arc(hz.x, hz.y, hz.r + flick, 0, Math.PI * 2); ctx.fill();
        } else if (hz.type === 'acid') {
          ctx.fillStyle = 'rgba(132, 204, 22, 0.35)';
          ctx.strokeStyle = '#84cc16'; ctx.lineWidth = 2;
          ctx.beginPath(); ctx.arc(hz.x, hz.y, hz.r, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
        } else if (hz.type === 'spikes') {
          const spikesActive = (spikeTrapTick > 1.4);
          ctx.fillStyle = spikesActive ? 'rgba(220, 38, 38, 0.3)' : 'rgba(30, 41, 59, 0.5)';
          ctx.strokeStyle = spikesActive ? '#ef4444' : '#64748b';
          ctx.lineWidth = 2;
          ctx.fillRect(hz.x - hz.w/2, hz.y - hz.h/2, hz.w, hz.h);
          ctx.strokeRect(hz.x - hz.w/2, hz.y - hz.h/2, hz.w, hz.h);
          if (spikesActive) {
            ctx.fillStyle = '#f8fafc';
            for (let sx = hz.x - hz.w/2 + 20; sx < hz.x + hz.w/2; sx += 35) {
              for (let sy = hz.y - hz.h/2 + 20; sy < hz.y + hz.h/2; sy += 35) {
                ctx.beginPath(); ctx.arc(sx, sy, 4, 0, Math.PI * 2); ctx.fill();
              }
            }
          }
        }
      });

      // Draw Descent Portal in (-1, -1) when Boss is Slain
      if (bossDefeated) {
        ctx.save();
        ctx.translate(stage2PortalPos.x, stage2PortalPos.y);
        ctx.rotate(timeSec * 3);
        const pGrad = ctx.createRadialGradient(0, 0, 5, 0, 0, stage2PortalPos.radius);
        pGrad.addColorStop(0, '#fde047'); pGrad.addColorStop(0.5, '#38bdf8'); pGrad.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.fillStyle = pGrad;
        ctx.beginPath(); ctx.arc(0, 0, stage2PortalPos.radius, 0, Math.PI * 2); ctx.fill();
        ctx.font = '900 11px Cinzel, serif'; ctx.fillStyle = '#fff'; ctx.textAlign = 'center';
        ctx.fillText('STAGE 2 DESCENT', 0, 4);
        ctx.restore();
      }

      // Draw Central Firepit
      ctx.save();
      ctx.strokeStyle = 'rgba(74, 222, 128, 0.28)'; ctx.lineWidth = 3;
      ctx.beginPath(); ctx.arc(FIREPIT_POS.x, FIREPIT_POS.y, FIREPIT_POS.safeRadius, 0, Math.PI * 2); ctx.stroke();
      const fireGrad = ctx.createRadialGradient(FIREPIT_POS.x, FIREPIT_POS.y, 16, FIREPIT_POS.x, FIREPIT_POS.y, 350);
      fireGrad.addColorStop(0, 'rgba(251, 146, 60, 0.58)'); fireGrad.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = fireGrad; ctx.beginPath(); ctx.arc(FIREPIT_POS.x, FIREPIT_POS.y, 350, 0, Math.PI * 2); ctx.fill();
      ctx.restore();

      // Draw Gates
      GATES.forEach(g => {
        ctx.save();
        ctx.translate(g.x, g.y);
        const openRatio = g.openAnim || 0;
        ctx.fillStyle = '#334155'; ctx.strokeStyle = '#040306'; ctx.lineWidth = 3;
        if (g.horiz) {
          ctx.fillRect(-140, -18, 28, 36); ctx.fillRect(112, -18, 28, 36);
          if (openRatio < 0.8) {
            ctx.fillStyle = g.isBossGate ? 'rgba(220,38,38,0.7)' : 'rgba(15,23,42,0.88)';
            ctx.fillRect(-110, -10, 220 * (1 - openRatio), 20);
          } else {
            ctx.fillStyle = 'rgba(34, 197, 94, 0.2)';
            ctx.fillRect(-110, -14, 220, 28);
          }
        } else {
          ctx.fillRect(-18, -140, 36, 28); ctx.fillRect(-18, 112, 36, 28);
          if (openRatio < 0.8) {
            ctx.fillStyle = g.isBossGate ? 'rgba(220,38,38,0.7)' : 'rgba(15,23,42,0.88)';
            ctx.fillRect(-10, -110, 20, 220 * (1 - openRatio));
          } else {
            ctx.fillStyle = 'rgba(34, 197, 94, 0.2)';
            ctx.fillRect(-14, -110, 28, 220);
          }
        }
        ctx.font = '800 9px Cinzel, serif'; ctx.textAlign = 'center';
        ctx.fillStyle = g.isOpen ? '#4ade80' : (g.isBossGate ? '#f87171' : '#facc15');
        ctx.fillText(g.label, 0, -24);
        ctx.restore();
      });

      // Draw Pillars
      SOLID_PILLARS.forEach(pil => {
        ctx.fillStyle = '#1e293b'; ctx.strokeStyle = '#040306'; ctx.lineWidth = 3;
        ctx.beginPath(); ctx.arc(pil.x, pil.y, pil.r, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
      });

      // Draw Chests
      lootChests.forEach(ch => {
        ctx.save();
        ctx.translate(ch.x, ch.y);
        ctx.fillStyle = ch.isSealChest ? '#b45309' : '#5c3a18';
        ctx.strokeStyle = ch.isSealChest ? '#fde047' : '#38bdf8';
        ctx.lineWidth = 2.5;
        ctx.fillRect(-16, -12, 32, 24); ctx.strokeRect(-16, -12, 32, 24);
        ctx.font = '800 10px Cinzel, serif'; ctx.textAlign = 'center';
        ctx.fillStyle = ch.isSealChest ? '#fde047' : '#fff';
        ctx.fillText(`📦 ${ch.label} [E]`, 0, -17);
        ctx.restore();
      });

      // Draw Enemies
      enemies.forEach(en => {
        drawCardArtHostile(ctx, en, timeSec, en.id === localPlayer.targetEntityId);
      });

      // Draw Projectiles
      projectiles.forEach(pj => {
        ctx.save();
        ctx.translate(pj.x, pj.y); ctx.rotate(pj.angle);
        ctx.fillStyle = pj.color; ctx.beginPath(); ctx.arc(0, 0, pj.radius || 7, 0, Math.PI * 2); ctx.fill();
        ctx.restore();
      });

      // Draw Character
      drawOVACharacter(ctx, localPlayer, localPlayer.x, localPlayer.y, timeSec, 1.0, false, 1.0);

      // Draw Combat Texts
      combatTexts.forEach(ct => {
        ctx.font = '900 13px Cinzel, serif'; ctx.textAlign = 'center'; ctx.fillStyle = ct.color;
        ctx.fillText(ct.text, ct.x, ct.y);
      });

      ctx.restore();
    }

    // Stage 1 Bounded Minimap Renderer
    function renderStage1Minimap() {
      mapCtx.clearRect(0, 0, mapCanvas.width, mapCanvas.height);
      const myGx = Math.floor(localPlayer.x / TILE_SIZE);
      const myGy = Math.floor(localPlayer.y / TILE_SIZE);
      const cellW = 42, cellH = 34;
      const offX = 30, offY = 14;

      for (let gy = -1; gy <= 1; gy++) {
        for (let gx = -1; gx <= 1; gx++) {
          const sec = STAGE_SECTORS[sectorKey(gx, gy)];
          const rx = offX + (gx + 1) * (cellW + 4);
          const ry = offY + (gy + 1) * (cellH + 4);

          mapCtx.fillStyle = sec.safe ? '#166534' : (sec.isBossRoom ? '#7f1d1d' : '#1e293b');
          mapCtx.strokeStyle = (gx === myGx && gy === myGy) ? '#fde047' : '#4a3520';
          mapCtx.lineWidth = (gx === myGx && gy === myGy) ? 2 : 1;
          mapCtx.fillRect(rx, ry, cellW, cellH);
          mapCtx.strokeRect(rx, ry, cellW, cellH);

          mapCtx.font = '8px Cinzel, serif';
          mapCtx.fillStyle = '#fff';
          mapCtx.textAlign = 'center';
          if (sec.isBossRoom) mapCtx.fillText('☠️ ABESHU', rx + cellW/2, ry + cellH/2 + 3);
          else if (sec.sealType) mapCtx.fillText(sec.sealType.toUpperCase(), rx + cellW/2, ry + cellH/2 + 3);
          else if (sec.safe) mapCtx.fillText('HUB', rx + cellW/2, ry + cellH/2 + 3);
        }
      }
    }

    // =========================================================================
    // 8. LOOT CLAIMING & BOSS DEFEAT
    // =========================================================================
    function handleEnemyKilled(en, idx) {
      enemies.splice(idx, 1);
      localPlayer.xp += en.xpValue || 65;
      localPlayer.gold += en.isBoss ? 280 : 25;

      if (en.isBoss) {
        bossDefeated = true;
        triggerSoulsBanner('ARCHON ABESHU SLAIN! STAGE 2 PORTAL ACTIVATED!');
        document.getElementById('portal-status').textContent = '🌟 Stage 2 Portal: OPEN AT (-1, -1)!';
        document.getElementById('portal-status').style.color = '#38bdf8';
      }

      if (localPlayer.xp >= localPlayer.nextXp) {
        localPlayer.level++;
        localPlayer.xp -= localPlayer.nextXp;
        localPlayer.nextXp = Math.round(localPlayer.nextXp * 1.3);
        recalcEquipmentStats();
        renderHotbarUI();
        triggerSoulsBanner(`SOUL LEVEL ${localPlayer.level}!`);
      }
      savePersistentProgress();
      updateVitalsUI();
    }

    function openChestLootModal(chestIdx) {
      const ch = lootChests[chestIdx];
      if (!ch) return;
      activeOpenChestIdx = chestIdx;

      document.getElementById('loot-modal-title').textContent = ch.label;
      document.getElementById('loot-modal-rarity').textContent = `[💰 ${ch.gold}g • ⚱️ +${ch.atman || 15} Atman]`;

      const list = document.getElementById('loot-items-list');
      list.innerHTML = '';
      (ch.items || []).forEach((it, idx) => {
        const row = document.createElement('div');
        row.className = 'loot-item-row';
        row.innerHTML = `
          <div>
            <strong style="color:#fde047; font-family:'Cinzel',serif;">${it.name}</strong>
            <div style="font-size:10px; color:#a89984;">+${it.atk || 0} ATK • +${it.hp || 0} HP</div>
          </div>
          <button class="action-btn" id="claim-it-${idx}">Claim</button>
        `;
        row.querySelector(`#claim-it-${idx}`).onclick = () => {
          if (it.isSeal) checkCollectSeal(it.isSeal);
          if (localPlayer.backpack.length < 8) localPlayer.backpack.push(it);
          ch.items.splice(idx, 1);
          playSfx('loot');
          if (ch.items.length === 0) {
            lootChests.splice(chestIdx, 1);
            document.getElementById('loot-modal').style.display = 'none';
          }
          savePersistentProgress();
          updateVitalsUI();
        };
        list.appendChild(row);
      });

      document.getElementById('loot-modal').style.display = 'flex';
    }

    // Kickoff bounded stage
    initStage1World();
    requestAnimationFrame(gameLoop);
  </script>
</body>
