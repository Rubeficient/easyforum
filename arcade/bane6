    // =========================================================================
    // 7. INPUTS & COMBAT CONTROLS
    // =========================================================================
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    let screenW = window.innerWidth, screenH = window.innerHeight;
    canvas.width = screenW; canvas.height = screenH;
    generateProceduralTextures(ctx);

    window.onresize = () => {
      screenW = window.innerWidth; screenH = window.innerHeight;
      canvas.width = screenW; canvas.height = screenH;
      generateProceduralTextures(ctx);
    };

    let mouseScreenX = screenW / 2, mouseScreenY = screenH / 2;
    window.onmousemove = (e) => { mouseScreenX = e.clientX; mouseScreenY = e.clientY; };

    const keys = {};
    window.onkeydown = (e) => {
      if (document.activeElement === document.getElementById('chat-input')) {
        if (e.key === 'Enter') sendChat();
        return;
      }
      keys[e.key.toLowerCase()] = true;
      if (e.code === 'Space') { e.preventDefault(); performPrimaryWeaponAttack(); }
      else if (e.key.toLowerCase() === 'z') selectWeaponSlot(0);
      else if (e.key.toLowerCase() === 'x') selectWeaponSlot(1);
      else if (e.key.toLowerCase() === 'c') selectWeaponSlot(2);
      else if (e.key.toLowerCase() === 'v') {
        const order = ['fury', 'precision', 'bastion'];
        setCombatStance(order[(order.indexOf(localPlayer.combatStance) + 1) % order.length]);
      }
      else if (e.key.toLowerCase() === 'r') triggerAtmanCymaticBurst();
      else if (e.key === 'Shift') { e.preventDefault(); triggerDodgeRoll(); }
      else if (['1','2','3','4','5','6'].includes(e.key)) triggerSpellSlot(parseInt(e.key) - 1);
      else if (e.key.toLowerCase() === 'e') interactWithWorldObject();
      else if (e.key.toLowerCase() === 'i') toggleInventory();
      else if (e.key.toLowerCase() === 'g') toggleGrimoire();
      else if (e.key === 'Tab') { e.preventDefault(); cycleTabTarget(); }
    };
    window.onkeyup = (e) => { keys[e.key.toLowerCase()] = false; };

    canvas.onmousedown = (e) => {
      initAudioEngine();
      const clickX = e.clientX + (localPlayer.x - screenW / 2);
      const clickY = e.clientY + (localPlayer.y - screenH / 2);

      for (let i = lootChests.length - 1; i >= 0; i--) {
        if (Math.hypot(clickX - lootChests[i].x, clickY - lootChests[i].y) < 38) {
          if (Math.hypot(localPlayer.x - lootChests[i].x, localPlayer.y - lootChests[i].y) < 135) openChestLootModal(i);
          else { localPlayer.targetX = lootChests[i].x; localPlayer.targetY = lootChests[i].y; }
          return;
        }
      }

      for (const en of enemies) {
        if (Math.hypot(clickX - en.x, clickY - en.y) < en.radius + 22) {
          localPlayer.targetEntityId = en.id;
          performPrimaryWeaponAttack();
          return;
        }
      }

      if (e.button === 2) performPrimaryWeaponAttack();
      else { localPlayer.targetX = clickX; localPlayer.targetY = clickY; }
    };

    canvas.oncontextmenu = (e) => { e.preventDefault(); performPrimaryWeaponAttack(); };

    function getAimAngle() {
      if (localPlayer.autoAim) {
        let lock = enemies.find(e => e.id === localPlayer.targetEntityId);
        if (!lock) {
          let bDist = 450;
          enemies.forEach(en => {
            const d = Math.hypot(en.x - localPlayer.x, en.y - localPlayer.y);
            if (d < bDist) { bDist = d; lock = en; }
          });
        }
        if (lock) {
          localPlayer.facing = lock.x >= localPlayer.x ? 1 : -1;
          return Math.atan2(lock.y - localPlayer.y, lock.x - localPlayer.x);
        }
      }
      const wx = mouseScreenX + (localPlayer.x - screenW / 2);
      const wy = mouseScreenY + (localPlayer.y - screenH / 2);
      localPlayer.facing = wx >= localPlayer.x ? 1 : -1;
      return Math.atan2(wy - localPlayer.y, wx - localPlayer.x);
    }

    function triggerDodgeRoll() {
      if (localPlayer.dodgeTimer > 0) return;
      playSfx('bow'); localPlayer.dodgeTimer = 18;
      const ang = getAimAngle();
      resolveDungeonMovement(localPlayer, localPlayer.x + Math.cos(ang) * 120, localPlayer.y + Math.sin(ang) * 120);
    }

    function triggerAtmanCymaticBurst() {
      if (localPlayer.atman < 35) { showToast('Need 35 Atman in Urn! Slay foes to harvest.'); return; }
      localPlayer.atman -= 35;
      playSfx('atman'); screenShake = 12;
      localPlayer.hp = Math.min(localPlayer.maxHp, localPlayer.hp + Math.round(localPlayer.maxHp * 0.4));
      spawnCombatText(localPlayer.x, localPlayer.y - 20, '+ATMAN CYMATIC BURST!', '#fbbf24');
      for (let i = 0; i < 12; i++) {
        projectiles.push({
          ownerId: localPlayer.id, isEnemy: false, dmgType: 'ARCANE',
          x: localPlayer.x, y: localPlayer.y - 18,
          vx: Math.cos((i / 12) * Math.PI * 2) * 500, vy: Math.sin((i / 12) * Math.PI * 2) * 500,
          angle: (i / 12) * Math.PI * 2, dmg: 75, color: '#fbbf24', radius: 10, life: 1.2
        });
      }
      updateVitalsUI();
    }

    function triggerSpellSlot(slotIdx) {
      const sp = GRIMOIRE_SPELLS[slotIdx];
      if (!sp || localPlayer.mana < sp.mp) { showToast('Not enough Mana!'); return; }
      localPlayer.mana -= sp.mp;
      localPlayer.swingTimer = 18;
      const baseAng = getAimAngle();
      playSfx('spell');

      if (sp.type === 'heal') {
        localPlayer.hp = Math.min(localPlayer.maxHp, localPlayer.hp + 90);
        spawnCombatText(localPlayer.x, localPlayer.y - 20, '+90 MADI', '#4ade80');
      } else if (sp.type === 'buff') {
        localPlayer.speed = 400; setTimeout(() => { localPlayer.speed = localPlayer.baseSpeed; }, 2500);
        showToast('PORFIC Shield Active!');
      } else {
        projectiles.push({
          ownerId: localPlayer.id, isEnemy: false, dmgType: sp.dmgType,
          x: localPlayer.x, y: localPlayer.y - 18,
          vx: Math.cos(baseAng) * 550, vy: Math.sin(baseAng) * 550,
          angle: baseAng, dmg: sp.dmg, color: sp.color, radius: 8, life: 1.3
        });
      }
      updateVitalsUI();
    }

