            oCtx.fillStyle = (r + col) % 2 === 0 ? pal.slab1 : pal.slab2;
            oCtx.fillRect(sx + 2, sy + 2, 36, 36);
            oCtx.strokeStyle = pal.accent; oCtx.lineWidth = 1.2;
            oCtx.strokeRect(sx + 2, sy + 2, 36, 36);
          }
        }
        floorPatterns[k] = c.createPattern(off, 'repeat');
      });
    }

    // =========================================================================
    // 4. AUDIO ENGINE
    // =========================================================================
    let audioCtx = null, bgmEnabled = true, bgmTimer = null, bgmTick = 0, currentMusicTheme = 'tavern';

    const MUSIC_THEMES = {
      'tavern': { tempoMs: 420, leadNotes: [293.66, 349.23, 440.00, 349.23], bassNotes: [146.83, 174.61] },
      'labyrinth': { tempoMs: 480, leadNotes: [220.00, 233.08, 293.66, 220.00], bassNotes: [110.00, 116.54] },
      'boss': { tempoMs: 240, leadNotes: [293.66, 440.00, 466.16, 587.33], bassNotes: [146.83, 174.61] }
    };

    function scheduleMusicStep() {
      if (bgmTimer) clearTimeout(bgmTimer);
      const th = MUSIC_THEMES[currentMusicTheme] || MUSIC_THEMES['tavern'];
      if (bgmEnabled && audioCtx && document.getElementById('char-modal').style.display === 'none') {
        try {
          const now = audioCtx.currentTime;
          const idx = bgmTick % th.leadNotes.length;
          const osc = audioCtx.createOscillator(); const gain = audioCtx.createGain();
          osc.type = currentMusicTheme === 'boss' ? 'sawtooth' : 'triangle';
          osc.frequency.setValueAtTime(th.leadNotes[idx], now);
          gain.gain.setValueAtTime(0.025, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + (th.tempoMs / 1000) * 0.9);
          osc.connect(gain); gain.connect(audioCtx.destination);
          osc.start(now); osc.stop(now + (th.tempoMs / 1000));
          bgmTick++;
        } catch(e) {}
      }
      bgmTimer = setTimeout(scheduleMusicStep, th.tempoMs);
    }

    function initAudioEngine() {
      if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      if (audioCtx.state === 'suspended') audioCtx.resume();
      if (!bgmTimer) scheduleMusicStep();
    }

    function playSfx(kind) {
      if (!audioCtx || !bgmEnabled) return;
      try {
        const now = audioCtx.currentTime;
        const osc = audioCtx.createOscillator(); const gain = audioCtx.createGain();
        osc.connect(gain); gain.connect(audioCtx.destination);
        if (kind === 'resist_clang') {
          osc.type = 'square'; osc.frequency.setValueAtTime(920, now);
          gain.gain.setValueAtTime(0.12, now); gain.gain.exponentialRampToValueAtTime(0.005, now + 0.12);
          osc.start(now); osc.stop(now + 0.12);
        } else if (kind === 'crush_weakness') {
          osc.type = 'sawtooth'; osc.frequency.setValueAtTime(220, now); osc.frequency.exponentialRampToValueAtTime(52, now + 0.2);
          gain.gain.setValueAtTime(0.2, now); gain.gain.linearRampToValueAtTime(0.01, now + 0.2);
          osc.start(now); osc.stop(now + 0.2);
        } else if (kind === 'bow' || kind === 'slash') {
          osc.type = 'triangle'; osc.frequency.setValueAtTime(450, now); osc.frequency.exponentialRampToValueAtTime(120, now + 0.1);
          gain.gain.setValueAtTime(0.14, now); gain.gain.linearRampToValueAtTime(0.01, now + 0.1);
          osc.start(now); osc.stop(now + 0.1);
        } else if (kind === 'atman' || kind === 'spell') {
          osc.type = 'sine'; osc.frequency.setValueAtTime(140, now); osc.frequency.exponentialRampToValueAtTime(750, now + 0.3);
          gain.gain.setValueAtTime(0.16, now); gain.gain.linearRampToValueAtTime(0.01, now + 0.3);
          osc.start(now); osc.stop(now + 0.3);
        } else if (kind === 'loot' || kind === 'gate') {
          osc.type = 'triangle'; osc.frequency.setValueAtTime(260, now); osc.frequency.linearRampToValueAtTime(520, now + 0.18);
          gain.gain.setValueAtTime(0.14, now); gain.gain.linearRampToValueAtTime(0.01, now + 0.18);
          osc.start(now); osc.stop(now + 0.18);
        }
      } catch(e) {}
    }

