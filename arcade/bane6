    function updateStageHazards(dt) {
      spikeTrapTick = (spikeTrapTick + dt) % 3.0;
      const spikesActive = spikeTrapTick > 1.4;

      if (isInsideFirepitSafezone(localPlayer.x, localPlayer.y) || localPlayer.dodgeTimer > 0) return;

      activeHazards.forEach(hz => {
        if (hz.type === 'lava') {
          if (Math.hypot(localPlayer.x - hz.x, localPlayer.y - hz.y) < hz.r) {
            localPlayer.hp = Math.max(0, localPlayer.hp - 16 * dt);
            localPlayer.hitFlash = 3;
            if (Math.random() < 0.1) spawnCombatText(localPlayer.x, localPlayer.y, '-16 LAVA BURN!', '#f97316');
            if (localPlayer.hp <= 0) handleFullLootDeath();
          }
        } else if (hz.type === 'acid') {
          if (Math.hypot(localPlayer.x - hz.x, localPlayer.y - hz.y) < hz.r) {
            localPlayer.hp = Math.max(0, localPlayer.hp - 11 * dt);
            localPlayer.hitFlash = 2;
            if (Math.random() < 0.1) spawnCombatText(localPlayer.x, localPlayer.y, '-11 ACID SLIME!', '#84cc16');
            if (localPlayer.hp <= 0) handleFullLootDeath();
          }
        } else if (hz.type === 'spikes' && spikesActive) {
          if (localPlayer.x >= hz.x - hz.w/2 && localPlayer.x <= hz.x + hz.w/2 &&
              localPlayer.y >= hz.y - hz.h/2 && localPlayer.y <= hz.y + hz.h/2) {
            localPlayer.hp = Math.max(0, localPlayer.hp - 24 * dt);
            localPlayer.hitFlash = 4;
            playSfx('slash');
            if (Math.random() < 0.1) spawnCombatText(localPlayer.x, localPlayer.y, '-24 SPIKE TRAP!', '#ef4444');
            if (localPlayer.hp <= 0) handleFullLootDeath();
          }
        }
      });
    }

    function updateGatesAutoProximity(dt) {
      const allSealsCollected = stage1Seals.sun && stage1Seals.blood && stage1Seals.bone;

      GATES.forEach(g => {
        if (!g.manualLock) {
          const d = Math.hypot(localPlayer.x - g.x, localPlayer.y - g.y);
          if (g.isBossGate && !allSealsCollected) {
            g.isOpen = false;
          } else if (d < 145 && !g.isOpen) {
            g.isOpen = true;
            playSfx('gate');
          } else if (d > 200 && g.isOpen) {
            g.isOpen = false;
          }
        }
        const targetAnim = g.isOpen ? 1 : 0;
        g.openAnim = (g.openAnim || 0) + (targetAnim - (g.openAnim || 0)) * Math.min(1, dt * 10);
      });
    }

    function toggleNearestGate() {
      let nearest = null, minDist = 185;
      GATES.forEach(g => {
        const d = Math.hypot(localPlayer.x - g.x, localPlayer.y - g.y);
        if (d < minDist) { minDist = d; nearest = g; }
      });
      if (nearest) {
        if (nearest.isBossGate && !(stage1Seals.sun && stage1Seals.blood && stage1Seals.bone)) {
          showToast('Archon Gate Sealed! Recover Sun, Blood, and Bone Seals first.');
          return;
        }
        nearest.isOpen = !nearest.isOpen;
        nearest.manualLock = !nearest.isOpen;
        playSfx('gate');
        showToast(`${nearest.label}: ${nearest.isOpen ? 'OPENED ⛩️' : 'LOCKED SHUT 🔒'}`);
      }
