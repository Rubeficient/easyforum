      if (el.style.display === 'flex') {
        document.getElementById('eq-wpn1-name').textContent = localPlayer.weapons[0].name;
        document.getElementById('eq-wpn2-name').textContent = localPlayer.weapons[1].name;
        document.getElementById('eq-wpn3-name').textContent = localPlayer.weapons[2].name;
        const grid = document.getElementById('bag-grid'); grid.innerHTML = '';
        localPlayer.backpack.forEach(it => {
          const slot = document.createElement('div'); slot.className = 'bag-slot';
          slot.innerHTML = `<span style="font-size:10px; color:#fde047;">${it.name}</span>`;
          grid.appendChild(slot);
        });
      }
    }
    function toggleGrimoire(s) {
      const el = document.getElementById('grimoire-modal');
      el.style.display = (typeof s === 'boolean' ? s : el.style.display !== 'flex') ? 'flex' : 'none';
    }

    function sendChat() {
      const inp = document.getElementById('chat-input');
      if (!inp.value.trim()) return;
      const log = document.getElementById('chat-log');
      const d = document.createElement('div'); d.className = 'chat-msg';
      d.innerHTML = `<span class="author">${localPlayer.name}:</span><span>${inp.value}</span>`;
      log.appendChild(d); log.scrollTop = log.scrollHeight;
      inp.value = ''; inp.blur();
    }

    // =========================================================================
    // 8. 2.5D ARTICULATED SPRITE ENGINE
    // =========================================================================
    function drawOVACharacter(c, p, cx, cy, timeSec, scOverride = 1.0, isTarget = false, alpha = 1.0) {
      const sub = getSubraceMeta(p);
      const sc = sub.scale * scOverride;
      const facing = p.facing || 1;
      const legSwing = p.isMoving ? Math.sin(timeSec * 12) * 0.5 : 0;

      c.save(); c.globalAlpha = alpha; c.translate(cx, cy);
      c.fillStyle = 'rgba(0,0,0,0.7)'; c.beginPath(); c.ellipse(0, 5, 18 * sc, 8 * sc, 0, 0, Math.PI * 2); c.fill();

      c.save(); c.scale(facing * sc, sc);
      c.strokeStyle = '#040306'; c.lineWidth = 2.2;

      // Cloak
      c.fillStyle = p.armorColor || '#2b3d54';
      c.beginPath(); c.moveTo(-9, -28); c.lineTo(9, -28); c.lineTo(13, 2); c.lineTo(-13, 2); c.closePath();
      c.fill(); c.stroke();

      // Legs
      c.fillStyle = '#17141f';
      c.save(); c.translate(-4, -12); c.rotate(-legSwing); c.fillRect(-3, 0, 6, 14); c.strokeRect(-3, 0, 6, 14); c.restore();
      c.save(); c.translate(4, -12); c.rotate(legSwing); c.fillRect(-3, 0, 6, 14); c.strokeRect(-3, 0, 6, 14); c.restore();

      // Torso
      c.fillStyle = p.hitFlash > 0 ? '#fff' : '#334155';
      c.beginPath(); c.roundRect(-10, -29, 20, 19, 3); c.fill(); c.stroke();

      // Head
      c.fillStyle = p.hitFlash > 0 ? '#fff' : sub.skin;
      c.beginPath(); c.arc(0, -38, 10, 0, Math.PI * 2); c.fill(); c.stroke();

      c.fillStyle = p.hairColor || '#eab308';
      c.beginPath(); c.moveTo(-10, -32); c.lineTo(-6, -46); c.lineTo(6, -46); c.lineTo(10, -32); c.closePath(); c.fill();

      // Weapon
      const wpn = getActiveWeapon();
      c.save(); c.translate(9, -20);
      if (wpn.dmgType === 'PIERCE') {
        c.strokeStyle = '#d97706'; c.lineWidth = 2.5;
        c.beginPath(); c.arc(0, 0, 15, -Math.PI * 0.45, Math.PI * 0.45); c.stroke();
      } else if (wpn.dmgType === 'BLUNT') {
        c.fillStyle = '#78350f'; c.fillRect(-2, -32, 4, 30);
        c.fillStyle = '#fbbf24'; c.fillRect(-9, -38, 18, 10); c.strokeRect(-9, -38, 18, 10);
      } else {
        c.fillStyle = '#e2e8f0';
        c.beginPath(); c.moveTo(-2, 0); c.lineTo(-3, -36); c.lineTo(2, -40); c.lineTo(3, 0); c.closePath(); c.fill(); c.stroke();
      }
      c.restore();

      c.restore(); c.restore();
    }

    function drawCardArtHostile(c, en, timeSec, isTarget) {
      c.save(); c.translate(en.x, en.y);
      const sc = en.isBoss ? 1.8 : 1.0;
      c.fillStyle = 'rgba(0,0,0,0.6)'; c.beginPath(); c.ellipse(0, 6, en.radius, en.radius * 0.5, 0, 0, Math.PI * 2); c.fill();

      c.save(); c.scale(sc, sc);
      c.strokeStyle = '#040306'; c.lineWidth = 2;
      c.fillStyle = en.hitFlash > 0 ? '#fff' : en.color;
      c.beginPath(); c.roundRect(-12, -26, 24, 25, 4); c.fill(); c.stroke();
      c.beginPath(); c.arc(0, -34, 9, 0, Math.PI * 2); c.fill(); c.stroke();
      c.restore();

      const hpRatio = Math.max(0, en.hp / en.maxHp);
      c.fillStyle = '#040306'; c.fillRect(-20, -en.radius - 24, 40, 5);
      c.fillStyle = en.isBoss ? '#f97316' : '#ef4444'; c.fillRect(-19, -en.radius - 23, 38 * hpRatio, 3);
      c.font = '800 9px JetBrains Mono'; c.textAlign = 'center';
      c.fillStyle = en.weakTo === 'BLUNT' ? '#fde047' : (en.weakTo === 'PIERCE' ? '#93c5fd' : '#fca5a5');
      c.fillText(`[WEAK: ${en.weakTo}]`, 0, -en.radius - 28);
      c.restore();
    }

    function updatePreview(now) {
      if (document.getElementById('char-modal').style.display !== 'none') {
        const pc = document.getElementById('previewCanvas');
        const pCtx = pc.getContext('2d');
        pCtx.clearRect(0, 0, pc.width, pc.height);
        drawOVACharacter(pCtx, localPlayer, 120, 160, now * 0.001, 1.5, false, 1.0);
      }
    }

    // =========================================================================
    // 9. MAP MINIMAP & STARTUP
    // =========================================================================
    const mapCanvas = document.getElementById('minimapCanvas');
    const mapCtx = mapCanvas.getContext('2d');

    // Run Initialization Immediately
    initCreationUI();
    initStage1World();
    requestAnimationFrame(gameLoop);
  </script>
</body>
