    // =========================================================================
    // 1. WIZARDRY + DRAGON WARS + ATMAN LORE AUTO-NAME GENERATOR
    // =========================================================================
    const LORE_NAME_PREFIXES = ['Hawkwind', 'Werdna', 'Trebor', 'Muramasa', 'Lanac\'toor', 'Namis', 'Phoebus', 'Byzan', 'Dilmun', 'Myrrias', 'Ulrik', 'Nergal', 'Asura', 'Abeshu', 'Seshat', 'Zhad', 'Krita', 'Atman', 'Shinobi', 'Vaelen'];
    const LORE_NAME_TITLES = ['of Dilmun', 'of Zhad', 'the Unaged', 'of Purgatory', 'of Llylgamyn', 'the Krita-Born', 'of Lanac\'toor', 'the Sun-Scribe', 'of the Maelstrom', 'the Kubi-Kiri', 'of House Ra', ''];
    function generateLoreName() {
      const p = LORE_NAME_PREFIXES[Math.floor(Math.random() * LORE_NAME_PREFIXES.length)];
      const t = LORE_NAME_TITLES[Math.floor(Math.random() * LORE_NAME_TITLES.length)];
      return (t ? `${p} ${t}` : p).slice(0, 18);
    }
    document.getElementById('btn-roll-name').addEventListener('click', () => {
      const newName = generateLoreName();
      document.getElementById('char-name').value = newName;
      localPlayer.name = newName;
    });

    // =========================================================================
    // 2. BOUNDED STRATUM PROCEDURAL ZONE ENGINE (7x7 GRID) & HAZARDS
    // =========================================================================
    const TILE_SIZE = 1000;
    const FIREPIT_POS = { x: 500, y: 500, radius: 62, safeRadius: 390 };
    const STAGE_RADIUS = 3; // Grid goes from -3 to +3 (7x7). Depth = |gx| + |gy|. Max Depth is 6 (corners).

    let currentStratum = 1;
    let hasStageBossSpawned = false;
    let availableBosses = ['abeshu_statue', 'greater_demon', 'fire_giant', 'werdna_boss'];

    let worldSectors = new Map();
    let SOLID_PILLARS = [];
    let WALL_TORCHES = [];
    let GATES = [];
    let gateSet = new Set();
    let hazards = []; // { type: 'spikes'|'poison'|'lava', x, y, r, w, h, active, timer }
    let stageExit = null; // { x, y, active: false }

    function sectorKey(gx, gy) { return `${gx},${gy}`; }
    function seededHash(gx, gy, salt = 0) {
      let h = Math.imul(gx ^ 0x9e3779b9, 0x85ebca6b) ^ Math.imul(gy ^ 0xc2b2ae35, 0x27d4eb2f) ^ salt;
      h ^= h >>> 16; h = Math.imul(h, 0x85ebca6b); h ^= h >>> 13; return (h >>> 0) / 4294967296;
    }

    const SECTOR_ARCHETYPES = [
      { kind: 'catacomb_hall',  floor: 'stone_slate',   hazard: 'spikes', titles: ['Narrow Shusi Passageway', 'Hall of Krita Seeds', 'Dilmun Undercroft'] },
      { kind: 'pillars_zhad',   floor: 'stone_violet',  hazard: null,     titles: ['Pillars of Zhad Chamber', 'Cymatic Resonance Hall', 'Scribe\'s Gallery'] },
      { kind: 'purgatory_pit',  floor: 'stone_crimson', hazard: 'lava',   titles: ['Namis Purgatory Arena', 'Byzan Slaver Garrison', 'Crimson Foundry'] },
      { kind: 'sunken_ruin',    floor: 'stone_moss',    hazard: 'poison', titles: ['Sunken Ruin of Dilmun', 'Twilight Fungal Warren', 'Maelstrom Ossuary'] }
    ];

    function resetStratumMap() {
      worldSectors.clear();
      SOLID_PILLARS = [];
      WALL_TORCHES = [];
      GATES = [];
      gateSet.clear();
      hazards = [];
      enemies.length = 0;
      lootChests.length = 0;
      projectiles.length = 0;
      stageExit = null;
      hasStageBossSpawned = false;

      getOrGenerateSector(0, 0, 'House of Ra', false);
      getOrGenerateSector(0, -1, 'House of Ra', false);
      getOrGenerateSector(0, 1, 'House of Ra', false);
      getOrGenerateSector(-1, 0, 'House of Ra', false);
      getOrGenerateSector(1, 0, 'House of Ra', false);
    }

    function getOrGenerateSector(gx, gy, discovererName = 'House of Ra', broadcastNew = true) {
      if (Math.abs(gx) > STAGE_RADIUS || Math.abs(gy) > STAGE_RADIUS) return null; // Hard boundary
      const key = sectorKey(gx, gy);
      if (worldSectors.has(key)) return worldSectors.get(key);

      const depth = Math.abs(gx) + Math.abs(gy);
      const wx = gx * TILE_SIZE, wy = gy * TILE_SIZE;
      const cx = wx + TILE_SIZE / 2, cy = wy + TILE_SIZE / 2;

      const rects = [
        { x: wx + 340, y: wy - 90, w: 320, h: TILE_SIZE + 180, isSpine: true },
        { x: wx - 90,  y: wy + 340, w: TILE_SIZE + 180, h: 320, isSpine: true }
      ];

      let sector = null;
      if (gx === 0 && gy === 0) {
        rects.push({ x: wx + 90, y: wy + 90, w: 820, h: 820, isMain: true });
        sector = { gx, gy, key, depth: 0, name: `Stratum ${currentStratum} Firepit Sanctum`, kind: 'sanctum_hub', floor: 'stone_slate', safe: true, isBossRoom: false, mappedBy: 'Founders of Ra', rects };
      } else {
        const rVal = seededHash(gx, gy, 11);
        
        // Spawn the Stratum Boss Room only once per Stratum! Force it if depth >= 4 or randomly at depth 3.
        let isBoss = false;
        if (!hasStageBossSpawned && (depth >= 4 || (depth === 3 && rVal < 0.4))) {
          isBoss = true;
          hasStageBossSpawned = true;
        }

        const archIdx = Math.floor(seededHash(gx, gy, 22) * 4);
        const arch = SECTOR_ARCHETYPES[archIdx];
        const chosenTitle = isBoss ? '☠️ STRATUM EXIT SANCTUM' : arch.titles[Math.floor(seededHash(gx, gy, 33) * arch.titles.length)];

        if (arch.kind === 'catacomb_hall') rects.push({ x: wx + 220, y: wy + 220, w: 560, h: 560, isMain: true });
        else rects.push({ x: wx + 110, y: wy + 110, w: 780, h: 780, isMain: true });

        sector = { gx, gy, key, depth, name: `${chosenTitle} (${gx}, ${gy})`, kind: arch.kind, floor: isBoss ? 'stone_dark' : arch.floor, safe: false, isBossRoom: isBoss, mappedBy: discovererName, rects };

        // Environmental Hazards Setup
        if (depth > 0 && !isBoss && arch.hazard) {
          if (arch.hazard === 'spikes') {
            hazards.push({ type: 'spikes', x: cx - 120, y: cy - 120, w: 240, h: 240, active: false, timer: 0 });
          } else if (arch.hazard === 'lava' || arch.hazard === 'poison') {
            hazards.push({ type: arch.hazard, x: cx - 140, y: cy - 140, r: 90, active: true, timer: 0 });
            hazards.push({ type: arch.hazard, x: cx + 140, y: cy + 140, r: 90, active: true, timer: 0 });
          }
        }
      }

      worldSectors.set(key, sector);

      const pOffsets = [[-240, -240], [240, -240], [-240, 240], [240, 240]];
      pOffsets.forEach(([ox, oy], idx) => {
        if (sector.kind === 'catacomb_hall' && idx > 1) return;
        SOLID_PILLARS.push({ x: cx + ox, y: cy + oy, r: sector.isBossRoom ? 38 : 30, isZhadPillar: sector.kind === 'pillars_zhad' });
      });

      WALL_TORCHES.push({ x: cx - 175, y: wy + 125 }, { x: cx + 175, y: wy + 125 }, { x: cx - 175, y: wy + 875 }, { x: cx + 175, y: wy + 875 });

      // Generate Gates only if they don't lead outside the STAGE_RADIUS!
      const borderGates = [];
      if (gy > -STAGE_RADIUS) borderGates.push({ id: `gate-n-${gx}-${gy}`, x: cx, y: wy, horiz: true, gx2: gx, gy2: gy-1, label: `North (${gx},${gy-1})` });
      if (gy < STAGE_RADIUS)  borderGates.push({ id: `gate-s-${gx}-${gy+1}`, x: cx, y: wy + TILE_SIZE, horiz: true, gx2: gx, gy2: gy+1, label: `South (${gx},${gy+1})` });
      if (gx > -STAGE_RADIUS) borderGates.push({ id: `gate-w-${gx}-${gy}`, x: wx, y: cy, horiz: false, gx2: gx-1, gy2: gy, label: `West (${gx-1},${gy})` });
      if (gx < STAGE_RADIUS)  borderGates.push({ id: `gate-e-${gx+1}-${gy}`, x: wx + TILE_SIZE, y: cy, horiz: false, gx2: gx+1, gy2: gy, label: `East (${gx+1},${gy})` });

      borderGates.forEach(bg => {
        const gKey = `${Math.round(bg.x)},${Math.round(bg.y)}`;
        if (!gateSet.has(gKey)) { gateSet.add(gKey); GATES.push({ ...bg, isOpen: false, openAnim: 0, manualLock: false }); }
      });

      if (depth > 0) spawnSectorEntities(sector);

      const mappedEl = document.getElementById('mapped-count-txt');
      if (mappedEl) mappedEl.textContent = `${worldSectors.size}/49 Sectors`;

      if (broadcastNew && depth > 0) {
        triggerSoulsBanner(`NEW SECTOR MAPPED: ${sector.name.toUpperCase()}`);
        appendChat('Cartography Engine', `🗺️ ${discovererName} mapped ${sector.name}!`);
        sendPacket({ type: 'sector_mapped', id: localPlayer.id, gx, gy, discoverer: discovererName });
      }
      return sector;
    }

    // =========================================================================
    // 3. PROCEDURAL 2.5D TEXTURE GENERATOR
    // =========================================================================
    const floorPatterns = {};
    function generateProceduralTextures(ctx) {
      const palettes = {
        'stone_slate':   { slab1: '#232a38', slab2: '#171c26', mortar: '#0c0e14', accent: '#3b4963' },
        'stone_dark':    { slab1: '#1e1b29', slab2: '#12101a', mortar: '#09070d', accent: '#352f4a' },
        'stone_crimson': { slab1: '#2b161b', slab2: '#1a0d11', mortar: '#0d0608', accent: '#592029' },
        'stone_violet':  { slab1: '#211a33', slab2: '#120e1c', mortar: '#08060d', accent: '#452f63' },
        'stone_moss':    { slab1: '#19272a', slab2: '#0f1719', mortar: '#070b0c', accent: '#25473a' }
      };
      Object.keys(palettes).forEach(key => {
        const pal = palettes[key];
        const off = document.createElement('canvas'); off.width = 160; off.height = 160;
        const oCtx = off.getContext('2d');
        oCtx.fillStyle = pal.mortar; oCtx.fillRect(0, 0, 160, 160);
        const bw = 40, bh = 40;
        for (let r = 0; r < 4; r++) {
          for (let c = 0; c < 4; c++) {
            const sx = (c * bw + (r % 2) * 20) % 160, sy = r * bh;
            oCtx.fillStyle = (r + c) % 2 === 0 ? pal.slab1 : pal.slab2;
            oCtx.fillRect(sx + 2, sy + 2, bw - 4, bh - 4);
            oCtx.strokeStyle = pal.accent; oCtx.lineWidth = 1;
            oCtx.beginPath(); oCtx.moveTo(sx + 2, sy + bh - 3); oCtx.lineTo(sx + 2, sy + 2); oCtx.lineTo(sx + bw - 3, sy + 2); oCtx.stroke();
          }
        }
        floorPatterns[key] = ctx.createPattern(off, 'repeat');
      });
    }

