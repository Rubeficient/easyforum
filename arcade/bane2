<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Tartaria</title>
  <script src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;800;900&family=Crimson+Pro:ital,wght@0,500;0,700;1,400&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --ink-black: #040306;
      --tartaria-bg: #07060b;
      --tartaria-gold: #cfa354;
      --tartaria-gold-bright: #f8e2a8;
      --atman-amber: #fbbf24;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; -webkit-user-select: none; }
    body, html { width: 100%; height: 100%; overflow: hidden; background-color: var(--ink-black); font-family: 'Crimson Pro', serif; color: #e6dcc8; }
    canvas#gameCanvas { display: block; width: 100vw; height: 100vh; background: var(--tartaria-bg); cursor: crosshair; }
    
    #crt-overlay {
      position: fixed; inset: 0; pointer-events: none; z-index: 90;
      background: linear-gradient(rgba(14, 12, 18, 0) 50%, rgba(0, 0, 0, 0.25) 50%), radial-gradient(circle at center, transparent 58%, rgba(2, 1, 5, 0.82) 100%);
      background-size: 100% 3px, 100% 100%;
    }
    .tartaria-window {
      background: linear-gradient(180deg, rgba(18, 16, 26, 0.93) 0%, rgba(7, 6, 12, 0.97) 100%);
      border: 1.5px solid var(--tartaria-gold); outline: 2px solid #000;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.85), inset 0 0 0 1px rgba(255, 230, 160, 0.12);
      border-radius: 3px;
    }

    /* Modal Frameworks */
    .full-modal {
      position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center;
      z-index: 100; padding: 12px; overflow-y: auto;
      background: radial-gradient(circle at 50% 25%, rgba(45, 22, 32, 0.96) 0%, rgba(4, 3, 7, 0.99) 85%);
    }
    .char-card { width: 100%; max-width: 900px; padding: 18px 22px; display: grid; grid-template-columns: 1.28fr 0.72fr; gap: 16px; }
    @media (max-width: 740px) { .char-card { grid-template-columns: 1fr; } }
    .title-banner { grid-column: 1 / -1; text-align: center; border-bottom: 2px solid #3a2818; padding-bottom: 10px; }
    .title-banner h1 { font-family: 'Cinzel', serif; font-size: 32px; font-weight: 900; letter-spacing: 7px; color: #ef4444; text-shadow: 2px 2px 0 #000; }
    .title-banner h2 { font-family: 'Cinzel', serif; font-size: 11px; letter-spacing: 2px; color: var(--tartaria-gold-bright); margin-top: 4px; }
    .form-col { display: flex; flex-direction: column; gap: 9px; }
    .preview-col { display: flex; flex-direction: column; align-items: center; justify-content: space-between; background: #07080d; border: 2px solid #3a2818; padding: 10px; }
    #previewCanvas { width: 240px; height: 215px; background: radial-gradient(circle at 50% 65%, #232a3b 0%, #050508 78%); border: 1px solid #2d2016; }
    .lore-box { font-size: 12px; line-height: 1.35; color: #d8c8b4; font-style: italic; text-align: center; padding: 6px 8px; background: rgba(12, 10, 16, 0.92); border-left: 3px solid var(--tartaria-gold); width: 100%; }
    .form-group { display: flex; flex-direction: column; gap: 3px; }
    label { font-family: 'Cinzel', serif; font-size: 10px; font-weight: 800; text-transform: uppercase; color: var(--tartaria-gold); letter-spacing: 1px; }
    input[type="text"], select { background: #050408; border: 1.5px solid #4a3520; color: #f3ebd6; padding: 6px 10px; border-radius: 2px; font-family: 'Crimson Pro', serif; font-size: 14px; font-weight: 600; outline: none; }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .name-row { display: flex; gap: 6px; } .name-row input { flex: 1; }
    .swatch-row { display: flex; gap: 6px; margin-top: 2px; }
    .swatch { width: 22px; height: 22px; border: 2px solid #000; outline: 1px solid #574129; cursor: pointer; }
    .swatch.active { transform: scale(1.18); outline: 2px solid var(--tartaria-gold-bright); }
    .btn-spawn { grid-column: 1 / -1; background: linear-gradient(180deg, #991b1b 0%, #450a0a 100%); border: 2px solid var(--tartaria-gold-bright); color: #fff4db; padding: 11px; font-family: 'Cinzel', serif; font-size: 14px; font-weight: 900; letter-spacing: 2px; text-transform: uppercase; cursor: pointer; }
    .btn-spawn:hover { filter: brightness(1.15); }

    /* HUD Architecture */
    #hud { position: fixed; inset: 0; pointer-events: none; display: none; z-index: 50; }
    .interactive { pointer-events: auto; }

    .top-ribbon {
      position: absolute; top: 0; left: 0; right: 0; height: 34px;
      background: linear-gradient(180deg, rgba(12, 10, 18, 0.96) 0%, rgba(6, 5, 10, 0.92) 100%);
      border-bottom: 1.5px solid var(--tartaria-gold); display: flex; justify-content: space-between; align-items: center; padding: 0 12px; font-family: 'Cinzel', serif; font-size: 10.5px; z-index: 60;
    }
    .action-btn { background: linear-gradient(180deg, #241b29 0%, #120d16 100%); border: 1px solid var(--tartaria-gold); color: var(--tartaria-gold-bright); padding: 3px 8px; font-family: 'Cinzel', serif; font-size: 9px; font-weight: 700; cursor: pointer; border-radius: 2px; }
    
    #top-left-dock { position: absolute; top: 40px; left: 10px; width: 252px; display: flex; flex-direction: column; gap: 6px; }
    .profile-card { padding: 8px 10px; font-size: 10px; }
    .bar-container { width: 100%; height: 6px; background: #050408; border: 1px solid #3d2d1f; margin-top: 1px; }
    .bar-fill { height: 100%; width: 100%; transition: width 0.12s linear; }
    #hp-fill { background: linear-gradient(90deg, #991b1b 0%, #ef4444 100%); }
    #mana-fill { background: linear-gradient(90deg, #1e40af 0%, #38bdf8 100%); }
    #atman-fill { background: linear-gradient(90deg, #b45309 0%, #fbbf24 60%, #fef08a 100%); }
    
    #party-mates-box { padding: 6px 8px; font-size: 9.5px; display: flex; flex-direction: column; gap: 4px; }
    .party-member { display: flex; align-items: center; justify-content: space-between; gap: 6px; background: rgba(5, 4, 9, 0.85); border: 1px solid #3a2a18; padding: 4px 6px; }
    .mate-avatar { width: 24px; height: 24px; border-radius: 50%; border: 1.5px solid #38bdf8; background: #111827; display: flex; align-items: center; justify-content: center; font-family: 'Cinzel', serif; font-size: 10px; color: #38bdf8; }
    
    #right-dock { position: absolute; top: 40px; right: 10px; width: 206px; display: flex; flex-direction: column; gap: 7px; }
    #minimap-box { padding: 6px; display: flex; flex-direction: column; align-items: center; gap: 3px; }
    #minimapCanvas { width: 188px; height: 120px; background: #050408; border: 1px solid #4a3520; }
    
    #weapon-stance-dock { padding: 8px; display: flex; flex-direction: column; gap: 5px; }
    .stance-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; }
    .stance-btn { background: #0b0912; border: 1px solid #4a3520; color: #a89984; padding: 4px 2px; font-family: 'Cinzel', serif; font-size: 8px; font-weight: 800; text-align: center; cursor: pointer; }
    .stance-btn.active { background: linear-gradient(180deg, #5c1919 0%, #2a0a0a 100%); border-color: var(--tartaria-gold-bright); color: #fff; }
    .weapon-slot-card { display: flex; align-items: center; justify-content: space-between; background: rgba(6, 5, 10, 0.9); border: 1.5px solid #42301b; padding: 5px 7px; cursor: pointer; }
    .weapon-slot-card.active { background: linear-gradient(90deg, rgba(85, 48, 18, 0.65) 0%, rgba(16, 12, 22, 0.95) 100%); border-color: var(--tartaria-gold-bright); }
    .wpn-key-badge { font-family: 'JetBrains Mono', monospace; font-size: 8.5px; background: var(--tartaria-gold); color: #000; padding: 1px 4px; margin-right: 5px; }
    .wpn-dmg-tag { font-family: 'Cinzel', serif; font-size: 7.5px; font-weight: 900; padding: 1px 4px; border: 1px solid #000; }
    
    #boss-bar-wrap { position: absolute; top: 40px; left: 50%; transform: translateX(-50%); width: 430px; display: none; flex-direction: column; gap: 3px; z-index: 70; }
    .boss-hp-track { width: 100%; height: 10px; background: #090508; border: 1.5px solid #cfa354; }
    #boss-hp-fill { width: 100%; height: 100%; background: linear-gradient(90deg, #7f1d1d 0%, #ef4444 50%, #f97316 100%); transition: width 0.1s linear; }

    .chat-container { position: absolute; bottom: 70px; left: 10px; width: 295px; display: flex; flex-direction: column; gap: 3px; opacity: 0.86; }
    .chat-container:hover { opacity: 1.0; }
    .chat-log { height: 82px; padding: 6px 8px; overflow-y: auto; font-size: 11px; background: rgba(8, 7, 14, 0.78); }
    .chat-input-row { display: flex; gap: 4px; }
    .chat-input { flex: 1; background: rgba(5, 4, 8, 0.92); border: 1.5px solid #4a3520; padding: 4px 8px; color: #f3ebd6; font-size: 11.5px; }

    .bottom-action-dock { position: absolute; bottom: 8px; left: 50%; transform: translateX(-50%); display: flex; gap: 6px; padding: 4px 8px; background: rgba(8, 7, 13, 0.94); border: 1.5px solid var(--tartaria-gold); }
    .special-orb-btn { width: 46px; height: 46px; border-radius: 50%; border: 2px solid var(--tartaria-gold-bright); color: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; font-family: 'Cinzel', serif; font-size: 7.5px; font-weight: 900; }
    .hotkey-slot { width: 46px; height: 46px; background: linear-gradient(180deg, #1b1724 0%, #09080d 100%); border: 1.5px solid #6b532e; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; position: relative; }
    .cd-overlay { position: absolute; bottom: 0; left: 0; right: 0; height: 0%; background: rgba(0, 0, 0, 0.72); pointer-events: none; }

    .popup-modal { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 92%; max-width: 560px; background: rgba(10, 8, 15, 0.94); backdrop-filter: blur(8px); border: 2px solid var(--tartaria-gold); padding: 16px 20px; display: none; flex-direction: column; gap: 10px; z-index: 165; }
    .equip-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .equip-box { background: rgba(5, 4, 8, 0.85); border: 1px solid #574129; padding: 7px; text-align: center; cursor: pointer; }
    .bag-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
    .bag-slot { min-height: 64px; background: rgba(5, 4, 8, 0.82); border: 1px solid #3a2a18; padding: 6px; text-align: center; cursor: pointer; display: flex; flex-direction: column; justify-content: center; }
    
    #souls-banner { position: absolute; top: 22%; left: 0; right: 0; background: linear-gradient(90deg, transparent 0%, rgba(10, 4, 6, 0.92) 25%, rgba(10, 4, 6, 0.92) 75%, transparent 100%); border-top: 1px solid rgba(200, 157, 84, 0.45); border-bottom: 1px solid rgba(200, 157, 84, 0.45); padding: 12px 0; text-align: center; font-family: 'Cinzel', serif; font-size: 23px; font-weight: 900; letter-spacing: 5px; color: #fbbf24; display: none; z-index: 190; pointer-events: none; }
    #toast { position: absolute; top: 82px; left: 50%; transform: translateX(-50%); padding: 5px 16px; font-family: 'Cinzel', serif; font-size: 11px; font-weight: 800; color: var(--tartaria-gold-bright); display: none; z-index: 200; }
  </style>
</head>
<body>

  <div id="crt-overlay"></div>
  <div id="souls-banner">SECTOR CARVED INTO STONE</div>

  <div id="boss-bar-wrap" class="tartaria-window">
    <div id="boss-bar-title">☠️ PETRIFIED STATUE OF FATHER ABESHU</div>
    <div class="boss-hp-track"><div id="boss-hp-fill"></div></div>
  </div>

  <div id="werdna-modal" class="popup-modal" style="max-width: 520px; background: #f5f0e1; color: #111; border: 4px solid #111; outline: 3px solid var(--tartaria-gold);">
    <p style="font-family: 'Crimson Pro', serif; font-size: 14.5px; font-weight: 700; line-height: 1.35; color: #1a1615;">"Come, enter the World of Wizardry if you dare. I am sure I know you. You lead a small band of foolhardy adventurers that dares challenge me. Ha! My dark legions laugh at your exploits in my domain. But wait. You have yet to meet me and face the ultimate terrors of my wicked magic. You can still run away, fools! Ha, ha, ha!"</p>
    <canvas id="werdnaCanvas" width="260" height="230" style="border:2px solid #111; background:#f5f0e1; align-self:center;"></canvas>
    <button class="action-btn" onclick="document.getElementById('werdna-modal').style.display='none'" style="background:#7c0a0a; color:#fff; align-self:center;">Defy Werdna [Close]</button>
  </div>

  <div id="char-modal" class="full-modal">
    <div class="char-card tartaria-window">
      <div class="title-banner">
        <div class="wiz-logo-wrap"><div class="wiz-logo-sword"></div><h1>TARTARIA</h1></div>
        <h2>Bounded Stratum Engine • Unique Boss Keys • Environmental Hazards</h2>
      </div>
      <div id="returning-save-banner" class="save-banner">
        <span id="returning-save-txt">Saved Vessel Detected!</span>
        <button class="action-btn" id="btn-reset-save" style="border-color:#f87171; color:#fca5a5;">Wipe Vessel</button>
      </div>
      <div class="form-col">
        <div class="grid-2">
          <div class="form-group"><label>Denizen Name (Lore Generator)</label><div class="name-row"><input type="text" id="char-name" value="Hawkwind"><button id="btn-roll-name" class="action-btn">🎲</button></div></div>
          <div class="form-group"><label>4-Player Shard Code</label><input type="text" id="shard-code-input" value="MAIN"></div>
        </div>
        <div class="grid-2">
          <div class="form-group"><label>Vessel Race (No Humans)</label><select id="char-race"></select></div>
          <div class="form-group"><label>Sub-Race / Card Archetype</label><select id="char-subrace"></select></div>
        </div>
        <div class="grid-2">
          <div class="form-group">
            <label>Core Calling (Lv.1)</label>
            <select id="char-class">
              <option value="Rogue">Rogue (Highlander Bow / Ninja)</option>
              <option value="Fighter">Fighter (Fire Giant / Vanguard)</option>
              <option value="Mage">Mage (Sorceress Orb / High Mage)</option>
              <option value="Cleric">Cleric (Gaiden Witch / Sun-Priest)</option>
            </select>
          </div>
          <div class="form-group">
            <label>Magic Tradition (1-9 Specials)</label>
            <select id="char-sect">
              <option value="Classic">Llylgamyn (Classic Wizardry)</option>
              <option value="Sun">Dilmun Sun (Dragon Wars)</option>
              <option value="East">Set East (Kubi-Kiri / Shuriken)</option>
              <option value="North">Set North (Frost / Magma)</option>
              <option value="West">Pillars of Zhad (Atman Cymatics)</option>
            </select>
          </div>
        </div>
        <div class="grid-2">
          <div class="form-group"><label>Garb Tint</label><div class="swatch-row" id="armor-swatches"></div></div>
          <div class="form-group"><label>Mane Tint</label><div class="swatch-row" id="hair-swatches"></div></div>
        </div>
      </div>
      <div class="preview-col">
        <span style="font-size:10px; color:#cfa354;">ARTICULATED 2.5D VESSEL</span>
        <canvas id="previewCanvas" width="240" height="215"></canvas>
        <div class="lore-box" id="race-lore-box"></div>
      </div>
      <button id="btn-awaken" class="btn-spawn">🔥 Awaken in Stratum 1</button>
    </div>
  </div>

  <div id="loot-modal" class="popup-modal">
    <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #4a3520; padding-bottom:6px;">
      <span id="loot-modal-title" style="font-family:'Cinzel',serif; font-size:15px; font-weight:900; color:var(--tartaria-gold-bright);">📦 ANCIENT COFFER</span>
      <span id="loot-modal-rarity" style="font-size:11px; color:#38bdf8;">[RARE]</span>
    </div>
    <div id="loot-items-list" style="display:flex; flex-direction:column; gap:6px; max-height:240px; overflow-y:auto;"></div>
    <div style="display:flex; justify-content:space-between; align-items:center; margin-top:4px;">
      <button class="action-btn" id="btn-take-all-loot" style="background:#166534; color:#fff;">✨ Take All</button>
      <button class="action-btn" onclick="document.getElementById('loot-modal').style.display='none'">Close</button>
    </div>
  </div>

  <div id="inventory-modal" class="popup-modal">
    <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #4a3520; padding-bottom:6px;">
      <span style="font-family:'Cinzel',serif; font-size:15px; font-weight:900; color:var(--tartaria-gold-bright);">🎒 SATCHEL & ARMORY [I]</span>
      <span id="inv-gold" style="font-size:12px; color:#facc15;">💰 150 Gold</span>
    </div>
    <div class="equip-grid">
      <div class="equip-box" onclick="selectWeaponSlot(0)"><small>Prime 1 (SLASH)</small><strong id="eq-wpn1-name">Scimitar</strong><span id="eq-wpn1-stat">+18 ATK</span></div>
      <div class="equip-box" onclick="selectWeaponSlot(1)"><small>Side 2 (BLUNT)</small><strong id="eq-wpn2-name">Maul</strong><span id="eq-wpn2-stat">+20 ATK</span></div>
      <div class="equip-box" onclick="selectWeaponSlot(2)"><small>Backup 3 (PIERCE)</small><strong id="eq-wpn3-name">Bow</strong><span id="eq-wpn3-stat">+17 ATK</span></div>
    </div>
    <div class="equip-grid" style="grid-template-columns: 1fr 1fr;">
      <div class="equip-box"><small>Torso Hauberk</small><strong id="eq-armor-name">Shozoku</strong><span id="eq-armor-stat">+45 HP</span></div>
      <div class="equip-box"><small>Atman Urn / Shield</small><strong id="eq-relic-name">Sun Shield</strong><span id="eq-relic-stat">+50 HP</span></div>
    </div>
    <div class="bag-grid" id="bag-grid"></div>
    <div style="display:flex; justify-content:flex-end;"><button class="action-btn" onclick="toggleInventory(false)">Close [I]</button></div>
  </div>

  <div id="grimoire-modal" class="popup-modal">
    <div style="border-bottom:1px solid #4a3520; padding-bottom:6px; font-family:'Cinzel'; font-size:15px; font-weight:900; color:var(--tartaria-gold-bright);">📖 GRIMOIRE BINDING [G]</div>
    <div style="display:flex; gap:6px; flex-wrap:wrap;" id="grimoire-slot-selector"></div>
    <div style="display:grid; grid-template-columns: 1fr 1fr; gap:8px; max-height:260px; overflow-y:auto;" id="grimoire-spell-list"></div>
    <div style="display:flex; justify-content:flex-end;"><button class="action-btn" onclick="toggleGrimoire(false)">Close [G]</button></div>
  </div>

  <canvas id="gameCanvas"></canvas>

  <div id="hud">
    <div class="top-ribbon interactive">
      <div class="ribbon-left">
        <span id="zone-icon">🧭</span>
        <span id="shard-status" style="color:#f8e2a8; font-weight:800;">Stratum 1: Firepit Sanctum</span>
        <span id="pvp-badge" style="color:#4ade80; font-weight:800;">[SAFEZONE]</span>
        <span id="bgm-theme-badge" style="color:#cfa354;">🎵 Theme: Tavern Ballad</span>
      </div>
      <div class="ribbon-right">
        <button id="btn-autoaim" class="action-btn" style="border-color:#4ade80; color:#4ade80;">🎯 Aim: ON</button>
        <button id="btn-gates" class="action-btn">⛩️ Gate [E]</button>
        <button id="btn-inv" class="action-btn">🎒 Bag [I]</button>
        <button id="btn-grim" class="action-btn">📖 Spells [G]</button>
        <button id="btn-audio" class="action-btn">🔊 Music</button>
        <button id="btn-crt" class="action-btn">📺 CRT</button>
        <button id="btn-invite" class="action-btn">🔗 Invite</button>
      </div>
    </div>

    <div id="top-left-dock" class="interactive">
      <div class="profile-card tartaria-window">
        <div class="profile-header">
          <div class="portrait-badge" id="player-portrait-badge">H</div>
          <div style="flex:1;">
            <div style="display:flex; justify-content:space-between;"><span id="vitals-name" style="font-weight:900; font-size:13px; color:#f4dca6; font-family:'Cinzel';">Hawkwind</span><span id="vitals-lvl" style="font-family:'JetBrains Mono'; font-size:10px; color:#cfa354;">LV.1</span></div>
            <div style="font-size:10px; color:#d4a359;" id="vitals-race">Elf • Highlander</div>
          </div>
        </div>
        <div class="bar-row"><div class="bar-label"><span>KRITA HP</span><span id="hp-txt">250/250</span></div><div class="bar-container"><div id="hp-fill" class="bar-fill"></div></div></div>
        <div class="bar-row"><div class="bar-label"><span>DILMUN MP</span><span id="mana-txt">90/90</span></div><div class="bar-container"><div id="mana-fill" class="bar-fill"></div></div></div>
        <div class="bar-row"><div class="bar-label" style="color:#fde047;"><span>⚱️ ATMAN URN [R]</span><span id="atman-txt">45/100</span></div><div class="bar-container"><div id="atman-fill" class="bar-fill" style="width:45%;"></div></div></div>
        <div class="bar-row"><div class="bar-label"><span>XP (<span id="gold-hud" style="color:#facc15;">150g</span>)</span><span id="xp-txt">0/100</span></div><div class="bar-container"><div id="xp-fill" class="bar-fill" style="width:0%;"></div></div></div>
      </div>
      <div id="party-mates-box" class="tartaria-window">
        <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #3d2d1f; padding-bottom:2px;"><span style="font-family:'Cinzel'; font-size:9.5px; color:#f4dca6; font-weight:800;">🛡️ PARTY SHARD <span id="shard-code-label">MAIN</span></span><span id="mesh-status" style="font-size:8.5px; color:#4ade80;">1/4 Online</span></div>
        <div id="party-list" style="display:flex; flex-direction:column; gap:4px;"></div>
      </div>
    </div>

    <div id="right-dock" class="interactive">
      <div id="minimap-box" class="tartaria-window">
        <div style="display:flex; justify-content:space-between; width:100%; font-family:'Cinzel'; font-size:9px; color:#f4dca6;"><span>🗺️ MAP</span><span id="mapped-count-txt" style="color:#4ade80;">1/49 Sectors</span></div>
