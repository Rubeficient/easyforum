    function handleEnemyKilled(en, idx) {
      enemies.splice(idx, 1);
      localPlayer.xp += en.xpValue || 55;
      const goldDrop = en.isBoss ? 250 : (20 + Math.floor(Math.random() * 28));
      localPlayer.gold += goldDrop;

      if (en.isBoss || Math.random() < 0.45) {
        lootChests.push({
          id: 'chest-' + Math.random().toString(36).slice(2, 7),
          x: en.x,
          y: en.y,
          label: en.isBoss ? `👑 ${en.name} GRAND TREASURY` : `${en.name} Coffer`,
          isCorpse: false,
          gold: goldDrop,
          item: LOOT_TABLE[Math.floor(Math.random() * LOOT_TABLE.length)]
        });
      }

      if (en.isBoss) {
        triggerSoulsBanner(`GREAT FOE VANQUISHED: ${en.name}`);
      }

      if (localPlayer.xp >= localPlayer.nextXp) {
        localPlayer.xp -= localPlayer.nextXp;
        localPlayer.level++;
        localPlayer.nextXp = Math.round(localPlayer.nextXp * 1.3);
        recalcEquipmentStats();
        localPlayer.hp = localPlayer.maxHp;
        localPlayer.mana = localPlayer.maxMana;
