    function initAudioEngine() {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
      if (audioCtx.state === 'suspended') audioCtx.resume();
      if (!bgmTimer) {
        scheduleNextMusicStep();
      }
    }

    function scheduleNextMusicStep() {
      const theme = MUSIC_THEMES[currentMusicMode] || MUSIC_THEMES['tavern'];
      bgmTimer = setTimeout(() => {
        if (bgmEnabled && audioCtx && document.getElementById('char-modal').style.display === 'none') {
          playMusicStep(theme, bgmTick);
          bgmTick++;
        }
        scheduleNextMusicStep();
      }, theme.tempoMs);
    }

    function playMusicStep(theme, step) {
      try {
        const now = audioCtx.currentTime;
        const dur = (theme.tempoMs / 1000) * 0.92;

        // 1. Sub-Bass / Lute Root Note on every beat
        if (step % 2 === 0 || currentMusicMode === 'combat') {
          const bOsc = audioCtx.createOscillator();
          const bGain = audioCtx.createGain();
          bOsc.type = theme.bassWave;
          const bFreq = theme.bass[(step >> 1) % theme.bass.length];
          bOsc.frequency.setValueAtTime(bFreq, now);
          bGain.gain.setValueAtTime(currentMusicMode === 'combat' ? 0.045 : 0.035, now);
          bGain.gain.exponentialRampToValueAtTime(0.001, now + dur);
          bOsc.connect(bGain);
          bGain.connect(audioCtx.destination);
          bOsc.start(now);
          bOsc.stop(now + dur);
        }

        // 2. Lead Harpsichord / Flute / Brass Voice
        const lOsc = audioCtx.createOscillator();
        const lGain = audioCtx.createGain();
        lOsc.type = theme.leadWave;
        const mFreq = theme.melody[step % theme.melody.length];
        lOsc.frequency.setValueAtTime(mFreq, now);
        lGain.gain.setValueAtTime(currentMusicMode === 'combat' ? 0.025 : 0.028, now);
        lGain.gain.exponentialRampToValueAtTime(0.001, now + dur * 0.85);
        lOsc.connect(lGain);
        lGain.connect(audioCtx.destination);
        lOsc.start(now);
        lOsc.stop(now + dur);
      } catch (e) {}
    }

    function playSfx(kind) {
      if (!audioCtx || !bgmEnabled) return;
      try {
        const now = audioCtx.currentTime;
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain);
        gain.connect(audioCtx.destination);

        if (kind === 'clank') {
          // Metallic clang when hitting an enemy with the WRONG weapon damage type!
          osc.type = 'square';
          osc.frequency.setValueAtTime(980, now);
          osc.frequency.setValueAtTime(1420, now + 0.03);
          gain.gain.setValueAtTime(0.14, now);
          gain.gain.exponentialRampToValueAtTime(0.005, now + 0.09);
          osc.start(now); osc.stop(now + 0.09);
        } else if (kind === 'crushing') {
          // Heavy crunch when hitting an enemy's WEAKNESS!
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(190, now);
          osc.frequency.exponentialRampToValueAtTime(42, now + 0.20);
          gain.gain.setValueAtTime(0.24, now);
          gain.gain.linearRampToValueAtTime(0.01, now + 0.20);
          osc.start(now); osc.stop(now + 0.20);
        } else if (kind === 'bow') {
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(500, now);
          osc.frequency.exponentialRampToValueAtTime(140, now + 0.09);
          gain.gain.setValueAtTime(0.14, now);
          gain.gain.linearRampToValueAtTime(0.01, now + 0.09);
          osc.start(now); osc.stop(now + 0.09);
        } else if (kind === 'atman') {
          osc.type = 'sine';
          osc.frequency.setValueAtTime(110, now);
          osc.frequency.exponentialRampToValueAtTime(880, now + 0.45);
          gain.gain.setValueAtTime(0.22, now);
          gain.gain.linearRampToValueAtTime(0.01, now + 0.45);
          osc.start(now); osc.stop(now + 0.45);
        } else if (kind === 'slash') {
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(310, now);
          osc.frequency.exponentialRampToValueAtTime(65, now + 0.13);
          gain.gain.setValueAtTime(0.14, now);
          gain.gain.linearRampToValueAtTime(0.01, now + 0.13);
          osc.start(now); osc.stop(now + 0.13);
        } else if (kind === 'behead') {
          osc.type = 'square';
          osc.frequency.setValueAtTime(540, now);
          osc.frequency.exponentialRampToValueAtTime(85, now + 0.24);
          gain.gain.setValueAtTime(0.22, now);
          gain.gain.linearRampToValueAtTime(0.01, now + 0.24);
          osc.start(now); osc.stop(now + 0.24);
        } else if (kind === 'gate') {
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(95, now);
          osc.frequency.linearRampToValueAtTime(140, now + 0.22);
          gain.gain.setValueAtTime(0.18, now);
          gain.gain.linearRampToValueAtTime(0.01, now + 0.22);
          osc.start(now); osc.stop(now + 0.22);
        } else if (kind === 'spell') {
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(180, now);
          osc.frequency.exponentialRampToValueAtTime(720, now + 0.26);
          gain.gain.setValueAtTime(0.14, now);
          gain.gain.linearRampToValueAtTime(0.01, now + 0.26);
          osc.start(now); osc.stop(now + 0.26);
        } else if (kind === 'loot') {
          osc.type = 'sine';
          osc.frequency.setValueAtTime(523.25, now);
          osc.frequency.setValueAtTime(659.25, now + 0.08);
          gain.gain.setValueAtTime(0.15, now);
          gain.gain.linearRampToValueAtTime(0.01, now + 0.24);
          osc.start(now); osc.stop(now + 0.24);
        } else if (kind === 'death') {
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(130, now);
          osc.frequency.linearRampToValueAtTime(38, now + 0.65);
          gain.gain.setValueAtTime(0.24, now);
          gain.gain.linearRampToValueAtTime(0.01, now + 0.65);
          osc.start(now); osc.stop(now + 0.65);
        }
      } catch (e) {}
    }

