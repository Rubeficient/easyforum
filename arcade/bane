    const keys = {};
    window.addEventListener('keydown', (e) => {
      if (document.activeElement === document.getElementById('chat-input')) {
        if (e.key === 'Enter') sendChat();
        return;
      }
      keys[e.key.toLowerCase()] = true;

      if (e.code === 'Space') {
        e.preventDefault();
        executeWeaponStanceAttack(enemies.find(en => en.id === localPlayer.targetEntityId));
      } else if (e.key.toLowerCase() === 'z') {
        switchWeaponStance('prime');
      } else if (e.key.toLowerCase() === 'x') {
        switchWeaponStance('side');
      } else if (e.key.toLowerCase() === 'c') {
        switchWeaponStance('backup');
      } else if (e.key.toLowerCase() === 'q') {
        cycleWeaponStance();
      } else if (e.key === 'Shift') {
        e.preventDefault();
        triggerDodgeRoll();
      } else if (e.key.toLowerCase() === 'r') {
        triggerAtmanCymaticBurst();
      } else if (['1','2','3','4','5','6','7','8','9'].includes(e.key)) {
        triggerSpellSlot(parseInt(e.key) - 1);
      } else if (e.key.toLowerCase() === 'i') {
        toggleInventory();
      } else if (e.key.toLowerCase() === 'g') {
        toggleGrimoire();
      } else if (e.key.toLowerCase() === 'e') {
        interactWithWorldObject();
      } else if (e.key === 'Escape') {
        toggleInventory(false);
        toggleGrimoire(false);
        document.getElementById('werdna-modal').style.display = 'none';
      } else if (e.key === 'Tab') {
        e.preventDefault();
        cycleTabTarget();
      } else if (e.key === 'Enter') {
        document.getElementById('chat-input').focus();
      }
    });

    window.addEventListener('keyup', (e) => {
      keys[e.key.toLowerCase()] = false;
    });

    canvas.addEventListener('mousedown', (e) => {
      initAudioEngine();
      mouseScreenX = e.clientX;
      mouseScreenY = e.clientY;
      const camX = localPlayer.x - screenW / 2;
      const camY = localPlayer.y - screenH / 2;
      const clickX = e.clientX + camX;
      const clickY = e.clientY + camY;

      for (const g of GATES) {
        if (Math.hypot(clickX - g.x, clickY - g.y) < 55) {
          g.isOpen = !g.isOpen;
          g.manualLock = !g.isOpen;
          playSfx('gate');
          if (g.isOpen && typeof g.gx2 === 'number') {
            getOrGenerateSector(g.gx2, g.gy2, localPlayer.name, true);
          }
          showToast(`${g.label}: ${g.isOpen ? 'OPENED ⛩️' : 'LOCKED SHUT 🔒'}`);
          return;
        }
      }

      for (let i = lootChests.length - 1; i >= 0; i--) {
        const ch = lootChests[i];
        if (Math.hypot(clickX - ch.x, clickY - ch.y) < 38) {
          if (Math.hypot(localPlayer.x - ch.x, localPlayer.y - ch.y) < 135) {
            activeLootChestIdx = i;
            lootAllNearbyChest();
          } else {
            localPlayer.targetX = ch.x;
            localPlayer.targetY = ch.y;
          }
          return;
        }
      }

      for (const npc of TARTARIA_NPCS) {
        if (Math.hypot(clickX - npc.x, clickY - npc.y) < 38) {
          appendChat(npc.name, npc.dialog);
          showToast(`${npc.name}: ${npc.dialog}`);
          if (npc.isWerdna) document.getElementById('werdna-modal').style.display = 'flex';
          return;
        }
      }

      for (const en of enemies) {
        if (Math.hypot(clickX - en.x, clickY - en.y) < en.radius + 24) {
          localPlayer.targetEntityId = en.id;
          executeWeaponStanceAttack(en);
          return;
        }
      }

      if (e.button === 2) {
        executeWeaponStanceAttack(null);
      } else {
        localPlayer.targetX = clickX;
        localPlayer.targetY = clickY;
      }
    });

    canvas.addEventListener('contextmenu', (e) => {
      e.preventDefault();
      executeWeaponStanceAttack(null);
    });

    function interactWithWorldObject() {
      if (activeLootChestIdx !== -1) {
        lootAllNearbyChest();
        return;
      }
      for (const npc of TARTARIA_NPCS) {
        if (Math.hypot(localPlayer.x - npc.x, localPlayer.y - npc.y) < 125) {
          appendChat(npc.name, npc.dialog);
          showToast(`${npc.name}: ${npc.dialog}`);
          if (npc.isWerdna) document.getElementById('werdna-modal').style.display = 'flex';
          return;
        }
      }
      toggleNearestGate();
    }

    function cycleTabTarget() {
      const candidates = [
        ...enemies.map(e => ({ id: e.id, name: e.name, weakness: e.weakness, x: e.x, y: e.y })),
        ...Array.from(remotePlayers.values()).map(p => ({ id: p.id, name: p.name, weakness: 'SLASH', x: p.x, y: p.y }))
      ];
      if (candidates.length === 0) return;
      candidates.sort((a, b) =>
        Math.hypot(a.x - localPlayer.x, a.y - localPlayer.y) - Math.hypot(b.x - localPlayer.x, b.y - localPlayer.y)
      );
      const curIdx = candidates.findIndex(c => c.id === localPlayer.targetEntityId);
      const next = candidates[(curIdx + 1) % candidates.length];
      localPlayer.targetEntityId = next.id;
      showToast(`Target: ${next.name} [WEAKNESS: ${next.weakness}]`);
    }

    // =========================================================================
    // 14. ARTICULATED 2.5D CHARACTER MODELS & WEAKNESS NAMEPLATES
    // =========================================================================
    function drawOVACharacter(ctx, p, cx, cy, timeSec, scaleOverride = 1.0, isTargeted = false, alphaOverride = 1.0) {
      const subMeta = getSubraceMeta(p);
      const sc = subMeta.scale * scaleOverride;
      const facing = p.facing || 1;
      const isMoving = p.isMoving;
      const walkCycle = timeSec * 12;
      const walkBob = isMoving ? Math.abs(Math.sin(walkCycle)) * -5 : Math.sin(timeSec * 3) * 1.8;
      const legSwing = isMoving ? Math.sin(walkCycle) * 0.55 : 0;
      const torsoLean = isMoving ? 0.12 : (p.swingTimer > 0 ? 0.22 : 0);

      ctx.save();
      ctx.globalAlpha = alphaOverride;
      ctx.translate(cx, cy);

      const auraGrad = ctx.createRadialGradient(0, 0, 4, 0, 0, 44 * sc);
      auraGrad.addColorStop(0, 'rgba(251, 191, 36, 0.22)');
      auraGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
      ctx.fillStyle = auraGrad;
      ctx.beginPath();
      ctx.arc(0, 0, 44 * sc, 0, Math.PI * 2);
      ctx.fill();

      if (isTargeted) {
        ctx.strokeStyle = '#ff2a38';
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        ctx.ellipse(0, 4, 28 * sc, 13 * sc, 0, 0, Math.PI * 2);
        ctx.stroke();
      }

      ctx.fillStyle = 'rgba(0, 0, 0, 0.78)';
      ctx.beginPath();
      ctx.ellipse(0, 6, 20 * sc, 9 * sc, 0, 0, Math.PI * 2);
      ctx.fill();

      ctx.save();
      ctx.scale(facing * sc, sc);
      ctx.translate(0, walkBob);
      ctx.rotate(torsoLean);
      ctx.lineJoin = 'round';
      ctx.lineCap = 'round';

      if (subMeta.tail) {
        ctx.strokeStyle = subMeta.skin;
        ctx.lineWidth = 5;
        ctx.beginPath();
        ctx.moveTo(-6, -8);
        ctx.quadraticCurveTo(-26, 2, -32, -12 + Math.sin(timeSec * 6) * 5);
        ctx.stroke();
      }

      if (subMeta.wings) {
        const flap = Math.sin(timeSec * 7) * 6;
        ctx.fillStyle = subMeta.tail ? '#1e3a5f' : '#4a0808';
        ctx.strokeStyle = '#040306';
        ctx.lineWidth = 2.2;
        ctx.beginPath();
        ctx.moveTo(-4, -26);
        ctx.lineTo(-38, -48 + flap);
        ctx.lineTo(-28, -14);
        ctx.closePath();
        ctx.fill(); ctx.stroke();
      }

      const cloakWave = Math.sin(timeSec * 5.5 + (isMoving ? 2 : 0)) * (isMoving ? 8 : 3);
      ctx.fillStyle = subMeta.skeleton ? '#2563eb' : (subMeta.sunShield ? '#1d4ed8' : (p.armorColor || '#2b3d54'));
      ctx.strokeStyle = '#040306';
      ctx.lineWidth = 2.4;
      ctx.beginPath();
      ctx.moveTo(-10, -31);
      ctx.lineTo(10, -31);
      ctx.lineTo(15 - cloakWave, 4);
      ctx.lineTo(-16 - cloakWave, 4);
      ctx.closePath();
      ctx.fill(); ctx.stroke();

      ctx.fillStyle = subMeta.skeleton ? '#d6d3c4' : '#17141f';
      ctx.strokeStyle = '#040306';
      ctx.lineWidth = 2.2;

      ctx.save();
      ctx.translate(-4, -12);
      ctx.rotate(-legSwing);
      ctx.fillRect(-3, 0, 6, 14);
      ctx.strokeRect(-3, 0, 6, 14);
      ctx.restore();

      ctx.save();
      ctx.translate(4, -12);
      ctx.rotate(legSwing);
      ctx.fillRect(-3, 0, 6, 14);
      ctx.strokeRect(-3, 0, 6, 14);
      ctx.restore();

      const torsoGrad = ctx.createLinearGradient(-10, -30, 10, -10);
      torsoGrad.addColorStop(0, p.hitFlash > 0 ? '#ffffff' : (subMeta.shellChest ? '#d97706' : (subMeta.bow ? '#be185d' : '#3b3347')));
      torsoGrad.addColorStop(1, '#14111a');
      ctx.fillStyle = torsoGrad;
      ctx.strokeStyle = '#040306';
      ctx.lineWidth = 2.4;
      ctx.beginPath();
      ctx.roundRect(-11, -31, 22, 21, 3);
      ctx.fill(); ctx.stroke();

      ctx.fillStyle = '#cfa354';
      ctx.beginPath();
      ctx.ellipse(-11, -28, 5.5, 4, -0.3, 0, Math.PI * 2);
      ctx.ellipse(11, -28, 5.5, 4, 0.3, 0, Math.PI * 2);
      ctx.fill(); ctx.stroke();

      const headY = -40;
      const headR = 10.5;
      ctx.fillStyle = p.hitFlash > 0 ? '#ffffff' : subMeta.skin;
      ctx.beginPath();
      ctx.arc(0, headY, headR, 0, Math.PI * 2);
      ctx.fill(); ctx.stroke();

      if (subMeta.snout) {
        ctx.fillStyle = subMeta.skin;
        ctx.beginPath();
        ctx.roundRect(4, headY - 2, 10, 7, 2);
        ctx.fill(); ctx.stroke();
      }

      if (subMeta.ears) {
        ctx.fillStyle = subMeta.skin;
        ctx.beginPath();
        ctx.moveTo(-headR + 1, headY - 1);
        ctx.lineTo(-headR - 11, headY - 7);
        ctx.lineTo(-headR + 2, headY + 3);
        ctx.closePath();
        ctx.fill(); ctx.stroke();
      } else if (subMeta.catEars) {
        ctx.fillStyle = subMeta.skin;
        ctx.beginPath();
        ctx.moveTo(-8, headY - 7); ctx.lineTo(-10, headY - 18); ctx.lineTo(-2, headY - 9); ctx.closePath();
        ctx.moveTo(2, headY - 9);  ctx.lineTo(9, headY - 18);  ctx.lineTo(8, headY - 7);  ctx.closePath();
        ctx.fill(); ctx.stroke();
      } else if (subMeta.horns) {
        ctx.fillStyle = subMeta.tail ? '#38bdf8' : '#f4dca6';
        ctx.beginPath();
        ctx.moveTo(-5, headY - 7); ctx.lineTo(-16, headY - 24); ctx.lineTo(-1, headY - 9); ctx.closePath();
        ctx.moveTo(5, headY - 7);  ctx.lineTo(16, headY - 24);  ctx.lineTo(1, headY - 9);  ctx.closePath();
        ctx.fill(); ctx.stroke();
      } else {
        ctx.fillStyle = subMeta.flamberge ? '#dc2626' : (p.hairColor || '#eab308');
        ctx.beginPath();
        ctx.moveTo(-11, headY - 3);
        ctx.lineTo(-7, headY - 16);
        ctx.lineTo(0, headY - 12);
        ctx.lineTo(6, headY - 16);
        ctx.lineTo(11, headY - 4);
        ctx.closePath();
        ctx.fill(); ctx.stroke();
      }

      ctx.fillStyle = '#ff3838';
      ctx.fillRect(2, headY - 2, 2.5, 2.5);
      ctx.fillRect(6.5, headY - 2, 2.5, 2.5);

      if (subMeta.sunShield) {
        ctx.save();
        ctx.translate(-10, -17);
        ctx.fillStyle = '#facc15';
        ctx.strokeStyle = '#040306';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.ellipse(0, 0, 9, 13, 0, 0, Math.PI * 2);
        ctx.fill(); ctx.stroke();
        ctx.fillStyle = '#dc2626';
        ctx.beginPath(); ctx.arc(0, 0, 3.5, 0, Math.PI * 2); ctx.fill();
        ctx.restore();
      }

      // Render Weapon based on Active Stance (Prime SLASH, Side BLUNT Hammer, or Backup PIERCE Bow)
      let swingRot = isMoving ? Math.sin(walkCycle) * 0.2 : 0;
      if (p.swingTimer > 0) {
        const phase = (18 - p.swingTimer) / 18;
        swingRot = -0.85 + Math.sin(phase * Math.PI) * 2.2;
      }

      const stance = p.activeWeaponSlot || 'prime';
      ctx.save();
      ctx.translate(10, -21);
      ctx.rotate(swingRot);

      if (stance === 'backup') {
        // Recurve Bow
        ctx.strokeStyle = '#d97706';
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.arc(0, 0, 16, -Math.PI * 0.48, Math.PI * 0.48);
        ctx.stroke();
        const pullBack = p.swingTimer > 0 ? -8 : -3;
        ctx.strokeStyle = '#e2e8f0';
        ctx.lineWidth = 1.2;
        ctx.beginPath();
        ctx.moveTo(1, -15); ctx.lineTo(pullBack, 0); ctx.lineTo(1, 15);
        ctx.stroke();
        ctx.strokeStyle = '#4ade80';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(pullBack, 0); ctx.lineTo(18, 0);
        ctx.stroke();
      } else if (stance === 'side') {
        // Heavy Blunt Stone-Maul / Warhammer
        ctx.fillStyle = '#78350f';
        ctx.fillRect(-2, -38, 4, 38);
        ctx.fillStyle = '#eab308';
        ctx.strokeStyle = '#040306';
        ctx.lineWidth = 2;
        ctx.fillRect(-11, -44, 22, 12);
        ctx.strokeRect(-11, -44, 22, 12);
      } else {
        // Prime Melee Scimitar / Flamberge Blade
        ctx.fillStyle = '#cfa354';
        ctx.fillRect(-5, -3, 10, 3);
        ctx.fillStyle = '#e2e8f0';
        ctx.strokeStyle = '#040306';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(-3, -3);
        ctx.lineTo(-4, -40);
        ctx.lineTo(2, -45);
        ctx.lineTo(4, -3);
        ctx.closePath();
        ctx.fill(); ctx.stroke();
      }

      ctx.restore();
      ctx.restore();
      ctx.restore();
    }

    function drawCardArtHostile(ctx, en, timeSec, isTargeted) {
      const sc = en.isBoss ? 1.85 : 1.0;
