    const mapCanvas = document.getElementById('minimapCanvas');
    const mapCtx = mapCanvas.getContext('2d');

    function renderCartographyMap() {
      mapCtx.clearRect(0, 0, mapCanvas.width, mapCanvas.height);
      const myGx = Math.floor(localPlayer.x / TILE_SIZE);
      const myGy = Math.floor(localPlayer.y / TILE_SIZE);

      const cellPx = 20;
      const centerX = mapCanvas.width / 2;
      const centerY = mapCanvas.height / 2;

      worldSectors.forEach(sec => {
        const dx = sec.gx - myGx;
        const dy = sec.gy - myGy;
        const rx = centerX + dx * cellPx - cellPx / 2;
        const ry = centerY + dy * cellPx - cellPx / 2;

        if (rx < -cellPx || rx > mapCanvas.width || ry < -cellPx || ry > mapCanvas.height) return;

        mapCtx.fillStyle = sec.safe ? '#166534' : (sec.isBossRoom ? '#7f1d1d' : '#1e293b');
        mapCtx.strokeStyle = sec.gx === myGx && sec.gy === myGy ? '#fde047' : '#cfa354';
        mapCtx.lineWidth = sec.gx === myGx && sec.gy === myGy ? 2 : 1;
        mapCtx.fillRect(rx + 1, ry + 1, cellPx - 2, cellPx - 2);
        mapCtx.strokeRect(rx + 1, ry + 1, cellPx - 2, cellPx - 2);

        if (sec.isBossRoom) {
          mapCtx.fillStyle = '#fca5a5';
          mapCtx.font = '8px sans-serif';
          mapCtx.textAlign = 'center';
          mapCtx.fillText('☠', rx + cellPx / 2, ry + cellPx / 2 + 3);
        } else if (sec.safe) {
          mapCtx.fillStyle = '#fde047';
          mapCtx.font = '8px sans-serif';
          mapCtx.textAlign = 'center';
          mapCtx.fillText('🔥', rx + cellPx / 2, ry + cellPx / 2 + 3);
        }
      });

      remotePlayers.forEach(rp => {
        const dx = (rp.x - localPlayer.x) / TILE_SIZE;
        const dy = (rp.y - localPlayer.y) / TILE_SIZE;
        mapCtx.fillStyle = '#38bdf8';
        mapCtx.beginPath();
        mapCtx.arc(centerX + dx * cellPx, centerY + dy * cellPx, 3, 0, Math.PI * 2);
        mapCtx.fill();
      });

      mapCtx.fillStyle = '#ffffff';
      mapCtx.beginPath();
      mapCtx.arc(centerX, centerY, 3.5, 0, Math.PI * 2);
      mapCtx.fill();
    }

