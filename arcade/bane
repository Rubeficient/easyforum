    canvas.addEventListener('mousedown', (e) => {
      const camX = localPlayer.x - screenW / 2;
      const camY = localPlayer.y - screenH / 2;
      const clickX = e.clientX + camX;
      const clickY = e.clientY + camY;

      let clickedEnemy = null;
      for (const en of enemies) {
        if (Math.hypot(clickX - en.x, clickY - en.y) < en.radius + 18) {
          clickedEnemy = en;
          break;
        }
      }

      if (clickedEnemy) {
        localPlayer.targetEntityId = clickedEnemy.id;
        if (Math.hypot(localPlayer.x - clickedEnemy.x, localPlayer.y - clickedEnemy.y) < 95) {
          executePrimaryStrike(clickedEnemy);
        } else {
          localPlayer.targetX = clickedEnemy.x;
          localPlayer.targetY = clickedEnemy.y;
        }
      } else {
        localPlayer.targetX = clickX;
        localPlayer.targetY = clickY;
      }
    });

    function cycleTabTarget() {
      if (enemies.length === 0) {
        spawnLabyrinthHostiles();
        return;
      }
      const sorted = [...enemies].sort((a, b) => {
        return Math.hypot(a.x - localPlayer.x, a.y - localPlayer.y) - Math.hypot(b.x - localPlayer.x, b.y - localPlayer.y);
      });
      const currentIdx = sorted.findIndex(t => t.id === localPlayer.targetEntityId);
      const nextIdx = (currentIdx + 1) % sorted.length;
      localPlayer.targetEntityId = sorted[nextIdx].id;
      showToast(`Target: ${sorted[nextIdx].name} [${sorted[nextIdx].faction}]`);
    }

    const globalUrlParams = new URLSearchParams(window.location.search);
    const joinShardId = globalUrlParams.get('shard');

    let localBroadcastChannel = null;
    try {
      if (typeof BroadcastChannel !== 'undefined') {
        localBroadcastChannel = new BroadcastChannel('wizardry_firepit_' + (joinShardId || 'main'));
        localBroadcastChannel.onmessage = (ev) => {
          if (ev.data && ev.data.id !== localPlayer.id) handleIncomingPacket(ev.data);
        };
      }
    } catch (e) {}

    const RELAY_SERVERS = [
      'wss://free.blr2.piesocket.com/v3/wizardry_firepit_mmo?api_key=VCXCEuvhGcBDP7XhiJJUDvR1e1D3eiVjgZ9VRiaV&notify_self=0'
    ];
    let activeSocket = null;
    let socketConnected = false;

    function initNetworking() {
      try {
        const ws = new WebSocket(RELAY_SERVERS[0]);
        activeSocket = ws;
        ws.onopen = () => {
          socketConnected = true;
          broadcastState();
        };
        ws.onmessage = (e) => {
          try {
            const data = JSON.parse(e.data);
            if (data && data.id && data.id !== localPlayer.id) handleIncomingPacket(data);
          } catch(err) {}
        };
        ws.onerror = () => { socketConnected = false; };
      } catch(err) {}
    }

    function handleIncomingPacket(data) {
      if (!data || !data.id || data.id === localPlayer.id) return;
      if (data.type === 'state') {
        let p = remotePlayers.get(data.id);
        if (!p) {
          p = { ...data };
          remotePlayers.set(data.id, p);
          appendChat('Firepit Pact', `${p.name} (${p.raceLabel}) joined the Firepit.`);
        } else {
          Object.assign(p, data);
        }
        updateEscapePactCount();
      } else if (data.type === 'chat') {
        appendChat(data.sender, data.text);
      }
    }

    function broadcastState() {
      const packet = {
        type: 'state',
        id: localPlayer.id,
        name: localPlayer.name,
        raceCategory: localPlayer.raceCategory,
        subraceKey: localPlayer.subraceKey,
        raceLabel: localPlayer.raceLabel,
        coreClass: localPlayer.coreClass,
        eliteClass: localPlayer.eliteClass,
        prestigeClass: localPlayer.prestigeClass,
        prestigeSet: localPlayer.prestigeSet,
        armorColor: localPlayer.armorColor,
        hairColor: localPlayer.hairColor,
        x: Math.round(localPlayer.x),
        y: Math.round(localPlayer.y),
        facing: localPlayer.facing,
        isMoving: localPlayer.isMoving,
        swingTimer: localPlayer.swingTimer,
        level: localPlayer.level,
        chatBubble: localPlayer.chatBubble,
        chatTimer: localPlayer.chatTimer
      };
      if (localBroadcastChannel) {
        try { localBroadcastChannel.postMessage(packet); } catch(e) {}
      }
      if (activeSocket && socketConnected && activeSocket.readyState === WebSocket.OPEN) {
        try { activeSocket.send(JSON.stringify(packet)); } catch(e) {}
      }
    }

    function broadcastChat(text) {
      const packet = { type: 'chat', id: localPlayer.id, sender: localPlayer.name, text };
      if (localBroadcastChannel) {
        try { localBroadcastChannel.postMessage(packet); } catch(e) {}
      }
      if (activeSocket && socketConnected && activeSocket.readyState === WebSocket.OPEN) {
        try { activeSocket.send(JSON.stringify(packet)); } catch(e) {}
      }
    }

