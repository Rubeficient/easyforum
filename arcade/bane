      } else if (isSelf) {

        ctx.save();

        ctx.strokeStyle = 'rgba(234, 179, 8, 0.45)';

        ctx.lineWidth = 1.5;

        ctx.beginPath();

        ctx.ellipse(0, 4, 22 * sc, 11 * sc, 0, 0, Math.PI * 2);

        ctx.stroke();

        ctx.restore();

