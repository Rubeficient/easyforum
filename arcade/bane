      ctx.fillStyle = '#d4af37';
      ctx.fillText(`<${p.raceLabel || subMeta.name} • ${getActiveClassTitle(p)}>`, p.x, topY + 11);

      if (p.chatBubble) {
        ctx.font = '700 13px Crimson Pro, serif';
        const txtW = ctx.measureText(p.chatBubble).width;
        const boxW = Math.max(txtW + 18, 54);
        const boxH = 24;
        const boxX = p.x - boxW / 2;
        const boxY = topY - 36;

        ctx.fillStyle = 'rgba(12, 10, 18, 0.95)';
        ctx.strokeStyle = '#d4af37';
        ctx.lineWidth = 1.5;
        ctx.fillRect(boxX, boxY, boxW, boxH);
        ctx.strokeRect(boxX, boxY, boxW, boxH);

        ctx.fillStyle = '#fff4db';
        ctx.fillText(p.chatBubble, p.x, boxY + 16);
      }
      ctx.restore();
