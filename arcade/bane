    function initAudioEngine() {
      if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      if (audioCtx.state === 'suspended') audioCtx.resume();
      if (!bgmTimer) scheduleNextMusicBeat();
    }

    function scheduleNextMusicBeat() {
      if (bgmTimer) clearTimeout(bgmTimer);
      const theme = MUSIC_THEMES[activeThemeName] || MUSIC_THEMES['tavern'];
      bgmTimer = setTimeout(() => {
        if (bgmEnabled && audioCtx && document.getElementById('char-modal').style.display === 'none') {
          try {
            const now = audioCtx.currentTime;
            const idx = bgmStep % theme.notes.length;

            // 1. Lead Voice
            const osc1 = audioCtx.createOscillator();
            const g1 = audioCtx.createGain();
            osc1.type = theme.leadWave;
            osc1.frequency.setValueAtTime(theme.notes[idx], now);
            g1.gain.setValueAtTime(activeThemeName === 'boss' ? 0.022 : 0.032, now);
            g1.gain.exponentialRampToValueAtTime(0.001, now + (theme.tempoMs * 0.0009));
            osc1.connect(g1); g1.connect(audioCtx.destination);
            osc1.start(now); osc1.stop(now + (theme.tempoMs * 0.00095));

            // 2. Bass / Cymatic Drone Voice on even steps
            if (bgmStep % 2 === 0) {
              const osc2 = audioCtx.createOscillator();
              const g2 = audioCtx.createGain();
              osc2.type = theme.bassWave;
              osc2.frequency.setValueAtTime(theme.bass[idx], now);
              g2.gain.setValueAtTime(0.035, now);
              g2.gain.exponentialRampToValueAtTime(0.001, now + (theme.tempoMs * 0.0018));
              osc2.connect(g2); g2.connect(audioCtx.destination);
              osc2.start(now); osc2.stop(now + (theme.tempoMs * 0.0019));
            }
            bgmStep++;
          } catch (e) {}
        }
        scheduleNextMusicBeat();
      }, theme.tempoMs);
    }

