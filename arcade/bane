        ctx.lineWidth = 4;

        ctx.beginPath();

        ctx.moveTo(-20, -5); ctx.lineTo(-20 - legSwing, 4);

        ctx.moveTo(-13, -5); ctx.lineTo(-13 + legSwing, 4);

        ctx.moveTo(4, -5);   ctx.lineTo(4 + legSwing, 4);

        ctx.moveTo(9, -5);   ctx.lineTo(9 - legSwing, 4);

