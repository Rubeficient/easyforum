        if (localPlayer.backpack.length < 8) localPlayer.backpack.push(it);
      });
      activeOpenChest.items = [];
      playSfx('loot');
      savePersistentProgress();
      closeLootModal(true);
      showToast('Looted all relics into Satchel [I]!');
    });

    function closeLootModal(removeEmpty = false) {
      document.getElementById('loot-modal').style.display = 'none';
      if (activeOpenChest && (removeEmpty || activeOpenChest.items.length === 0)) {
        const idx = lootChests.indexOf(activeOpenChest);
        if (idx !== -1) lootChests.splice(idx, 1);
      }
      activeOpenChest = null;
    }

