      document.getElementById('vitals-lvl').textContent = `LV.${localPlayer.level}`;
      document.getElementById('vitals-race').textContent = `${localPlayer.raceCategory} • ${subMeta.name}`;

      renderHotbarUI();
      initNetworking();
      updateVitalsUI();
      checkClassAscensionPrompt();
      triggerSoulsBanner('TARTARIA CENTRAL FIREPIT');
    });

    function updateVitalsUI() {
      document.getElementById('vitals-class').textContent = getActiveClassTitle(localPlayer);
      document.getElementById('gold-hud').textContent = `${localPlayer.gold}g`;
      document.getElementById('hp-txt').textContent = `${Math.max(0, Math.round(localPlayer.hp))}/${localPlayer.maxHp}`;
      document.getElementById('hp-fill').style.width = `${Math.max(0, (localPlayer.hp / localPlayer.maxHp) * 100)}%`;
      document.getElementById('mana-txt').textContent = `${Math.max(0, Math.round(localPlayer.mana))}/${localPlayer.maxMana}`;
      document.getElementById('mana-fill').style.width = `${Math.max(0, (localPlayer.mana / localPlayer.maxMana) * 100)}%`;
      document.getElementById('xp-txt').textContent = `${localPlayer.xp}/${localPlayer.nextXp}`;
      document.getElementById('xp-fill').style.width = `${Math.min(100, (localPlayer.xp / localPlayer.nextXp) * 100)}%`;
    }

    // =========================================================================
    // 18. MAIN 60 FPS GAME LOOP & SOULS-GOTHIC RENDERER
    // =========================================================================
    let lastTime = performance.now();
    let netTickTimer = 0;

    function gameLoop(now) {
      const dt = Math.min((now - lastTime) / 1000, 0.1);
      lastTime = now;

      updatePreview(now);

      let moveX = 0, moveY = 0;
      if (keys['w'] || keys['arrowup']) moveY -= 1;
      if (keys['s'] || keys['arrowdown']) moveY += 1;
      if (keys['a'] || keys['arrowleft']) moveX -= 1;
      if (keys['d'] || keys['arrowright']) moveX += 1;

      if (moveX !== 0 || moveY !== 0) {
        localPlayer.targetX = null;
        localPlayer.targetY = null;
        const len = Math.hypot(moveX, moveY);
        const nx = localPlayer.x + (moveX / len) * localPlayer.speed * dt;
        const ny = localPlayer.y + (moveY / len) * localPlayer.speed * dt;
        resolveDungeonMovement(localPlayer, nx, ny);
        if (Math.abs(moveX) > 0.05) localPlayer.facing = moveX > 0 ? 1 : -1;
        localPlayer.isMoving = true;
      } else if (localPlayer.targetX !== null && localPlayer.targetY !== null) {
        const dx = localPlayer.targetX - localPlayer.x;
        const dy = localPlayer.targetY - localPlayer.y;
        const dist = Math.hypot(dx, dy);
        if (dist > 8) {
          const nx = localPlayer.x + (dx / dist) * localPlayer.speed * dt;
          const ny = localPlayer.y + (dy / dist) * localPlayer.speed * dt;
          resolveDungeonMovement(localPlayer, nx, ny);
          if (Math.abs(dx) > 2) localPlayer.facing = dx > 0 ? 1 : -1;
          localPlayer.isMoving = true;
        } else {
          localPlayer.targetX = null;
          localPlayer.targetY = null;
          localPlayer.isMoving = false;
        }
      } else {
        localPlayer.isMoving = false;
      }

      // Check Current Zone & Safezone Firepit Status
      const activeZone = isPointInWalkableDungeon(localPlayer.x, localPlayer.y);
      const inSafezone = isInsideFirepitSafezone(localPlayer.x, localPlayer.y);
      document.getElementById('shard-status').textContent = activeZone ? activeZone.name : 'Tartaria Labyrinth';

      const pvpBadge = document.getElementById('pvp-badge');
      if (inSafezone) {
        pvpBadge.textContent = '[SAFEZONE SANCTUARY]';
        pvpBadge.style.color = '#4ade80';
        localPlayer.hp = Math.min(localPlayer.maxHp, localPlayer.hp + 12 * dt);
        localPlayer.mana = Math.min(localPlayer.maxMana, localPlayer.mana + 14 * dt);
      } else {
        pvpBadge.textContent = '[⚔️ FULL-LOOT PVP ZONE]';
        pvpBadge.style.color = '#ef4444';
        localPlayer.mana = Math.min(localPlayer.maxMana, localPlayer.mana + 4 * dt);
      }
      updateVitalsUI();

      // Update Hostile AI (Blocked from entering the Central Firepit Safezone)
      enemies.forEach(en => {
        const distToPlayer = Math.hypot(localPlayer.x - en.x, localPlayer.y - en.y);
        if (distToPlayer < 420 && distToPlayer > 32 && !inSafezone) {
          const ang = Math.atan2(localPlayer.y - en.y, localPlayer.x - en.x);
          const nx = en.x + Math.cos(ang) * en.speed * dt;
          const ny = en.y + Math.sin(ang) * en.speed * dt;
          if (!isInsideFirepitSafezone(nx, ny)) {
            resolveDungeonMovement(en, nx, ny);
          }
        }
        if (distToPlayer < 46 && !inSafezone) {
          en.attackCooldown -= dt;
          if (en.attackCooldown <= 0) {
            en.attackCooldown = 1.35;
            const hitDmg = 13 + Math.floor(Math.random() * 9);
            localPlayer.hp = Math.max(0, localPlayer.hp - hitDmg);
            playSfx('slash');
            spawnCombatText(localPlayer.x, localPlayer.y, `-${hitDmg}`, '#ef4444');
            if (localPlayer.hp <= 0) handleFullLootDeath(en.name);
          }
        }
      });

      if (localPlayer.swingTimer > 0) localPlayer.swingTimer--;
      if (localPlayer.chatTimer > 0) {
        localPlayer.chatTimer--;
        if (localPlayer.chatTimer <= 0) localPlayer.chatBubble = null;
      }

      remotePlayers.forEach(p => {
        if (p.chatTimer > 0) {
          p.chatTimer--;
          if (p.chatTimer <= 0) p.chatBubble = null;
        }
        if (p.swingTimer > 0) p.swingTimer--;
      });

      for (let i = spellVortexes.length - 1; i >= 0; i--) {
        spellVortexes[i].life--;
        if (spellVortexes[i].life <= 0) spellVortexes.splice(i, 1);
      }
      for (let i = slashArcs.length - 1; i >= 0; i--) {
        slashArcs[i].life--;
        if (slashArcs[i].life <= 0) slashArcs.splice(i, 1);
      }
      for (let i = bloodSparks.length - 1; i >= 0; i--) {
        const sp = bloodSparks[i];
        sp.x += sp.vx * dt;
        sp.y += sp.vy * dt;
        sp.life--;
        if (sp.life <= 0) bloodSparks.splice(i, 1);
      }
      for (let i = combatTexts.length - 1; i >= 0; i--) {
        const ct = combatTexts[i];
        ct.y -= 26 * dt;
        ct.life--;
        if (ct.life <= 0) combatTexts.splice(i, 1);
      }

      netTickTimer += dt;
      if (netTickTimer > 0.08) {
        broadcastState();
        netTickTimer = 0;
      }

      renderWorld(now * 0.001);
      requestAnimationFrame(gameLoop);
    }

    function renderWorld(timeSec) {
      ctx.clearRect(0, 0, screenW, screenH);

      const camX = localPlayer.x - screenW / 2;
      const camY = localPlayer.y - screenH / 2;

      ctx.save();
      ctx.translate(-camX, -camY);

      // Abyssal Void Background
      ctx.fillStyle = '#040307';
      ctx.fillRect(camX, camY, screenW, screenH);

      // 1. Draw Walkable Dungeon Rooms, Connecting Hallways & Cobblestone Grids
      WALKABLE_ZONES.forEach(z => {
        ctx.fillStyle = z.floor;
        ctx.fillRect(z.x, z.y, z.w, z.h);

        // Gothic Stone Slab Grid Lines
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.03)';
        ctx.lineWidth = 1;
        const step = 80;
        for (let gx = z.x; gx <= z.x + z.w; gx += step) {
          ctx.beginPath(); ctx.moveTo(gx, z.y); ctx.lineTo(gx, z.y + z.h); ctx.stroke();
        }
        for (let gy = z.y; gy <= z.y + z.h; gy += step) {
          ctx.beginPath(); ctx.moveTo(z.x, gy); ctx.lineTo(z.x + z.w, gy); ctx.stroke();
        }

        // Heavy Inked Outer Stone Walls
        ctx.strokeStyle = z.safe ? '#6b532e' : '#4a1c24';
        ctx.lineWidth = 6;
        ctx.strokeRect(z.x, z.y, z.w, z.h);

        // Room Title Engraving on Stone Floor
        ctx.font = '900 13px Cinzel, serif';
        ctx.textAlign = 'center';
        ctx.fillStyle = z.safe ? 'rgba(212, 175, 55, 0.45)' : 'rgba(217, 38, 38, 0.42)';
        ctx.fillText(z.name.toUpperCase(), z.x + z.w / 2, z.y + 28);
      });

      // 2. Draw Stone Doorways Connecting Rooms & Hallways
      DOORWAYS.forEach(d => {
        ctx.save();
        ctx.translate(d.x, d.y);
        ctx.fillStyle = '#2d2318';
        ctx.strokeStyle = '#c89d54';
        ctx.lineWidth = 2;
        if (d.horiz) {
          ctx.fillRect(-95, -10, 190, 20);
          ctx.strokeRect(-95, -10, 190, 20);
        } else {
          ctx.fillRect(-10, -95, 20, 190);
          ctx.strokeRect(-10, -95, 20, 190);
        }
        ctx.restore();
      });

      // 3. Draw Central Firepit Safezone Sanctuary Ring & Roaring Bonfire Sword
      ctx.save();
      ctx.strokeStyle = 'rgba(74, 222, 128, 0.28)';
      ctx.lineWidth = 3;
      ctx.setLineDash([12, 8]);
      ctx.beginPath();
      ctx.arc(FIREPIT_POS.x, FIREPIT_POS.y, FIREPIT_POS.safeRadius, 0, Math.PI * 2);
      ctx.stroke();
      ctx.setLineDash([]);

      const flicker = Math.sin(timeSec * 9) * 18;
      const fireGrad = ctx.createRadialGradient(
        FIREPIT_POS.x, FIREPIT_POS.y, 16,
        FIREPIT_POS.x, FIREPIT_POS.y, 340 + flicker
      );
      fireGrad.addColorStop(0, 'rgba(251, 146, 60, 0.55)');
      fireGrad.addColorStop(0.5, 'rgba(185, 28, 28, 0.22)');
      fireGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
      ctx.fillStyle = fireGrad;
      ctx.beginPath();
      ctx.arc(FIREPIT_POS.x, FIREPIT_POS.y, 340 + flicker, 0, Math.PI * 2);
      ctx.fill();

      // Obsidian Firepit Basin
      ctx.fillStyle = '#1f1924';
      ctx.strokeStyle = '#c89d54';
      ctx.lineWidth = 4;
      ctx.beginPath();
      ctx.arc(FIREPIT_POS.x, FIREPIT_POS.y, FIREPIT_POS.radius, 0, Math.PI * 2);
      ctx.fill(); ctx.stroke();

      // Animated Flame Tongues + Coiled Souls Sword in the Firepit
      for (let f = 0; f < 7; f++) {
        const ang = (f / 7) * Math.PI * 2 + timeSec * 2;
        const r = 24 + Math.sin(timeSec * 8 + f) * 10;
        ctx.fillStyle = f % 2 === 0 ? '#f97316' : '#facc15';
        ctx.beginPath();
        ctx.arc(FIREPIT_POS.x + Math.cos(ang) * r * 0.5, FIREPIT_POS.y + Math.sin(ang) * r * 0.5, 14, 0, Math.PI * 2);
        ctx.fill();
      }
      // Coiled Iron Sword stuck in the embers
      ctx.strokeStyle = '#e2e8f0';
      ctx.lineWidth = 4;
      ctx.beginPath();
      ctx.moveTo(FIREPIT_POS.x, FIREPIT_POS.y + 8);
      ctx.lineTo(FIREPIT_POS.x + 6, FIREPIT_POS.y - 48);
      ctx.stroke();
      ctx.restore();

      // 4. Draw Solid Gothic Columns
      SOLID_PILLARS.forEach(pil => {
        ctx.fillStyle = '#231d2b';
        ctx.strokeStyle = '#040306';
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.arc(pil.x, pil.y, pil.r, 0, Math.PI * 2);
        ctx.fill(); ctx.stroke();

        ctx.strokeStyle = '#57442b';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.arc(pil.x, pil.y, pil.r - 7, 0, Math.PI * 2);
        ctx.stroke();
      });

      // 5. Draw Loot Chests & Full-Loot PvP Corpse Satchels
      lootChests.forEach(ch => {
        ctx.save();
        ctx.translate(ch.x, ch.y);
        ctx.fillStyle = ch.isCorpse ? '#7f1d1d' : '#5c3a18';
        ctx.strokeStyle = '#f4dca6';
        ctx.lineWidth = 2;
        ctx.fillRect(-15, -11, 30, 22);
        ctx.strokeRect(-15, -11, 30, 22);
        ctx.fillStyle = '#facc15';
        ctx.fillRect(-4, -3, 8, 6);

        ctx.font = '700 10px Cinzel, serif';
        ctx.textAlign = 'center';
        ctx.fillStyle = ch.isCorpse ? '#fca5a5' : '#fde68a';
        ctx.fillText(ch.label, 0, -16);
        ctx.restore();
      });

      // 6. Draw Tartaria NPC Denizens
      TARTARIA_NPCS.forEach(npc => {
        ctx.save();
        ctx.translate(npc.x, npc.y);
        ctx.fillStyle = 'rgba(0,0,0,0.65)';
        ctx.beginPath(); ctx.ellipse(0, 6, 18, 8, 0, 0, Math.PI * 2); ctx.fill();

        ctx.fillStyle = npc.color;
        ctx.strokeStyle = '#040306';
        ctx.lineWidth = 2.5;
        ctx.beginPath(); ctx.roundRect(-12, -30, 24, 30, 4); ctx.fill(); ctx.stroke();
        ctx.fillStyle = '#e5dccb';
        ctx.beginPath(); ctx.arc(0, -38, 10, 0, Math.PI * 2); ctx.fill(); ctx.stroke();

        ctx.font = '800 11px Cinzel, serif';
        ctx.textAlign = 'center';
        ctx.fillStyle = '#f4dca6';
        ctx.fillText(`💬 ${npc.name}`, 0, -56);
        ctx.font = 'italic 10px Crimson Pro, serif';
        ctx.fillStyle = '#c89d54';
        ctx.fillText(`<${npc.title}>`, 0, -45);
        ctx.restore();
      });

      // 7. Draw Dungeon Hostiles
      enemies.forEach(en => {
        ctx.save();
        ctx.translate(en.x, en.y);
        if (en.id === localPlayer.targetEntityId) {
          ctx.strokeStyle = '#ff2a38';
          ctx.lineWidth = 2.5;
          ctx.beginPath();
          ctx.ellipse(0, 6, en.radius + 10, (en.radius + 10) * 0.45, 0, 0, Math.PI * 2);
          ctx.stroke();
        }
        ctx.fillStyle = 'rgba(0,0,0,0.65)';
        ctx.beginPath(); ctx.ellipse(0, 6, en.radius, en.radius * 0.45, 0, 0, Math.PI * 2); ctx.fill();

        const bob = Math.sin(timeSec * 6 + en.x) * 2.5;
        ctx.translate(0, bob);
        ctx.strokeStyle = '#040306';
        ctx.lineWidth = 2.2;

        if (en.kind === 'bunny') {
          ctx.fillStyle = '#f8fafc';
          ctx.beginPath(); ctx.ellipse(0, -8, 12, 10, 0, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
          ctx.beginPath();
          ctx.ellipse(-4, -22, 3, 9, -0.2, 0, Math.PI * 2);
          ctx.ellipse(4, -22, 3, 9, 0.2, 0, Math.PI * 2);
          ctx.fill(); ctx.stroke();
        } else {
          ctx.fillStyle = en.color;
          ctx.beginPath(); ctx.roundRect(-12, -28, 24, 26, 4); ctx.fill(); ctx.stroke();
          ctx.fillStyle = '#fde68a';
          ctx.beginPath(); ctx.arc(0, -35, 9, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
        }

        const hpRatio = Math.max(0, en.hp / en.maxHp);
        ctx.fillStyle = '#040306';
        ctx.fillRect(-18, -en.radius - 26, 36, 6);
        ctx.fillStyle = '#ef4444';
        ctx.fillRect(-17, -en.radius - 25, 34 * hpRatio, 4);

        ctx.font = '700 10px Cinzel, serif';
        ctx.textAlign = 'center';
        ctx.fillStyle = '#fca5a5';
        ctx.fillText(en.name, 0, -en.radius - 30);
        ctx.restore();
      });

      // 8. Draw Multi-Ring Spell Vortexes & Runes
      spellVortexes.forEach(vx => {
        ctx.save();
        ctx.translate(vx.x, vx.y);
        const progress = 1 - vx.life / vx.maxLife;
        const alpha = vx.life / vx.maxLife;
        ctx.strokeStyle = vx.color;
        ctx.globalAlpha = alpha;
        ctx.lineWidth = 3.5;

        const curR = vx.radius * (0.25 + progress * 0.75);
        ctx.beginPath();
        ctx.arc(0, 0, curR, 0, Math.PI * 2);
        ctx.stroke();

        // Inner Rotating Octagram Sigil
        ctx.rotate(timeSec * 4);
        ctx.strokeRect(-curR * 0.55, -curR * 0.55, curR * 1.1, curR * 1.1);
        ctx.rotate(Math.PI / 4);
        ctx.strokeRect(-curR * 0.55, -curR * 0.55, curR * 1.1, curR * 1.1);
        ctx.restore();
      });

      // 9. Draw Players (Depth-Sorted)
      const allPlayers = [localPlayer, ...Array.from(remotePlayers.values())];
      allPlayers.sort((a, b) => a.y - b.y);
      allPlayers.forEach(p => {
        drawOVACharacter(ctx, p, p.x, p.y, timeSec, 1.0, p.id === localPlayer.targetEntityId);
        drawPlayerTag(ctx, p);
      });

      // 10. Draw Slash Arcs, Blood Sparks & Floating Combat Text
      slashArcs.forEach(arc => {
        ctx.save();
        const alpha = arc.life / arc.maxLife;
        ctx.strokeStyle = arc.color;
        ctx.lineWidth = 6 * alpha;
        ctx.beginPath();
        ctx.arc(arc.x, arc.y - 18, arc.radius, -0.85, 0.85);
        ctx.stroke();
        ctx.restore();
      });

      bloodSparks.forEach(sp => {
        ctx.fillStyle = sp.color;
        ctx.fillRect(sp.x, sp.y, 3.5, 3.5);
      });

      combatTexts.forEach(ct => {
        ctx.font = '900 14px Cinzel, serif';
        ctx.textAlign = 'center';
        ctx.fillStyle = ct.color;
        ctx.strokeStyle = '#000';
        ctx.lineWidth = 3;
        ctx.strokeText(ct.text, ct.x, ct.y);
        ctx.fillText(ct.text, ct.x, ct.y);
      });

      ctx.restore();
    }

    function drawPlayerTag(ctx, p) {
      const subMeta = getSubraceMeta(p);
      const topY = p.y - 58 * subMeta.scale;

      ctx.save();
      ctx.textAlign = 'center';
      ctx.font = '800 12px Cinzel, serif';
      ctx.strokeStyle = '#000';
      ctx.lineWidth = 3;
      ctx.strokeText(`${p.name} [Lv.${p.level || 1}]`, p.x, topY);
      ctx.fillStyle = p.id === localPlayer.id ? '#f4dca6' : '#f87171';
      ctx.fillText(`${p.name} [Lv.${p.level || 1}]`, p.x, topY);

      ctx.font = 'italic 11px Crimson Pro, serif';
      ctx.fillStyle = '#c89d54';
      ctx.fillText(`<${p.raceLabel || subMeta.name} • ${getActiveClassTitle(p)}>`, p.x, topY + 11);

      if (p.chatBubble) {
        ctx.font = '700 13px Crimson Pro, serif';
        const txtW = ctx.measureText(p.chatBubble).width;
        const boxW = Math.max(txtW + 18, 54);
        const boxH = 24;
        const boxX = p.x - boxW / 2;
        const boxY = topY - 36;

        ctx.fillStyle = 'rgba(10, 8, 15, 0.95)';
        ctx.strokeStyle = '#c89d54';
        ctx.lineWidth = 1.5;
        ctx.fillRect(boxX, boxY, boxW, boxH);
        ctx.strokeRect(boxX, boxY, boxW, boxH);

        ctx.fillStyle = '#fff4db';
        ctx.fillText(p.chatBubble, p.x, boxY + 16);
      }
      ctx.restore();
    }

    requestAnimationFrame(gameLoop);
  </script>
</body>
</html>
