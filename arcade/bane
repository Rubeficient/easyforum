<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Wizardry Inverted: Tartaria Online</title>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;800;900&family=Crimson+Pro:ital,wght@0,500;0,700;1,400&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --ink-black: #040306;
      --tartaria-bg: #08060c;
      --tartaria-gold: #c89d54;
      --tartaria-gold-bright: #f4dca6;
      --tartaria-blood: #7c0a0a;
      --tartaria-crimson: #d92626;
      --tartaria-stone: #1c1824;
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      -webkit-user-select: none;
    }
    body, html {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: var(--ink-black);
      font-family: 'Crimson Pro', 'Georgia', serif;
      color: #e4dac9;
    }
    canvas#gameCanvas {
      display: block;
      width: 100vw;
      height: 100vh;
      background: var(--tartaria-bg);
      cursor: crosshair;
    }

    #crt-overlay {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 90;
      background:
        linear-gradient(rgba(16, 14, 18, 0) 50%, rgba(0, 0, 0, 0.34) 50%),
        radial-gradient(circle at center, transparent 48%, rgba(2, 1, 4, 0.88) 100%);
      background-size: 100% 3px, 100% 100%;
    }

    .tartaria-window {
      background: linear-gradient(180deg, rgba(16, 13, 22, 0.94) 0%, rgba(7, 5, 10, 0.97) 100%);
      border: 2px solid var(--tartaria-gold);
      outline: 2px solid #000;
      box-shadow:
        4px 4px 0px #000,
        inset 0 0 0 1px #3a2a18,
        inset 0 0 28px rgba(0, 0, 0, 0.95);
      border-radius: 2px;
    }

    /* Character Creation & Returning Login Modal */
    #char-modal {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 50% 30%, rgba(42, 12, 16, 0.95) 0%, rgba(4, 3, 7, 0.99) 85%);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 100;
      padding: 12px;
      overflow-y: auto;
    }
    .char-card {
      width: 100%;
      max-width: 860px;
      padding: 18px 22px;
      display: grid;
      grid-template-columns: 1.25fr 0.75fr;
      gap: 16px;
    }
    @media (max-width: 720px) {
      .char-card { grid-template-columns: 1fr; }
    }
    .title-banner {
      grid-column: 1 / -1;
      text-align: center;
      border-bottom: 2px solid #3a2818;
      padding-bottom: 8px;
    }
    .title-banner h1 {
      font-family: 'Cinzel', serif;
      font-size: 24px;
      font-weight: 900;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--tartaria-gold-bright);
      text-shadow: 2px 2px 0 #000, 0 0 18px rgba(180, 20, 20, 0.7);
    }
    .title-banner h2 {
      font-family: 'Cinzel', serif;
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #b89456;
      margin-top: 2px;
    }
    .save-banner {
      grid-column: 1 / -1;
      background: rgba(25, 45, 25, 0.65);
      border: 1px solid #4ade80;
      color: #bbf7d0;
      padding: 6px 12px;
      font-size: 12px;
      font-family: 'Cinzel', serif;
      display: none;
      justify-content: space-between;
      align-items: center;
    }

    .form-col { display: flex; flex-direction: column; gap: 9px; }
    .preview-col {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      background: #050408;
      border: 2px solid #3a2818;
      box-shadow: inset 0 0 28px rgba(0,0,0,0.95);
      padding: 10px;
    }
    #previewCanvas {
      width: 240px;
      height: 205px;
      background: radial-gradient(circle at 50% 65%, #261219 0%, #040306 75%);
      border: 1px solid #2d2016;
    }
    .lore-box {
      font-size: 12px;
      line-height: 1.35;
      color: #d8c8b4;
      font-style: italic;
      text-align: center;
      padding: 6px 8px;
      background: rgba(12, 10, 16, 0.92);
      border-left: 3px solid var(--tartaria-gold);
      width: 100%;
    }
    .form-group { display: flex; flex-direction: column; gap: 3px; }
    label {
      font-family: 'Cinzel', serif;
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      color: var(--tartaria-gold);
      letter-spacing: 1px;
    }
    input[type="text"], select {
      background: #050408;
      border: 2px solid #3a2818;
      color: #f3ebd6;
      padding: 6px 10px;
      border-radius: 2px;
      font-family: 'Crimson Pro', serif;
      font-size: 14px;
      font-weight: 600;
      outline: none;
    }
    input[type="text"]:focus, select:focus { border-color: var(--tartaria-gold-bright); }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .swatch-row { display: flex; gap: 6px; margin-top: 2px; }
    .swatch {
      width: 22px;
      height: 22px;
      border: 2px solid #000;
      outline: 1px solid #574129;
      cursor: pointer;
    }
    .swatch.active {
      transform: scale(1.18);
      outline: 2px solid var(--tartaria-gold-bright);
    }

    .btn-spawn {
      grid-column: 1 / -1;
      background: linear-gradient(180deg, #8b0c0c 0%, #420404 100%);
      border: 2px solid var(--tartaria-gold-bright);
      outline: 2px solid #000;
      color: #fff4db;
      padding: 11px;
      font-family: 'Cinzel', serif;
      font-size: 14px;
      font-weight: 900;
      letter-spacing: 2px;
      text-transform: uppercase;
      cursor: pointer;
      text-shadow: 2px 2px 0 #000;
      box-shadow: 3px 3px 0 #000;
    }
    .btn-spawn:hover { filter: brightness(1.15); }

    /* Translucent Quick Inventory & Equipment Popup [I] */
    #inventory-modal {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 92%;
      max-width: 580px;
      background: rgba(10, 8, 15, 0.84);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      border: 2px solid var(--tartaria-gold);
      outline: 2px solid #000;
      box-shadow: 0 12px 45px rgba(0,0,0,0.92);
      padding: 16px 20px;
      display: none;
      flex-direction: column;
      gap: 12px;
      z-index: 140;
    }
    .equip-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }
    .equip-box {
      background: rgba(5, 4, 8, 0.85);
      border: 1px solid #574129;
      padding: 8px;
      text-align: center;
      cursor: pointer;
    }
    .equip-box:hover { border-color: var(--tartaria-gold-bright); }
    .equip-box small {
      display: block;
      font-family: 'Cinzel', serif;
      font-size: 9px;
      color: #9c8462;
      text-transform: uppercase;
    }
    .equip-box strong {
      display: block;
      font-family: 'Cinzel', serif;
      font-size: 12px;
      color: var(--tartaria-gold-bright);
      margin-top: 2px;
    }
    .equip-box span {
      font-size: 10.5px;
      color: #4ade80;
    }
    .bag-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
    }
    .bag-slot {
      min-height: 62px;
      background: rgba(5, 4, 8, 0.82);
      border: 1px solid #3a2a18;
      padding: 6px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      cursor: pointer;
      position: relative;
      transition: border-color 0.12s, transform 0.1s;
    }
    .bag-slot:hover {
      border-color: var(--tartaria-gold-bright);
      transform: translateY(-1px);
    }
    .bag-slot .item-name {
      font-family: 'Cinzel', serif;
      font-size: 10.5px;
      color: #f4dca6;
      font-weight: 700;
    }
    .bag-slot .item-stat {
      font-size: 10px;
      color: #a89984;
    }

    /* Grimoire / Ascension Modals */
    #grimoire-modal, #ascend-modal {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 92%;
      max-width: 620px;
      background: rgba(10, 8, 15, 0.92);
      backdrop-filter: blur(6px);
      padding: 18px;
      display: none;
      flex-direction: column;
      gap: 12px;
      z-index: 150;
    }
    .spell-list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
      max-height: 280px;
      overflow-y: auto;
    }
    .spell-card {
      background: #060509;
      border: 1px solid #4a3520;
      padding: 8px 10px;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .spell-card:hover { border-color: var(--tartaria-gold-bright); }

    /* HUD */
    #hud {
      position: absolute;
      inset: 0;
      pointer-events: none;
      display: none;
      z-index: 50;
    }
    .interactive { pointer-events: auto; }

    .top-bar {
      position: absolute;
      top: 10px;
      left: 12px;
      right: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }
    .panel {
      padding: 6px 12px;
      font-size: 11px;
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: 'Cinzel', serif;
    }
    .action-btn {
      background: #171219;
      border: 1px solid var(--tartaria-gold);
      color: var(--tartaria-gold-bright);
      padding: 4px 8px;
      font-family: 'Cinzel', serif;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1px;
      cursor: pointer;
      text-transform: uppercase;
      box-shadow: 2px 2px 0 #000;
    }
    .action-btn:hover { background: #2d201c; }

    .vitals-box {
      position: absolute;
      top: 50px;
      left: 12px;
      padding: 10px 14px;
      width: 268px;
      font-size: 11px;
    }
    .bar-container {
      width: 100%;
      height: 9px;
      background: #050408;
      border: 2px solid #000;
      outline: 1px solid #3d2d1f;
      margin-top: 2px;
      overflow: hidden;
    }
    .bar-fill {
      height: 100%;
      width: 100%;
      transition: width 0.12s linear;
    }
    #hp-fill { background: linear-gradient(180deg, #c92a2a 0%, #6b1111 100%); }
    #mana-fill { background: linear-gradient(180deg, #2b78b8 0%, #123654 100%); }
    #xp-fill { background: linear-gradient(180deg, #f4dca6 0%, #b88b3a 100%); }

    /* 9-Slot Grimoire Action Bar (1 Slot Per Level up to 9) */
    .hotbar {
      position: absolute;
      bottom: 12px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 5px;
      flex-wrap: wrap;
      max-width: 96vw;
      justify-content: center;
    }
    .hotkey-slot {
      width: 54px;
      height: 54px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      position: relative;
    }
    .hotkey-slot.locked {
      opacity: 0.42;
      border-color: #3a2d24;
      cursor: not-allowed;
    }
    .hotkey-slot:not(.locked):hover { border-color: var(--tartaria-gold-bright); }
    .hotkey-num {
      position: absolute;
      top: 2px;
      left: 4px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 9px;
      font-weight: 700;
      color: var(--tartaria-gold);
    }
    .hotkey-icon { font-size: 16px; }
    .hotkey-label {
      font-family: 'Cinzel', serif;
      font-size: 7px;
      color: #dfd0ba;
      text-transform: uppercase;
      margin-top: 2px;
      text-align: center;
      max-width: 48px;
      overflow: hidden;
      white-space: nowrap;
    }

    .chat-container {
      position: absolute;
      bottom: 76px;
      left: 12px;
      width: 340px;
      max-width: calc(100vw - 24px);
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .chat-log {
      height: 112px;
      padding: 7px 10px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 3px;
      font-size: 12px;
    }
    .chat-msg {
      word-break: break-word;
      line-height: 1.25;
      text-shadow: 1px 1px 0 #000;
    }
    .chat-msg .author {
      color: var(--tartaria-gold-bright);
      font-weight: 700;
      font-family: 'Cinzel', serif;
      margin-right: 5px;
    }
    .chat-input-row { display: flex; gap: 4px; }
    .chat-input {
      flex: 1;
      background: rgba(5, 4, 8, 0.94);
      border: 2px solid #3a2818;
      padding: 5px 10px;
      color: #f3ebd6;
      font-size: 13px;
      font-family: 'Crimson Pro', serif;
      outline: none;
    }

    /* Souls-like Banner / Toast */
    #souls-banner {
      position: absolute;
      top: 24%;
      left: 0;
      right: 0;
      background: linear-gradient(90deg, transparent 0%, rgba(10, 4, 6, 0.92) 25%, rgba(10, 4, 6, 0.92) 75%, transparent 100%);
      border-top: 1px solid rgba(200, 157, 84, 0.45);
      border-bottom: 1px solid rgba(200, 157, 84, 0.45);
      padding: 14px 0;
      text-align: center;
      font-family: 'Cinzel', serif;
      font-size: 26px;
      font-weight: 900;
      letter-spacing: 6px;
      color: #d92626;
      text-shadow: 0 0 18px rgba(217, 38, 38, 0.75), 2px 2px 0 #000;
      display: none;
      z-index: 190;
      pointer-events: none;
    }
    #toast {
      position: absolute;
      top: 54px;
      left: 50%;
      transform: translateX(-50%);
      padding: 6px 18px;
      font-family: 'Cinzel', serif;
      font-size: 11.5px;
      font-weight: 800;
      color: var(--tartaria-gold-bright);
      letter-spacing: 1.5px;
      display: none;
      z-index: 200;
      text-shadow: 1px 1px 0 #000;
    }
  </style>
</head>
<body>

  <div id="crt-overlay"></div>
  <div id="souls-banner">FIREPIT RESTORED</div>

  <!-- Character Creation / Persistent Server Login -->
  <div id="char-modal">
    <div class="char-card tartaria-window">
      <div class="title-banner">
        <h1>Wizardry Inverted: Tartaria Online</h1>
        <h2>Always-On MMORPG • Full-Loot PvP • 1991 OVA Souls-Gothic Labyrinth</h2>
      </div>

      <div id="returning-save-banner" class="save-banner">
        <span id="returning-save-txt">Saved Character Detected!</span>
        <button class="action-btn" id="btn-reset-save" style="border-color:#f87171; color:#fca5a5;">Wipe Soul Save</button>
      </div>

      <div class="form-col">
        <div class="form-group">
          <label for="char-name">Denizen Name</label>
          <input type="text" id="char-name" maxlength="16" value="Vaelen">
        </div>

        <div class="grid-2">
          <div class="form-group">
            <label for="char-race">Non-Human Race (No Humans)</label>
            <select id="char-race"></select>
          </div>
          <div class="form-group">
            <label for="char-subrace">Sub-Race / Bloodline</label>
            <select id="char-subrace"></select>
          </div>
        </div>

        <div class="grid-2">
          <div class="form-group">
            <label for="char-class">Core Calling (Lv.1)</label>
            <select id="char-class">
              <option value="Fighter">Fighter (Lv.3 -> Warrior)</option>
              <option value="Rogue">Rogue (Lv.3 -> Thief)</option>
              <option value="Mage">Mage (Lv.3 -> Wizard)</option>
              <option value="Cleric">Cleric (Lv.3 -> Priest)</option>
            </select>
          </div>
          <div class="form-group">
            <label for="char-sect">Starting Regional Magic Sect</label>
            <select id="char-sect">
              <option value="Classic">Set Classic (Llylgamyn Chants)</option>
              <option value="North">Set North (Frost & Runic Fury)</option>
              <option value="East">Set East (Muramasa & Ki Arts)</option>
              <option value="South">Set South (Sun-Mirage & Alchemy)</option>
              <option value="West">Set West (Obsidian Totem & Blood)</option>
            </select>
          </div>
        </div>

        <div class="grid-2">
          <div class="form-group">
            <label>Garb & Plate Tint</label>
            <div class="swatch-row" id="armor-swatches"></div>
          </div>
          <div class="form-group">
            <label>Crest / Mane Tint</label>
            <div class="swatch-row" id="hair-swatches"></div>
          </div>
        </div>
      </div>

      <div class="preview-col">
        <span style="font-family:'Cinzel',serif; font-size:10px; color:#c89d54; letter-spacing:1px;">1991 OVA CEL VISAGE</span>
        <canvas id="previewCanvas" width="240" height="205"></canvas>
        <div class="lore-box" id="race-lore-box"></div>
      </div>

      <button id="btn-awaken" class="btn-spawn">🔥 Awaken at the Tartaria Central Firepit</button>
    </div>
  </div>

  <!-- Quick Translucent Inventory & Equipment Popup [I] -->
  <div id="inventory-modal">
    <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #4a3520; padding-bottom:6px;">
      <span style="font-family:'Cinzel',serif; font-size:15px; font-weight:900; color:var(--tartaria-gold-bright);">🎒 SATURNINE SATCHEL & ARMORY [I]</span>
      <span id="inv-gold" style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#facc15;">💰 150 Gold</span>
    </div>

    <div style="font-size:11px; color:#b8a68e;">Equipped Relics (Click an item in your Backpack below to equip, or click Equipped to unequip):</div>
    <div class="equip-grid">
      <div class="equip-box" onclick="unequipSlot('weapon')">
        <small>Right Hand Weapon</small>
        <strong id="eq-weapon-name">Rusty Gladius</strong>
        <span id="eq-weapon-stat">+6 DMG</span>
      </div>
      <div class="equip-box" onclick="unequipSlot('armor')">
        <small>Torso Hauberk</small>
        <strong id="eq-armor-name">Tattered Brigandine</strong>
        <span id="eq-armor-stat">+25 HP</span>
      </div>
      <div class="equip-box" onclick="unequipSlot('relic')">
        <small>Talisman / Relic</small>
        <strong id="eq-relic-name">Ash Signet</strong>
        <span id="eq-relic-stat">+10 MP</span>
      </div>
    </div>

    <div style="display:flex; justify-content:space-between; align-items:center;">
      <span style="font-family:'Cinzel',serif; font-size:11px; color:var(--tartaria-gold);">Backpack Satchel (⚠️ Dropped as Corpse Bag on PvP/Labyrinth Death!):</span>
      <span id="inv-stats-summary" style="font-family:'JetBrains Mono',monospace; font-size:10.5px; color:#4ade80;">ATK +6 | HP +25</span>
    </div>
    <div class="bag-grid" id="bag-grid"></div>

    <div style="display:flex; justify-content:flex-end; gap:8px;">
      <button class="action-btn" onclick="toggleInventory(false)">Close [I / ESC]</button>
    </div>
  </div>

  <!-- Regional Spell & Skill Grimoire Loadout Modal [G] -->
  <div id="grimoire-modal" class="tartaria-window">
    <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #4a3520; padding-bottom:6px;">
      <span style="font-family:'Cinzel',serif; font-size:15px; font-weight:900; color:var(--tartaria-gold-bright);">📖 REGIONAL SECT GRIMOIRE [G]</span>
      <span id="grimoire-slot-info" style="font-size:11px; color:#c89d54;">Unlocked Slots: 1 / 9 (1 per Level)</span>
    </div>
    <div style="font-size:11.5px; color:#d4c5b2;">
      Select which unlocked Slot (`1`–`9`) to bind, then click any Regional Sect Spell or Wizardry Chant below:
    </div>
    <div style="display:flex; gap:6px; flex-wrap:wrap;" id="grimoire-slot-selector"></div>
    <div class="spell-list" id="grimoire-spell-list"></div>
    <div style="display:flex; justify-content:flex-end;">
      <button class="action-btn" onclick="toggleGrimoire(false)">Close Grimoire [G]</button>
    </div>
  </div>

  <!-- Level 3 Specialist & Level 6 Regional Prestige Ascension Modal -->
  <div id="ascend-modal" class="tartaria-window">
    <div style="border-bottom:1px solid #4a3520; padding-bottom:6px;">
      <span id="ascend-title" style="font-family:'Cinzel',serif; font-size:16px; font-weight:900; color:var(--tartaria-gold-bright);">🔥 SOUL ASCENSION</span>
    </div>
    <div id="ascend-desc" style="font-size:12.5px; color:#e2d9c8;">Choose your path:</div>
    <div id="ascend-options" style="display:grid; grid-template-columns:1fr 1fr; gap:8px;"></div>
  </div>

  <canvas id="gameCanvas"></canvas>

  <!-- Main HUD -->
  <div id="hud">
    <div class="top-bar">
      <div class="panel tartaria-window">
        <span id="zone-icon">🔥</span>
        <span id="shard-status">Central Firepit Sanctum</span>
        <span id="pvp-badge" style="color:#4ade80; font-weight:800;">[SAFEZONE SANCTUARY]</span>
        <span id="online-badge" style="color:#c89d54; font-family:'JetBrains Mono',monospace; font-size:10px;">(1 Denizen)</span>
      </div>
      <div class="panel tartaria-window interactive">
        <button id="btn-inv" class="action-btn">🎒 Bag [I]</button>
