    function drawCharacterSprite(ctx, charData, screenX, screenY, time, scaleMultiplier = 1.0, isSelf = false, isTargeted = false) {

      const raceObj = RACES[charData.race] || RACES.Human;

      const sc = raceObj.scale * scaleMultiplier;



      ctx.save();

      ctx.translate(screenX, screenY);



      if (isTargeted) {

        ctx.save();

        ctx.strokeStyle = '#f59e0b';

        ctx.lineWidth = 2.5;

        ctx.beginPath();

        ctx.ellipse(0, 4, 26 * sc, 13 * sc, 0, 0, Math.PI * 2);

        ctx.stroke();

