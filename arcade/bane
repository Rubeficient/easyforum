        rp.y += (rp.syncY - rp.y) * Math.min(1, dt * 12);

        if (rp.emoteTimer > 0) rp.emoteTimer = Math.max(0, rp.emoteTimer - dt);

        if (rp.swingTimer > 0) rp.swingTimer = Math.max(0, rp.swingTimer - dt);

        if (rp.spellTimer > 0) rp.spellTimer = Math.max(0, rp.spellTimer - dt);

      });



      for (let i = particles.length - 1; i >= 0; i--) {

        const p = particles[i];

