    function updateJoystick(cx, cy) {

      const maxR = 36;

      let dx = cx - joyCenter.x;

      let dy = cy - joyCenter.y;

      const d = Math.hypot(dx, dy);

      if (d > maxR) { dx = (dx / d) * maxR; dy = (dy / d) * maxR; }

      touchVector.x = dx / maxR;

      touchVector.y = dy / maxR;

      joystickStick.style.transform = `translate(${dx}px, ${dy}px)`;

    }



    function resolveTreeCollision(entity) {

      const dx = entity.x - TREE_X;

      const dy = entity.y - TREE_Y;

      const dist = Math.hypot(dx, dy);

      const minD = TREE_TRUNK_RADIUS + 20;

      if (dist < minD && dist > 0.001) {

        entity.x = TREE_X + (dx / dist) * minD;

        entity.y = TREE_Y + (dy / dist) * minD;

      }

    }



    function updateOverworld(dt) {

      if (!hasSpawned) return;



      const raceSpeed = (RACES[localPlayer.race] || RACES.Human).speedMod;

      const runeSpeed = ccState.selectedRunes.includes('fleet') ? 0.08 : 0;

      const sprintBonus = localPlayer.sprintTimer > 0 ? 0.42 : 0;

      const effectiveSpeed = BASE_MOVE_SPEED * (raceSpeed + runeSpeed + sprintBonus);



      let vx = 0;

      let vy = 0;

      if (keys.w || keys.ArrowUp) vy -= 1;

      if (keys.s || keys.ArrowDown) vy += 1;

      if (keys.a || keys.ArrowLeft) vx -= 1;

      if (keys.d || keys.ArrowRight) vx += 1;

      if (touchVector.active) { vx += touchVector.x; vy += touchVector.y; }



      if (Math.hypot(vx, vy) > 0.05) {

        const len = Math.hypot(vx, vy);

        vx /= len; vy /= len;

        localPlayer.x += vx * effectiveSpeed * dt;

        localPlayer.y += vy * effectiveSpeed * dt;

        if (Math.abs(vx) > 0.1) localPlayer.facing = vx > 0 ? 1 : -1;

        localPlayer.isMoving = true;

      } else if (localPlayer.targetX !== null && localPlayer.targetY !== null) {

        const dx = localPlayer.targetX - localPlayer.x;

        const dy = localPlayer.targetY - localPlayer.y;

        const dist = Math.hypot(dx, dy);

        if (dist > 6) {

          localPlayer.x += (dx / dist) * effectiveSpeed * dt;

          localPlayer.y += (dy / dist) * effectiveSpeed * dt;

          if (Math.abs(dx) > 2) localPlayer.facing = dx > 0 ? 1 : -1;

          localPlayer.isMoving = true;

        } else {

          localPlayer.targetX = null;

          localPlayer.targetY = null;

          localPlayer.isMoving = false;

        }

      } else {

        localPlayer.isMoving = false;

      }



      localPlayer.x = Math.max(50, Math.min(WORLD_SIZE - 50, localPlayer.x));

      localPlayer.y = Math.max(50, Math.min(WORLD_SIZE - 50, localPlayer.y));

      resolveTreeCollision(localPlayer);



