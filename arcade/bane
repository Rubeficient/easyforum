        renderHotbarUI();
        triggerSoulsBanner(`SOUL LEVEL ${localPlayer.level} — NEW SPELL SLOT UNLOCKED`);
        checkClassAscensionPrompt();
      }

      savePersistentProgress();
      if (localPlayer.targetEntityId === en.id) localPlayer.targetEntityId = null;
      if (enemies.length < 10) setTimeout(spawnWorldEntities, 6000);
      updateVitalsUI();
    }

