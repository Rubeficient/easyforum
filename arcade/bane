    function renderInventoryUI() {
      recalcEquipmentStats();
      document.getElementById('inv-gold').textContent = `💰 ${localPlayer.gold} Gold`;
      document.getElementById('gold-hud').textContent = `${localPlayer.gold}g`;

      for (let i = 0; i < 3; i++) {
        const w = localPlayer.weapons[i];
        document.getElementById(`eq-wpn${i+1}-name`).textContent = w ? w.name : 'Empty';
        document.getElementById(`eq-wpn${i+1}-stat`).textContent = w ? `[${w.dmgType}] +${w.atk} ATK` : '—';
      }
      ['armor', 'relic'].forEach(slotKey => {
        const item = localPlayer.equipped[slotKey];
        document.getElementById(`eq-${slotKey}-name`).textContent = item ? item.name : 'Empty';
        document.getElementById(`eq-${slotKey}-stat`).textContent = item ? `+${item.hp || 0} HP +${item.atk || 0} ATK` : '—';
