        p.life -= dt;

        if (p.life <= 0) particles.splice(i, 1);

      }

    }



    function drawTreeOfLifeBaseAndRoots(ctx, camX, camY, time) {

      const tx = TREE_X - camX;

      const ty = TREE_Y - camY;



      ctx.save();

      const sanctuaryGrad = ctx.createRadialGradient(tx, ty, 60, tx, ty, SANCTUARY_RADIUS);

      sanctuaryGrad.addColorStop(0, 'rgba(234, 179, 8, 0.22)');

      sanctuaryGrad.addColorStop(0.6, 'rgba(34, 197, 94, 0.08)');

      sanctuaryGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');

      ctx.fillStyle = sanctuaryGrad;

      ctx.beginPath();

      ctx.arc(tx, ty, SANCTUARY_RADIUS, 0, Math.PI * 2);

      ctx.fill();



      ctx.strokeStyle = 'rgba(212, 175, 89, 0.28)';

      ctx.lineWidth = 2;

      ctx.beginPath();

      ctx.arc(tx, ty, 220, 0, Math.PI * 2);

      ctx.stroke();



      for (let i = 0; i < 8; i++) {

        const ang = (i / 8) * Math.PI * 2 + 0.2;

        ctx.save();

        ctx.translate(tx, ty);

        ctx.rotate(ang);

        ctx.fillStyle = '#3b2618';

        ctx.strokeStyle = '#24160d';

        ctx.lineWidth = 2;

        ctx.beginPath();

        ctx.moveTo(0, -28);

        ctx.quadraticCurveTo(110, -35, 215, -6);

        ctx.quadraticCurveTo(110, 18, 0, 28);

        ctx.closePath();

        ctx.fill();

        ctx.stroke();

        ctx.restore();

      }



      ctx.fillStyle = '#472e1d';

      ctx.strokeStyle = '#1f130b';

      ctx.lineWidth = 4;

      ctx.beginPath();

      ctx.arc(tx, ty, TREE_TRUNK_RADIUS, 0, Math.PI * 2);

      ctx.fill();

      ctx.stroke();



      const pulse = 0.55 + Math.sin(time * 2.2) * 0.35;

      ctx.strokeStyle = `rgba(250, 204, 21, ${pulse})`;

      ctx.lineWidth = 3;

      ctx.beginPath();

      ctx.arc(tx, ty, 38, 0, Math.PI * 2);

      ctx.moveTo(tx, ty - 55); ctx.lineTo(tx, ty + 55);

      ctx.moveTo(tx - 55, ty); ctx.lineTo(tx + 55, ty);

      ctx.stroke();

      ctx.restore();

    }



    function drawTreeOfLifeCanopyAndSpores(ctx, camX, camY, time) {

      const tx = TREE_X - camX;

      const ty = TREE_Y - camY;



      ctx.save();

      const playerDist = Math.hypot(localPlayer.x - TREE_X, localPlayer.y - TREE_Y);

      const canopyAlpha = playerDist < 310 ? 0.38 : 0.88;

      ctx.globalAlpha = canopyAlpha;



      const clusters = [

        { dx: 0, dy: -60, r: 210, color: '#143821' },

        { dx: -130, dy: -20, r: 155, color: '#194528' },

        { dx: 135, dy: -25, r: 155, color: '#194528' },

        { dx: -95, dy: 90, r: 145, color: '#1f5230' },

        { dx: 105, dy: 85, r: 145, color: '#1f5230' },

        { dx: 0, dy: -30, r: 165, color: '#27633a' },

        { dx: 0, dy: -45, r: 110, color: '#38804c' }

      ];



      clusters.forEach((c, idx) => {

        const swayX = Math.sin(time * 1.2 + idx) * 6;

        const swayY = Math.cos(time * 1.0 + idx) * 4;

        ctx.fillStyle = c.color;

        ctx.beginPath();

        ctx.arc(tx + c.dx + swayX, ty + c.dy + swayY, c.r, 0, Math.PI * 2);

        ctx.fill();

      });



      ctx.restore();



      ctx.save();

      TREE_SPORES.forEach((sp) => {

        const a = sp.angle + time * sp.speed;

        const sx = tx + Math.cos(a) * sp.dist;

        const sy = ty + Math.sin(a) * (sp.dist * 0.75) - 30;

        ctx.fillStyle = sp.gold ? 'rgba(253, 224, 71, 0.85)' : 'rgba(110, 231, 183, 0.8)';

        ctx.beginPath();

        ctx.arc(sx, sy, sp.size, 0, Math.PI * 2);

        ctx.fill();

      });

      ctx.restore();

    }



    function drawNameplateAndSpeech(ctx, ent, sx, sy, isSelf) {

      ctx.save();

      const raceObj = RACES[ent.race] || RACES.Human;

      const offsetY = 58 * raceObj.scale;



      ctx.font = '700 12px Cinzel, serif';

      ctx.textAlign = 'center';

      ctx.fillStyle = isSelf ? '#fde047' : '#34d399';

      ctx.shadowColor = 'rgba(0,0,0,0.95)';

      ctx.shadowBlur = 4;

      ctx.fillText(ent.name, sx, sy - offsetY);



      ctx.font = 'italic 11px Crimson Pro, serif';

      ctx.fillStyle = '#cbd5e1';

      ctx.fillText(`<Lv.${ent.level || 1} ${ent.race} ${ent.charClass}>`, sx, sy - offsetY + 12);

      ctx.shadowBlur = 0;



      if (ent.chat && Date.now() - ent.chatTimestamp < 6500) {

        ctx.font = '600 13px Crimson Pro, serif';

        const m = ctx.measureText(ent.chat);

        const bw = Math.min(280, m.width + 22);

        const bh = 26;

        const bx = sx - bw / 2;

        const by = sy - offsetY - 42;



        ctx.fillStyle = 'rgba(14, 14, 18, 0.92)';

        ctx.strokeStyle = ent.chatType === 'shout' ? '#f87171' : '#c8a253';

        ctx.lineWidth = 1.5;

        ctx.beginPath();

        ctx.roundRect(bx, by, bw, bh, 6);

        ctx.fill();

        ctx.stroke();



        ctx.fillStyle = ent.chatType === 'shout' ? '#fecaca' : '#fef3c7';

        ctx.textBaseline = 'middle';

        ctx.fillText(ent.chat, sx, by + bh / 2);

      }



      ctx.restore();

    }



    function renderOverworld(time) {

      if (!hasSpawned) return;



      ctx.clearRect(0, 0, screenWidth, screenHeight);



      const camX = localPlayer.x - screenWidth / 2;

      const camY = localPlayer.y - screenHeight / 2;



      ctx.fillStyle = '#152414';

      ctx.fillRect(0, 0, screenWidth, screenHeight);



      ctx.strokeStyle = 'rgba(34, 62, 30, 0.45)';

      ctx.lineWidth = 1;

      const step = 128;

      const startX = Math.floor(camX / step) * step;

      const startY = Math.floor(camY / step) * step;

      for (let x = startX; x < camX + screenWidth + step; x += step) {

        ctx.beginPath(); ctx.moveTo(x - camX, 0); ctx.lineTo(x - camX, screenHeight); ctx.stroke();

      }

      for (let y = startY; y < camY + screenHeight + step; y += step) {

        ctx.beginPath(); ctx.moveTo(0, y - camY); ctx.lineTo(screenWidth, y - camY); ctx.stroke();

      }



      ctx.strokeStyle = '#8b1e22';

      ctx.lineWidth = 4;

      ctx.strokeRect(-camX, -camY, WORLD_SIZE, WORLD_SIZE);



      if (clickMarker && clickMarker.timer > 0) {

        ctx.save();

        ctx.strokeStyle = `rgba(250, 204, 21, ${clickMarker.timer})`;

        ctx.lineWidth = 2;

        ctx.beginPath();

        ctx.ellipse(clickMarker.x - camX, clickMarker.y - camY, 16 * clickMarker.timer, 8 * clickMarker.timer, 0, 0, Math.PI * 2);

        ctx.stroke();

        ctx.restore();

      }



      drawTreeOfLifeBaseAndRoots(ctx, camX, camY, time);



      RUNESTONES.forEach(stone => {

        const rx = stone.x - camX;

        const ry = stone.y - camY;

        if (rx < -80 || rx > screenWidth + 80 || ry < -80 || ry > screenHeight + 80) return;

        ctx.save();

        ctx.fillStyle = 'rgba(0,0,0,0.45)';

        ctx.beginPath();

        ctx.ellipse(rx, ry + 6, 22, 10, 0, 0, Math.PI * 2);

        ctx.fill();

        ctx.fillStyle = '#2d3139';

        ctx.strokeStyle = '#6e5322';

        ctx.lineWidth = 2;

        ctx.beginPath();

        ctx.moveTo(rx - 14, ry + 4);

        ctx.lineTo(rx - 10, ry - 38);

        ctx.lineTo(rx, ry - 48);

        ctx.lineTo(rx + 10, ry - 38);

        ctx.lineTo(rx + 14, ry + 4);

        ctx.closePath();

        ctx.fill();

        ctx.stroke();

        const runeGlow = 0.5 + Math.sin(time * 3) * 0.4;

        ctx.strokeStyle = `rgba(56, 189, 248, ${runeGlow})`;

        ctx.lineWidth = 2;

        ctx.beginPath();

        ctx.moveTo(rx, ry - 34); ctx.lineTo(rx, ry - 10);

        ctx.moveTo(rx - 6, ry - 26); ctx.lineTo(rx + 6, ry - 18);

        ctx.stroke();

        ctx.restore();

      });



      LIFE_ORBS.forEach(orb => {

        if (!orb.active) return;

        const ox = orb.x - camX;

        const oy = orb.y - camY + Math.sin(time * 3.5 + orb.id) * 5;

        if (ox < -40 || ox > screenWidth + 40 || oy < -40 || oy > screenHeight + 40) return;

        ctx.save();

        const orbGrad = ctx.createRadialGradient(ox, oy, 2, ox, oy, 16);

        orbGrad.addColorStop(0, 'rgba(254, 240, 138, 1)');

        orbGrad.addColorStop(0.5, 'rgba(250, 204, 21, 0.55)');

        orbGrad.addColorStop(1, 'rgba(234, 179, 8, 0)');

        ctx.fillStyle = orbGrad;

        ctx.beginPath();

        ctx.arc(ox, oy, 16, 0, Math.PI * 2);

        ctx.fill();

        ctx.restore();

      });



      const allChars = [

        { ...localPlayer, isSelf: true },

        ...Array.from(remotePlayers.values())

      ];

      allChars.sort((a, b) => a.y - b.y);



      ctx.save();

      ctx.lineCap = 'round';

      for (let i = 0; i < GRASS_PATCHES.length; i++) {

        const g = GRASS_PATCHES[i];

        const gx = g.x - camX;

        const gy = g.y - camY;

        if (gx < -30 || gx > screenWidth + 30 || gy < -30 || gy > screenHeight + 30) continue;



        let targetBend = Math.sin(time * 2.2 + g.x * 0.02 + g.y * 0.01) * 4.5;

        for (let c = 0; c < allChars.length; c++) {

          const ch = allChars[c];

          const dx = g.x - ch.x;

          const dy = g.y - ch.y;

          const dSq = dx * dx + dy * dy;

          if (dSq < 1800) {

            const push = (1 - Math.sqrt(dSq) / 42) * 16;

            targetBend += (dx >= 0 ? push : -push);

          }

        }

        g.bend += (targetBend - g.bend) * 0.22;



        ctx.strokeStyle = `hsl(${g.hue}, 46%, ${g.light}%)`;

        ctx.lineWidth = 2.2;

        ctx.beginPath();

        ctx.moveTo(gx, gy);

        ctx.quadraticCurveTo(gx + g.bend * 0.5, gy - g.height * 0.6, gx + g.bend, gy - g.height);

        ctx.stroke();



        ctx.beginPath();

        ctx.moveTo(gx + 3, gy + 1);

        ctx.quadraticCurveTo(gx + 3 + g.bend * 0.4, gy - g.height * 0.5, gx + 4 + g.bend * 0.85, gy - g.height * 0.82);

        ctx.stroke();

      }

      ctx.restore();



      allChars.forEach(ch => {

        const sx = ch.x - camX;

        const sy = ch.y - camY;

        if (sx < -120 || sx > screenWidth + 120 || sy < -120 || sy > screenHeight + 120) return;



        drawCharacterSprite(ctx, ch, sx, sy, time, 1.0, ch.isSelf, selectedTargetId === ch.id);

        drawNameplateAndSpeech(ctx, ch, sx, sy, ch.isSelf);



        if (ch.spellTimer > 0 && ch.spellEffect) {

          ctx.save();

          const progress = 1 - (ch.spellTimer / 0.85);

          const radius = 22 + progress * 58;

          ctx.lineWidth = 3;

          if (ch.spellEffect === 'fighter' || ch.spellEffect === 'slash') {

            ctx.strokeStyle = `rgba(239, 68, 68, ${ch.spellTimer})`;

          } else if (ch.spellEffect === 'healer' || ch.spellEffect === 'commune') {

            ctx.strokeStyle = `rgba(52, 211, 153, ${ch.spellTimer})`;

          } else if (ch.spellEffect === 'mage') {

            ctx.strokeStyle = `rgba(56, 189, 248, ${ch.spellTimer})`;

          } else {

            ctx.strokeStyle = `rgba(168, 85, 247, ${ch.spellTimer})`;

          }

          ctx.beginPath();

          ctx.ellipse(sx, sy - 10, radius, radius * 0.55, 0, 0, Math.PI * 2);

          ctx.stroke();

          ctx.restore();

        }



        if (ch.isSelf && localPlayer.spawnBeamTimer > 0) {

          ctx.save();

          const beamAlpha = Math.min(0.75, localPlayer.spawnBeamTimer * 0.4);

          const beamGrad = ctx.createLinearGradient(sx - 35, sy, sx + 35, sy);

          beamGrad.addColorStop(0, 'rgba(253, 224, 71, 0)');

          beamGrad.addColorStop(0.5, `rgba(253, 224, 71, ${beamAlpha})`);

          beamGrad.addColorStop(1, 'rgba(253, 224, 71, 0)');

          ctx.fillStyle = beamGrad;

          ctx.fillRect(sx - 35, sy - 400, 70, 410);

          ctx.restore();

        }

      });



      particles.forEach(p => {

        ctx.fillStyle = p.color;

        ctx.beginPath();

        ctx.arc(p.x - camX, p.y - camY, p.size, 0, Math.PI * 2);

        ctx.fill();

      });



      drawTreeOfLifeCanopyAndSpores(ctx, camX, camY, time);



      floatingTexts.forEach(ft => {

        ctx.save();

        ctx.font = 'bold 13px Cinzel, serif';

        ctx.textAlign = 'center';

        ctx.fillStyle = ft.color;

        ctx.globalAlpha = Math.max(0, ft.life / ft.maxLife);

        ctx.shadowColor = 'rgba(0,0,0,0.95)';

        ctx.shadowBlur = 4;

        ctx.fillText(ft.text, ft.x - camX, ft.y - camY);

        ctx.restore();

      });



      const activeTint = LIGHTING_MODES[lightingMode].tint;

      if (activeTint) {

        ctx.save();

        ctx.fillStyle = activeTint;

        ctx.fillRect(0, 0, screenWidth, screenHeight);

        ctx.restore();

      }



      renderMinimap();

    }



    function renderMinimap() {

      const mw = minimapCanvas.width;

      const mh = minimapCanvas.height;

      mCtx.clearRect(0, 0, mw, mh);



      mCtx.fillStyle = '#0d190d';

      mCtx.fillRect(0, 0, mw, mh);



      const cx = (TREE_X / WORLD_SIZE) * mw;

      const cy = (TREE_Y / WORLD_SIZE) * mh;

      mCtx.strokeStyle = 'rgba(52, 211, 153, 0.35)';

      mCtx.beginPath();

      mCtx.arc(cx, cy, (SANCTUARY_RADIUS / WORLD_SIZE) * mw, 0, Math.PI * 2);

      mCtx.stroke();



      mCtx.fillStyle = '#facc15';

      mCtx.beginPath();

      mCtx.arc(cx, cy, 5, 0, Math.PI * 2);

      mCtx.fill();



      mCtx.fillStyle = '#34d399';

      remotePlayers.forEach(rp => {

        mCtx.beginPath();

        mCtx.arc((rp.x / WORLD_SIZE) * mw, (rp.y / WORLD_SIZE) * mh, 3, 0, Math.PI * 2);

        mCtx.fill();

      });



      mCtx.fillStyle = '#ffffff';

      mCtx.beginPath();

      mCtx.arc((localPlayer.x / WORLD_SIZE) * mw, (localPlayer.y / WORLD_SIZE) * mh, 3, 0, Math.PI * 2);

      mCtx.fill();

    }



    let lastFrameTime = performance.now();

    let netSyncAccumulator = 0;

    function mainLoop(nowMs) {

      const dt = Math.min((nowMs - lastFrameTime) / 1000, 0.1);

      lastFrameTime = nowMs;

      const elapsedSeconds = nowMs / 1000;



      updateOverworld(dt);

      renderOverworld(elapsedSeconds);



      if (hasSpawned) {

        netSyncAccumulator += dt;

        if (netSyncAccumulator >= (localPlayer.isMoving ? 0.12 : 1.0)) {

          netSyncAccumulator = 0;

          broadcastStatePacket('state');

        }

      }



      requestAnimationFrame(mainLoop);

    }



    requestAnimationFrame(mainLoop);

  </script>

