        spawnCombatText(targetWrapper.ref.x, targetWrapper.ref.y, `-${dmg} PVP`, '#ff2a38');
      } else {
        const en = targetWrapper.ref;
        en.hp -= dmg;
        spawnCombatText(en.x, en.y, `-${dmg}`, color);
        if (en.hp <= 0) {
          const idx = enemies.indexOf(en);
          if (idx !== -1) handleEnemyKilled(en, idx);
        }
      }
    }

