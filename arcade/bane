<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Undercities: Neverwinter Lite - 90s Dark Anime Edition</title>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;800;900&family=Crimson+Pro:ital,wght@0,500;0,700;1,400&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --ink-black: #08060c;
      --cel-gold: #d6a85a;
      --cel-gold-bright: #f4d28c;
      --cel-blood: #a82028;
      --cel-slate: #1c1826;
      --cel-violet: #8b42b8;
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      -webkit-user-select: none;
    }
    body, html {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: var(--ink-black);
      font-family: 'Crimson Pro', 'Georgia', serif;
      color: #e6dac8;
    }
    canvas#gameCanvas {
      display: block;
      width: 100vw;
      height: 100vh;
      background: #0d0a14;
      cursor: crosshair;
    }

    /* Late 90s Anime Cel-Animation CRT Scanline & Film Grain Overlay */
    #crt-overlay {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 90;
      background:
        linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.24) 50%),
        radial-gradient(circle at center, transparent 58%, rgba(5, 3, 8, 0.72) 100%);
      background-size: 100% 3px, 100% 100%;
    }

    /* 90s JRPG / Lodoss Framed Window Styling */
    .anime-window {
      background: linear-gradient(180deg, rgba(28, 23, 38, 0.96) 0%, rgba(12, 10, 18, 0.98) 100%);
      border: 2px solid var(--cel-gold);
      outline: 2px solid #060408;
      box-shadow:
        4px 4px 0px #060408,
        inset 0 0 0 2px #3b2d22,
        inset 0 0 18px rgba(0, 0, 0, 0.85);
      border-radius: 3px;
    }

    /* Character Creation Modal */
    #char-modal {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 50% 35%, rgba(46, 24, 54, 0.94) 0%, rgba(8, 6, 12, 0.99) 85%);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 100;
      padding: 14px;
      overflow-y: auto;
    }
    .char-card {
      width: 100%;
      max-width: 760px;
      padding: 20px 24px;
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 20px;
    }
    @media (max-width: 700px) {
      .char-card {
        grid-template-columns: 1fr;
      }
    }
    .title-banner {
      grid-column: 1 / -1;
      text-align: center;
      border-bottom: 2px solid #4a3723;
      padding-bottom: 10px;
    }
    .title-banner h1 {
      font-family: 'Cinzel', serif;
      font-size: 26px;
      font-weight: 900;
      letter-spacing: 4px;
      text-transform: uppercase;
      color: var(--cel-gold-bright);
      text-shadow: 2px 2px 0 #000, -1px -1px 0 #000, 0 0 14px rgba(214, 168, 90, 0.45);
    }
    .title-banner h2 {
      font-family: 'Cinzel', serif;
      font-size: 11px;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      color: #b89872;
      margin-top: 2px;
    }

    .form-col {
      display: flex;
      flex-direction: column;
      gap: 11px;
    }
    .preview-col {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      background: #0b0811;
      border: 2px solid #4a3723;
      box-shadow: inset 0 0 24px rgba(0,0,0,0.9);
      padding: 12px;
      border-radius: 3px;
    }
    #previewCanvas {
      width: 240px;
      height: 220px;
      background: radial-gradient(circle at 50% 60%, #241730 0%, #09060e 75%);
      border: 1px solid #3c2a1e;
    }
    .lore-box {
      font-size: 13px;
      line-height: 1.35;
      color: #d6c5ad;
      font-style: italic;
      text-align: center;
      padding: 6px 8px;
      background: rgba(18, 14, 24, 0.9);
      border-left: 3px solid var(--cel-gold);
      width: 100%;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    label {
      font-family: 'Cinzel', serif;
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      color: var(--cel-gold);
      letter-spacing: 1px;
      text-shadow: 1px 1px 0 #000;
    }
    input[type="text"], select {
      background: #09070e;
      border: 2px solid #574128;
      color: #f5ebd6;
      padding: 8px 10px;
      border-radius: 2px;
      font-family: 'Crimson Pro', serif;
      font-size: 15px;
      font-weight: 600;
      outline: none;
      box-shadow: inset 2px 2px 0 rgba(0,0,0,0.8);
    }
    input[type="text"]:focus, select:focus {
      border-color: var(--cel-gold-bright);
    }
    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    .swatch-row {
      display: flex;
      gap: 6px;
      margin-top: 2px;
    }
    .swatch {
      width: 22px;
      height: 22px;
      border: 2px solid #000;
      outline: 1px solid #6b5335;
      cursor: pointer;
      transition: transform 0.1s;
    }
    .swatch.active {
      transform: scale(1.2);
      outline: 2px solid var(--cel-gold-bright);
    }

    .btn-spawn {
      grid-column: 1 / -1;
      background: linear-gradient(180deg, #8f1d24 0%, #4d0d12 100%);
      border: 2px solid var(--cel-gold-bright);
      outline: 2px solid #000;
      color: #fff4db;
      padding: 12px;
      font-family: 'Cinzel', serif;
      font-size: 15px;
      font-weight: 900;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      cursor: pointer;
      text-shadow: 2px 2px 0 #000;
      box-shadow: 3px 3px 0 #000;
      transition: transform 0.1s, filter 0.15s;
    }
    .btn-spawn:hover {
      filter: brightness(1.18);
    }
    .btn-spawn:active {
      transform: translate(2px, 2px);
      box-shadow: 1px 1px 0 #000;
    }

    /* HUD Overlay */
    #hud {
      position: absolute;
      inset: 0;
      pointer-events: none;
      display: none;
      z-index: 50;
    }
    .interactive {
      pointer-events: auto;
    }

    /* Top Shard Bar */
    .top-bar {
      position: absolute;
      top: 12px;
      left: 12px;
      right: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }
    .panel {
      padding: 6px 12px;
      font-size: 13px;
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: 'Cinzel', serif;
    }
    .action-btn {
      background: #2b1824;
      border: 1px solid var(--cel-gold);
      color: var(--cel-gold-bright);
      padding: 4px 10px;
      font-family: 'Cinzel', serif;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1px;
      cursor: pointer;
      text-transform: uppercase;
      box-shadow: 2px 2px 0 #000;
    }
    .action-btn:hover {
      background: #47243b;
    }

    /* Player Vitals Bar (Top Left) */
    .vitals-box {
      position: absolute;
      top: 56px;
      left: 12px;
      padding: 10px 14px;
      width: 245px;
      font-size: 12px;
    }
    .bar-container {
      width: 100%;
      height: 11px;
      background: #09060d;
      border: 2px solid #000;
      outline: 1px solid #59432a;
      margin-top: 3px;
      overflow: hidden;
    }
    .bar-fill {
      height: 100%;
      width: 100%;
      transition: width 0.12s linear;
    }
    #hp-fill { background: linear-gradient(180deg, #e03c3c 0%, #851616 100%); }
    #mana-fill { background: linear-gradient(180deg, #479be8 0%, #1b4985 100%); }

    /* Action Hotbar */
    .hotbar {
      position: absolute;
      bottom: 16px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 10px;
    }
    .hotkey-slot {
      width: 58px;
      height: 58px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      position: relative;
      transition: transform 0.08s;
    }
    .hotkey-slot:hover {
      border-color: var(--cel-gold-bright);
    }
    .hotkey-slot:active {
      transform: translate(2px, 2px);
    }
    .hotkey-num {
      position: absolute;
      top: 2px;
      left: 5px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      font-weight: 700;
      color: var(--cel-gold);
      text-shadow: 1px 1px 0 #000;
    }
    .hotkey-icon {
      font-size: 20px;
      filter: drop-shadow(2px 2px 0 #000);
    }
    .hotkey-label {
      font-family: 'Cinzel', serif;
      font-size: 9px;
      color: #d6c5ad;
      text-transform: uppercase;
      margin-top: 2px;
    }

    /* Chat Frame */
    .chat-container {
      position: absolute;
      bottom: 84px;
      left: 12px;
      width: 340px;
      max-width: calc(100vw - 24px);
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .chat-log {
      height: 115px;
      padding: 8px 10px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 4px;
      font-size: 13px;
    }
    .chat-msg {
      word-break: break-word;
      line-height: 1.25;
      text-shadow: 1px 1px 0 #000;
    }
    .chat-msg .author {
      color: var(--cel-gold-bright);
      font-weight: 700;
      font-family: 'Cinzel', serif;
      margin-right: 5px;
    }
    .chat-input-row {
      display: flex;
      gap: 4px;
    }
    .chat-input {
      flex: 1;
      background: rgba(9, 7, 14, 0.94);
      border: 2px solid #59432a;
      padding: 6px 10px;
      color: #f5ebd6;
      font-size: 13px;
      font-family: 'Crimson Pro', serif;
      outline: none;
    }

    /* Toast Notification */
    #toast {
      position: absolute;
      top: 64px;
      left: 50%;
      transform: translateX(-50%);
      padding: 6px 18px;
      font-family: 'Cinzel', serif;
      font-size: 12px;
      font-weight: 800;
      color: var(--cel-gold-bright);
      letter-spacing: 1.5px;
      display: none;
      z-index: 200;
      text-shadow: 1px 1px 0 #000;
    }
  </style>
</head>
<body>

  <!-- Late 90s Anime Cel Scanline & Vignette Filter -->
  <div id="crt-overlay"></div>

  <!-- Character Creation Screen -->
  <div id="char-modal">
    <div class="char-card anime-window">
      <div class="title-banner">
        <h1>Undercities: Blood & Obsidian</h1>
        <h2>Late-90s Low-Fantasy Underdark Shard MMO</h2>
      </div>

      <!-- Left Column: Controls -->
      <div class="form-col">
        <div class="form-group">
          <label for="char-name">Mercenary / Scion Name</label>
          <input type="text" id="char-name" maxlength="16" placeholder="Enter name..." value="Malakor">
        </div>

        <div class="grid-2">
          <div class="form-group">
            <label for="char-race">Lineage / Sub-Race</label>
            <select id="char-race">
              <optgroup label="Human Bloodlines">
                <option value="Human-Torta">Human (Torta • Heavy Brawler)</option>
                <option value="Human-Edgar">Human (Edgar • Thin Blade Scholar)</option>
                <option value="Human-Standard">Human (Midland Mercenary)</option>
              </optgroup>
              <optgroup label="Abyssal & Underdark">
                <option value="Demon-Succubus">Demon (Nocturne Fiend)</option>
                <option value="Demon-Balor">Demon (Arch-Balor Titan)</option>
                <option value="Drow">Drow (Obsidian High-Elf)</option>
                <option value="Duergar">Duergar (Ash-Beard Dwarf)</option>
              </optgroup>
            </select>
          </div>

          <div class="form-group">
            <label for="char-class">Martial Calling</label>
            <select id="char-class">
              <option value="Fighter">Black Swordsman (Fighter)</option>
              <option value="Rogue">Shadow Dagger (Rogue)</option>
              <option value="Mage">High Sorcerer (Mage)</option>
              <option value="Healer">Blood Cleric (Healer)</option>
            </select>
          </div>
        </div>

        <div class="grid-2">
          <div class="form-group">
            <label>Cloak & Armor Dye</label>
            <div class="swatch-row" id="armor-swatches"></div>
          </div>
          <div class="form-group">
            <label>Hair / Crest Tint</label>
            <div class="swatch-row" id="hair-swatches"></div>
          </div>
        </div>

        <div class="form-group">
          <label for="hell-name">Your Personal Hell Shard Citadel</label>
          <input type="text" id="hell-name" maxlength="24" value="Eclipse Bastion of Dis">
        </div>
      </div>

      <!-- Right Column: Live 90s Cel-Shaded Sprite Preview -->
      <div class="preview-col">
        <span style="font-family:'Cinzel',serif; font-size:11px; color:#d6a85a; letter-spacing:1.5px;">CEL VISAGE PREVIEW (CLICK TO SLASH)</span>
        <canvas id="previewCanvas" width="240" height="220"></canvas>
        <div class="lore-box" id="race-lore-box">
          "A powerhouse Torta brawler of the lower wards—unstoppable poise and crushing physical bulk."
        </div>
      </div>

      <button id="btn-awaken" class="btn-spawn">⚔️ Enter the Eclipse Shard</button>
    </div>
  </div>

  <!-- Main Game Canvas -->
  <canvas id="gameCanvas"></canvas>

  <!-- HUD Layer -->
  <div id="hud">
    <div class="top-bar">
      <div class="panel anime-window">
        <span style="color:#e03c3c;">◆</span>
        <span id="shard-status">Citadel: Eclipse Bastion</span>
        <span id="player-count" style="color:#d6a85a;">(1 Mercenary)</span>
      </div>
      <div class="panel anime-window interactive">
        <button id="btn-toggle-crt" class="action-btn" title="Toggle 90s CRT Scanlines">📺 CRT: ON</button>
        <button id="btn-copy-invite" class="action-btn">🔗 Invite Friend</button>
        <button id="btn-home-shard" class="action-btn" title="Return to your own Hell Shard">🏰 My Shard</button>
      </div>
    </div>

    <!-- Vitals Bar -->
    <div class="vitals-box anime-window">
      <div style="display:flex; justify-content:space-between; align-items:baseline;">
        <div id="vitals-name" style="font-weight:900; font-size:14px; color:#f4d28c; font-family:'Cinzel',serif;">Malakor</div>
        <span id="vitals-lvl" style="font-family:'JetBrains Mono',monospace; font-size:11px; color:#d6a85a;">LV.1</span>
      </div>
      <div style="font-size:11px; color:#b89872; margin-bottom:5px; font-style:italic;" id="vitals-subtitle">Human-Torta Black Swordsman</div>
      <div style="display:flex; justify-content:space-between; font-size:11px;">
        <span>VITALITY</span><span id="hp-txt" style="font-family:'JetBrains Mono',monospace;">200/200</span>
      </div>
      <div class="bar-container"><div id="hp-fill" class="bar-fill"></div></div>
      <div style="display:flex; justify-content:space-between; font-size:11px; margin-top:5px;">
        <span>OD / ASTRAL</span><span id="mana-txt" style="font-family:'JetBrains Mono',monospace;">50/50</span>
      </div>
      <div class="bar-container"><div id="mana-fill" class="bar-fill"></div></div>
    </div>

    <!-- Chat -->
    <div class="chat-container interactive">
      <div class="chat-log anime-window" id="chat-log">
        <div class="chat-msg" style="color: #d6a85a;"><i>[Chronicle]: Press [TAB] to lock onto the nearest Apostle, [1-4] for techniques, or Click to move & cleave.</i></div>
      </div>
      <div class="chat-input-row">
        <input type="text" id="chat-input" class="chat-input" placeholder="Press Enter to speak..." maxlength="100">
      </div>
    </div>

    <!-- Hotbar -->
    <div class="hotbar interactive">
      <div class="hotkey-slot anime-window" onclick="triggerAbility(1)" title="Heavy Cleave (Key 1)">
        <span class="hotkey-num">1</span>
        <span class="hotkey-icon">🗡️</span>
        <span class="hotkey-label">Cleave</span>
      </div>
      <div class="hotkey-slot anime-window" onclick="triggerAbility(2)" title="Blood Art Nova (Key 2)">
        <span class="hotkey-num">2</span>
        <span class="hotkey-icon">🩸</span>
        <span class="hotkey-label">Eclipse</span>
      </div>
      <div class="hotkey-slot anime-window" onclick="triggerAbility(3)" title="Gale Dash (Key 3)">
        <span class="hotkey-num">3</span>
        <span class="hotkey-icon">💨</span>
        <span class="hotkey-label">Strider</span>
      </div>
      <div class="hotkey-slot anime-window" onclick="triggerAbility(4)" title="Elf Dust Mend (Key 4)">
        <span class="hotkey-num">4</span>
        <span class="hotkey-icon">✨</span>
        <span class="hotkey-label">Mend</span>
      </div>
    </div>
  </div>

  <div id="toast" class="anime-window">Invite link copied!</div>

  <script>
    // --- WORLD & DOMAIN CONFIGURATION ---
    const WORLD_SIZE = 3200;
    const DOMAIN_CORE = { x: 1600, y: 1600, radius: 92 };

    // --- 90s ANIME LOW-FANTASY PALETTES ---
    const ARMOR_PALETTE = ['#7a1c24', '#1d293d', '#233b29', '#422a1d', '#3b1e47', '#26262e'];
    const HAIR_PALETTE  = ['#141218', '#d9d2c5', '#8c2d24', '#c99b42', '#493222', '#4a5c7a'];

    // --- RACE & SUB-RACE ATTRIBUTES & SILHOUETTES ---
    const RACES = {
      'Human-Torta': {
        name: 'Human (Torta)',
        scale: 1.24,
        torsoW: 26,
        torsoH: 22,
        skin: '#e0b18c',
        hpBonus: 75,
        speedMod: 0.94,
        desc: '"A powerhouse Torta brawler of the lower wards—unstoppable poise, wide curves, hoop earrings, and crushing physical strength."'
      },
      'Human-Edgar': {
        name: 'Human (Edgar)',
        scale: 0.96,
        torsoW: 14,
        torsoH: 21,
        skin: '#d9ac86',
        hpBonus: 0,
        speedMod: 1.12,
        desc: '"A lean, sharp-eyed Edgar tactician sporting the iconic straight-cut fringe bowl cut and lethal footwork."'
      },
      'Human-Standard': {
        name: 'Human (Midlander)',
        scale: 1.0,
        torsoW: 18,
        torsoH: 20,
        skin: '#e3bc9a',
        hpBonus: 20,
        speedMod: 1.0,
        desc: '"A battle-scarred Midland mercenary tempered by a hundred subterranean sieges."'
      },
      'Demon-Succubus': {
        name: 'Demon (Nocturne)',
        scale: 1.04,
        torsoW: 17,
        torsoH: 20,
        skin: '#c49fd1',
        hpBonus: 30,
        speedMod: 1.08,
        wings: true,
        horns: 'curved',
        desc: '"Aristocratic fiend of the velvet abyss, bearing bat-like nocturnal wings and lethal grace."'
      },
      'Demon-Balor': {
        name: 'Demon (Arch-Balor)',
        scale: 1.38,
        torsoW: 28,
        torsoH: 24,
        skin: '#9e2a2b',
        hpBonus: 110,
        speedMod: 0.90,
        wings: true,
        horns: 'bull',
        desc: '"Towering horned apostle of the deep pit, wreathed in ancient 90s OVA hellfire."'
      },
      'Drow': {
        name: 'Drow (Obsidian Elf)',
        scale: 0.98,
        torsoW: 16,
        torsoH: 21,
        skin: '#6c688c',
        hpBonus: 15,
        speedMod: 1.07,
        ears: true,
        desc: '"Long-eared subterranean high elf with Record of Lodoss War shoulder pauldrons and silver hair."'
      },
      'Duergar': {
        name: 'Duergar (Ash Dwarf)',
        scale: 0.88,
        torsoW: 23,
        torsoH: 18,
        skin: '#877f85',
        hpBonus: 55,
        speedMod: 0.93,
        beard: true,
        desc: '"Stout iron-forged gray dwarf of the deep magma foundries."'
      }
    };

    const CLASSES = {
      'Fighter': { name: 'Black Swordsman', hp: 150, mana: 45, color: '#c92a2a' },
      'Rogue':   { name: 'Shadow Dagger',   hp: 105, mana: 65, color: '#9c36b5' },
      'Mage':    { name: 'High Sorcerer',   hp: 90,  mana: 120, color: '#3b82f6' },
      'Healer':  { name: 'Blood Cleric',    hp: 115, mana: 95,  color: '#10b981' }
    };

    // --- GAME STATE ---
    let localPlayer = {
      id: 'p-' + Math.random().toString(36).substring(2, 9),
      name: 'Malakor',
      race: 'Human-Torta',
      className: 'Fighter',
      armorColor: ARMOR_PALETTE[0],
      hairColor: HAIR_PALETTE[0],
      domainName: 'Eclipse Bastion of Dis',
      x: DOMAIN_CORE.x + 150,
      y: DOMAIN_CORE.y + 150,
      targetX: null,
      targetY: null,
      facing: 1,
      isMoving: false,
      speed: 220,
      hp: 225,
      maxHp: 225,
      mana: 45,
      maxMana: 45,
      level: 1,
      kills: 0,
      targetEntityId: null,
      swingTimer: 0,
      actionEffect: null,
      actionTimer: 0,
      chatBubble: null,
      chatTimer: 0
    };

    const remotePlayers = new Map();
    const enemies = [];
    const combatTexts = [];
    const slashArcs = [];
    const bloodSparks = [];

    // --- UI SWATCH PICKERS & PREVIEW ---
    function initCreationUI() {
      const armorRow = document.getElementById('armor-swatches');
      ARMOR_PALETTE.forEach((col, i) => {
        const s = document.createElement('div');
        s.className = 'swatch' + (i === 0 ? ' active' : '');
        s.style.backgroundColor = col;
        s.onclick = () => {
          localPlayer.armorColor = col;
          armorRow.querySelectorAll('.swatch').forEach(el => el.classList.remove('active'));
          s.classList.add('active');
        };
        armorRow.appendChild(s);
      });

      const hairRow = document.getElementById('hair-swatches');
      HAIR_PALETTE.forEach((col, i) => {
        const s = document.createElement('div');
