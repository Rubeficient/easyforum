<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Wizardry Inverted: Tartaria Online (Always-On MMORPG)</title>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;800;900&family=Crimson+Pro:ital,wght@0,500;0,700;1,400&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --ink-black: #050407;
      --tartaria-dark: #0b0910;
      --tartaria-gold: #d4af37;
      --tartaria-gold-bright: #f3e5ab;
      --tartaria-blood: #8b0000;
      --tartaria-stone: #25222e;
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      -webkit-user-select: none;
    }
    body, html {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: var(--ink-black);
      font-family: 'Crimson Pro', 'Georgia', serif;
      color: #e2d9c8;
    }
    canvas#gameCanvas {
      display: block;
      width: 100vw;
      height: 100vh;
      background: var(--tartaria-dark);
      cursor: crosshair;
    }

    #crt-overlay {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 90;
      background:
        linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.3) 50%),
        radial-gradient(circle at center, transparent 50%, rgba(3, 2, 5, 0.85) 100%);
      background-size: 100% 3px, 100% 100%;
    }

    .tartaria-window {
      background: linear-gradient(180deg, rgba(18, 15, 24, 0.96) 0%, rgba(8, 7, 12, 0.99) 100%);
      border: 2px solid var(--tartaria-gold);
      outline: 2px solid #020104;
      box-shadow:
        4px 4px 0px #020104,
        inset 0 0 0 2px #2d2216,
        inset 0 0 25px rgba(0, 0, 0, 0.95);
      border-radius: 2px;
    }

    #char-modal {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 50% 30%, rgba(45, 18, 18, 0.95) 0%, rgba(5, 4, 8, 0.99) 85%);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 100;
      padding: 12px;
      overflow-y: auto;
    }
    .char-card {
      width: 100%;
      max-width: 840px;
      padding: 20px 24px;
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 18px;
    }
    @media (max-width: 720px) {
      .char-card { grid-template-columns: 1fr; }
    }
    .title-banner {
      grid-column: 1 / -1;
      text-align: center;
      border-bottom: 2px solid #3d2e1c;
      padding-bottom: 8px;
    }
    .title-banner h1 {
      font-family: 'Cinzel', serif;
      font-size: 23px;
      font-weight: 900;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--tartaria-gold-bright);
      text-shadow: 2px 2px 0 #000, 0 0 16px rgba(139, 0, 0, 0.6);
    }
    .title-banner h2 {
      font-family: 'Cinzel', serif;
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #b8975a;
      margin-top: 3px;
    }

    .form-col {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .preview-col {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      background: #060509;
      border: 2px solid #3d2e1c;
      box-shadow: inset 0 0 25px rgba(0,0,0,0.95);
      padding: 10px;
    }
    #previewCanvas {
      width: 240px;
      height: 210px;
      background: radial-gradient(circle at 50% 65%, #21141b 0%, #050407 75%);
      border: 1px solid #2d2119;
    }
    .lore-box {
      font-size: 12px;
      line-height: 1.35;
      color: #d4c5b2;
      font-style: italic;
      text-align: center;
      padding: 6px 8px;
      background: rgba(12, 10, 16, 0.92);
      border-left: 3px solid var(--tartaria-gold);
      width: 100%;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }
    label {
      font-family: 'Cinzel', serif;
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      color: var(--tartaria-gold);
      letter-spacing: 1px;
      text-shadow: 1px 1px 0 #000;
    }
    input[type="text"], select {
      background: #060509;
      border: 2px solid #3d2d1f;
      color: #f3ebd6;
      padding: 7px 10px;
      border-radius: 2px;
      font-family: 'Crimson Pro', serif;
      font-size: 14px;
      font-weight: 600;
      outline: none;
    }
    input[type="text"]:focus, select:focus {
      border-color: var(--tartaria-gold-bright);
    }
    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    .swatch-row {
      display: flex;
      gap: 6px;
      margin-top: 2px;
    }
    .swatch {
      width: 22px;
      height: 22px;
      border: 2px solid #000;
      outline: 1px solid #574129;
      cursor: pointer;
    }
    .swatch.active {
      transform: scale(1.18);
      outline: 2px solid var(--tartaria-gold-bright);
    }

    .btn-spawn {
      grid-column: 1 / -1;
      background: linear-gradient(180deg, #8b0000 0%, #4a0000 100%);
      border: 2px solid var(--tartaria-gold-bright);
      outline: 2px solid #000;
      color: #fff4db;
      padding: 11px;
      font-family: 'Cinzel', serif;
      font-size: 14px;
      font-weight: 900;
      letter-spacing: 2px;
      text-transform: uppercase;
      cursor: pointer;
      text-shadow: 2px 2px 0 #000;
      box-shadow: 3px 3px 0 #000;
    }
    .btn-spawn:hover { filter: brightness(1.15); }

    /* Inventory Modal (Press I) */
    #inventory-modal {
      position: absolute;
      inset: 0;
      background: rgba(4, 3, 6, 0.85);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 150;
      padding: 16px;
    }
    .inventory-card {
      width: 100%;
      max-width: 600px;
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .inv-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
    }
    .inv-slot {
      height: 64px;
      background: #060509;
      border: 2px solid #3d2d1f;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      text-align: center;
      cursor: pointer;
      position: relative;
    }
    .inv-slot:hover { border-color: var(--tartaria-gold-bright); }
    .inv-slot strong { font-family: 'Cinzel', serif; color: var(--tartaria-gold-bright); font-size: 10px; }

    #hud {
      position: absolute;
      inset: 0;
      pointer-events: none;
      display: none;
      z-index: 50;
    }
    .interactive { pointer-events: auto; }

    .top-bar {
      position: absolute;
      top: 10px;
      left: 12px;
      right: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }
    .panel {
      padding: 6px 12px;
      font-size: 11.5px;
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: 'Cinzel', serif;
    }
    .action-btn {
      background: #1a141b;
      border: 1px solid var(--tartaria-gold);
      color: var(--tartaria-gold-bright);
      padding: 4px 9px;
      font-family: 'Cinzel', serif;
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: 1px;
      cursor: pointer;
      text-transform: uppercase;
      box-shadow: 2px 2px 0 #000;
    }
    .action-btn:hover { background: #2d221f; }

    .vitals-box {
      position: absolute;
      top: 52px;
      left: 12px;
      padding: 10px 14px;
      width: 265px;
      font-size: 11.5px;
    }
    .bar-container {
      width: 100%;
      height: 10px;
      background: #060509;
      border: 2px solid #000;
      outline: 1px solid #3d2d1f;
      margin-top: 2px;
      overflow: hidden;
    }
    .bar-fill {
      height: 100%;
      width: 100%;
      transition: width 0.12s linear;
    }
    #hp-fill { background: linear-gradient(180deg, #c0392b 0%, #781c14 100%); }
    #mana-fill { background: linear-gradient(180deg, #2980b9 0%, #154360 100%); }
    #xp-fill { background: linear-gradient(180deg, #f3e5ab 0%, #b8975a 100%); }

    .hotbar {
      position: absolute;
      bottom: 14px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      max-width: 90vw;
      justify-content: center;
    }
    .hotkey-slot {
      width: 56px;
      height: 56px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      position: relative;
    }
    .hotkey-slot:hover { border-color: var(--tartaria-gold-bright); }
    .hotkey-num {
      position: absolute;
      top: 2px;
      left: 4px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 9.5px;
      font-weight: 700;
      color: var(--tartaria-gold);
    }
    .hotkey-icon { font-size: 17px; }
    .hotkey-label {
      font-family: 'Cinzel', serif;
      font-size: 7.5px;
      color: #dfd0ba;
      text-transform: uppercase;
      margin-top: 2px;
    }

    .chat-container {
      position: absolute;
      bottom: 82px;
      left: 12px;
      width: 340px;
      max-width: calc(100vw - 24px);
      display: flex;
      flex-direction: column;
      gap: 5px;
    }
    .chat-log {
      height: 115px;
      padding: 8px 10px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 4px;
      font-size: 12.5px;
    }
    .chat-msg {
      word-break: break-word;
      line-height: 1.25;
      text-shadow: 1px 1px 0 #000;
    }
    .chat-msg .author {
      color: var(--tartaria-gold-bright);
      font-weight: 700;
      font-family: 'Cinzel', serif;
      margin-right: 5px;
    }
    .chat-input-row { display: flex; gap: 4px; }
    .chat-input {
      flex: 1;
      background: rgba(6, 5, 9, 0.94);
      border: 2px solid #3d2d1f;
      padding: 6px 10px;
      color: #f3ebd6;
      font-size: 13px;
      font-family: 'Crimson Pro', serif;
      outline: none;
    }

    #toast {
      position: absolute;
      top: 58px;
      left: 50%;
      transform: translateX(-50%);
      padding: 6px 18px;
      font-family: 'Cinzel', serif;
      font-size: 12px;
      font-weight: 800;
      color: var(--tartaria-gold-bright);
      letter-spacing: 1.5px;
      display: none;
      z-index: 200;
      text-shadow: 1px 1px 0 #000;
    }
  </style>
</head>
<body>

  <div id="crt-overlay"></div>

  <div id="char-modal">
    <div class="char-card tartaria-window">
      <div class="title-banner">
        <h1>Tartaria Online: The Undeworld</h1>
        <h2>Always-On MMORPG • Full-Loot PvP • Central Firepit Safezone</h2>
      </div>

      <div class="form-col">
        <div class="form-group">
          <label for="char-name">Denizen Name</label>
          <input type="text" id="char-name" maxlength="16" value="Xalthor">
        </div>

        <div class="grid-2">
          <div class="form-group">
            <label for="char-race">Non-Human Race</label>
            <select id="char-race"></select>
          </div>
          <div class="form-group">
            <label for="char-subrace">Bloodline / Sub-Race</label>
            <select id="char-subrace"></select>
          </div>
        </div>

        <div class="grid-2">
          <div class="form-group">
            <label for="char-class">Core Calling (Lv.1)</label>
            <select id="char-class">
              <option value="Fighter">Fighter (Lv.3 -> Warrior)</option>
              <option value="Rogue">Rogue (Lv.3 -> Thief)</option>
              <option value="Mage">Mage (Lv.3 -> Wizard)</option>
              <option value="Cleric">Cleric (Lv.3 -> Priest)</option>
            </select>
          </div>
          <div class="form-group">
            <label>Progression Path</label>
            <input type="text" id="path-preview" readonly value="Lv.3 Specialist -> Lv.6 Prestige Set" style="color:#d4af37; font-size:12px;">
          </div>
        </div>

        <div class="grid-2">
          <div class="form-group">
            <label>Garb & Armor Tint</label>
            <div class="swatch-row" id="armor-swatches"></div>
          </div>
          <div class="form-group">
            <label>Crest / Aura Tint</label>
            <div class="swatch-row" id="hair-swatches"></div>
          </div>
        </div>
      </div>

      <div class="preview-col">
        <span style="font-family:'Cinzel',serif; font-size:10px; color:#d4af37; letter-spacing:1px;">TARTARIA DENIZEN VISAGE</span>
        <canvas id="previewCanvas" width="240" height="210"></canvas>
        <div class="lore-box" id="race-lore-box"></div>
      </div>

      <button id="btn-awaken" class="btn-spawn">⚔️ Enter Tartaria Central Server</button>
    </div>
  </div>

  <div id="inventory-modal">
    <div class="inventory-card tartaria-window">
      <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #3d2d1f; padding-bottom:6px;">
        <h2 style="font-family:'Cinzel',serif; color:#f3e5ab; font-size:16px;">Denizen Inventory & Equipment [I]</h2>
        <span style="font-size:11px; color:#b8975a;" id="inv-gold-display">Gold: 150g</span>
      </div>
      <div style="font-family:'Cinzel',serif; font-size:11px; color:#d4af37;">Equipped Gear:</div>
      <div style="display:flex; gap:8px;" id="equipped-row">
        <div class="inv-slot"><strong>Weapon</strong><span id="eq-weapon">None</span></div>
        <div class="inv-slot"><strong>Armor</strong><span id="eq-armor">Garb</span></div>
        <div class="inv-slot"><strong>Relic</strong><span id="eq-relic">None</span></div>
      </div>
      <div style="font-family:'Cinzel',serif; font-size:11px; color:#d4af37; margin-top:4px;">Backpack Satchel (Full Loot on PvP Death):</div>
      <div class="inv-grid" id="backpack-grid"></div>
      <button class="action-btn" onclick="document.getElementById('inventory-modal').style.display='none'" style="padding:6px; text-align:center;">Close Satchel</button>
    </div>
  </div>

  <canvas id="gameCanvas"></canvas>

  <div id="hud">
    <div class="top-bar">
      <div class="panel tartaria-window">
        <span style="color:#8b0000;">🛡️</span>
        <span id="shard-status">Central Firepit (Safezone)</span>
        <span id="pvp-zone-status" style="color:#22c55e;">[SAFEZONE ACTIVE]</span>
      </div>
      <div class="panel tartaria-window interactive">
        <button id="btn-toggle-inv" class="action-btn">🎒 Inventory [I]</button>
        <button id="btn-toggle-crt" class="action-btn">📺 CRT: ON</button>
        <button id="btn-copy-invite" class="action-btn">🔗 Copy Server Link</button>
      </div>
    </div>

    <div class="vitals-box tartaria-window">
      <div style="display:flex; justify-content:space-between; align-items:baseline;">
        <div id="vitals-name" style="font-weight:900; font-size:14px; color:#f3e5ab; font-family:'Cinzel',serif;">Denizen</div>
        <span id="vitals-lvl" style="font-family:'JetBrains Mono',monospace; font-size:11px; color:#d4af37;">LV.1</span>
      </div>
      <div style="font-size:11px; color:#c99e67; margin-bottom:2px; font-weight:bold;" id="vitals-race">Halfling • Kobold</div>
      <div style="font-size:11px; color:#a89984; margin-bottom:5px; font-style:italic;" id="vitals-class">Core Fighter</div>

      <div style="display:flex; justify-content:space-between; font-size:10.5px;">
        <span>CORPOREAL HP</span><span id="hp-txt" style="font-family:'JetBrains Mono',monospace;">200/200</span>
      </div>
      <div class="bar-container"><div id="hp-fill" class="bar-fill"></div></div>

      <div style="display:flex; justify-content:space-between; font-size:10.5px; margin-top:4px;">
        <span>SPELL MP</span><span id="mana-txt" style="font-family:'JetBrains Mono',monospace;">50/50</span>
      </div>
      <div class="bar-container"><div id="mana-fill" class="bar-fill"></div></div>

      <div style="display:flex; justify-content:space-between; font-size:10.5px; margin-top:4px;">
        <span>SOUL XP</span><span id="xp-txt" style="font-family:'JetBrains Mono',monospace;">0/100</span>
      </div>
      <div class="bar-container"><div id="xp-fill" class="bar-fill" style="width:0%;"></div></div>
    </div>

    <div class="chat-container interactive">
      <div class="chat-log tartaria-window" id="chat-log">
        <div class="chat-msg" style="color: #f3e5ab;"><i>[Tartaria Oracle]: Welcome to the Central Server. The Central Firepit is a safezone. Step outside into the North, South, East, or West Halls for Full-Loot PvP and dungeon crawling! Press [I] for inventory.</i></div>
      </div>
      <div class="chat-input-row">
        <input type="text" id="chat-input" class="chat-input" placeholder="Type message or press Enter..." maxlength="100">
      </div>
    </div>

    <div class="hotbar interactive">
      <div class="hotkey-slot tartaria-window" onclick="triggerAbility(1)" title="Weapon Strike (Key 1)">
        <span class="hotkey-num">1</span>
        <span class="hotkey-icon">⚔️</span>
        <span class="hotkey-label">Strike</span>
      </div>
      <div class="hotkey-slot tartaria-window" onclick="triggerAbility(2)" title="MAHALITO (Key 2)">
        <span class="hotkey-num">2</span>
        <span class="hotkey-icon">🔥</span>
        <span class="hotkey-label">Mahalito</span>
      </div>
      <div class="hotkey-slot tartaria-window" onclick="triggerAbility(3)" title="PORFIC (Key 3)">
        <span class="hotkey-num">3</span>
        <span class="hotkey-icon">💨</span>
        <span class="hotkey-label">Porfic</span>
      </div>
      <div class="hotkey-slot tartaria-window" onclick="triggerAbility(4)" title="MADI (Key 4)">
        <span class="hotkey-num">4</span>
        <span class="hotkey-icon">✨</span>
        <span class="hotkey-label">Madi</span>
      </div>
    </div>
  </div>

  <div id="toast" class="tartaria-window">Notice</div>

  <script>
    // --- PERSISTENT MMORPG CONFIGURATION ---
    const WORLD_SIZE = 3600;
    const FIREPIT_POS = { x: 1800, y: 1800, radius: 90, safeRadius: 360 };

    // --- 5 CONNECTED TARTARIA ROOMS / HALLS ---
    const ROOMS = [
      { id: 'center', name: 'Central Firepit Sanctum', x: 1800, y: 1800, w: 1000, h: 1000, safe: true },
      { id: 'north',  name: 'North Catacomb Hall',      x: 1800, y: 700,  w: 900,  h: 800,  safe: false },
      { id: 'south',  name: 'South Ossuary Vault',      x: 1800, y: 2900, w: 900,  h: 800,  safe: false },
