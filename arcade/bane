<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Wizardry Inverted: The Maelstrom Firepit (OVA Edition)</title>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;800;900&family=Crimson+Pro:ital,wght@0,500;0,700;1,400&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --ink-black: #070609;
      --ova-slate: #16141c;
      --ova-amber: #d99b43;
      --ova-amber-bright: #f7c978;
      --ova-blood: #a82424;
      --ova-fire: #e85d24;
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      -webkit-user-select: none;
    }
    body, html {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: var(--ink-black);
      font-family: 'Crimson Pro', 'Georgia', serif;
      color: #e6dac8;
    }
    canvas#gameCanvas {
      display: block;
      width: 100vw;
      height: 100vh;
      background: #0b090e;
      cursor: crosshair;
    }

    #crt-overlay {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 90;
      background:
        linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%),
        radial-gradient(circle at center, transparent 55%, rgba(4, 3, 6, 0.78) 100%);
      background-size: 100% 3px, 100% 100%;
    }

    .ova-window {
      background: linear-gradient(180deg, rgba(24, 21, 32, 0.96) 0%, rgba(10, 9, 14, 0.98) 100%);
      border: 2px solid var(--ova-amber);
      outline: 2px solid #040307;
      box-shadow:
        4px 4px 0px #040307,
        inset 0 0 0 2px #3d2c19,
        inset 0 0 20px rgba(0, 0, 0, 0.9);
      border-radius: 2px;
    }

    #char-modal {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 50% 30%, rgba(48, 28, 22, 0.94) 0%, rgba(7, 6, 9, 0.99) 85%);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 100;
      padding: 12px;
      overflow-y: auto;
    }
    .char-card {
      width: 100%;
      max-width: 820px;
      padding: 18px 22px;
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 18px;
    }
    @media (max-width: 720px) {
      .char-card { grid-template-columns: 1fr; }
    }
    .title-banner {
      grid-column: 1 / -1;
      text-align: center;
      border-bottom: 2px solid #4a3520;
      padding-bottom: 8px;
    }
    .title-banner h1 {
      font-family: 'Cinzel', serif;
      font-size: 24px;
      font-weight: 900;
      letter-spacing: 3.5px;
      text-transform: uppercase;
      color: var(--ova-amber-bright);
      text-shadow: 2px 2px 0 #000, 0 0 14px rgba(232, 93, 36, 0.5);
    }
    .title-banner h2 {
      font-family: 'Cinzel', serif;
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #c98a5b;
      margin-top: 2px;
    }

    .form-col {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .preview-col {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      background: #09080d;
      border: 2px solid #4a3520;
      box-shadow: inset 0 0 24px rgba(0,0,0,0.95);
      padding: 10px;
    }
    #previewCanvas {
      width: 240px;
      height: 210px;
      background: radial-gradient(circle at 50% 65%, #2b1d18 0%, #07060a 75%);
      border: 1px solid #3c2a1e;
    }
    .lore-box {
      font-size: 12.5px;
      line-height: 1.35;
      color: #dfd0ba;
      font-style: italic;
      text-align: center;
      padding: 6px 8px;
      background: rgba(16, 14, 22, 0.92);
      border-left: 3px solid var(--ova-amber);
      width: 100%;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }
    label {
      font-family: 'Cinzel', serif;
      font-size: 10.5px;
      font-weight: 800;
      text-transform: uppercase;
      color: var(--ova-amber);
      letter-spacing: 1px;
      text-shadow: 1px 1px 0 #000;
    }
    input[type="text"], select {
      background: #08070c;
      border: 2px solid #573f26;
      color: #f5ebd6;
      padding: 7px 10px;
      border-radius: 2px;
      font-family: 'Crimson Pro', serif;
      font-size: 14.5px;
      font-weight: 600;
      outline: none;
    }
    input[type="text"]:focus, select:focus {
      border-color: var(--ova-amber-bright);
    }
    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    .swatch-row {
      display: flex;
      gap: 6px;
      margin-top: 2px;
    }
    .swatch {
      width: 22px;
      height: 22px;
      border: 2px solid #000;
      outline: 1px solid #6b5335;
      cursor: pointer;
    }
    .swatch.active {
      transform: scale(1.18);
      outline: 2px solid var(--ova-amber-bright);
    }

    .btn-spawn {
      grid-column: 1 / -1;
      background: linear-gradient(180deg, #9c2a1c 0%, #52110a 100%);
      border: 2px solid var(--ova-amber-bright);
      outline: 2px solid #000;
      color: #fff4db;
      padding: 11px;
      font-family: 'Cinzel', serif;
      font-size: 14px;
      font-weight: 900;
      letter-spacing: 2px;
      text-transform: uppercase;
      cursor: pointer;
      text-shadow: 2px 2px 0 #000;
      box-shadow: 3px 3px 0 #000;
    }
    .btn-spawn:hover { filter: brightness(1.15); }

    #ascension-modal {
      position: absolute;
      inset: 0;
      background: rgba(5, 4, 8, 0.88);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 150;
      padding: 16px;
    }
    .ascend-card {
      width: 100%;
      max-width: 640px;
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .choice-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      max-height: 340px;
      overflow-y: auto;
    }
    .choice-btn {
      background: #121018;
      border: 2px solid #594126;
      color: #f5ebd6;
      padding: 10px;
      text-align: left;
      cursor: pointer;
      font-family: 'Crimson Pro', serif;
    }
    .choice-btn:hover {
      border-color: var(--ova-amber-bright);
      background: #1f1a29;
    }
    .choice-btn strong {
      display: block;
      font-family: 'Cinzel', serif;
      color: var(--ova-amber-bright);
      font-size: 13px;
    }
    .choice-btn span {
      font-size: 12px;
      color: #b8a68e;
    }

    #hud {
      position: absolute;
      inset: 0;
      pointer-events: none;
      display: none;
      z-index: 50;
    }
    .interactive { pointer-events: auto; }

    .top-bar {
      position: absolute;
      top: 10px;
      left: 12px;
      right: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }
    .panel {
      padding: 6px 12px;
      font-size: 12px;
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: 'Cinzel', serif;
    }
    .action-btn {
      background: #261816;
      border: 1px solid var(--ova-amber);
      color: var(--ova-amber-bright);
      padding: 4px 9px;
      font-family: 'Cinzel', serif;
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: 1px;
      cursor: pointer;
      text-transform: uppercase;
      box-shadow: 2px 2px 0 #000;
    }
    .action-btn:hover { background: #3d241f; }

    .vitals-box {
      position: absolute;
      top: 52px;
      left: 12px;
      padding: 10px 14px;
      width: 265px;
      font-size: 11.5px;
    }
    .bar-container {
      width: 100%;
      height: 10px;
      background: #08060c;
      border: 2px solid #000;
      outline: 1px solid #59432a;
      margin-top: 2px;
      overflow: hidden;
    }
    .bar-fill {
      height: 100%;
      width: 100%;
      transition: width 0.12s linear;
    }
    #hp-fill { background: linear-gradient(180deg, #e03c3c 0%, #851616 100%); }
    #mana-fill { background: linear-gradient(180deg, #479be8 0%, #1b4985 100%); }
    #xp-fill { background: linear-gradient(180deg, #f7c978 0%, #b87b28 100%); }

    .hotbar {
      position: absolute;
      bottom: 14px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      max-width: 90vw;
      justify-content: center;
    }
    .hotkey-slot {
      width: 56px;
      height: 56px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      position: relative;
    }
    .hotkey-slot:hover { border-color: var(--ova-amber-bright); }
    .hotkey-num {
      position: absolute;
      top: 2px;
      left: 4px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 9.5px;
      font-weight: 700;
      color: var(--ova-amber);
    }
    .hotkey-icon { font-size: 17px; }
    .hotkey-label {
      font-family: 'Cinzel', serif;
      font-size: 7.5px;
      color: #dfd0ba;
      text-transform: uppercase;
      margin-top: 2px;
    }

    .chat-container {
      position: absolute;
      bottom: 82px;
      left: 12px;
      width: 340px;
      max-width: calc(100vw - 24px);
      display: flex;
      flex-direction: column;
      gap: 5px;
    }
    .chat-log {
      height: 115px;
      padding: 8px 10px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 4px;
      font-size: 12.5px;
    }
    .chat-msg {
      word-break: break-word;
      line-height: 1.25;
      text-shadow: 1px 1px 0 #000;
    }
    .chat-msg .author {
      color: var(--ova-amber-bright);
      font-weight: 700;
      font-family: 'Cinzel', serif;
      margin-right: 5px;
    }
    .chat-input-row { display: flex; gap: 4px; }
    .chat-input {
      flex: 1;
      background: rgba(9, 7, 14, 0.94);
      border: 2px solid #59432a;
      padding: 6px 10px;
      color: #f5ebd6;
      font-size: 13px;
      font-family: 'Crimson Pro', serif;
      outline: none;
    }

    #toast {
      position: absolute;
      top: 58px;
      left: 50%;
      transform: translateX(-50%);
      padding: 6px 18px;
      font-family: 'Cinzel', serif;
      font-size: 12px;
      font-weight: 800;
      color: var(--ova-amber-bright);
      letter-spacing: 1.5px;
      display: none;
      z-index: 200;
      text-shadow: 1px 1px 0 #000;
    }
  </style>
</head>
<body>

  <div id="crt-overlay"></div>

  <div id="char-modal">
    <div class="char-card ova-window">
      <div class="title-banner">
        <h1>Wizardry Inverted: The Firepit</h1>
        <h2>No Humans Allowed • Hunt Naive Adventurers • Regain Your Humanity</h2>
      </div>

      <div class="form-col">
        <div class="form-group">
          <label for="char-name">Underworld Denizen Name</label>
          <input type="text" id="char-name" maxlength="16" value="LaLa Moo-Moo">
        </div>

        <div class="grid-2">
          <div class="form-group">
            <label for="char-race">Non-Human Race</label>
            <select id="char-race"></select>
          </div>
          <div class="form-group">
            <label for="char-subrace">Bloodline / Sub-Race</label>
            <select id="char-subrace"></select>
          </div>
        </div>

        <div class="grid-2">
          <div class="form-group">
            <label for="char-class">Core Calling (Lv.1)</label>
            <select id="char-class">
              <option value="Fighter">Fighter (Lv.3 -> Warrior)</option>
              <option value="Rogue">Rogue (Lv.3 -> Thief)</option>
              <option value="Mage">Mage (Lv.3 -> Wizard)</option>
              <option value="Cleric">Cleric (Lv.3 -> Priest)</option>
            </select>
          </div>
          <div class="form-group">
            <label>Progression Path Preview</label>
            <input type="text" id="path-preview" readonly value="Lv.3 Specialist/Elite -> Lv.6 Prestige Set" style="color:#d99b43; font-size:12px;">
          </div>
        </div>

        <div class="grid-2">
          <div class="form-group">
            <label>Garb & Armor Tint</label>
            <div class="swatch-row" id="armor-swatches"></div>
          </div>
          <div class="form-group">
            <label>Crest / Mane / Aura Tint</label>
            <div class="swatch-row" id="hair-swatches"></div>
          </div>
        </div>
      </div>

      <div class="preview-col">
        <span style="font-family:'Cinzel',serif; font-size:10.5px; color:#d99b43; letter-spacing:1.5px;">OVA DENIZEN VISAGE (CLICK TO STRIKE)</span>
        <canvas id="previewCanvas" width="240" height="210"></canvas>
        <div class="lore-box" id="race-lore-box"></div>
      </div>

      <button id="btn-awaken" class="btn-spawn">🔥 Awaken at the Underworld Firepit</button>
    </div>
  </div>

  <div id="ascension-modal">
    <div class="ascend-card ova-window">
      <h2 id="ascend-title" style="font-family:'Cinzel',serif; color:#f7c978; text-align:center;">Ascension Awaits</h2>
      <p id="ascend-desc" style="text-align:center; font-size:14px; color:#dfd0ba;"></p>
      <div class="choice-grid" id="ascend-choices"></div>
    </div>
  </div>

  <div id="grimoire-modal" style="display:none; position:absolute; inset:0; background:rgba(5,4,8,0.92); z-index:160; align-items:center; justify-content:center; padding:16px;">
    <div class="ascend-card ova-window" style="max-width:720px;">
      <h2 style="font-family:'Cinzel',serif; color:#f7c978; text-align:center;">Regional Grimoire Customization</h2>
      <p style="text-align:center; font-size:12.5px; color:#dfd0ba;">Configure your equipped incantations & combat powers across your unlocked slots (1 per level up to 9).</p>
      <div id="grimoire-slots-container" style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:8px; max-height:300px; overflow-y:auto; padding:6px;"></div>
      <button class="action-btn" onclick="document.getElementById('grimoire-modal').style.display='none'" style="margin-top:10px; padding:8px; text-align:center;">Save & Close Grimoire</button>
    </div>
  </div>

  <canvas id="gameCanvas"></canvas>

  <div id="hud">
    <div class="top-bar">
      <div class="panel ova-window">
        <span style="color:#e85d24;">🔥</span>
        <span id="shard-status">Labyrinth Floor 7: The Firepit</span>
        <span id="escape-pact" style="color:#f7c978;">Escape Pact: 1/5 Denizens</span>
      </div>
      <div class="panel ova-window interactive">
        <button id="btn-ascend-now" class="action-btn" style="display:none; background:#6b1d1d;">⭐ Ascend Class!</button>
        <button id="btn-toggle-crt" class="action-btn">📺 OVA CRT: ON</button>
        <button id="btn-copy-invite" class="action-btn">🔗 Summon 4 Allies</button>
      </div>
    </div>

    <div class="vitals-box ova-window">
      <div style="display:flex; justify-content:space-between; align-items:baseline;">
        <div id="vitals-name" style="font-weight:900; font-size:14px; color:#f7c978; font-family:'Cinzel',serif;">Denizen</div>
        <span id="vitals-lvl" style="font-family:'JetBrains Mono',monospace; font-size:11px; color:#d99b43;">LV.1</span>
      </div>
      <div style="font-size:11px; color:#c99e67; margin-bottom:2px; font-weight:bold;" id="vitals-race">Legend • Murphy's Ghost</div>
      <div style="font-size:11px; color:#a89984; margin-bottom:5px; font-style:italic;" id="vitals-class">Core Fighter</div>

      <div style="display:flex; justify-content:space-between; font-size:10.5px;">
        <span>CORPOREAL HP</span><span id="hp-txt" style="font-family:'JetBrains Mono',monospace;">200/200</span>
      </div>
      <div class="bar-container"><div id="hp-fill" class="bar-fill"></div></div>

      <div style="display:flex; justify-content:space-between; font-size:10.5px; margin-top:4px;">
        <span>SPELL CHANT MP</span><span id="mana-txt" style="font-family:'JetBrains Mono',monospace;">50/50</span>
      </div>
      <div class="bar-container"><div id="mana-fill" class="bar-fill"></div></div>

      <div style="display:flex; justify-content:space-between; font-size:10.5px; margin-top:4px;">
        <span>HUMANITY SPARKS (XP)</span><span id="xp-txt" style="font-family:'JetBrains Mono',monospace;">0/100</span>
      </div>
      <div class="bar-container"><div id="xp-fill" class="bar-fill" style="width:0%;"></div></div>
    </div>

    <div class="chat-container interactive">
      <div class="chat-log ova-window" id="chat-log">
        <div class="chat-msg" style="color: #f7c978;"><i>[Firepit Loa]: Humans are forbidden here. Slay Naive Surface Adventurers & Loyalist Mobs to reach Lv.3 (Specialist) & Lv.6 (Prestige)! Pool 5 players at the Firepit to escape!</i></div>
      </div>
      <div class="chat-input-row">
        <input type="text" id="chat-input" class="chat-input" placeholder="Press Enter to chant to your pact..." maxlength="100">
      </div>
    </div>

    <div class="hotbar interactive" id="dynamic-hotbar">
      <!-- Generated dynamically (up to 9 slots based on level + spellbook button) -->
    </div>
  </div>

  <div id="toast" class="ova-window">Notice</div>

  <script>
    const WORLD_SIZE = 3200;
    const FIREPIT_POS = { x: 1600, y: 1600, radius: 85, safeRadius: 340 };

    const ARMOR_PALETTE = ['#6e1a1a', '#1d2b3a', '#253826', '#4a321f', '#381e42', '#26262e'];
    const HAIR_PALETTE  = ['#d9d2c5', '#16141c', '#9e2a22', '#d4a243', '#493222', '#528078'];

    const RACE_TREE = {
      'Underworld Legend': {
        desc: 'Iconic named denizens of the Maze of Maelstrom seeking to reclaim a mortal soul.',
        subraces: {
          'Murphys Ghost':   { name: "Murphy's Ghost", scale: 1.18, skin: '#7fa699', hpBonus: 95, speedMod: 0.94, ghost: true, desc: '"The legendary Undead Knight of Floor 1—now tired of being farmed by surface brats."' },
          'Vampire Lord':    { name: 'Vampire Lord',   scale: 1.12, skin: '#c8c2d6', hpBonus: 65, speedMod: 1.08, cape: true, fangs: true, desc: '"Aristocratic ruler of Floor 10 who drains levels and blood from foolish paladins."' },
          'Lack Imp Jester': { name: 'Lack the Imp Jester', scale: 0.92, skin: '#c94a38', hpBonus: 35, speedMod: 1.16, jester: true, horns: true, desc: '"Cackling trickster jester of the deep heart of the Maelstrom."' },
          'Greater Demon':   { name: 'Greater Demon',  scale: 1.34, skin: '#8c2222', hpBonus: 110, speedMod: 0.92, wings: true, horns: true, desc: '"Towering abyssal fiend who rebelled against Werdna to seek mortality."' }
        }
      },
      'Halfling': {
        desc: 'Pint-sized subterranean kin—now encompassing Kobolds, Imps, Goblins, Gnomes, and Deep Orc-kin.',
        subraces: {
          'Kobold': { name: 'Halfling (Kobold)', scale: 0.84, skin: '#a86b3c', hpBonus: 20, speedMod: 1.14, snout: true, ears: true, desc: '"Yipping trap-smith dog-kin of the upper labyrinth."' },
          'Imp':    { name: 'Halfling (Imp)',    scale: 0.82, skin: '#b83232', hpBonus: 15, speedMod: 1.18, wings: true, horns: true, desc: '"Nimble winged firepit imp with a barbed tail."' },
          'Goblin': { name: 'Halfling (Goblin)', scale: 0.86, skin: '#567d46', hpBonus: 30, speedMod: 1.12, ears: true, desc: '"Cutthroat tunnel ambusher armed with jagged steel."' },
          'Gnome':  { name: 'Halfling (Gnome)',  scale: 0.85, skin: '#c9a68a', hpBonus: 25, speedMod: 1.05, beard: true, desc: '"Ascetic subterranean gem-priest folded into the Halfling lineage."' },
          'Orc':    { name: 'Halfling (Deep Orc)', scale: 0.95, skin: '#4f6346', hpBonus: 55, speedMod: 1.02, tusks: true, desc: '"Broad-shouldered pig-faced dungeon vanguard."' }
        }
      },
      'Elf': {
        desc: 'Ancient subterranean and twilight fey who turned their backs on the surface.',
        subraces: {
          'Drow':     { name: 'Elf (Drow)',     scale: 0.98, skin: '#645f82', hpBonus: 20, speedMod: 1.08, ears: true, desc: '"Obsidian-skinned subterranean spellblade."' },
          'Wood Elf': { name: 'Elf (Wildwood)', scale: 0.98, skin: '#cfa882', hpBonus: 25, speedMod: 1.10, ears: true, desc: '"Feral labyrinth stalker lost in the underground groves."' },
          'High Elf': { name: 'Elf (Fallen High)', scale: 1.0, skin: '#e0c6ad', hpBonus: 15, speedMod: 1.06, ears: true, desc: '"Exiled noble house seeking redemption in the Firepit."' },
          'Blood Elf':{ name: 'Elf (Crimson)',  scale: 0.99, skin: '#d99a96', hpBonus: 30, speedMod: 1.07, ears: true, desc: '"Mana-starved siphon mage of the deep catacombs."' }
        }
      },
      'Dwarf': {
        desc: 'Stout subterranean smiths carved from stone, ash, and deep magma.',
        subraces: {
          'Duergar':        { name: 'Dwarf (Duergar)',   scale: 0.88, skin: '#7d7580', hpBonus: 65, speedMod: 0.94, beard: true, desc: '"Ash-bearded gray dwarf of the chains."' },
          'Mountain Dwarf': { name: 'Dwarf (Ironpeak)',  scale: 0.90, skin: '#c99b78', hpBonus: 75, speedMod: 0.92, beard: true, desc: '"Heavily plated tunnel defender."' },
          'Forgeborn':      { name: 'Dwarf (Magma-Kin)', scale: 0.92, skin: '#8c4230', hpBonus: 85, speedMod: 0.90, beard: true, desc: '"Charcoal-skinned smith whose beard smolders with embers."' }
        }
