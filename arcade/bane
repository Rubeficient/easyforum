    // Keys 1-9 Trigger Specials Only
    function triggerSpellSlot(slotIdx) {
      initAudioEngine();
      const unlocked = Math.min(9, localPlayer.level);
      if (slotIdx + 1 > unlocked) {
        showToast(`Special Slot ${slotIdx + 1} unlocks at Level ${slotIdx + 1}!`);
        return;
      }

      const nowSec = performance.now() * 0.001;
      if (nowSec < slotCooldowns[slotIdx]) return;

      const spellId = localPlayer.spellBar[slotIdx] || 'muramasa';
      const sp = GRIMOIRE_SPELLS.find(s => s.id === spellId) || GRIMOIRE_SPELLS[0];

      if (localPlayer.mana < sp.mp) {
        showToast(`Need ${sp.mp} MP for ${sp.name}!`);
        return;
      }

      localPlayer.mana -= sp.mp;
      slotCooldowns[slotIdx] = nowSec + sp.cd;
      slotMaxCooldowns[slotIdx] = sp.cd;
      localPlayer.swingTimer = 18;
      localPlayer.chatBubble = sp.chant;
      localPlayer.chatTimer = 60;

      const baseAngle = getAimAngle();
      localPlayer.aimAngle = baseAngle;
      const totalPower = sp.dmg + localPlayer.dmgBonus;

      if (sp.type === 'heal') {
        playSfx('spell');
        localPlayer.hp = Math.min(localPlayer.maxHp, localPlayer.hp + totalPower);
        spawnSpellVortex(localPlayer.x, localPlayer.y, sp.color, 75);
        spawnCombatText(localPlayer.x, localPlayer.y, `+${totalPower} ${sp.name}`, '#4ade80');
      } else if (sp.type === 'buff') {
        playSfx('spell');
        localPlayer.hp = Math.min(localPlayer.maxHp, localPlayer.hp + sp.dmg);
        localPlayer.speed = 420;
        spawnSpellVortex(localPlayer.x, localPlayer.y, sp.color, 85);
        setTimeout(() => { recalcEquipmentStats(); }, 2500);
        showToast(`${sp.name} Active!`);
      } else if (sp.type === 'dash') {
        playSfx('slash');
        const dashX = localPlayer.x + Math.cos(baseAngle) * 145;
        const dashY = localPlayer.y + Math.sin(baseAngle) * 145;
        resolveDungeonMovement(localPlayer, dashX, dashY, true);
        spawnSlashArc(localPlayer.x, localPlayer.y, localPlayer.facing, sp.color, 85);
        for (let c = 0; c < sp.count; c++) {
          const offset = (c - (sp.count - 1) / 2) * (sp.spread / Math.max(1, sp.count - 1));
          spawnProjectile({
            ownerId: localPlayer.id, isEnemy: false,
            x: localPlayer.x, y: localPlayer.y - 18,
            angle: baseAngle + offset, speed: sp.speed,
            dmg: totalPower, dmgType: sp.dmgType || 'SLASH', color: sp.color, projType: 'kunai', radius: 8
          });
        }
      } else {
        playSfx('spell');
        const count = sp.count || 1;
        for (let c = 0; c < count; c++) {
          const offset = count === 1
            ? 0
            : (sp.type === 'proj_nova'
                ? (c / count) * Math.PI * 2
                : (c - (count - 1) / 2) * (sp.spread / (count - 1)));
          spawnProjectile({
            ownerId: localPlayer.id,
            isEnemy: false,
            x: localPlayer.x + Math.cos(baseAngle + offset) * 18,
            y: localPlayer.y - 18 + Math.sin(baseAngle + offset) * 18,
            angle: baseAngle + offset,
            speed: sp.speed || 580,
            dmg: totalPower,
            dmgType: sp.dmgType || 'ARCANE',
            color: sp.color,
            projType: sp.dmgType === 'PIERCE' ? 'arrow' : (sp.type === 'proj_aoe' ? 'fireball' : 'orb'),
            explosive: sp.type === 'proj_aoe',
            radius: sp.type === 'proj_aoe' ? 12 : 7
          });
        }
      }

      updateVitalsUI();
      broadcastState();
    }

