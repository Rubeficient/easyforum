    // =========================================================================
    // 11. IMPROVED RANGED COMBAT & PROJECTILE ENGINE
    // =========================================================================
    const slotCooldowns = new Array(9).fill(0);
    let mouseScreenX = window.innerWidth / 2;
    let mouseScreenY = window.innerHeight / 2;

    function getAimAngle() {
      // If Auto-Aim is enabled and an enemy is within 480px, aim directly at the locked/nearest threat!
      if (localPlayer.autoAim) {
        let lock = enemies.find(e => e.id === localPlayer.targetEntityId);
        if (!lock) {
          let bestDist = 480;
          enemies.forEach(en => {
            const d = Math.hypot(en.x - localPlayer.x, en.y - localPlayer.y);
            if (d < bestDist) {
              bestDist = d;
              lock = en;
            }
          });
        }
        if (lock) {
          localPlayer.facing = lock.x >= localPlayer.x ? 1 : -1;
          return Math.atan2(lock.y - localPlayer.y, lock.x - localPlayer.x);
        }
      }
      // Otherwise aim directly toward the mouse cursor!
      const camX = localPlayer.x - screenW / 2;
      const camY = localPlayer.y - screenH / 2;
      const worldMouseX = mouseScreenX + camX;
      const worldMouseY = mouseScreenY + camY;
      localPlayer.facing = worldMouseX >= localPlayer.x ? 1 : -1;
      return Math.atan2(worldMouseY - localPlayer.y, worldMouseX - localPlayer.x);
    }

    function spawnProjectile(opts) {
      const pObj = {
        id: 'pj-' + Math.random().toString(36).slice(2, 8),
        ownerId: opts.ownerId,
        isEnemy: !!opts.isEnemy,
        x: opts.x,
        y: opts.y,
        vx: Math.cos(opts.angle) * opts.speed,
        vy: Math.sin(opts.angle) * opts.speed,
        angle: opts.angle,
        dmg: opts.dmg,
        color: opts.color || '#fde047',
        projType: opts.projType || 'arrow',
        explosive: !!opts.explosive,
        radius: opts.radius || 7,
        life: opts.life || 1.35
      };
      projectiles.push(pObj);

      if (opts.ownerId === localPlayer.id) {
        sendPacket({ type: 'proj', id: localPlayer.id, proj: pObj });
      }
    }

    function triggerSpellSlot(slotIdx) {
      initAudioEngine();
      const unlocked = Math.min(9, localPlayer.level);
      if (slotIdx + 1 > unlocked) {
        showToast(`Slot ${slotIdx + 1} unlocks at Level ${slotIdx + 1}!`);
        return;
      }

      const nowSec = performance.now() * 0.001;
      if (nowSec < slotCooldowns[slotIdx]) return;

      const spellId = localPlayer.spellBar[slotIdx] || 'ranged_shot';
      const sp = GRIMOIRE_SPELLS.find(s => s.id === spellId) || GRIMOIRE_SPELLS[0];

      if (localPlayer.mana < sp.mp) {
        showToast(`Need ${sp.mp} MP for ${sp.name}!`);
        return;
      }

      localPlayer.mana -= sp.mp;
      slotCooldowns[slotIdx] = nowSec + sp.cd;
      localPlayer.swingTimer = 15;
      localPlayer.chatBubble = sp.chant;
      localPlayer.chatTimer = 60;

      const subMeta = getSubraceMeta(localPlayer);
      const baseAngle = getAimAngle();
      localPlayer.aimAngle = baseAngle;
      const totalPower = sp.dmg + localPlayer.dmgBonus;

      if (sp.type === 'heal') {
        playSfx('spell');
        localPlayer.hp = Math.min(localPlayer.maxHp, localPlayer.hp + totalPower);
        spawnSpellVortex(localPlayer.x, localPlayer.y, sp.color, 75);
        spawnCombatText(localPlayer.x, localPlayer.y, `+${totalPower} ${sp.name}`, '#4ade80');
      } else if (sp.type === 'buff') {
        playSfx('spell');
        localPlayer.hp = Math.min(localPlayer.maxHp, localPlayer.hp + sp.dmg);
        localPlayer.speed = 420;
        spawnSpellVortex(localPlayer.x, localPlayer.y, sp.color, 85);
        setTimeout(() => { recalcEquipmentStats(); }, 2500);
        showToast(`${sp.name} Active!`);
      } else if (sp.type === 'dash') {
        playSfx('slash');
        const dashX = localPlayer.x + Math.cos(baseAngle) * 145;
        const dashY = localPlayer.y + Math.sin(baseAngle) * 145;
        resolveDungeonMovement(localPlayer, dashX, dashY);
        spawnSlashArc(localPlayer.x, localPlayer.y, localPlayer.facing, sp.color, 85);
        for (let c = 0; c < sp.count; c++) {
          const offset = (c - (sp.count - 1) / 2) * (sp.spread / Math.max(1, sp.count - 1));
          spawnProjectile({
            ownerId: localPlayer.id, isEnemy: false,
            x: localPlayer.x, y: localPlayer.y - 18,
            angle: baseAngle + offset, speed: sp.speed,
            dmg: totalPower, color: sp.color, projType: 'kunai', radius: 8
          });
        }
      } else if (sp.type === 'proj_single' || sp.type === 'proj_fan' || sp.type === 'proj_aoe' || sp.type === 'proj_nova') {
        playSfx(sp.id === 'ranged_shot' || sp.id === 'multishot' ? 'bow' : 'spell');
        const count = sp.count || 1;
        for (let c = 0; c < count; c++) {
          const offset = count === 1
            ? 0
            : (sp.type === 'proj_nova'
                ? (c / count) * Math.PI * 2
                : (c - (count - 1) / 2) * (sp.spread / (count - 1)));
          spawnProjectile({
            ownerId: localPlayer.id,
            isEnemy: false,
            x: localPlayer.x + Math.cos(baseAngle + offset) * 18,
            y: localPlayer.y - 18 + Math.sin(baseAngle + offset) * 18,
            angle: baseAngle + offset,
            speed: sp.speed || 580,
            dmg: totalPower,
            color: sp.id === 'ranged_shot' ? (subMeta.projColor || sp.color) : sp.color,
            projType: sp.id === 'ranged_shot' ? (subMeta.projType || 'arrow') : (sp.type === 'proj_aoe' ? 'fireball' : 'orb'),
            explosive: sp.type === 'proj_aoe',
            radius: sp.type === 'proj_aoe' ? 12 : 7
          });
        }
      }

      updateVitalsUI();
      broadcastState();
    }

