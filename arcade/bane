    const floorPatterns = {};
    function generateProceduralTextures(ctx) {
      const palettes = {
        'stone_slate':   { slab1: '#232a38', slab2: '#171c26', mortar: '#0c0e14', accent: '#3b4963' },
        'stone_dark':    { slab1: '#1e1b29', slab2: '#12101a', mortar: '#09070d', accent: '#352f4a' },
        'stone_crimson': { slab1: '#2b161b', slab2: '#1a0d11', mortar: '#0d0608', accent: '#592029' },
        'stone_violet':  { slab1: '#211a33', slab2: '#120e1c', mortar: '#08060d', accent: '#452f63' },
        'stone_moss':    { slab1: '#19272a', slab2: '#0f1719', mortar: '#070b0c', accent: '#25473a' }
      };
      Object.keys(palettes).forEach(key => {
        const pal = palettes[key];
        const off = document.createElement('canvas');
        off.width = 160; off.height = 160;
        const oCtx = off.getContext('2d');
        oCtx.fillStyle = pal.mortar; oCtx.fillRect(0, 0, 160, 160);
        for (let r = 0; r < 4; r++) {
          for (let c = 0; c < 4; c++) {
            const sx = (c * 40 + (r % 2) * 20) % 160, sy = r * 40;
            oCtx.fillStyle = (r + c) % 2 === 0 ? pal.slab1 : pal.slab2;
            oCtx.fillRect(sx + 2, sy + 2, 36, 36);
            oCtx.strokeStyle = pal.accent; oCtx.lineWidth = 1;
            oCtx.beginPath(); oCtx.moveTo(sx + 2, sy + 37); oCtx.lineTo(sx + 2, sy + 2); oCtx.lineTo(sx + 37, sy + 2); oCtx.stroke();
          }
        }
        floorPatterns[key] = ctx.createPattern(off, 'repeat');
      });
    }

