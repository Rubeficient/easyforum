    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    const keys = {};
    window.addEventListener('keydown', (e) => {
      if (document.activeElement === document.getElementById('chat-input')) {
        if (e.key === 'Enter') sendChat();
        return;
      }
      keys[e.key.toLowerCase()] = true;

      if (['1','2','3','4','5','6','7','8','9'].includes(e.key)) {
        triggerSpellSlot(parseInt(e.key) - 1);
      } else if (e.key.toLowerCase() === 'i') {
        toggleInventory();
      } else if (e.key.toLowerCase() === 'g') {
        toggleGrimoire();
      } else if (e.key.toLowerCase() === 'e') {
        interactWithNearestNpcOrChest();
      } else if (e.key === 'Escape') {
        toggleInventory(false);
        toggleGrimoire(false);
      } else if (e.key === 'Tab') {
        e.preventDefault();
        cycleTabTarget();
      } else if (e.key === 'Enter') {
        document.getElementById('chat-input').focus();
      }
    });

    window.addEventListener('keyup', (e) => {
      keys[e.key.toLowerCase()] = false;
    });

    canvas.addEventListener('mousedown', (e) => {
      initAudioEngine();
      const camX = localPlayer.x - screenW / 2;
      const camY = localPlayer.y - screenH / 2;
      const clickX = e.clientX + camX;
      const clickY = e.clientY + camY;

      // 1. Check if clicking a Loot Chest / Corpse Bag
      for (let i = lootChests.length - 1; i >= 0; i--) {
        const ch = lootChests[i];
        if (Math.hypot(clickX - ch.x, clickY - ch.y) < 34) {
          if (Math.hypot(localPlayer.x - ch.x, localPlayer.y - ch.y) < 110) {
            claimChestLoot(i);
          } else {
            localPlayer.targetX = ch.x;
            localPlayer.targetY = ch.y;
          }
          return;
        }
      }

      // 2. Check if clicking an NPC Denizen
      for (const npc of TARTARIA_NPCS) {
        if (Math.hypot(clickX - npc.x, clickY - npc.y) < 34) {
          appendChat(npc.name, npc.dialog);
          showToast(`${npc.name}: ${npc.dialog}`);
          return;
        }
      }

      // 3. Check if clicking a Hostile Monster
      for (const en of enemies) {
        if (Math.hypot(clickX - en.x, clickY - en.y) < en.radius + 18) {
          localPlayer.targetEntityId = en.id;
          if (Math.hypot(localPlayer.x - en.x, localPlayer.y - en.y) < 105) {
            triggerSpellSlot(0);
          } else {
            localPlayer.targetX = en.x;
            localPlayer.targetY = en.y;
          }
          return;
        }
      }

      // 4. Check if clicking a Remote Player (for Full-Loot PvP targeting)
      for (const rp of remotePlayers.values()) {
        if (Math.hypot(clickX - rp.x, clickY - rp.y) < 28) {
          localPlayer.targetEntityId = rp.id;
          showToast(`Targeted Denizen: ${rp.name}`);
          return;
        }
      }

      localPlayer.targetX = clickX;
      localPlayer.targetY = clickY;
    });

    function interactWithNearestNpcOrChest() {
      for (let i = lootChests.length - 1; i >= 0; i--) {
        if (Math.hypot(localPlayer.x - lootChests[i].x, localPlayer.y - lootChests[i].y) < 110) {
          claimChestLoot(i);
          return;
        }
      }
      for (const npc of TARTARIA_NPCS) {
        if (Math.hypot(localPlayer.x - npc.x, localPlayer.y - npc.y) < 120) {
          appendChat(npc.name, npc.dialog);
          showToast(`${npc.name}: ${npc.dialog}`);
          return;
        }
      }
    }

    function claimChestLoot(idx) {
      const ch = lootChests[idx];
      if (!ch) return;
      lootChests.splice(idx, 1);
      playSfx('loot');
      localPlayer.gold += ch.gold || 30;
      if (ch.item) {
        if (localPlayer.backpack.length < 8) {
          localPlayer.backpack.push({ ...ch.item });
          showToast(`Looted ${ch.item.name} & ${ch.gold}g! Press [I] to equip.`);
        } else {
          showToast(`Looted ${ch.gold}g! (Backpack full for ${ch.item.name})`);
        }
      }
      savePersistentProgress();
      updateVitalsUI();
    }

    function cycleTabTarget() {
      const candidates = [
        ...enemies.map(e => ({ id: e.id, name: e.name, x: e.x, y: e.y })),
        ...Array.from(remotePlayers.values()).map(p => ({ id: p.id, name: p.name, x: p.x, y: p.y }))
      ];
      if (candidates.length === 0) return;
      candidates.sort((a, b) =>
        Math.hypot(a.x - localPlayer.x, a.y - localPlayer.y) - Math.hypot(b.x - localPlayer.x, b.y - localPlayer.y)
      );
      const curIdx = candidates.findIndex(c => c.id === localPlayer.targetEntityId);
      const next = candidates[(curIdx + 1) % candidates.length];
      localPlayer.targetEntityId = next.id;
      showToast(`Targeted: ${next.name}`);
    }

    // =========================================================================
    // 16. 1991 WIZARDRY OVA + SOULS-GOTHIC CEL CHARACTER & WORLD RENDERER
    // =========================================================================
    function drawOVACharacter(ctx, p, cx, cy, timeSec, scaleOverride = 1.0, isTargeted = false) {
      const subMeta = getSubraceMeta(p);
      const sc = subMeta.scale * scaleOverride;
      const facing = p.facing || 1;
      const isMoving = p.isMoving;
      const walkBob = isMoving ? Math.abs(Math.sin(timeSec * 11)) * -4.5 : Math.sin(timeSec * 2.8) * 1.5;
      const stride = isMoving ? Math.sin(timeSec * 11) * 6 : 0;

      ctx.save();
      ctx.translate(cx, cy);

      if (isTargeted) {
        ctx.strokeStyle = '#ff2a38';
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        ctx.ellipse(0, 4, 28 * sc, 13 * sc, 0, 0, Math.PI * 2);
        ctx.stroke();
      }

      ctx.fillStyle = 'rgba(0, 0, 0, 0.75)';
      ctx.beginPath();
      ctx.ellipse(0, 5, 19 * sc, 8.5 * sc, 0, 0, Math.PI * 2);
      ctx.fill();

      ctx.save();
      ctx.scale(facing * sc, sc);
      ctx.translate(0, walkBob);
      ctx.lineJoin = 'round';
      ctx.lineCap = 'round';

      if (subMeta.wings) {
        const flap = Math.sin(timeSec * 6) * 4;
        ctx.fillStyle = '#4a0808';
        ctx.strokeStyle = '#040306';
        ctx.lineWidth = 2.2;
        ctx.beginPath();
        ctx.moveTo(-4, -24);
        ctx.lineTo(-30, -42 + flap);
        ctx.lineTo(-24, -15);
        ctx.closePath();
        ctx.fill(); ctx.stroke();
      }

      const cloakWave = Math.sin(timeSec * 5 + (isMoving ? 2 : 0)) * (isMoving ? 7 : 2.5);
      ctx.fillStyle = p.armorColor || '#7c0a0a';
      ctx.strokeStyle = '#040306';
      ctx.lineWidth = 2.4;
      ctx.beginPath();
      ctx.moveTo(-9, -30);
      ctx.lineTo(9, -30);
      ctx.lineTo(13 - cloakWave, 2);
      ctx.lineTo(-14 - cloakWave, 3);
      ctx.closePath();
      ctx.fill(); ctx.stroke();

      ctx.fillStyle = '#17141f';
      ctx.strokeStyle = '#040306';
      ctx.lineWidth = 2.2;
      ctx.fillRect(-7 + stride * 0.5, -12, 6, 14);
      ctx.strokeRect(-7 + stride * 0.5, -12, 6, 14);
      ctx.fillRect(2 - stride * 0.5, -12, 6, 14);
      ctx.strokeRect(2 - stride * 0.5, -12, 6, 14);

      ctx.fillStyle = '#282330';
      ctx.strokeStyle = '#040306';
      ctx.lineWidth = 2.4;
      ctx.beginPath();
      ctx.roundRect(-10, -30, 20, 20, 3);
      ctx.fill(); ctx.stroke();

      const headY = -39;
      const headR = 10.5;
      ctx.fillStyle = subMeta.skin;
      ctx.beginPath();
      ctx.arc(0, headY, headR, 0, Math.PI * 2);
      ctx.fill(); ctx.stroke();

      if (subMeta.snout) {
        ctx.fillStyle = subMeta.skin;
        ctx.beginPath();
        ctx.roundRect(4, headY - 2, 10, 7, 2);
        ctx.fill(); ctx.stroke();
      }

      if (subMeta.ears) {
        ctx.fillStyle = subMeta.skin;
        ctx.beginPath();
        ctx.moveTo(-headR + 1, headY - 1);
        ctx.lineTo(-headR - 10, headY - 6);
        ctx.lineTo(-headR + 2, headY + 3);
        ctx.closePath();
        ctx.fill(); ctx.stroke();
      } else if (subMeta.catEars) {
        ctx.fillStyle = subMeta.skin;
        ctx.beginPath();
        ctx.moveTo(-8, headY - 7); ctx.lineTo(-10, headY - 17); ctx.lineTo(-2, headY - 9); ctx.closePath();
        ctx.moveTo(2, headY - 9);  ctx.lineTo(9, headY - 17);  ctx.lineTo(8, headY - 7);  ctx.closePath();
        ctx.fill(); ctx.stroke();
      } else if (subMeta.horns) {
        ctx.fillStyle = '#f4dca6';
        ctx.beginPath();
        ctx.moveTo(-5, headY - 7); ctx.lineTo(-15, headY - 22); ctx.lineTo(-1, headY - 9); ctx.closePath();
        ctx.moveTo(5, headY - 7);  ctx.lineTo(15, headY - 22);  ctx.lineTo(1, headY - 9);  ctx.closePath();
        ctx.fill(); ctx.stroke();
      } else {
        ctx.fillStyle = p.hairColor || '#e5dccb';
        ctx.beginPath();
        ctx.moveTo(-11, headY - 3);
        ctx.lineTo(-7, headY - 15);
        ctx.lineTo(0, headY - 11);
        ctx.lineTo(6, headY - 15);
        ctx.lineTo(11, headY - 4);
        ctx.closePath();
        ctx.fill(); ctx.stroke();
      }

      ctx.fillStyle = '#ff3838';
      ctx.fillRect(2, headY - 2, 2.5, 2.5);
      ctx.fillRect(6.5, headY - 2, 2.5, 2.5);

      const swingRot = p.swingTimer > 0 ? Math.sin(p.swingTimer * 0.35) * 1.45 : (isMoving ? Math.sin(timeSec * 11) * 0.18 : 0);
      ctx.save();
      ctx.translate(10, -20);
      ctx.rotate(swingRot);

      ctx.fillStyle = '#c89d54';
      ctx.fillRect(-5, -3, 10, 3);
      ctx.fillStyle = '#cbd5e1';
      ctx.strokeStyle = '#040306';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(-3, -3); ctx.lineTo(-2, -38); ctx.lineTo(2, -42); ctx.lineTo(3, -3);
      ctx.closePath();
      ctx.fill(); ctx.stroke();

      ctx.restore();
      ctx.restore();
      ctx.restore();
    }

    const prevCanvas = document.getElementById('previewCanvas');
    const prevCtx = prevCanvas.getContext('2d');
    let previewSwing = 0;
    prevCanvas.addEventListener('mousedown', () => { previewSwing = 20; });

    function updatePreview(now) {
      if (document.getElementById('char-modal').style.display !== 'none') {
        prevCtx.clearRect(0, 0, prevCanvas.width, prevCanvas.height);
        prevCtx.fillStyle = '#140f17';
        prevCtx.strokeStyle = '#040306';
        prevCtx.lineWidth = 2.5;
        prevCtx.beginPath();
        prevCtx.ellipse(120, 168, 54, 15, 0, 0, Math.PI * 2);
        prevCtx.fill(); prevCtx.stroke();

        if (previewSwing > 0) previewSwing--;
        const dummy = {
          raceCategory: document.getElementById('char-race').value,
          subraceKey: document.getElementById('char-subrace').value,
          coreClass: document.getElementById('char-class').value,
          armorColor: localPlayer.armorColor,
          hairColor: localPlayer.hairColor,
          facing: 1,
          isMoving: false,
          swingTimer: previewSwing
        };
        drawOVACharacter(prevCtx, dummy, 120, 160, now * 0.001, 1.55, false);
      }
    }

    // =========================================================================
    // 17. CHAT, HUD BUTTONS & AWAKEN HANDLER
    // =========================================================================
    function sendChat() {
      const input = document.getElementById('chat-input');
      const val = input.value.trim();
      if (!val) { input.blur(); return; }
      appendChat(localPlayer.name, val);
      localPlayer.chatBubble = val;
      localPlayer.chatTimer = 240;
      sendPacket({ type: 'chat', id: localPlayer.id, sender: localPlayer.name, text: val });
      broadcastState();
      input.value = '';
      input.blur();
    }

    function appendChat(author, text) {
      const log = document.getElementById('chat-log');
      const div = document.createElement('div');
      div.className = 'chat-msg';
      div.innerHTML = `<span class="author">${escapeHtml(author)}:</span><span>${escapeHtml(text)}</span>`;
      log.appendChild(div);
      log.scrollTop = log.scrollHeight;
    }

    function escapeHtml(str) {
      return String(str).replace(/[&<>"']/g, m => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
      }[m]));
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.textContent = msg;
      toast.style.display = 'block';
      clearTimeout(window._tTimer);
      window._tTimer = setTimeout(() => { toast.style.display = 'none'; }, 2800);
    }

