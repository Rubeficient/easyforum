      const item = localPlayer.backpack[idx];
      if (!item) return;
      const targetSlot = item.slot || 'weapon';
      const prevEquipped = localPlayer.equipped[targetSlot];
      localPlayer.equipped[targetSlot] = item;
      if (prevEquipped) {
        localPlayer.backpack[idx] = prevEquipped;
