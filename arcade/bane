    function createMultiItemChest(x, y, label, tier = 1, isCorpse = false) {
      const count = 2 + Math.floor(Math.random() * 2);
      const items = [];
      for (let i = 0; i < count; i++) {
        const base = LOOT_TABLE[Math.floor(Math.random() * LOOT_TABLE.length)];
        items.push({
          ...base,
          atk: base.atk + (tier - 1) * 4,
          identified: Math.random() < 0.35 // 65% of chest items require Wizardry appraisal!
        });
      }
      return {
        id: 'chest-' + Math.random().toString(36).slice(2, 7),
        x, y, label, isCorpse,
        gold: (45 + Math.floor(Math.random() * 55)) * tier,
        atman: 10 + tier * 5,
        items
      };
    }

