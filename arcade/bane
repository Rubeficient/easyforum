    // =========================================================================
    let activeLootChestIdx = -1;

    function updateNearbyLootInspector() {
      const box = document.getElementById('loot-inspector');
      let bestIdx = -1;
      let bestDist = 135;

      for (let i = 0; i < lootChests.length; i++) {
        const d = Math.hypot(localPlayer.x - lootChests[i].x, localPlayer.y - lootChests[i].y);
        if (d < bestDist) {
          bestDist = d;
          bestIdx = i;
        }
      }

      activeLootChestIdx = bestIdx;
      if (bestIdx === -1) {
        box.style.display = 'none';
        return;
      }

      const ch = lootChests[bestIdx];
      box.style.display = 'flex';
      document.getElementById('loot-box-title').textContent = `🎁 ${ch.label} (${ch.gold || 0}g)`;

      const list = document.getElementById('loot-items-list');
      list.innerHTML = '';

      const items = ch.items || (ch.item ? [ch.item] : []);
      items.forEach((it, itemIdx) => {
        const row = document.createElement('div');
        row.className = 'loot-item-row';
        const displayName = it.unidentified ? `? Unidentified ${it.slot.toUpperCase()}` : it.name;
        const badge = it.dmgType ? `<span class="dmg-badge dmg-${it.dmgType}">${it.dmgType}</span>` : `<span style="color:#4ade80;">+${it.hp}HP</span>`;
        row.innerHTML = `
          <span style="color:${it.unidentified ? '#facc15' : (it.rarityColor || '#f4dca6')}; font-weight:700;">${displayName}</span>
          ${badge}
        `;
        row.onclick = () => claimSingleLootItem(bestIdx, itemIdx);
        list.appendChild(row);
      });
    }

    function claimSingleLootItem(chestIdx, itemIdx) {
      const ch = lootChests[chestIdx];
      if (!ch) return;
      const items = ch.items || (ch.item ? [ch.item] : []);
      const it = items[itemIdx];
      if (!it) return;

      if (localPlayer.backpack.length >= 8) {
        showToast('Backpack Satchel is full! Press [I] to equip or clear space.');
        return;
      }
      it.unidentified = false; // Auto-appraise on selective pickup!
      localPlayer.backpack.push(it);
      items.splice(itemIdx, 1);

      if (ch.gold > 0) {
        localPlayer.gold += ch.gold;
        ch.gold = 0;
      }
      playSfx('loot');
      showToast(`Looted & Appraised: ${it.name}!`);

      if (items.length === 0) {
        lootChests.splice(chestIdx, 1);
      }
      savePersistentProgress();
      updateVitalsUI();
      updateNearbyLootInspector();
    }

    function lootAllNearbyChest() {
      if (activeLootChestIdx === -1 || !lootChests[activeLootChestIdx]) return;
      const ch = lootChests[activeLootChestIdx];
      const items = ch.items || (ch.item ? [ch.item] : []);

      playSfx('loot');
      localPlayer.gold += ch.gold || 0;
      localPlayer.atman = Math.min(localPlayer.maxAtman, localPlayer.atman + 15);

      let picked = 0;
      while (items.length > 0 && localPlayer.backpack.length < 8) {
        const it = items.shift();
        it.unidentified = false;
        localPlayer.backpack.push(it);
        picked++;
      }

      if (items.length === 0) {
        lootChests.splice(activeLootChestIdx, 1);
        showToast(`Looted ${picked} Relics & Gold!`);
      } else {
        showToast(`Looted ${picked} Relics (Backpack Full)!`);
      }
      savePersistentProgress();
      updateVitalsUI();
      updateNearbyLootInspector();
    }

