    function triggerGrimoireSpell(slotIndex, sInfo) {
      if (localPlayer.mana < sInfo.mp) {
        showToast(`Insufficient MP! Needs ${sInfo.mp} MP.`);
        return;
      }
      localPlayer.mana -= sInfo.mp;
      localPlayer.swingTimer = 20;

      const chant = `"${sInfo.name.split(' ')[0]}!!" (${sInfo.icon})`;
      localPlayer.chatBubble = chant;
      localPlayer.chatTimer = 95;

      if (sInfo.id.includes('madi') || sInfo.id.includes('dial') || sInfo.id.includes('mend') || sInfo.id.includes('renew')) {
        const healAmt = 65 + localPlayer.dmgBonus;
        localPlayer.hp = Math.min(localPlayer.maxHp, localPlayer.hp + healAmt);
        spawnSlashArc(localPlayer.x, localPlayer.y, localPlayer.facing, '#10b981', 85);
        spawnCombatText(localPlayer.x, localPlayer.y, `+${healAmt} ${sInfo.id.toUpperCase()}`, '#10b981');
      } else if (sInfo.id.includes('porfic') || sInfo.id.includes('ward') || sInfo.id.includes('cloak')) {
        localPlayer.speed = 420;
        spawnSlashArc(localPlayer.x, localPlayer.y, localPlayer.facing, '#38bdf8', 65);
        setTimeout(() => {
          const sub = getSubraceMeta(localPlayer);
          localPlayer.speed = 225 * sub.speedMod;
        }, 2200);
        showToast(`${sInfo.name} Shield Active!`);
      } else {
        spawnSlashArc(localPlayer.x, localPlayer.y, localPlayer.facing, '#e85d24', 160);
        for (let i = enemies.length - 1; i >= 0; i--) {
          const en = enemies[i];
          if (Math.hypot(en.x - localPlayer.x, en.y - localPlayer.y) < 210) {
            const spellDmg = (sInfo.mp > 25 ? 110 : 55) + localPlayer.dmgBonus;
            en.hp -= spellDmg;
            spawnCombatText(en.x, en.y, `-${spellDmg} ${sInfo.id.toUpperCase()}`, '#f7c978');
            if (en.hp <= 0) handleEnemyDefeat(en, i);
          }
        }
      }

      updateVitalsUI();
      broadcastState();
    }

