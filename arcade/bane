      let rarity = RARITY_TIERS[0];
      if (rRoll > 1.15) rarity = RARITY_TIERS[4];
      else if (rRoll > 0.92) rarity = RARITY_TIERS[3];
      else if (rRoll > 0.65) rarity = RARITY_TIERS[2];
      else if (rRoll > 0.35) rarity = RARITY_TIERS[1];

      const isUnidentified = forceUnidentified || (rarity.mult >= 1.55 && Math.random() < 0.45);
      return {
        uid: 'it-' + Math.random().toString(36).slice(2, 8),
        name: `${rarity.name} ${base.name}`,
        trueName: `${rarity.name} ${base.name}`,
        unidentified: isUnidentified,
        rarityId: rarity.id,
        rarityColor: rarity.color,
        slot: base.slot,
        dmgType: base.dmgType || null,
        range: base.range || 'melee',
        atk: Math.round((base.atk || 0) * rarity.mult),
        hp:  Math.round((base.hp  || 0) * rarity.mult),
        mp:  Math.round((base.mp  || 0) * rarity.mult),
        val: Math.round((base.val || 100) * rarity.mult)
