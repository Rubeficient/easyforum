    function damageTargetsInRadius(cx, cy, radius, dmg, label, color) {
      for (let i = enemies.length - 1; i >= 0; i--) {
        const en = enemies[i];
        if (Math.hypot(en.x - cx, en.y - cy) <= radius) {
          const isCrit = Math.random() < 0.28;
          const finalDmg = isCrit ? Math.round(dmg * 1.45) : dmg;
          en.hp -= finalDmg;
          spawnCombatText(en.x, en.y, isCrit ? `-${finalDmg} KUBI-KIRI!!` : `-${finalDmg} ${label}`, isCrit ? '#84cc16' : color);
          if (en.hp <= 0 || isCrit) {
            if (en.hp <= 0) {
              spawnOvaDecapitation(en.x, en.y, localPlayer.facing);
              handleEnemyKilled(en, i);
            }
          }
        }
      }

      if (!isInsideFirepitSafezone(localPlayer.x, localPlayer.y)) {
        remotePlayers.forEach(rp => {
          if (!isInsideFirepitSafezone(rp.x, rp.y) && Math.hypot(rp.x - cx, rp.y - cy) <= radius) {
            sendPacket({
              type: 'pvp_hit',
              id: localPlayer.id,
              targetId: rp.id,
              attackerName: localPlayer.name,
              dmg: dmg
            });
            spawnCombatText(rp.x, rp.y, `-${dmg} PVP!`, '#ff2a38');
          }
        });
      }
    }

    function applyHitToTarget(targetWrapper, dmg, label, color) {
      if (targetWrapper.isPlayer) {
