<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Undercities: Neverwinter Lite</title>
  <script src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js"></script>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      -webkit-user-select: none;
    }
    body, html {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: #08060a;
      font-family: 'Cinzel', 'Georgia', serif;
      color: #dfd0e5;
    }
    canvas {
      display: block;
      width: 100vw;
      height: 100vh;
      background: #0d0912;
    }

    /* Modal / Character Screen */
    #char-modal {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at center, rgba(14, 10, 20, 0.96) 0%, rgba(4, 3, 6, 0.99) 100%);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 100;
      padding: 16px;
    }
    .char-card {
      background: rgba(12, 10, 18, 0.95);
      border: 2px solid #52345e;
      box-shadow: 0 0 35px rgba(0, 0, 0, 0.9), 0 0 15px rgba(138, 43, 226, 0.25);
      width: 100%;
      max-width: 520px;
      padding: 24px;
      border-radius: 6px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .char-card h1 {
      font-size: 22px;
      letter-spacing: 3px;
      text-transform: uppercase;
      text-align: center;
      color: #b582df;
      border-bottom: 1px solid #33213d;
      padding-bottom: 8px;
    }
    .char-card h2 {
      font-size: 13px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: #8c739e;
      text-align: center;
    }
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    label {
      font-size: 12px;
      text-transform: uppercase;
      color: #ad94bc;
      letter-spacing: 1px;
    }
    input[type="text"], select {
      background: #08060c;
      border: 1px solid #422b4f;
      color: #f1e4f8;
      padding: 8px 12px;
      border-radius: 4px;
      font-family: inherit;
      font-size: 14px;
      outline: none;
    }
    input[type="text"]:focus, select:focus {
      border-color: #a851cf;
      box-shadow: 0 0 8px rgba(168, 81, 207, 0.3);
    }
