    // =========================================================================
    // 14. CHAT, HUD BUTTONS & AWAKEN HANDLER
    // =========================================================================
    function sendChat() {
      const input = document.getElementById('chat-input');
      const val = input.value.trim();
      if (!val) { input.blur(); return; }
      appendChat(localPlayer.name, val);
      localPlayer.chatBubble = val;
      localPlayer.chatTimer = 240;
      sendPacket({ type: 'chat', id: localPlayer.id, sender: localPlayer.name, text: val });
      broadcastState();
      input.value = '';
      input.blur();
    }

    function appendChat(author, text) {
      const log = document.getElementById('chat-log');
      const div = document.createElement('div');
      div.className = 'chat-msg';
      div.innerHTML = `<span class="author">${escapeHtml(author)}:</span><span>${escapeHtml(text)}</span>`;
      log.appendChild(div);
      log.scrollTop = log.scrollHeight;
    }

    function escapeHtml(str) {
      return String(str).replace(/[&<>"']/g, m => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
      }[m]));
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.textContent = msg;
      toast.style.display = 'block';
      clearTimeout(window._tTimer);
      window._tTimer = setTimeout(() => { toast.style.display = 'none'; }, 2800);
    }

    document.getElementById('btn-crt').addEventListener('click', (e) => {
      const crt = document.getElementById('crt-overlay');
      const hidden = crt.style.display === 'none';
      crt.style.display = hidden ? 'block' : 'none';
      e.currentTarget.textContent = hidden ? '📺 CRT: ON' : '📺 CRT: OFF';
    });

