  <script>
    // =========================================================================
    // 1. WIZARDRY + DRAGON WARS + ATMAN LORE AUTO-NAME GENERATOR
    // =========================================================================
    const LORE_NAME_PREFIXES = [
      'Hawkwind', 'Werdna', 'Trebor', 'Halito', 'Kadorto', 'Tiltowait', 'Muramasa', 'Llylgamyn',
      'Lanac\'toor', 'Namis', 'Phoebus', 'Byzan', 'Dilmun', 'Myrrias', 'Ulrik', 'Nergal',
      'Asura', 'Abeshu', 'Seshat', 'Zhad', 'Krita', 'Atman', 'Marduk', 'Shinobi', 'Vaelen'
    ];
    const LORE_NAME_TITLES = [
      'of Dilmun', 'of Zhad', 'the Unaged', 'of Purgatory', 'of Llylgamyn', 'the Krita-Born',
      'of Lanac\'toor', 'the Sun-Scribe', 'of the Maelstrom', 'the Kubi-Kiri', 'of House Ra', ''
    ];

    function generateLoreName() {
      const p = LORE_NAME_PREFIXES[Math.floor(Math.random() * LORE_NAME_PREFIXES.length)];
      const t = LORE_NAME_TITLES[Math.floor(Math.random() * LORE_NAME_TITLES.length)];
      return (t ? `${p} ${t}` : p).slice(0, 18);
    }

    document.getElementById('btn-roll-name').addEventListener('click', () => {
      const newName = generateLoreName();
      document.getElementById('char-name').value = newName;
      localPlayer.name = newName;
    });

    // =========================================================================
    // 2. SEAMLESS PLAYER-MAPPED PROCEDURAL ZONE ENGINE
    // =========================================================================
    const TILE_SIZE = 1000;
    const FIREPIT_POS = { x: 500, y: 500, radius: 62, safeRadius: 390 };

    const worldSectors = new Map();
    const SOLID_PILLARS = [];
    const WALL_TORCHES = [];
    const GATES = [];
    const gateSet = new Set();

    function sectorKey(gx, gy) { return `${gx},${gy}`; }

    function seededHash(gx, gy, salt = 0) {
      let h = Math.imul(gx ^ 0x9e3779b9, 0x85ebca6b) ^ Math.imul(gy ^ 0xc2b2ae35, 0x27d4eb2f) ^ salt;
      h ^= h >>> 16; h = Math.imul(h, 0x85ebca6b); h ^= h >>> 13;
      return (h >>> 0) / 4294967296;
    }

    const SECTOR_ARCHETYPES = [
      { kind: 'catacomb_hall',  floor: 'stone_slate',   titles: ['Narrow Shusi Passageway', 'Hall of the Krita Seeds', 'Dilmun Undercroft Corridor'] },
      { kind: 'pillars_zhad',   floor: 'stone_violet',  titles: ['Pillars of Zhad Chamber', 'Cymatic Resonance Hall', 'Scribe\'s Kush Gallery'] },
      { kind: 'purgatory_pit',  floor: 'stone_crimson', titles: ['Namis Purgatory Arena', 'Byzan Slaver Garrison', 'Quagmire Blood-Vault'] },
      { kind: 'sunken_ruin',    floor: 'stone_moss',    titles: ['Sunken Ruin of Dilmun', 'Phoebus Sun-Dial Vault', 'Maelstrom Ossuary Crossing'] },
      { kind: 'statue_sanctum', floor: 'stone_dark',    titles: ['☠️ Sanctum of Petrified Abeshu', '☠️ Citadel of Lanac\'toor', '☠️ Throne of Fire Giant Surtr', '☠️ Altar of Archmage Werdna'] }
    ];

    function getOrGenerateSector(gx, gy, discovererName = 'House of Ra', broadcastNew = true) {
      const key = sectorKey(gx, gy);
      if (worldSectors.has(key)) return worldSectors.get(key);

      const depth = Math.abs(gx) + Math.abs(gy);
      const wx = gx * TILE_SIZE;
      const wy = gy * TILE_SIZE;
      const cx = wx + TILE_SIZE / 2;
      const cy = wy + TILE_SIZE / 2;

      const rects = [
        { x: wx + 340, y: wy - 90, w: 320, h: TILE_SIZE + 180, isSpine: true },
        { x: wx - 90,  y: wy + 340, w: TILE_SIZE + 180, h: 320, isSpine: true }
      ];

      let sector = null;
      if (gx === 0 && gy === 0) {
        rects.push({ x: wx + 90, y: wy + 90, w: 820, h: 820, isMain: true });
        sector = {
          gx, gy, key, depth: 0,
          name: 'Central Firepit Sanctum (0, 0)',
          kind: 'sanctum_hub', floor: 'stone_slate',
          safe: true, isBossRoom: false, mappedBy: 'Founders of Ra', rects
        };
      } else {
        const rVal = seededHash(gx, gy, 11);
        const isBoss = depth >= 2 && ((Math.abs(gx) + Math.abs(gy)) % 2 === 0 && rVal < 0.65);
        const archIdx = isBoss ? 4 : Math.floor(seededHash(gx, gy, 22) * 4);
        const arch = SECTOR_ARCHETYPES[archIdx];
        const chosenTitle = arch.titles[Math.floor(seededHash(gx, gy, 33) * arch.titles.length)];

        if (arch.kind === 'catacomb_hall') {
          rects.push({ x: wx + 220, y: wy + 220, w: 560, h: 560, isMain: true });
        } else {
          rects.push({ x: wx + 110, y: wy + 110, w: 780, h: 780, isMain: true });
        }

        sector = {
          gx, gy, key, depth,
          name: `${chosenTitle} (${gx}, ${gy})`,
          kind: arch.kind, floor: arch.floor,
          safe: false, isBossRoom: isBoss, mappedBy: discovererName, rects
        };
      }

      worldSectors.set(key, sector);

      const pOffsets = [[-240, -240], [240, -240], [-240, 240], [240, 240]];
      pOffsets.forEach(([ox, oy], idx) => {
        if (sector.kind === 'catacomb_hall' && idx > 1) return;
        SOLID_PILLARS.push({
          x: cx + ox, y: cy + oy,
          r: sector.isBossRoom ? 38 : 30,
          isZhadPillar: sector.kind === 'pillars_zhad'
        });
      });

      WALL_TORCHES.push(
        { x: cx - 175, y: wy + 125 }, { x: cx + 175, y: wy + 125 },
        { x: cx - 175, y: wy + 875 }, { x: cx + 175, y: wy + 875 }
      );

      const borderGates = [
        { id: `gate-n-${gx}-${gy}`,   x: cx,             y: wy,             horiz: true,  gx1: gx, gy1: gy, gx2: gx,   gy2: gy-1, label: `North Gate (${gx},${gy-1})` },
        { id: `gate-s-${gx}-${gy+1}`, x: cx,             y: wy + TILE_SIZE, horiz: true,  gx1: gx, gy1: gy, gx2: gx,   gy2: gy+1, label: `South Gate (${gx},${gy+1})` },
        { id: `gate-w-${gx}-${gy}`,   x: wx,             y: cy,             horiz: false, gx1: gx, gy1: gy, gx2: gx-1, gy2: gy,   label: `West Gate (${gx-1},${gy})` },
        { id: `gate-e-${gx+1}-${gy}`, x: wx + TILE_SIZE, y: cy,             horiz: false, gx1: gx, gy1: gy, gx2: gx+1, gy2: gy,   label: `East Gate (${gx+1},${gy})` }
      ];
      borderGates.forEach(bg => {
        const gKey = `${Math.round(bg.x)},${Math.round(bg.y)}`;
        if (!gateSet.has(gKey)) {
          gateSet.add(gKey);
          GATES.push({ ...bg, isOpen: false, openAnim: 0, manualLock: false });
        }
      });

      if (depth > 0) spawnSectorEntities(sector);

      const mappedEl = document.getElementById('mapped-count-txt');
      if (mappedEl) mappedEl.textContent = `${worldSectors.size} Sectors`;

      if (broadcastNew && depth > 0) {
        triggerSoulsBanner(`NEW SECTOR MAPPED: ${sector.name.toUpperCase()}`);
        appendChat('Cartography Engine', `🗺️ ${discovererName} carved & mapped ${sector.name} [Tier ${depth}]!`);
        sendPacket({ type: 'sector_mapped', id: localPlayer.id, gx, gy, discoverer: discovererName });
      }
      return sector;
    }

