<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Wizardry Inverted: Tartaria Online (4-Player Co-Op/PvP & Boss Edition)</title>
  <script src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;800;900&family=Crimson+Pro:ital,wght@0,500;0,700;1,400&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --ink-black: #040306;
      --tartaria-bg: #07060b;
      --tartaria-gold: #cfa354;
      --tartaria-gold-bright: #f8e2a8;
      --wiz-red: #dc2626;
      --ova-ectoplasm: #84cc16;
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      -webkit-user-select: none;
    }
    body, html {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: var(--ink-black);
      font-family: 'Crimson Pro', 'Georgia', serif;
      color: #e6dcc8;
    }
    canvas#gameCanvas {
      display: block;
      width: 100vw;
      height: 100vh;
      background: var(--tartaria-bg);
      cursor: crosshair;
    }

    #crt-overlay {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 90;
      background:
        linear-gradient(rgba(14, 12, 18, 0) 50%, rgba(0, 0, 0, 0.32) 50%),
        radial-gradient(circle at center, transparent 52%, rgba(2, 1, 5, 0.86) 100%);
      background-size: 100% 3px, 100% 100%;
    }

    .tartaria-window {
      background: linear-gradient(180deg, rgba(20, 18, 29, 0.95) 0%, rgba(8, 7, 13, 0.98) 100%);
      border: 2px solid var(--tartaria-gold);
      outline: 2px solid #000;
      box-shadow:
        4px 4px 0px #000,
        inset 0 0 0 1px #42301b,
        inset 0 0 28px rgba(0, 0, 0, 0.95);
      border-radius: 2px;
    }

    /* Character Creation Modal */
    #char-modal {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 50% 25%, rgba(45, 22, 32, 0.96) 0%, rgba(4, 3, 7, 0.99) 85%);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 100;
      padding: 12px;
      overflow-y: auto;
    }
    .char-card {
      width: 100%;
      max-width: 900px;
      padding: 18px 22px;
      display: grid;
      grid-template-columns: 1.25fr 0.75fr;
      gap: 16px;
    }
    @media (max-width: 740px) {
      .char-card { grid-template-columns: 1fr; }
    }
    .title-banner {
      grid-column: 1 / -1;
      text-align: center;
      border-bottom: 2px solid #3a2818;
      padding-bottom: 10px;
    }
    .wiz-logo-wrap {
      position: relative;
      display: inline-block;
      padding: 0 38px;
    }
    .wiz-logo-sword {
      position: absolute;
      top: 52%;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, #ef4444 0%, #dc2626 85%, #facc15 100%);
      box-shadow: 0 2px 0 #000;
      z-index: 1;
    }
    .wiz-logo-sword::after {
      content: '';
      position: absolute;
      right: 12px;
      top: -9px;
      width: 4px;
      height: 22px;
      background: #ef4444;
      box-shadow: 1px 1px 0 #000;
    }
    .title-banner h1 {
      position: relative;
      z-index: 2;
      font-family: 'Cinzel', serif;
      font-size: 27px;
      font-weight: 900;
      letter-spacing: 4px;
      text-transform: uppercase;
      color: #ef4444;
      text-shadow: 2px 2px 0 #000, -1px -1px 0 #000, 0 0 18px rgba(220, 38, 38, 0.75);
    }
    .title-banner h2 {
      font-family: 'Cinzel', serif;
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--tartaria-gold-bright);
      margin-top: 4px;
    }
    .save-banner {
      grid-column: 1 / -1;
      background: rgba(20, 45, 25, 0.7);
      border: 1px solid #4ade80;
      color: #bbf7d0;
      padding: 6px 12px;
      font-size: 12px;
      font-family: 'Cinzel', serif;
      display: none;
      justify-content: space-between;
      align-items: center;
    }

    .form-col { display: flex; flex-direction: column; gap: 9px; }
    .preview-col {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      background: #07080d;
      border: 2px solid #3a2818;
      box-shadow: inset 0 0 28px rgba(0,0,0,0.95);
      padding: 10px;
    }
    #previewCanvas {
      width: 240px;
      height: 215px;
      background: radial-gradient(circle at 50% 65%, #232a3b 0%, #050508 78%);
      border: 1px solid #2d2016;
    }
    .lore-box {
      font-size: 12px;
      line-height: 1.35;
      color: #d8c8b4;
      font-style: italic;
      text-align: center;
      padding: 6px 8px;
      background: rgba(12, 10, 16, 0.92);
      border-left: 3px solid var(--tartaria-gold);
      width: 100%;
    }
    .form-group { display: flex; flex-direction: column; gap: 3px; }
    label {
      font-family: 'Cinzel', serif;
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      color: var(--tartaria-gold);
      letter-spacing: 1px;
    }
    input[type="text"], select {
      background: #050408;
      border: 2px solid #3a2818;
      color: #f3ebd6;
      padding: 6px 10px;
      border-radius: 2px;
      font-family: 'Crimson Pro', serif;
      font-size: 14px;
      font-weight: 600;
      outline: none;
    }
    input[type="text"]:focus, select:focus { border-color: var(--tartaria-gold-bright); }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .swatch-row { display: flex; gap: 6px; margin-top: 2px; }
    .swatch {
      width: 22px;
      height: 22px;
      border: 2px solid #000;
      outline: 1px solid #574129;
      cursor: pointer;
    }
    .swatch.active {
      transform: scale(1.18);
      outline: 2px solid var(--tartaria-gold-bright);
    }

    .btn-spawn {
      grid-column: 1 / -1;
      background: linear-gradient(180deg, #991b1b 0%, #450a0a 100%);
      border: 2px solid var(--tartaria-gold-bright);
      outline: 2px solid #000;
      color: #fff4db;
      padding: 11px;
      font-family: 'Cinzel', serif;
      font-size: 14px;
      font-weight: 900;
      letter-spacing: 2px;
      text-transform: uppercase;
      cursor: pointer;
      text-shadow: 2px 2px 0 #000;
      box-shadow: 3px 3px 0 #000;
    }
    .btn-spawn:hover { filter: brightness(1.15); }

    /* Top-Center Boss Health Bar */
    #boss-bar-wrap {
      position: absolute;
      top: 52px;
      left: 50%;
      transform: translateX(-50%);
      width: 480px;
      max-width: 88vw;
      padding: 8px 14px;
      display: none;
      flex-direction: column;
      gap: 4px;
      z-index: 70;
      pointer-events: none;
    }
    #boss-bar-title {
      font-family: 'Cinzel', serif;
      font-size: 13px;
      font-weight: 900;
      color: #fca5a5;
      letter-spacing: 2px;
      text-align: center;
      text-shadow: 2px 2px 0 #000;
    }
    .boss-hp-track {
      width: 100%;
      height: 14px;
      background: #090508;
      border: 2px solid #cfa354;
      outline: 2px solid #000;
      overflow: hidden;
    }
    #boss-hp-fill {
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, #7f1d1d 0%, #ef4444 50%, #f97316 100%);
      transition: width 0.1s linear;
    }

    /* 4-Player Party Roster Box */
    #party-box {
      position: absolute;
      top: 215px;
      left: 12px;
      width: 274px;
      padding: 8px 12px;
      font-size: 11px;
      display: flex;
      flex-direction: column;
      gap: 5px;
    }
    .party-member {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(6, 5, 10, 0.78);
      border: 1px solid #3d2d1f;
      padding: 4px 7px;
    }
    .party-warp-btn {
      background: #1e293b;
      border: 1px solid #64748b;
      color: #e2e8f0;
      font-family: 'Cinzel', serif;
      font-size: 9px;
      padding: 2px 6px;
      cursor: pointer;
    }
    .party-warp-btn:hover { border-color: var(--tartaria-gold-bright); color: var(--tartaria-gold-bright); }

    /* Werdna 1981 Illustrated Taunt Modal */
    #werdna-modal {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 92%;
      max-width: 520px;
      background: #f5f0e1;
      color: #111;
      border: 4px solid #111;
      outline: 3px solid var(--tartaria-gold);
      box-shadow: 0 18px 55px rgba(0,0,0,0.95);
      padding: 18px;
      display: none;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      z-index: 180;
    }
    #werdna-modal p {
      font-family: 'Crimson Pro', Georgia, serif;
      font-size: 14.5px;
      font-weight: 700;
      line-height: 1.35;
      text-align: justify;
      color: #1a1615;
    }

    /* Quick Translucent Inventory & Equipment Popup [I] */
    #inventory-modal {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 92%;
      max-width: 580px;
      background: rgba(10, 8, 15, 0.88);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      border: 2px solid var(--tartaria-gold);
      outline: 2px solid #000;
      box-shadow: 0 12px 45px rgba(0,0,0,0.92);
      padding: 16px 20px;
      display: none;
      flex-direction: column;
      gap: 12px;
      z-index: 140;
    }
    .equip-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
    .equip-box {
      background: rgba(5, 4, 8, 0.85);
      border: 1px solid #574129;
      padding: 8px;
      text-align: center;
      cursor: pointer;
    }
    .equip-box:hover { border-color: var(--tartaria-gold-bright); }
    .equip-box small {
      display: block;
      font-family: 'Cinzel', serif;
      font-size: 9px;
      color: #9c8462;
      text-transform: uppercase;
    }
    .equip-box strong {
      display: block;
      font-family: 'Cinzel', serif;
      font-size: 12px;
      color: var(--tartaria-gold-bright);
      margin-top: 2px;
    }
    .equip-box span { font-size: 10.5px; color: #4ade80; }
    .bag-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
    .bag-slot {
      min-height: 62px;
      background: rgba(5, 4, 8, 0.82);
      border: 1px solid #3a2a18;
      padding: 6px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      cursor: pointer;
      transition: border-color 0.12s, transform 0.1s;
    }
    .bag-slot:hover {
      border-color: var(--tartaria-gold-bright);
      transform: translateY(-1px);
    }
    .bag-slot .item-name {
      font-family: 'Cinzel', serif;
      font-size: 10.5px;
      color: #f4dca6;
      font-weight: 700;
    }
    .bag-slot .item-stat { font-size: 10px; color: #a89984; }

    #grimoire-modal, #ascend-modal {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 92%;
      max-width: 620px;
      background: rgba(10, 8, 15, 0.94);
      backdrop-filter: blur(6px);
      padding: 18px;
      display: none;
      flex-direction: column;
      gap: 12px;
      z-index: 150;
    }
    .spell-list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
      max-height: 280px;
      overflow-y: auto;
    }
    .spell-card {
      background: #060509;
      border: 1px solid #4a3520;
      padding: 8px 10px;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .spell-card:hover { border-color: var(--tartaria-gold-bright); }

    /* HUD */
    #hud {
      position: absolute;
      inset: 0;
      pointer-events: none;
      display: none;
      z-index: 50;
    }
    .interactive { pointer-events: auto; }

    .top-bar {
      position: absolute;
      top: 10px;
      left: 12px;
      right: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }
    .panel {
      padding: 6px 12px;
      font-size: 11px;
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: 'Cinzel', serif;
    }
    .action-btn {
      background: #171219;
      border: 1px solid var(--tartaria-gold);
      color: var(--tartaria-gold-bright);
      padding: 4px 8px;
      font-family: 'Cinzel', serif;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1px;
      cursor: pointer;
      text-transform: uppercase;
      box-shadow: 2px 2px 0 #000;
    }
    .action-btn:hover { background: #2d201c; }

    .vitals-box {
      position: absolute;
      top: 50px;
      left: 12px;
      padding: 10px 14px;
      width: 274px;
      font-size: 11px;
    }
    .bar-container {
      width: 100%;
      height: 9px;
      background: #050408;
      border: 2px solid #000;
      outline: 1px solid #3d2d1f;
      margin-top: 2px;
      overflow: hidden;
    }
    .bar-fill {
      height: 100%;
      width: 100%;
      transition: width 0.12s linear;
    }
    #hp-fill { background: linear-gradient(180deg, #c92a2a 0%, #6b1111 100%); }
    #mana-fill { background: linear-gradient(180deg, #2b78b8 0%, #123654 100%); }
    #xp-fill { background: linear-gradient(180deg, #f4dca6 0%, #b88b3a 100%); }

    /* 9-Slot Grimoire Action Bar */
    .hotbar {
      position: absolute;
      bottom: 12px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 5px;
      flex-wrap: wrap;
      max-width: 96vw;
      justify-content: center;
    }
    .hotkey-slot {
      width: 54px;
      height: 54px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      position: relative;
    }
    .hotkey-slot.locked {
      opacity: 0.42;
      border-color: #3a2d24;
      cursor: not-allowed;
    }
    .hotkey-slot:not(.locked):hover { border-color: var(--tartaria-gold-bright); }
    .hotkey-num {
      position: absolute;
      top: 2px;
      left: 4px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 9px;
      font-weight: 700;
      color: var(--tartaria-gold);
    }
    .hotkey-icon { font-size: 16px; }
    .hotkey-label {
      font-family: 'Cinzel', serif;
      font-size: 7px;
      color: #dfd0ba;
      text-transform: uppercase;
      margin-top: 2px;
      text-align: center;
      max-width: 48px;
      overflow: hidden;
      white-space: nowrap;
    }

    .chat-container {
      position: absolute;
      bottom: 76px;
      left: 12px;
      width: 350px;
      max-width: calc(100vw - 24px);
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .chat-log {
      height: 112px;
      padding: 7px 10px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 3px;
      font-size: 12px;
    }
    .chat-msg {
      word-break: break-word;
      line-height: 1.25;
      text-shadow: 1px 1px 0 #000;
    }
    .chat-msg .author {
      color: var(--tartaria-gold-bright);
      font-weight: 700;
      font-family: 'Cinzel', serif;
      margin-right: 5px;
    }
    .chat-input-row { display: flex; gap: 4px; }
    .chat-input {
      flex: 1;
      background: rgba(5, 4, 8, 0.94);
      border: 2px solid #3a2818;
      padding: 5px 10px;
      color: #f3ebd6;
      font-size: 13px;
      font-family: 'Crimson Pro', serif;
      outline: none;
    }

    #souls-banner {
      position: absolute;
      top: 24%;
      left: 0;
      right: 0;
      background: linear-gradient(90deg, transparent 0%, rgba(10, 4, 6, 0.92) 25%, rgba(10, 4, 6, 0.92) 75%, transparent 100%);
      border-top: 1px solid rgba(200, 157, 84, 0.45);
      border-bottom: 1px solid rgba(200, 157, 84, 0.45);
      padding: 14px 0;
      text-align: center;
      font-family: 'Cinzel', serif;
      font-size: 26px;
      font-weight: 900;
      letter-spacing: 6px;
      color: #d92626;
      text-shadow: 0 0 18px rgba(217, 38, 38, 0.75), 2px 2px 0 #000;
      display: none;
      z-index: 190;
      pointer-events: none;
    }
    #toast {
      position: absolute;
      top: 98px;
      left: 50%;
      transform: translateX(-50%);
      padding: 6px 18px;
      font-family: 'Cinzel', serif;
      font-size: 11.5px;
      font-weight: 800;
      color: var(--tartaria-gold-bright);
      letter-spacing: 1.5px;
      display: none;
      z-index: 200;
      text-shadow: 1px 1px 0 #000;
    }
  </style>
</head>
<body>

  <div id="crt-overlay"></div>
  <div id="souls-banner">FIREPIT RESTORED</div>

  <!-- Top-Center Boss Health Bar -->
  <div id="boss-bar-wrap" class="tartaria-window">
    <div id="boss-bar-title">☠️ SURTR, KING OF THE FIRE GIANTS</div>
    <div class="boss-hp-track">
      <div id="boss-hp-fill"></div>
    </div>
  </div>

  <!-- Werdna 1981 Manual Art Portrait Modal -->
  <div id="werdna-modal">
    <p>"Come, enter the World of Wizardry if you dare. I am sure I know you. You lead a small band of foolhardy adventurers that dares challenge me. Ha! My dark legions laugh at your exploits in my domain. But wait. You have yet to meet me and face the ultimate terrors of my wicked magic. You can still run away, fools! Ha, ha, ha!"</p>
    <canvas id="werdnaCanvas" width="260" height="230" style="border:2px solid #111; background:#f5f0e1;"></canvas>
    <button class="action-btn" onclick="document.getElementById('werdna-modal').style.display='none'" style="background:#7c0a0a; color:#fff; padding:6px 18px;">Defy Werdna [Close]</button>
  </div>

  <!-- Character Creation / 4-Player Shard Lobby -->
  <div id="char-modal">
    <div class="char-card tartaria-window">
      <div class="title-banner">
        <div class="wiz-logo-wrap">
          <div class="wiz-logo-sword"></div>
          <h1>WIZARDRY: TARTARIA</h1>
        </div>
        <h2>2.5D OVA Graphics • 4-Player Auto-Mesh Co-Op/PvP • Aimed Ranged Combat & 4 End-Bosses</h2>
      </div>

      <div id="returning-save-banner" class="save-banner">
        <span id="returning-save-txt">Saved Character Detected!</span>
        <button class="action-btn" id="btn-reset-save" style="border-color:#f87171; color:#fca5a5;">Wipe Soul Save</button>
      </div>

      <div class="form-col">
        <div class="grid-2">
          <div class="form-group">
            <label for="char-name">Denizen Name</label>
            <input type="text" id="char-name" maxlength="16" value="Hawkwind">
          </div>
          <div class="form-group">
            <label for="shard-code-input">4-Player Party Shard Code</label>
            <input type="text" id="shard-code-input" maxlength="12" value="MAIN" title="Friends typing the same Shard Code automatically connect into Slots 1-4!">
          </div>
        </div>

        <div class="grid-2">
          <div class="form-group">
            <label for="char-race">Non-Human Race (No Humans)</label>
            <select id="char-race"></select>
          </div>
          <div class="form-group">
            <label for="char-subrace">Sub-Race / Card Archetype</label>
            <select id="char-subrace"></select>
          </div>
        </div>

        <div class="grid-2">
          <div class="form-group">
            <label for="char-class">Core Calling (Lv.1)</label>
            <select id="char-class">
              <option value="Rogue">Rogue (Highlander Bow / OVA Ninja)</option>
              <option value="Mage">Mage (Sorceress Orb / Tiltowait)</option>
              <option value="Fighter">Fighter (Fire Giant Cleaver / Vanguard)</option>
              <option value="Cleric">Cleric (Gaiden Witch / Madi Priest)</option>
            </select>
          </div>
          <div class="form-group">
            <label for="char-sect">Starting Regional Magic Sect</label>
            <select id="char-sect">
              <option value="East">Set East (OVA Kubi-Kiri & Shuriken)</option>
              <option value="Classic">Set Classic (Llylgamyn Chants)</option>
              <option value="North">Set North (Fire Giant & Frost Fury)</option>
              <option value="South">Set South (Sun-Mirage & Naphtha)</option>
              <option value="West">Set West (Obsidian Totem & Blood)</option>
            </select>
          </div>
        </div>

        <div class="grid-2">
          <div class="form-group">
            <label>Garb & Plate Tint</label>
            <div class="swatch-row" id="armor-swatches"></div>
          </div>
          <div class="form-group">
            <label>Crest / Mane Tint</label>
            <div class="swatch-row" id="hair-swatches"></div>
          </div>
        </div>
      </div>

      <div class="preview-col">
        <span style="font-family:'Cinzel',serif; font-size:10px; color:#cfa354; letter-spacing:1px;">2.5D SHADED OVA VISAGE</span>
        <canvas id="previewCanvas" width="240" height="215"></canvas>
        <div class="lore-box" id="race-lore-box"></div>
      </div>

