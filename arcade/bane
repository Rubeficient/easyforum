    function drawWerdna1981Portrait() {
      const c = document.getElementById('werdnaCanvas');
      if (!c) return;
      const wCtx = c.getContext('2d');
      wCtx.clearRect(0, 0, c.width, c.height);

      // Crimson-Magenta Robe Billows (matching 1981 manual illustration)
      wCtx.fillStyle = '#c81e56';
      wCtx.strokeStyle = '#111';
      wCtx.lineWidth = 2.5;
      wCtx.beginPath();
      wCtx.moveTo(40, 225);
      wCtx.quadraticCurveTo(15, 130, 75, 95);
      wCtx.lineTo(185, 95);
      wCtx.quadraticCurveTo(245, 130, 220, 225);
      wCtx.closePath();
      wCtx.fill(); wCtx.stroke();

      // Ornate Mitre Hat
      wCtx.fillStyle = '#d6336c';
      wCtx.beginPath();
      wCtx.moveTo(105, 65);
      wCtx.lineTo(130, 12);
      wCtx.lineTo(155, 65);
      wCtx.closePath();
      wCtx.fill(); wCtx.stroke();

      // Yellowish Face & Scowl
      wCtx.fillStyle = '#eab308';
      wCtx.beginPath();
      wCtx.arc(130, 78, 18, 0, Math.PI * 2);
      wCtx.fill(); wCtx.stroke();

      // Long Flowing White Beard
      wCtx.fillStyle = '#f8fafc';
      wCtx.beginPath();
      wCtx.moveTo(112, 85);
      wCtx.quadraticCurveTo(95, 165, 115, 220);
      wCtx.quadraticCurveTo(135, 195, 155, 220);
      wCtx.quadraticCurveTo(165, 155, 148, 85);
      wCtx.closePath();
      wCtx.fill(); wCtx.stroke();

      // Clawed Yellow Hands
      wCtx.fillStyle = '#eab308';
      wCtx.beginPath();
      wCtx.arc(85, 112, 10, 0, Math.PI * 2);
      wCtx.arc(175, 112, 10, 0, Math.PI * 2);
      wCtx.fill(); wCtx.stroke();
    }
