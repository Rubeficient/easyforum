    function handleEnemyKilled(en, idx) {
      enemies.splice(idx, 1);
      localPlayer.xp += en.xpValue || 55;
      const goldDrop = en.isBoss ? 280 : (24 + Math.floor(Math.random() * 28));
      localPlayer.gold += goldDrop;

      const moteCount = en.isBoss ? 6 : 2;
      for (let m = 0; m < moteCount; m++) {
        atmanMotes.push({
          x: en.x + (Math.random() - 0.5) * 40,
          y: en.y - 12 + (Math.random() - 0.5) * 40,
          val: en.isBoss ? 12 : 8
        });
      }

      if (en.isBoss || Math.random() < 0.52) {
        const drop1 = rollProceduralLootItem(en.tier || 1);
        const drop2 = en.isBoss ? rollProceduralLootItem((en.tier || 1) + 2, true) : null;
        lootChests.push({
          id: 'chest-' + Math.random().toString(36).slice(2, 7),
          x: en.x,
          y: en.y,
          label: en.isBoss ? `👑 ${en.name} GRAND URN` : `${en.name} Coffer`,
          isCorpse: false,
          beamColor: (drop2 || drop1).rarityColor,
          gold: goldDrop,
          items: drop2 ? [drop1, drop2] : [drop1]
        });
      }

      if (en.isBoss) {
        triggerSoulsBanner(`ARCHON STATUE SHATTERED: ${en.name}`);
      }

      if (localPlayer.xp >= localPlayer.nextXp) {
        localPlayer.xp -= localPlayer.nextXp;
        localPlayer.level++;
        localPlayer.nextXp = Math.round(localPlayer.nextXp * 1.3);
        recalcEquipmentStats();
        localPlayer.hp = localPlayer.maxHp;
        localPlayer.mana = localPlayer.maxMana;
        document.getElementById('vitals-lvl').textContent = `LV.${localPlayer.level}`;
        renderHotbarUI();
        triggerSoulsBanner(`SOUL LEVEL ${localPlayer.level} — NEW SPECIAL SLOT UNLOCKED`);
        checkClassAscensionPrompt();
      }

      savePersistentProgress();
      if (localPlayer.targetEntityId === en.id) localPlayer.targetEntityId = null;
      updateVitalsUI();
    }

