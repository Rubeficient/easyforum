    // --- 90s ANIME CEL-SHADED CHARACTER RENDERER ---
    function drawAnimeCharacter(ctx, p, cx, cy, timeSec, scaleOverride = 1.0, isTargeted = false) {
      const raceMeta = RACES[p.race] || RACES['Human-Standard'];
      const sc = raceMeta.scale * scaleOverride;
      const facing = p.facing || 1;
      const isMoving = p.isMoving;
      const walkBob = isMoving ? Math.abs(Math.sin(timeSec * 11)) * -5 : Math.sin(timeSec * 2.6) * 1.5;
      const stride = isMoving ? Math.sin(timeSec * 11) * 6 : 0;

      ctx.save();
      ctx.translate(cx, cy);

      // Target Reticle (Crimson Anime Crosshair Ring)
      if (isTargeted) {
        ctx.save();
        ctx.strokeStyle = '#ff2a38';
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        ctx.ellipse(0, 4, 28 * sc, 13 * sc, 0, 0, Math.PI * 2);
        ctx.stroke();
        ctx.restore();
      }

      // Ground Cel Drop Shadow
      ctx.fillStyle = 'rgba(4, 2, 8, 0.72)';
      ctx.beginPath();
      ctx.ellipse(0, 5, 20 * sc, 9 * sc, 0, 0, Math.PI * 2);
      ctx.fill();

      ctx.save();
      ctx.scale(facing * sc, sc);
      ctx.translate(0, walkBob);

      ctx.lineJoin = 'round';
      ctx.lineCap = 'round';

      // 1. Demonic Wings (if Succubus or Balor)
      if (raceMeta.wings) {
        const flap = Math.sin(timeSec * 4.5) * 4;
        ctx.fillStyle = p.race === 'Demon-Balor' ? '#4a0e12' : '#281536';
        ctx.strokeStyle = '#050308';
        ctx.lineWidth = 2.2;
        ctx.beginPath();
        ctx.moveTo(-4, -24);
        ctx.lineTo(-32, -44 + flap);
        ctx.lineTo(-26, -16);
        ctx.lineTo(-14, -20);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();
      }

      // 2. Flowing 90s Anime Tattered Cloak (Behind body)
      const cloakWave = Math.sin(timeSec * 5 + (isMoving ? 2 : 0)) * (isMoving ? 7 : 2.5);
      ctx.fillStyle = p.armorColor || '#7a1c24';
      ctx.strokeStyle = '#050308';
      ctx.lineWidth = 2.4;
      ctx.beginPath();
      ctx.moveTo(-raceMeta.torsoW * 0.45, -30);
      ctx.lineTo(raceMeta.torsoW * 0.45, -30);
      ctx.lineTo(raceMeta.torsoW * 0.65 - cloakWave, 2);
      ctx.lineTo(0 - cloakWave * 0.8, -3);
      ctx.lineTo(-raceMeta.torsoW * 0.75 - cloakWave, 3);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();

      // 3. Boots & Legs
      ctx.fillStyle = '#1b1621';
      ctx.strokeStyle = '#050308';
      ctx.lineWidth = 2.2;
      ctx.fillRect(-7 + stride * 0.5, -12, 6, 14);
      ctx.strokeRect(-7 + stride * 0.5, -12, 6, 14);
      ctx.fillRect(2 - stride * 0.5, -12, 6, 14);
      ctx.strokeRect(2 - stride * 0.5, -12, 6, 14);

      // 4. Torso & Sub-Race Silhouette (Torta vs Edgar vs Standard)
      const tw = raceMeta.torsoW;
      const th = raceMeta.torsoH;
      ctx.fillStyle = '#262130';
      ctx.strokeStyle = '#050308';
      ctx.lineWidth = 2.4;

      if (p.race === 'Human-Torta') {
        // Stylized wide curvy brawler silhouette + crop chestplate
        ctx.beginPath();
        ctx.roundRect(-tw / 2, -30, tw, th, 8);
        ctx.fill();
        ctx.stroke();
        // Hard cel-shaded highlight on armor
        ctx.fillStyle = p.armorColor || '#7a1c24';
        ctx.fillRect(-tw / 2 + 2, -29, tw - 4, 11);
      } else {
        ctx.beginPath();
        ctx.roundRect(-tw / 2, -30, tw, th, 3);
        ctx.fill();
        ctx.stroke();
        // Diagonal Sword Belt
        ctx.strokeStyle = '#8c6239';
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        ctx.moveTo(-tw / 2 + 1, -28);
        ctx.lineTo(tw / 2 - 1, -12);
        ctx.stroke();
      }

      // 5. Lodoss-Style Exaggerated Shoulder Pauldrons
      ctx.fillStyle = '#9ca3af';
      ctx.strokeStyle = '#050308';
      ctx.lineWidth = 2.2;
      ctx.beginPath();
      ctx.ellipse(-tw / 2 - 2, -27, 7, 4.5, -0.3, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();
      ctx.beginPath();
      ctx.ellipse(tw / 2 + 2, -27, 7, 4.5, 0.3, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();

      // 6. Head & Anime Facial Features
      const headY = -39;
      const headR = 10.5;
      ctx.fillStyle = raceMeta.skin;
      ctx.strokeStyle = '#050308';
      ctx.lineWidth = 2.2;
      ctx.beginPath();
      ctx.arc(0, headY, headR, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();

      // Long 90s Elf Ears for Drow
      if (raceMeta.ears) {
        ctx.fillStyle = raceMeta.skin;
        ctx.beginPath();
        ctx.moveTo(-headR + 1, headY - 1);
        ctx.lineTo(-headR - 11, headY - 6);
        ctx.lineTo(-headR + 2, headY + 3);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();
      }

      // Gold Hoop Earrings for Torta
      if (p.race === 'Human-Torta') {
        ctx.strokeStyle = '#f4d28c';
        ctx.lineWidth = 1.8;
        ctx.beginPath();
        ctx.arc(-headR - 1, headY + 3, 3.5, 0, Math.PI * 2);
        ctx.stroke();
      }

      // Sharp 90s Anime Eyes
      ctx.fillStyle = '#050308';
      ctx.fillRect(1, headY - 3, 4, 1.5);
      ctx.fillRect(6, headY - 3, 3.5, 1.5);
      ctx.fillStyle = (p.race.startsWith('Demon') || p.race === 'Drow') ? '#ff3b4e' : '#ffffff';
      ctx.fillRect(2, headY - 2, 2.2, 2.2);
      ctx.fillRect(6.5, headY - 2, 2.2, 2.2);

      // Duergar Braided Beard
      if (raceMeta.beard) {
        ctx.fillStyle = p.hairColor || '#d9d2c5';
        ctx.beginPath();
        ctx.moveTo(-6, headY + 3);
        ctx.lineTo(8, headY + 3);
        ctx.lineTo(5, headY + 16);
        ctx.lineTo(-4, headY + 16);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();
      }

      // 7. Sub-Race Specific Hair & Horns
      ctx.fillStyle = p.hairColor || '#141218';
      ctx.strokeStyle = '#050308';
      ctx.lineWidth = 2;

      if (p.race === 'Human-Edgar') {
        // Iconic Edgar high-fade straight fringe bowl cut
        ctx.beginPath();
        ctx.arc(0, headY - 2, headR + 1.5, Math.PI * 0.95, Math.PI * 2.05);
        ctx.lineTo(headR + 2, headY - 3);
        ctx.lineTo(-headR - 2, headY - 3);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();
      } else if (p.race === 'Human-Torta') {
        // Voluminous dark hair with side bangs
        ctx.beginPath();
        ctx.arc(0, headY - 2, headR + 2, Math.PI * 0.8, Math.PI * 2.2);
        ctx.fill();
        ctx.stroke();
        ctx.beginPath();
        ctx.arc(-headR, headY + 2, 5, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
      } else if (raceMeta.horns) {
        // Curved Demon Horns
        ctx.fillStyle = '#d6c5ad';
        ctx.beginPath();
        ctx.moveTo(-6, headY - 7);
        ctx.quadraticCurveTo(-19, headY - 16, -14, headY - 25);
        ctx.lineTo(-4, headY - 9);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();

        ctx.beginPath();
        ctx.moveTo(6, headY - 7);
        ctx.quadraticCurveTo(19, headY - 16, 14, headY - 25);
        ctx.lineTo(4, headY - 9);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();
      } else {
        // Spiky 90s Anime Swordsman Hair
        ctx.beginPath();
        ctx.moveTo(-headR - 2, headY - 2);
        ctx.lineTo(-8, headY - 15);
        ctx.lineTo(-3, headY - 11);
        ctx.lineTo(2, headY - 16);
        ctx.lineTo(7, headY - 11);
        ctx.lineTo(headR + 3, headY - 4);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();
      }

      // 8. Class Weapon (Dragon-Slayer Greatsword / Runestaff / Twin Daggers)
      const swingRot = p.swingTimer > 0 ? Math.sin(p.swingTimer * 0.35) * 1.45 : (isMoving ? Math.sin(timeSec * 11) * 0.18 : 0);
      ctx.save();
      ctx.translate(tw * 0.48, -20);
      ctx.rotate(swingRot);

      if (p.className === 'Fighter') {
        // Massive Berserk-style Slab Greatsword
        ctx.fillStyle = '#4a3525';
        ctx.fillRect(-1.5, 0, 3, 7);
        ctx.fillStyle = '#d6a85a';
        ctx.fillRect(-5, -3, 10, 3);
        ctx.fillStyle = '#333942';
        ctx.strokeStyle = '#050308';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(-4, -3);
        ctx.lineTo(-4, -36);
        ctx.lineTo(0, -43);
        ctx.lineTo(4, -36);
        ctx.lineTo(4, -3);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();
        // Metallic edge highlight
        ctx.fillStyle = '#cbd5e1';
        ctx.fillRect(1.5, -35, 1.5, 31);
      } else if (p.className === 'Mage' || p.className === 'Healer') {
        // Ornate Skull/Crescent Staff
        ctx.fillStyle = '#5c3a21';
        ctx.strokeStyle = '#050308';
        ctx.lineWidth = 2;
        ctx.fillRect(-1.5, -34, 3, 40);
        ctx.strokeRect(-1.5, -34, 3, 40);
        ctx.fillStyle = p.className === 'Mage' ? '#38bdf8' : '#10b981';
        ctx.beginPath();
        ctx.arc(0, -37, 5.5, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
      } else {
        // Reverse-grip Crimson Kris Dagger
        ctx.fillStyle = '#cbd5e1';
        ctx.strokeStyle = '#050308';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(-2, -2);
        ctx.lineTo(0, -22);
        ctx.lineTo(3, -2);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();
      }
      ctx.restore();

      ctx.restore();
      ctx.restore();
    }

    // --- PREVIEW CANVAS LOOP ---
    const prevCanvas = document.getElementById('previewCanvas');
    const prevCtx = prevCanvas.getContext('2d');
    let previewSwing = 0;
    prevCanvas.addEventListener('mousedown', () => { previewSwing = 20; });

    function updatePreview(now) {
      if (document.getElementById('char-modal').style.display !== 'none') {
        prevCtx.clearRect(0, 0, prevCanvas.width, prevCanvas.height);

        // Draw Gothic Stone Pedestal
        prevCtx.fillStyle = '#181321';
        prevCtx.strokeStyle = '#050308';
        prevCtx.lineWidth = 2.5;
        prevCtx.beginPath();
        prevCtx.ellipse(120, 175, 56, 16, 0, 0, Math.PI * 2);
        prevCtx.fill();
        prevCtx.stroke();

        if (previewSwing > 0) previewSwing--;

        const previewDummy = {
          race: document.getElementById('char-race').value,
          className: document.getElementById('char-class').value,
          armorColor: localPlayer.armorColor,
          hairColor: localPlayer.hairColor,
          facing: 1,
          isMoving: false,
          swingTimer: previewSwing
        };
        drawAnimeCharacter(prevCtx, previewDummy, 120, 168, now * 0.001, 1.65, false);
      }
    }

    // --- SPAWN INITIAL HELL MONSTERS (Apostles, Gargoyles, Hellhounds) ---
    function spawnHellEnemies() {
      enemies.length = 0;
      const types = [
        { name: 'Crimson Behelit Imp', hp: 50, maxHp: 50, radius: 15, speed: 125, color: '#b82832', type: 'imp' },
        { name: 'Abyssal Hellhound',   hp: 85, maxHp: 85, radius: 18, speed: 170, color: '#4a1525', type: 'hound' },
        { name: 'Obsidian Apostle',    hp: 120, maxHp: 120, radius: 22, speed: 110, color: '#5c2d7a', type: 'apostle' }
      ];

      for (let i = 0; i < 18; i++) {
        const t = types[i % types.length];
        const ang = (i / 18) * Math.PI * 2 + (Math.random() * 0.3);
        const dist = 390 + Math.random() * 1100;
        enemies.push({
          id: 'mob-' + i,
          name: t.name,
          x: DOMAIN_CORE.x + Math.cos(ang) * dist,
          y: DOMAIN_CORE.y + Math.sin(ang) * dist,
          hp: t.hp,
          maxHp: t.maxHp,
          radius: t.radius,
          speed: t.speed,
          color: t.color,
          type: t.type,
          attackCooldown: 0
        });
      }
    }
    spawnHellEnemies();

    // --- CAVERN PROPS (Broken Gothic Pillars, Braziers, Skull Piles) ---
    const hellProps = [];
    for (let i = 0; i < 280; i++) {
      const gx = 100 + Math.random() * (WORLD_SIZE - 200);
      const gy = 100 + Math.random() * (WORLD_SIZE - 200);
      if (Math.hypot(gx - DOMAIN_CORE.x, gy - DOMAIN_CORE.y) > 160) {
        hellProps.push({
          x: gx,
          y: gy,
          type: i % 3 === 0 ? 'brazier' : 'pillar',
          size: 16 + Math.random() * 20
        });
      }
    }

    // --- CANVAS & RESIZING ---
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    let screenW = 0, screenH = 0;

    function resizeCanvas() {
      screenW = window.innerWidth;
      screenH = window.innerHeight;
      canvas.width = screenW;
      canvas.height = screenH;
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    // --- INPUT CONTROLS & LAPTOP TOUCHPAD OPTIMIZATION ---
    const keys = {};
    window.addEventListener('keydown', (e) => {
      if (document.activeElement === document.getElementById('chat-input')) {
        if (e.key === 'Enter') sendChat();
        return;
      }
      keys[e.key.toLowerCase()] = true;
      if (['1','2','3','4'].includes(e.key)) {
        triggerAbility(parseInt(e.key));
      }
      if (e.key === 'Tab') {
        e.preventDefault();
        cycleTabTarget();
      }
      if (e.key === 'Enter') {
        document.getElementById('chat-input').focus();
      }
    });

    window.addEventListener('keyup', (e) => {
      keys[e.key.toLowerCase()] = false;
    });

    canvas.addEventListener('mousedown', (e) => {
      const camX = localPlayer.x - screenW / 2;
      const camY = localPlayer.y - screenH / 2;
      const clickX = e.clientX + camX;
      const clickY = e.clientY + camY;

      let clickedEnemy = null;
      for (const en of enemies) {
        if (Math.hypot(clickX - en.x, clickY - en.y) < en.radius + 18) {
          clickedEnemy = en;
          break;
        }
      }

      if (clickedEnemy) {
        localPlayer.targetEntityId = clickedEnemy.id;
        if (Math.hypot(localPlayer.x - clickedEnemy.x, localPlayer.y - clickedEnemy.y) < 95) {
          executePrimaryStrike(clickedEnemy);
        } else {
          localPlayer.targetX = clickedEnemy.x;
          localPlayer.targetY = clickedEnemy.y;
        }
      } else {
        localPlayer.targetX = clickX;
        localPlayer.targetY = clickY;
      }
    });

    // --- TAB TARGETING SYSTEM ---
    function cycleTabTarget() {
      if (enemies.length === 0) {
        spawnHellEnemies();
        return;
      }
      const sorted = [...enemies].sort((a, b) => {
        return Math.hypot(a.x - localPlayer.x, a.y - localPlayer.y) - Math.hypot(b.x - localPlayer.x, b.y - localPlayer.y);
      });
      const currentIdx = sorted.findIndex(t => t.id === localPlayer.targetEntityId);
      const nextIdx = (currentIdx + 1) % sorted.length;
      localPlayer.targetEntityId = sorted[nextIdx].id;
      showToast(`Locked On: ${sorted[nextIdx].name}`);
    }

    // --- MULTIPLAYER & PERSONAL HELL SHARDS ---
    const globalUrlParams = new URLSearchParams(window.location.search);
    const joinShardId = globalUrlParams.get('shard');
    const isHost = !joinShardId;

    let localBroadcastChannel = null;
    try {
      if (typeof BroadcastChannel !== 'undefined') {
        localBroadcastChannel = new BroadcastChannel('undercity_hell_v4_' + (joinShardId || 'main'));
        localBroadcastChannel.onmessage = (ev) => {
          if (ev.data && ev.data.id !== localPlayer.id) {
            handleIncomingPacket(ev.data);
          }
        };
      }
    } catch (e) {}

    const RELAY_SERVERS = [
      'wss://free.blr2.piesocket.com/v3/undercity_hell_shard?api_key=VCXCEuvhGcBDP7XhiJJUDvR1e1D3eiVjgZ9VRiaV&notify_self=0'
    ];
    let activeSocket = null;
    let socketConnected = false;

    function initNetworking() {
      const shardStatus = document.getElementById('shard-status');
      if (isHost) {
        shardStatus.textContent = `Citadel: ${localPlayer.domainName}`;
        try {
          const newUrl = `${window.location.origin}${window.location.pathname}?shard=hell-${localPlayer.id}`;
          window.history.replaceState(null, '', newUrl);
        } catch(e) {}
      } else {
        shardStatus.textContent = `Visiting Ally Shard`;
      }

      try {
        const ws = new WebSocket(RELAY_SERVERS[0]);
        activeSocket = ws;
        ws.onopen = () => {
          socketConnected = true;
          broadcastState(true);
        };
        ws.onmessage = (e) => {
          try {
            const data = JSON.parse(e.data);
            if (data && data.id && data.id !== localPlayer.id) {
              handleIncomingPacket(data);
            }
          } catch(err) {}
        };
        ws.onerror = () => { socketConnected = false; };
      } catch(err) {}
    }

    function handleIncomingPacket(data) {
      if (!data || !data.id || data.id === localPlayer.id) return;

      if (data.type === 'state') {
        let p = remotePlayers.get(data.id);
        if (!p) {
          p = { ...data };
          remotePlayers.set(data.id, p);
          appendChat('Chronicle', `${p.name} (${p.race}) crossed the Astral Rift.`);
        } else {
          Object.assign(p, data);
        }
        updateRosterCount();
      } else if (data.type === 'chat') {
        appendChat(data.sender, data.text);
      }
    }

    function broadcastState() {
      const packet = {
        type: 'state',
        id: localPlayer.id,
        name: localPlayer.name,
        race: localPlayer.race,
        className: localPlayer.className,
        armorColor: localPlayer.armorColor,
        hairColor: localPlayer.hairColor,
        domainName: localPlayer.domainName,
        x: Math.round(localPlayer.x),
        y: Math.round(localPlayer.y),
        facing: localPlayer.facing,
        isMoving: localPlayer.isMoving,
        swingTimer: localPlayer.swingTimer,
        hp: localPlayer.hp,
        maxHp: localPlayer.maxHp,
        chatBubble: localPlayer.chatBubble,
        chatTimer: localPlayer.chatTimer
      };

      if (localBroadcastChannel) {
        try { localBroadcastChannel.postMessage(packet); } catch(e) {}
      }
      if (activeSocket && socketConnected && activeSocket.readyState === WebSocket.OPEN) {
        try { activeSocket.send(JSON.stringify(packet)); } catch(e) {}
      }
    }

    function broadcastChat(text) {
      const packet = {
        type: 'chat',
        id: localPlayer.id,
        sender: localPlayer.name,
        text: text
      };
      if (localBroadcastChannel) {
        try { localBroadcastChannel.postMessage(packet); } catch(e) {}
      }
      if (activeSocket && socketConnected && activeSocket.readyState === WebSocket.OPEN) {
        try { activeSocket.send(JSON.stringify(packet)); } catch(e) {}
      }
    }

    function updateRosterCount() {
      const el = document.getElementById('player-count');
      if (el) el.textContent = `(${remotePlayers.size + 1} Mercenaries)`;
    }

    // --- ANIME SLASH FX & COMBAT ABILITIES ---
    function spawnSlashArc(x, y, facing, color = '#f4d28c', radius = 48) {
      slashArcs.push({ x, y, facing, color, radius, life: 14, maxLife: 14 });
      for (let i = 0; i < 8; i++) {
        bloodSparks.push({
          x, y: y - 15,
          vx: (Math.random() - 0.2) * facing * 180,
          vy: (Math.random() - 0.8) * 140,
          color: i % 2 === 0 ? '#e03c3c' : color,
          life: 18
        });
      }
    }

    function triggerAbility(slot) {
      if (slot === 1) {
        let target = enemies.find(e => e.id === localPlayer.targetEntityId);
        if (!target && enemies.length > 0) {
          cycleTabTarget();
          target = enemies.find(e => e.id === localPlayer.targetEntityId);
        }
        if (target) executePrimaryStrike(target);
      } else if (slot === 2) {
        if (localPlayer.mana < 15) {
          showToast('Insufficient Astral Od!');
          return;
        }
        localPlayer.mana -= 15;
        localPlayer.swingTimer = 20;
        spawnSlashArc(localPlayer.x, localPlayer.y, localPlayer.facing, '#e03c3c', 135);

        for (let i = enemies.length - 1; i >= 0; i--) {
          const en = enemies[i];
          if (Math.hypot(en.x - localPlayer.x, en.y - localPlayer.y) < 165) {
            en.hp -= 55;
            spawnCombatText(en.x, en.y, '55 ECLIPSE!', '#f4d28c');
            if (en.hp <= 0) handleEnemyDefeat(en, i);
          }
        }
      } else if (slot === 3) {
        localPlayer.speed = 410;
        spawnSlashArc(localPlayer.x, localPlayer.y, localPlayer.facing, '#38bdf8', 40);
        setTimeout(() => {
          const r = RACES[localPlayer.race] || RACES['Human-Standard'];
          localPlayer.speed = 220 * r.speedMod;
        }, 2000);
        showToast('Gale Strider Dash!');
      } else if (slot === 4) {
        if (localPlayer.mana < 15) {
          showToast('Insufficient Astral Od!');
          return;
        }
        localPlayer.mana -= 15;
        localPlayer.hp = Math.min(localPlayer.maxHp, localPlayer.hp + 65);
        spawnCombatText(localPlayer.x, localPlayer.y, '+65 MEND', '#10b981');
      }
      updateVitalsUI();
      broadcastState();
    }

    function executePrimaryStrike(target) {
      const dist = Math.hypot(localPlayer.x - target.x, localPlayer.y - target.y);
      if (dist > 95) {
        localPlayer.targetX = target.x;
        localPlayer.targetY = target.y;
        return;
      }

      localPlayer.facing = target.x >= localPlayer.x ? 1 : -1;
      localPlayer.swingTimer = 18;
      spawnSlashArc(target.x, target.y, localPlayer.facing, '#f4d28c', 52);

      const dmg = 26 + Math.floor(Math.random() * 14);
      target.hp -= dmg;
      spawnCombatText(target.x, target.y, `-${dmg}`, '#ff4d4d');

      if (target.hp <= 0) {
        const idx = enemies.indexOf(target);
        if (idx !== -1) handleEnemyDefeat(target, idx);
      }
      broadcastState();
    }

    function handleEnemyDefeat(target, idx) {
      enemies.splice(idx, 1);
      localPlayer.kills++;
      if (localPlayer.kills % 3 === 0) {
        localPlayer.level++;
        localPlayer.maxHp += 20;
        localPlayer.hp = localPlayer.maxHp;
        document.getElementById('vitals-lvl').textContent = `LV.${localPlayer.level}`;
        spawnCombatText(localPlayer.x, localPlayer.y - 20, `LEVEL UP! LV.${localPlayer.level}`, '#f4d28c');
      }
      if (localPlayer.targetEntityId === target.id) localPlayer.targetEntityId = null;
      if (enemies.length < 6) setTimeout(spawnHellEnemies, 3000);
      updateVitalsUI();
    }

    function spawnCombatText(x, y, text, color) {
      combatTexts.push({ x, y: y - 28, text, color, life: 50, maxLife: 50 });
    }

    function sendChat() {
      const input = document.getElementById('chat-input');
      const val = input.value.trim();
      if (!val) {
        input.blur();
        return;
      }
      appendChat(localPlayer.name, val);
      localPlayer.chatBubble = val;
      localPlayer.chatTimer = 240;
      broadcastChat(val);
      broadcastState();
      input.value = '';
      input.blur();
    }

    function appendChat(author, text) {
      const log = document.getElementById('chat-log');
      const div = document.createElement('div');
      div.className = 'chat-msg';
      div.innerHTML = `<span class="author">${escapeHtml(author)}:</span><span>${escapeHtml(text)}</span>`;
      log.appendChild(div);
      log.scrollTop = log.scrollHeight;
    }

    function escapeHtml(str) {
      return str.replace(/[&<>"']/g, m => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
      }[m]));
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.textContent = msg;
      toast.style.display = 'block';
      clearTimeout(window._tTimer);
      window._tTimer = setTimeout(() => { toast.style.display = 'none'; }, 2400);
    }

    // CRT Scanline Toggle
    document.getElementById('btn-toggle-crt').addEventListener('click', (e) => {
      const crt = document.getElementById('crt-overlay');
      const hidden = crt.style.display === 'none';
      crt.style.display = hidden ? 'block' : 'none';
      e.currentTarget.textContent = hidden ? '📺 CRT: ON' : '📺 CRT: OFF';
    });

    document.getElementById('btn-copy-invite').addEventListener('click', () => {
      const temp = document.createElement('textarea');
      temp.value = window.location.href;
      document.body.appendChild(temp);
      temp.select();
      document.execCommand('copy');
      document.body.removeChild(temp);
      showToast('Shard Invite URL Copied!');
    });

    document.getElementById('btn-home-shard').addEventListener('click', () => {
      const u = new URL(window.location.href);
      u.searchParams.delete('shard');
      window.location.href = u.toString();
    });

    document.getElementById('btn-awaken').addEventListener('click', () => {
      const nameInput = document.getElementById('char-name').value.trim();
      if (nameInput) localPlayer.name = nameInput;
      localPlayer.race = document.getElementById('char-race').value;
      localPlayer.className = document.getElementById('char-class').value;
      localPlayer.domainName = document.getElementById('hell-name').value.trim() || 'Eclipse Bastion';

      const raceMeta = RACES[localPlayer.race] || RACES['Human-Standard'];
      const classMeta = CLASSES[localPlayer.className] || CLASSES['Fighter'];
      localPlayer.maxHp = classMeta.hp + raceMeta.hpBonus;
      localPlayer.hp = localPlayer.maxHp;
      localPlayer.maxMana = classMeta.mana;
      localPlayer.mana = localPlayer.maxMana;
      localPlayer.speed = 220 * raceMeta.speedMod;

      document.getElementById('char-modal').style.display = 'none';
      document.getElementById('hud').style.display = 'block';

      document.getElementById('vitals-name').textContent = localPlayer.name;
      document.getElementById('vitals-subtitle').textContent = `${raceMeta.name} • ${classMeta.name}`;

      initNetworking();
      updateVitalsUI();
      appendChat('Chronicle', `You stand within ${localPlayer.domainName}. Apostles prowl the outer flagstones.`);
    });

    function updateVitalsUI() {
      document.getElementById('hp-txt').textContent = `${Math.max(0, Math.round(localPlayer.hp))}/${localPlayer.maxHp}`;
      document.getElementById('hp-fill').style.width = `${Math.max(0, (localPlayer.hp / localPlayer.maxHp) * 100)}%`;
      document.getElementById('mana-txt').textContent = `${Math.max(0, Math.round(localPlayer.mana))}/${localPlayer.maxMana}`;
      document.getElementById('mana-fill').style.width = `${Math.max(0, (localPlayer.mana / localPlayer.maxMana) * 100)}%`;
    }

    // --- MAIN TICK & GAME LOOP ---
    let lastTime = performance.now();
    let netTickTimer = 0;

    function gameLoop(now) {
      const dt = Math.min((now - lastTime) / 1000, 0.1);
      lastTime = now;

      updatePreview(now);

      let moveX = 0;
      let moveY = 0;

      if (keys['w'] || keys['arrowup']) moveY -= 1;
      if (keys['s'] || keys['arrowdown']) moveY += 1;
      if (keys['a'] || keys['arrowleft']) moveX -= 1;
      if (keys['d'] || keys['arrowright']) moveX += 1;

      if (moveX !== 0 || moveY !== 0) {
        localPlayer.targetX = null;
        localPlayer.targetY = null;
        const len = Math.hypot(moveX, moveY);
        localPlayer.x += (moveX / len) * localPlayer.speed * dt;
        localPlayer.y += (moveY / len) * localPlayer.speed * dt;
        if (Math.abs(moveX) > 0.05) localPlayer.facing = moveX > 0 ? 1 : -1;
        localPlayer.isMoving = true;
      } else if (localPlayer.targetX !== null && localPlayer.targetY !== null) {
        const dx = localPlayer.targetX - localPlayer.x;
        const dy = localPlayer.targetY - localPlayer.y;
        const dist = Math.hypot(dx, dy);
        if (dist > 6) {
          localPlayer.x += (dx / dist) * localPlayer.speed * dt;
          localPlayer.y += (dy / dist) * localPlayer.speed * dt;
          if (Math.abs(dx) > 2) localPlayer.facing = dx > 0 ? 1 : -1;
          localPlayer.isMoving = true;
        } else {
          localPlayer.targetX = null;
          localPlayer.targetY = null;
          localPlayer.isMoving = false;
        }
      } else {
        localPlayer.isMoving = false;
      }

      // Passive Mana / Od Recovery
      localPlayer.mana = Math.min(localPlayer.maxMana, localPlayer.mana + 3.5 * dt);

      localPlayer.x = Math.max(60, Math.min(WORLD_SIZE - 60, localPlayer.x));
      localPlayer.y = Math.max(60, Math.min(WORLD_SIZE - 60, localPlayer.y));

      const coreDist = Math.hypot(localPlayer.x - DOMAIN_CORE.x, localPlayer.y - DOMAIN_CORE.y);
      if (coreDist < DOMAIN_CORE.radius) {
        const pushAngle = Math.atan2(localPlayer.y - DOMAIN_CORE.y, localPlayer.x - DOMAIN_CORE.x);
        localPlayer.x = DOMAIN_CORE.x + Math.cos(pushAngle) * DOMAIN_CORE.radius;
        localPlayer.y = DOMAIN_CORE.y + Math.sin(pushAngle) * DOMAIN_CORE.radius;
      }

      enemies.forEach(en => {
        const distToPlayer = Math.hypot(localPlayer.x - en.x, localPlayer.y - en.y);
        if (distToPlayer < 420 && distToPlayer > 32) {
          const ang = Math.atan2(localPlayer.y - en.y, localPlayer.x - en.x);
          en.x += Math.cos(ang) * en.speed * dt;
          en.y += Math.sin(ang) * en.speed * dt;
        }
        if (distToPlayer < 46) {
          en.attackCooldown -= dt;
          if (en.attackCooldown <= 0) {
            en.attackCooldown = 1.35;
            const hitDmg = 10 + Math.floor(Math.random() * 7);
            localPlayer.hp = Math.max(10, localPlayer.hp - hitDmg);
            spawnCombatText(localPlayer.x, localPlayer.y, `-${hitDmg}`, '#e03c3c');
            updateVitalsUI();
          }
        }
      });

      if (localPlayer.swingTimer > 0) localPlayer.swingTimer--;
      if (localPlayer.chatTimer > 0) {
        localPlayer.chatTimer--;
        if (localPlayer.chatTimer <= 0) localPlayer.chatBubble = null;
      }

      remotePlayers.forEach(p => {
        if (p.chatTimer > 0) {
          p.chatTimer--;
          if (p.chatTimer <= 0) p.chatBubble = null;
        }
        if (p.swingTimer > 0) p.swingTimer--;
      });

      for (let i = slashArcs.length - 1; i >= 0; i--) {
        slashArcs[i].life--;
        if (slashArcs[i].life <= 0) slashArcs.splice(i, 1);
      }
      for (let i = bloodSparks.length - 1; i >= 0; i--) {
        const sp = bloodSparks[i];
        sp.x += sp.vx * dt;
        sp.y += sp.vy * dt;
        sp.life--;
        if (sp.life <= 0) bloodSparks.splice(i, 1);
      }
      for (let i = combatTexts.length - 1; i >= 0; i--) {
        const ct = combatTexts[i];
        ct.y -= 26 * dt;
        ct.life--;
        if (ct.life <= 0) combatTexts.splice(i, 1);
      }

      netTickTimer += dt;
      if (netTickTimer > 0.08) {
        broadcastState();
        netTickTimer = 0;
      }

      render(now * 0.001);
      requestAnimationFrame(gameLoop);
    }

    // --- 90s ANIME LOW-FANTASY WORLD RENDERING ---
    function drawAnimeMonster(ctx, en, timeSec, isTargeted) {
      ctx.save();
      ctx.translate(en.x, en.y);

      if (isTargeted) {
        ctx.strokeStyle = '#ff2a38';
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        ctx.ellipse(0, 6, en.radius + 10, (en.radius + 10) * 0.45, 0, 0, Math.PI * 2);
        ctx.stroke();
      }

      // Shadow
      ctx.fillStyle = 'rgba(0,0,0,0.65)';
      ctx.beginPath();
      ctx.ellipse(0, 6, en.radius, en.radius * 0.45, 0, 0, Math.PI * 2);
      ctx.fill();

      const bob = Math.sin(timeSec * 6 + en.x) * 3;
      ctx.translate(0, bob);
      ctx.strokeStyle = '#050308';
      ctx.lineWidth = 2.4;

      if (en.type === 'imp') {
        // Behelit / Crimson Gargoyle Imp with Wings & Glowing Yellow Eyes
        ctx.fillStyle = '#3b1018';
        ctx.beginPath();
        ctx.moveTo(0, -10); ctx.lineTo(-22, -24); ctx.lineTo(-14, -2); ctx.closePath();
        ctx.moveTo(0, -10); ctx.lineTo(22, -24);  ctx.lineTo(14, -2);  ctx.closePath();
        ctx.fill(); ctx.stroke();

        ctx.fillStyle = en.color;
        ctx.beginPath();
        ctx.ellipse(0, -10, 13, 15, 0, 0, Math.PI * 2);
        ctx.fill(); ctx.stroke();

        ctx.fillStyle = '#fde047';
        ctx.fillRect(-6, -13, 4, 3);
        ctx.fillRect(2, -13, 4, 3);
      } else if (en.type === 'hound') {
        // Jagged Black-Dog Beast of Darkness
        ctx.fillStyle = '#1f121c';
        ctx.beginPath();
        ctx.moveTo(-20, 2);
        ctx.lineTo(-14, -15);
        ctx.lineTo(-4, -12);
        ctx.lineTo(6, -18);
        ctx.lineTo(20, -8);
        ctx.lineTo(16, 4);
        ctx.closePath();
        ctx.fill(); ctx.stroke();

        ctx.fillStyle = '#ff2a38';
        ctx.fillRect(8, -12, 5, 2.5);
      } else {
        // Towering Horned Obsidian Apostle
        ctx.fillStyle = '#381e4a';
        ctx.beginPath();
        ctx.roundRect(-18, -32, 36, 34, 8);
        ctx.fill(); ctx.stroke();

        // Giant Curved Horns
        ctx.fillStyle = '#d6c5ad';
        ctx.beginPath();
        ctx.moveTo(-12, -28); ctx.lineTo(-28, -44); ctx.lineTo(-6, -30); ctx.closePath();
        ctx.moveTo(12, -28);  ctx.lineTo(28, -44);  ctx.lineTo(6, -30);  ctx.closePath();
        ctx.fill(); ctx.stroke();

        ctx.fillStyle = '#ff2a38';
        ctx.fillRect(-8, -20, 5, 3);
        ctx.fillRect(3, -20, 5, 3);
      }

      // Monster HP Bar
      const hpRatio = Math.max(0, en.hp / en.maxHp);
      ctx.fillStyle = '#050308';
      ctx.fillRect(-18, -en.radius - 24, 36, 6);
      ctx.fillStyle = '#e03c3c';
      ctx.fillRect(-17, -en.radius - 23, 34 * hpRatio, 4);

      ctx.font = '700 10px Cinzel, serif';
      ctx.textAlign = 'center';
      ctx.fillStyle = '#e6dac8';
      ctx.shadowColor = '#000';
      ctx.shadowBlur = 3;
      ctx.fillText(en.name, 0, -en.radius - 28);
      ctx.shadowBlur = 0;

      ctx.restore();
    }

    function render(timeSec) {
      ctx.clearRect(0, 0, screenW, screenH);

      const camX = localPlayer.x - screenW / 2;
      const camY = localPlayer.y - screenH / 2;

      ctx.save();
      ctx.translate(-camX, -camY);

      // 1. Hand-Painted Dark Stone Cavern Base
      ctx.fillStyle = '#110d19';
      ctx.fillRect(0, 0, WORLD_SIZE, WORLD_SIZE);

      // Ink-Hatched Stone Flagstone Grid
      ctx.strokeStyle = 'rgba(38, 30, 54, 0.65)';
      ctx.lineWidth = 1.5;
      const tile = 96;
      const startX = Math.floor(camX / tile) * tile;
      const startY = Math.floor(camY / tile) * tile;
      for (let x = startX; x < camX + screenW + tile; x += tile) {
        ctx.beginPath(); ctx.moveTo(x, camY); ctx.lineTo(x, camY + screenH); ctx.stroke();
      }
      for (let y = startY; y < camY + screenH + tile; y += tile) {
        ctx.beginPath(); ctx.moveTo(camX, y); ctx.lineTo(camX + screenW, y); ctx.stroke();
      }

      // 2. Central Eclipse Citadel Flagstone Ring & Brand of Sacrifice Runes
      ctx.fillStyle = '#191324';
      ctx.strokeStyle = '#050308';
      ctx.lineWidth = 4;
      ctx.beginPath();
      ctx.arc(DOMAIN_CORE.x, DOMAIN_CORE.y, 380, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();

      ctx.strokeStyle = 'rgba(184, 40, 50, 0.38)';
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.arc(DOMAIN_CORE.x, DOMAIN_CORE.y, 290, 0, Math.PI * 2);
      ctx.stroke();

      // 3. Gothic Pillars & Flickering Crimson Braziers
      for (let i = 0; i < hellProps.length; i++) {
        const prop = hellProps[i];
        if (prop.x < camX - 80 || prop.x > camX + screenW + 80 || prop.y < camY - 80 || prop.y > camY + screenH + 80) continue;

        ctx.strokeStyle = '#050308';
        ctx.lineWidth = 2.5;
        if (prop.type === 'pillar') {
          ctx.fillStyle = '#251e33';
          ctx.beginPath();
          ctx.arc(prop.x, prop.y, prop.size, 0, Math.PI * 2);
          ctx.fill();
          ctx.stroke();
          // Cel shadow crescent
          ctx.fillStyle = '#140f1d';
          ctx.beginPath();
          ctx.arc(prop.x + 3, prop.y + 3, prop.size * 0.7, 0, Math.PI * 2);
          ctx.fill();
        } else {
          // Flickering Hellfire Brazier
          const glowR = prop.size * (1.5 + Math.sin(timeSec * 7 + i) * 0.2);
          const grad = ctx.createRadialGradient(prop.x, prop.y, 2, prop.x, prop.y, glowR);
          grad.addColorStop(0, 'rgba(255, 110, 48, 0.65)');
          grad.addColorStop(1, 'rgba(255, 50, 30, 0)');
          ctx.fillStyle = grad;
          ctx.beginPath();
          ctx.arc(prop.x, prop.y, glowR, 0, Math.PI * 2);
          ctx.fill();

          ctx.fillStyle = '#2b1d24';
          ctx.beginPath();
          ctx.arc(prop.x, prop.y, prop.size * 0.55, 0, Math.PI * 2);
          ctx.fill();
          ctx.stroke();

          ctx.fillStyle = '#ff6b35';
          ctx.beginPath();
          ctx.arc(prop.x, prop.y - 2, prop.size * 0.3, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      // 4. Central Crimson Behelit / Obsidian Monolith Shrine
      const shrineGrad = ctx.createRadialGradient(DOMAIN_CORE.x, DOMAIN_CORE.y, 20, DOMAIN_CORE.x, DOMAIN_CORE.y, 280);
      shrineGrad.addColorStop(0, 'rgba(184, 32, 48, 0.32)');
      shrineGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
      ctx.fillStyle = shrineGrad;
      ctx.beginPath();
      ctx.arc(DOMAIN_CORE.x, DOMAIN_CORE.y, 280, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#24152b';
      ctx.strokeStyle = '#050308';
      ctx.lineWidth = 4;
      ctx.beginPath();
      ctx.arc(DOMAIN_CORE.x, DOMAIN_CORE.y, DOMAIN_CORE.radius, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();

      ctx.strokeStyle = '#d6a85a';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.arc(DOMAIN_CORE.x, DOMAIN_CORE.y, DOMAIN_CORE.radius - 10, 0, Math.PI * 2);
      ctx.stroke();

      ctx.fillStyle = '#f4d28c';
      ctx.font = '900 13px Cinzel, serif';
      ctx.textAlign = 'center';
      ctx.shadowColor = '#000';
      ctx.shadowBlur = 4;
      ctx.fillText(localPlayer.domainName.toUpperCase(), DOMAIN_CORE.x, DOMAIN_CORE.y + 4);
      ctx.shadowBlur = 0;

      // 5. Render Apostles & Beasts
      enemies.forEach(en => {
        drawAnimeMonster(ctx, en, timeSec, en.id === localPlayer.targetEntityId);
      });

      // 6. Depth-Sorted Players
      const allPlayers = [localPlayer, ...Array.from(remotePlayers.values())];
      allPlayers.sort((a, b) => a.y - b.y);
      allPlayers.forEach(p => {
        drawAnimeCharacter(ctx, p, p.x, p.y, timeSec, 1.0, false);
        drawPlayerNameAndSpeech(ctx, p);
      });

      // 7. Anime Crescent Weapon Slash Arcs & Blood Sparks
      slashArcs.forEach(arc => {
        ctx.save();
        const alpha = arc.life / arc.maxLife;
        ctx.strokeStyle = arc.color;
        ctx.lineWidth = 6 * alpha;
        ctx.beginPath();
        ctx.arc(arc.x, arc.y - 18, arc.radius, -0.8, 0.8);
        ctx.stroke();
        ctx.restore();
      });

      bloodSparks.forEach(sp => {
        ctx.fillStyle = sp.color;
        ctx.fillRect(sp.x, sp.y, 3.5, 3.5);
      });

      // 8. Floating Combat Damage Popups
      combatTexts.forEach(ct => {
        ctx.font = '900 14px Cinzel, serif';
        ctx.textAlign = 'center';
        ctx.fillStyle = ct.color;
        ctx.strokeStyle = '#000';
        ctx.lineWidth = 3;
        ctx.strokeText(ct.text, ct.x, ct.y);
        ctx.fillText(ct.text, ct.x, ct.y);
      });

      ctx.restore();
    }

    function drawPlayerNameAndSpeech(ctx, p) {
      const raceMeta = RACES[p.race] || RACES['Human-Standard'];
      const topY = p.y - 58 * raceMeta.scale;

      ctx.save();
      ctx.textAlign = 'center';
      ctx.font = '800 12px Cinzel, serif';
      ctx.strokeStyle = '#000';
      ctx.lineWidth = 3;
      ctx.strokeText(p.name, p.x, topY);
      ctx.fillStyle = p.id === localPlayer.id ? '#f4d28c' : '#e2d9c8';
      ctx.fillText(p.name, p.x, topY);

      ctx.font = 'italic 11px Crimson Pro, serif';
      ctx.fillStyle = '#b89872';
      ctx.fillText(`<${raceMeta.name}>`, p.x, topY + 11);

      if (p.chatBubble) {
        ctx.font = '600 13px Crimson Pro, serif';
        const txtW = ctx.measureText(p.chatBubble).width;
        const boxW = Math.max(txtW + 18, 54);
        const boxH = 24;
        const boxX = p.x - boxW / 2;
        const boxY = topY - 36;

        ctx.fillStyle = 'rgba(12, 10, 18, 0.95)';
        ctx.strokeStyle = '#d6a85a';
        ctx.lineWidth = 1.5;
        ctx.fillRect(boxX, boxY, boxW, boxH);
        ctx.strokeRect(boxX, boxY, boxW, boxH);

        ctx.fillStyle = '#fff4db';
        ctx.fillText(p.chatBubble, p.x, boxY + 16);
      }
      ctx.restore();
    }

    requestAnimationFrame(gameLoop);
  </script>
</body>
