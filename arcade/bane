          'Wood Elf': { name: 'Elf (Wildwood)', scale: 0.98, skin: '#cfa882', hpBonus: 25, speedMod: 1.10, ears: true, desc: '"Feral labyrinth stalker."' },
          'High Elf': { name: 'Elf (Fallen High)', scale: 1.0, skin: '#e0c6ad', hpBonus: 15, speedMod: 1.06, ears: true, desc: '"Exiled noble house seeking redemption."' },
          'Blood Elf':{ name: 'Elf (Crimson)',  scale: 0.99, skin: '#d99a96', hpBonus: 30, speedMod: 1.07, ears: true, desc: '"Mana-starved siphon mage."' }
        }
      },
      'Dwarf': {
        desc: 'Stout subterranean smiths carved from stone and magma.',
