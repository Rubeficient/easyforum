    function updateGatesAutoProximity(dt) {
      GATES.forEach(g => {
        if (!g.manualLock) {
          const d = Math.hypot(localPlayer.x - g.x, localPlayer.y - g.y);
          if (d < 145 && !g.isOpen) {
            g.isOpen = true;
            playSfx('gate');
            if (typeof g.gx2 === 'number') {
              getOrGenerateSector(g.gx2, g.gy2, localPlayer.name, true);
            }
          } else if (d > 210 && g.isOpen) {
            g.isOpen = false;
          }
        }
        const targetAnim = g.isOpen ? 1 : 0;
        g.openAnim = (g.openAnim || 0) + (targetAnim - (g.openAnim || 0)) * Math.min(1, dt * 10);
      });
    }

    function toggleNearestGate() {
      let nearest = null;
      let minDist = 185;
      GATES.forEach(g => {
        const d = Math.hypot(localPlayer.x - g.x, localPlayer.y - g.y);
        if (d < minDist) {
          minDist = d;
          nearest = g;
        }
      });

      if (nearest) {
        nearest.isOpen = !nearest.isOpen;
        nearest.manualLock = !nearest.isOpen;
        playSfx('gate');
        if (nearest.isOpen && typeof nearest.gx2 === 'number') {
          getOrGenerateSector(nearest.gx2, nearest.gy2, localPlayer.name, true);
        }
        showToast(`${nearest.label}: ${nearest.isOpen ? 'OPENED ⛩️' : 'LOCKED SHUT 🔒'}`);
      } else {
        showToast('Move closer to a Portcullis Gate to toggle it!');
      }
    }

    function isNearOpenGateThreshold(px, py) {
      for (const g of GATES) {
        if (!g.isOpen) continue;
        if (g.horiz) {
          if (Math.abs(px - g.x) < 130 && Math.abs(py - g.y) < 95) return true;
        } else {
          if (Math.abs(px - g.x) < 95 && Math.abs(py - g.y) < 130) return true;
        }
      }
      return false;
    }

    function isBlockedByClosedGate(px, py) {
      for (const g of GATES) {
        if (g.isOpen) continue;
        if (g.horiz) {
          if (Math.abs(px - g.x) < 120 && Math.abs(py - g.y) < 16) return true;
        } else {
          if (Math.abs(px - g.x) < 16 && Math.abs(py - g.y) < 120) return true;
        }
      }
      return false;
    }

    function getWalkableSectorAt(px, py, allowAutoGenerate = false) {
      if (isBlockedByClosedGate(px, py)) return null;

      const gx = Math.floor(px / TILE_SIZE);
      const gy = Math.floor(py / TILE_SIZE);
      const key = sectorKey(gx, gy);

      let sec = worldSectors.get(key);
      if (!sec && allowAutoGenerate) {
        sec = getOrGenerateSector(gx, gy, localPlayer.name, true);
      }
      if (!sec) return null;

      if (isNearOpenGateThreshold(px, py)) {
        return sec;
      }

      for (let i = 0; i < sec.rects.length; i++) {
        const r = sec.rects[i];
        if (px >= r.x + 8 && px <= r.x + r.w - 8 && py >= r.y + 8 && py <= r.y + r.h - 8) {
          return sec;
        }
      }
      return null;
    }

    function resolveDungeonMovement(entity, nextX, nextY, isLocalPlayer = false) {
      if (getWalkableSectorAt(nextX, entity.y, isLocalPlayer)) {
        entity.x = nextX;
      }
      if (getWalkableSectorAt(entity.x, nextY, isLocalPlayer)) {
        entity.y = nextY;
      }

      for (let i = 0; i < SOLID_PILLARS.length; i++) {
        const pil = SOLID_PILLARS[i];
        const dist = Math.hypot(entity.x - pil.x, entity.y - pil.y);
        const minR = pil.r + 14;
        if (dist < minR && dist > 0.001) {
          const ang = Math.atan2(entity.y - pil.y, entity.x - pil.x);
          entity.x = pil.x + Math.cos(ang) * minR;
          entity.y = pil.y + Math.sin(ang) * minR;
        }
      }

      const fDist = Math.hypot(entity.x - FIREPIT_POS.x, entity.y - FIREPIT_POS.y);
      if (fDist < FIREPIT_POS.radius + 14) {
        const ang = Math.atan2(entity.y - FIREPIT_POS.y, entity.x - FIREPIT_POS.x);
        entity.x = FIREPIT_POS.x + Math.cos(ang) * (FIREPIT_POS.radius + 14);
        entity.y = FIREPIT_POS.y + Math.sin(ang) * (FIREPIT_POS.radius + 14);
      }
    }

    function isInsideFirepitSafezone(x, y) {
      return Math.hypot(x - FIREPIT_POS.x, y - FIREPIT_POS.y) <= FIREPIT_POS.safeRadius;
    }

    // =========================================================================
    // 11. 4-PLAYER DETERMINISTIC AUTO-MESH MULTIPLAYER + TOP-LEFT PARTY PROFILES
    // =========================================================================
    const remotePlayers = new Map();
    let peerInstance = null;
    const peerConnections = new Map();
    let localBroadcastChannel = null;

    function getSlotPeerId(shard, slotNum) {
      const cleanShard = String(shard || 'MAIN').toUpperCase().replace(/[^A-Z0-9]/g, '');
      return `tartaria-v7-${cleanShard}-slot-${slotNum}`;
    }

    function initFourPlayerMesh(shardCode) {
      localPlayer.shardCode = String(shardCode || 'MAIN').toUpperCase().replace(/[^A-Z0-9]/g, '') || 'MAIN';

      try {
        if (typeof BroadcastChannel !== 'undefined') {
          if (localBroadcastChannel) localBroadcastChannel.close();
          localBroadcastChannel = new BroadcastChannel('tartaria_v7_mesh_' + localPlayer.shardCode);
          localBroadcastChannel.onmessage = (ev) => {
            if (ev.data && ev.data.id !== localPlayer.id) handleNetworkPacket(ev.data);
          };
        }
      } catch (e) {}

      if (typeof Peer === 'undefined') return;

      function tryClaimSlot(slotAttempt) {
        if (slotAttempt > 4) {
          createPeerWithId(undefined, 4);
          return;
        }
        const candidateId = getSlotPeerId(localPlayer.shardCode, slotAttempt);
        createPeerWithId(candidateId, slotAttempt);
      }

      function createPeerWithId(myPeerId, slotNum) {
        try {
          const p = myPeerId ? new Peer(myPeerId) : new Peer();
          peerInstance = p;

          p.on('open', () => {
            localPlayer.slotNum = slotNum;
            connectToAllOtherSlots();
            updatePartyRosterUI();
          });

          p.on('connection', (conn) => { setupPeerConn(conn); });
          p.on('error', (err) => {
            if (err.type === 'unavailable-id' && myPeerId) tryClaimSlot(slotNum + 1);
          });
        } catch (err) {}
      }

      tryClaimSlot(1);

      setInterval(() => {
        connectToAllOtherSlots();
        pruneStalePlayers();
      }, 3500);
    }

    function connectToAllOtherSlots() {
      if (!peerInstance || peerInstance.disconnected || peerInstance.destroyed) return;
      for (let s = 1; s <= 4; s++) {
        if (s === localPlayer.slotNum) continue;
        const targetPeerId = getSlotPeerId(localPlayer.shardCode, s);
        if (!peerConnections.has(targetPeerId)) {
          try {
            const conn = peerInstance.connect(targetPeerId, { reliable: false });
            setupPeerConn(conn);
          } catch (e) {}
        }
      }
    }

    function setupPeerConn(conn) {
      conn.on('open', () => {
        peerConnections.set(conn.peer, conn);
        broadcastState();
      });
      conn.on('data', (data) => {
        if (data && data.id !== localPlayer.id) handleNetworkPacket(data);
      });
      conn.on('close', () => { peerConnections.delete(conn.peer); });
      conn.on('error', () => { peerConnections.delete(conn.peer); });
    }

    function sendPacket(packet) {
      if (localBroadcastChannel) {
        try { localBroadcastChannel.postMessage(packet); } catch (e) {}
      }
      peerConnections.forEach(conn => {
        if (conn && conn.open) {
          try { conn.send(packet); } catch (e) {}
        }
      });
    }

    function handleNetworkPacket(data) {
      if (!data || !data.id || data.id === localPlayer.id) return;

      if (data.type === 'state') {
        let p = remotePlayers.get(data.id);
        if (!p) {
          p = { ...data, lastSeen: performance.now() };
          remotePlayers.set(data.id, p);
          appendChat('Party Shard', `⚔️ ${p.name} (${p.raceLabel}) joined Slot ${p.slotNum || '?'}!`);
          updatePartyRosterUI();
        } else {
          Object.assign(p, data);
          p.lastSeen = performance.now();
        }
        const rgx = Math.floor(p.x / TILE_SIZE);
        const rgy = Math.floor(p.y / TILE_SIZE);
        if (!worldSectors.has(sectorKey(rgx, rgy))) {
          getOrGenerateSector(rgx, rgy, p.name, false);
        }
      } else if (data.type === 'sector_mapped') {
        getOrGenerateSector(data.gx, data.gy, data.discoverer, false);
      } else if (data.type === 'proj') {
        projectiles.push({ ...data.proj, isRemote: true });
      } else if (data.type === 'chat') {
        appendChat(data.sender, data.text);
      } else if (data.type === 'pvp_hit') {
        if (data.targetId === localPlayer.id) {
          if (isInsideFirepitSafezone(localPlayer.x, localPlayer.y)) return;
          localPlayer.hp = Math.max(0, localPlayer.hp - data.dmg);
          localPlayer.hitFlash = 8;
          playSfx('slash');
          spawnCombatText(localPlayer.x, localPlayer.y, `-${data.dmg} (${data.attackerName})`, '#ff2a38');
          updateVitalsUI();
          if (localPlayer.hp <= 0) handleFullLootDeath(data.attackerName);
        }
      } else if (data.type === 'corpse_drop') {
        lootChests.push(data.chest);
        appendChat('Full-Loot PvP', `💀 ${data.victimName} fell! Corpse Satchel dropped!`);
      }
    }

