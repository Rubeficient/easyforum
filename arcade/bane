      'wss://free.blr2.piesocket.com/v3/tartaria_mmo_core?api_key=VCXCEuvhGcBDP7XhiJJUDvR1e1D3eiVjgZ9VRiaV&notify_self=0'
    ];
    let activeSocket = null;
    let socketConnected = false;

    function initNetworking() {
      try {
        const ws = new WebSocket(RELAY_SERVERS[0]);
        activeSocket = ws;
        ws.onopen = () => {
          socketConnected = true;
          broadcastState();
        };
        ws.onmessage = (e) => {
          try {
            const data = JSON.parse(e.data);
            if (data && data.id && data.id !== localPlayer.id) handleIncomingPacket(data);
          } catch(err) {}
        };
        ws.onerror = () => { socketConnected = false; };
      } catch(err) {}
    }

    function handleIncomingPacket(data) {
      if (!data || !data.id || data.id === localPlayer.id) return;
      if (data.type === 'state') {
        let p = remotePlayers.get(data.id);
        if (!p) {
          p = { ...data };
          remotePlayers.set(data.id, p);
          appendChat('Tartaria Realm', `${p.name} (${p.raceLabel}) stepped into the realm.`);
        } else {
          Object.assign(p, data);
        }
      } else if (data.type === 'chat') {
        appendChat(data.sender, data.text);
      }
    }

    function broadcastState() {
      const packet = {
        type: 'state',
        id: localPlayer.id,
        name: localPlayer.name,
        raceCategory: localPlayer.raceCategory,
        subraceKey: localPlayer.subraceKey,
        raceLabel: localPlayer.raceLabel,
        coreClass: localPlayer.coreClass,
        eliteClass: localPlayer.eliteClass,
        prestigeClass: localPlayer.prestigeClass,
        prestigeSet: localPlayer.prestigeSet,
        armorColor: localPlayer.armorColor,
        hairColor: localPlayer.hairColor,
        x: Math.round(localPlayer.x),
        y: Math.round(localPlayer.y),
        facing: localPlayer.facing,
        isMoving: localPlayer.isMoving,
        swingTimer: localPlayer.swingTimer,
        level: localPlayer.level,
        chatBubble: localPlayer.chatBubble,
        chatTimer: localPlayer.chatTimer
      };
      if (localBroadcastChannel) {
        try { localBroadcastChannel.postMessage(packet); } catch(e) {}
      }
      if (activeSocket && socketConnected && activeSocket.readyState === WebSocket.OPEN) {
        try { activeSocket.send(JSON.stringify(packet)); } catch(e) {}
      }
    }

    function broadcastChat(text) {
      const packet = { type: 'chat', id: localPlayer.id, sender: localPlayer.name, text };
      if (localBroadcastChannel) {
        try { localBroadcastChannel.postMessage(packet); } catch(e) {}
      }
      if (activeSocket && socketConnected && activeSocket.readyState === WebSocket.OPEN) {
        try { activeSocket.send(JSON.stringify(packet)); } catch(e) {}
      }
    }

    function spawnSlashArc(x, y, facing, color = '#f3e5ab', radius = 48) {
      slashArcs.push({ x, y, facing, color, radius, life: 14, maxLife: 14 });
      for (let i = 0; i < 8; i++) {
        bloodSparks.push({
          x, y: y - 15,
          vx: (Math.random() - 0.2) * facing * 180,
          vy: (Math.random() - 0.8) * 140,
          color: i % 2 === 0 ? '#8b0000' : color,
          life: 18
        });
      }
    }

    function triggerAbility(slot) {
      initAudio();
      if (slot === 1) {
        let target = enemies.find(e => e.id === localPlayer.targetEntityId);
        if (!target && enemies.length > 0) {
          cycleTabTarget();
          target = enemies.find(e => e.id === localPlayer.targetEntityId);
        }
        if (target) executePrimaryStrike(target);
      } else if (slot === 2) {
        if (localPlayer.mana < 15) {
          showToast('Insufficient Spell MP!');
          return;
        }
        localPlayer.mana -= 15;
        localPlayer.swingTimer = 20;
        playSound('spell');
        const chant = '"MAHALITO!!"';
        localPlayer.chatBubble = chant;
        localPlayer.chatTimer = 95;
        spawnSlashArc(localPlayer.x, localPlayer.y, localPlayer.facing, '#e85d24', 145);

        for (let i = enemies.length - 1; i >= 0; i--) {
          const en = enemies[i];
          if (Math.hypot(en.x - localPlayer.x, en.y - localPlayer.y) < 175) {
            const spellDmg = 55 + localPlayer.dmgBonus;
            en.hp -= spellDmg;
            spawnCombatText(en.x, en.y, `-${spellDmg} MAHALITO`, '#f3e5ab');
            if (en.hp <= 0) handleEnemyDefeat(en, i);
          }
        }
      } else if (slot === 3) {
        localPlayer.speed = 415;
        localPlayer.chatBubble = '"PORFIC!!"';
        localPlayer.chatTimer = 70;
        playSound('spell');
        spawnSlashArc(localPlayer.x, localPlayer.y, localPlayer.facing, '#38bdf8', 42);
        setTimeout(() => {
          const sub = getSubraceMeta(localPlayer);
          localPlayer.speed = 230 * sub.speedMod;
        }, 2100);
        showToast('PORFIC Shield Active!');
      } else if (slot === 4) {
        if (localPlayer.mana < 15) {
          showToast('Insufficient Spell MP!');
          return;
        }
        localPlayer.mana -= 15;
        const healAmt = 75 + localPlayer.dmgBonus;
        localPlayer.hp = Math.min(localPlayer.maxHp, localPlayer.hp + healAmt);
        localPlayer.chatBubble = '"MADI!!"';
        localPlayer.chatTimer = 85;
        playSound('spell');
        spawnCombatText(localPlayer.x, localPlayer.y, `+${healAmt} MADI`, '#10b981');
      }
      updateVitalsUI();
      broadcastState();
    }

    function executePrimaryStrike(target) {
      const dist = Math.hypot(localPlayer.x - target.x, localPlayer.y - target.y);
      if (dist > 95) {
        localPlayer.targetX = target.x;
        localPlayer.targetY = target.y;
        return;
      }

      localPlayer.facing = target.x >= localPlayer.x ? 1 : -1;
      localPlayer.swingTimer = 18;
      playSound('sword');
      spawnSlashArc(target.x, target.y, localPlayer.facing, '#f3e5ab', 52);

      const dmg = 28 + localPlayer.dmgBonus + Math.floor(Math.random() * 14);
      target.hp -= dmg;
      spawnCombatText(target.x, target.y, `-${dmg}`, '#ff4d4d');

      if (target.hp <= 0) {
        const idx = enemies.indexOf(target);
        if (idx !== -1) handleEnemyDefeat(target, idx);
      }
      broadcastState();
    }

    function handleEnemyDefeat(target, idx) {
      enemies.splice(idx, 1);
      localPlayer.xp += target.xpValue || 40;
      localPlayer.gold += 25;

      if (localPlayer.xp >= localPlayer.nextXp) {
        localPlayer.xp -= localPlayer.nextXp;
        localPlayer.level++;
        localPlayer.nextXp = Math.round(localPlayer.nextXp * 1.25);
        localPlayer.maxHp += 25;
        localPlayer.hp = localPlayer.maxHp;
        localPlayer.maxMana += 10;
        localPlayer.mana = localPlayer.maxMana;
        document.getElementById('vitals-lvl').textContent = `LV.${localPlayer.level}`;
        spawnCombatText(localPlayer.x, localPlayer.y - 25, `LEVEL UP! LV.${localPlayer.level}`, '#f3e5ab');
      }
      saveGameProgress();
      if (localPlayer.targetEntityId === target.id) localPlayer.targetEntityId = null;
      if (enemies.length < 10) setTimeout(spawnTartariaHostiles, 3000);
      updateVitalsUI();
    }

    function handlePlayerPvPDeath() {
      playSound('hurt');
      showToast('YOU WERE SLAIN IN FULL-LOOT PVP!');
      appendChat('Tartaria Realm', `${localPlayer.name} was slain in full-loot PvP! Backpack satchel looted.`);
      
      // Full Loot Penalty
      localPlayer.gold = Math.max(0, localPlayer.gold - 50);
      localPlayer.backpack = ['Empty', 'Empty', 'Empty', 'Empty', 'Empty', 'Empty', 'Empty', 'Empty'];
      
      // Respawn at Safezone Central Firepit
      localPlayer.x = FIREPIT_POS.x;
      localPlayer.y = FIREPIT_POS.y;
      localPlayer.hp = localPlayer.maxHp;
      localPlayer.mana = localPlayer.maxMana;
      saveGameProgress();
      updateVitalsUI();
    }

    function spawnCombatText(x, y, text, color) {
      combatTexts.push({ x, y: y - 28, text, color, life: 52, maxLife: 52 });
    }

    function sendChat() {
      const input = document.getElementById('chat-input');
      const val = input.value.trim();
      if (!val) { input.blur(); return; }
      appendChat(localPlayer.name, val);
      localPlayer.chatBubble = val;
      localPlayer.chatTimer = 240;
      broadcastChat(val);
      broadcastState();
      input.value = '';
      input.blur();
    }

    function appendChat(author, text) {
      const log = document.getElementById('chat-log');
      const div = document.createElement('div');
      div.className = 'chat-msg';
      div.innerHTML = `<span class="author">${escapeHtml(author)}:</span><span>${escapeHtml(text)}</span>`;
      log.appendChild(div);
      log.scrollTop = log.scrollHeight;
    }

    function escapeHtml(str) {
      return str.replace(/[&<>"']/g, m => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
      }[m]));
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.textContent = msg;
      toast.style.display = 'block';
      clearTimeout(window._tTimer);
      window._tTimer = setTimeout(() => { toast.style.display = 'none'; }, 2600);
    }

    document.getElementById('btn-toggle-crt').addEventListener('click', (e) => {
      const crt = document.getElementById('crt-overlay');
      const hidden = crt.style.display === 'none';
      crt.style.display = hidden ? 'block' : 'none';
      e.currentTarget.textContent = hidden ? '📺 CRT: ON' : '📺 CRT: OFF';
    });

    document.getElementById('btn-copy-invite').addEventListener('click', () => {
      const temp = document.createElement('textarea');
      temp.value = window.location.href;
      document.body.appendChild(temp);
      temp.select();
      document.execCommand('copy');
      document.body.removeChild(temp);
      showToast('Tartaria Server Link Copied!');
    });

    document.getElementById('btn-awaken').addEventListener('click', () => {
      initAudio();
      const nameInput = document.getElementById('char-name').value.trim();
      if (nameInput) localPlayer.name = nameInput;
      localPlayer.raceCategory = document.getElementById('char-race').value;
      localPlayer.subraceKey = document.getElementById('char-subrace').value;
      localPlayer.coreClass = document.getElementById('char-class').value;

      const subMeta = getSubraceMeta(localPlayer);
      const classMeta = CLASS_PROGRESSION[localPlayer.coreClass];
      localPlayer.raceLabel = subMeta.name;
      localPlayer.maxHp = classMeta.hp + subMeta.hpBonus;
      localPlayer.hp = localPlayer.maxHp;
      localPlayer.maxMana = classMeta.mana;
      localPlayer.mana = localPlayer.maxMana;
      localPlayer.speed = 230 * subMeta.speedMod;

      loadGameProgress(); // Load saved xp, gold & gear if returning

      document.getElementById('char-modal').style.display = 'none';
      document.getElementById('hud').style.display = 'block';

      document.getElementById('vitals-name').textContent = localPlayer.name;
      document.getElementById('vitals-race').textContent = `${localPlayer.raceCategory} • ${subMeta.name}`;

      initNetworking();
      updateVitalsUI();
      showToast('Connected to Tartaria Central Server.');
    });

    function updateVitalsUI() {
      document.getElementById('vitals-class').textContent = getActiveClassTitle(localPlayer);
      document.getElementById('hp-txt').textContent = `${Math.max(0, Math.round(localPlayer.hp))}/${localPlayer.maxHp}`;
      document.getElementById('hp-fill').style.width = `${Math.max(0, (localPlayer.hp / localPlayer.maxHp) * 100)}%`;
      document.getElementById('mana-txt').textContent = `${Math.max(0, Math.round(localPlayer.mana))}/${localPlayer.maxMana}`;
      document.getElementById('mana-fill').style.width = `${Math.max(0, (localPlayer.mana / localPlayer.maxMana) * 100)}%`;
      document.getElementById('xp-txt').textContent = `${localPlayer.xp}/${localPlayer.nextXp}`;
      document.getElementById('xp-fill').style.width = `${Math.min(100, (localPlayer.xp / localPlayer.nextXp) * 100)}%`;
    }

    let lastTime = performance.now();
    let netTickTimer = 0;

    function gameLoop(now) {
      const dt = Math.min((now - lastTime) / 1000, 0.1);
      lastTime = now;

      updatePreview(now);

      let moveX = 0, moveY = 0;
      if (keys['w'] || keys['arrowup']) moveY -= 1;
      if (keys['s'] || keys['arrowdown']) moveY += 1;
      if (keys['a'] || keys['arrowleft']) moveX -= 1;
      if (keys['d'] || keys['arrowright']) moveX += 1;

      if (moveX !== 0 || moveY !== 0) {
        localPlayer.targetX = null;
        localPlayer.targetY = null;
        const len = Math.hypot(moveX, moveY);
        localPlayer.x += (moveX / len) * localPlayer.speed * dt;
        localPlayer.y += (moveY / len) * localPlayer.speed * dt;
        if (Math.abs(moveX) > 0.05) localPlayer.facing = moveX > 0 ? 1 : -1;
        localPlayer.isMoving = true;
      } else if (localPlayer.targetX !== null && localPlayer.targetY !== null) {
        const dx = localPlayer.targetX - localPlayer.x;
        const dy = localPlayer.targetY - localPlayer.y;
        const dist = Math.hypot(dx, dy);
        if (dist > 6) {
          localPlayer.x += (dx / dist) * localPlayer.speed * dt;
          localPlayer.y += (dy / dist) * localPlayer.speed * dt;
          if (Math.abs(dx) > 2) localPlayer.facing = dx > 0 ? 1 : -1;
          localPlayer.isMoving = true;
        } else {
          localPlayer.targetX = null;
          localPlayer.targetY = null;
          localPlayer.isMoving = false;
        }
      } else {
        localPlayer.isMoving = false;
      }

      // Determine current room and Safezone status
      let currentRoom = ROOMS[0];
      for (const r of ROOMS) {
        if (localPlayer.x >= r.x - r.w/2 && localPlayer.x <= r.x + r.w/2 &&
            localPlayer.y >= r.y - r.h/2 && localPlayer.y <= r.y + r.h/2) {
          currentRoom = r;
          break;
        }
      }

      const pvpStatusEl = document.getElementById('pvp-zone-status');
      const shardStatusEl = document.getElementById('shard-status');
      shardStatusEl.textContent = currentRoom.name;

      if (currentRoom.safe) {
        pvpStatusEl.textContent = '[SAFEZONE ACTIVE]';
        pvpStatusEl.style.color = '#22c55e';
        localPlayer.hp = Math.min(localPlayer.maxHp, localPlayer.hp + 8 * dt);
        localPlayer.mana = Math.min(localPlayer.maxMana, localPlayer.mana + 10 * dt);
      } else {
        pvpStatusEl.textContent = '[FULL LOOT PVP ACTIVE!]';
        pvpStatusEl.style.color = '#ef4444';
        localPlayer.mana = Math.min(localPlayer.maxMana, localPlayer.mana + 3 * dt);
      }

      localPlayer.x = Math.max(60, Math.min(WORLD_SIZE - 60, localPlayer.x));
      localPlayer.y = Math.max(60, Math.min(WORLD_SIZE - 60, localPlayer.y));

      // Central firepit collision
      const distToFire = Math.hypot(localPlayer.x - FIREPIT_POS.x, localPlayer.y - FIREPIT_POS.y);
      if (distToFire < FIREPIT_POS.radius) {
        const pushAngle = Math.atan2(localPlayer.y - FIREPIT_POS.y, localPlayer.x - FIREPIT_POS.x);
        localPlayer.x = FIREPIT_POS.x + Math.cos(pushAngle) * FIREPIT_POS.radius;
        localPlayer.y = FIREPIT_POS.y + Math.sin(pushAngle) * FIREPIT_POS.radius;
      }

      enemies.forEach(en => {
        const distToPlayer = Math.hypot(localPlayer.x - en.x, localPlayer.y - en.y);
        if (distToPlayer < 380 && distToPlayer > 30) {
          const ang = Math.atan2(localPlayer.y - en.y, localPlayer.x - en.x);
          en.x += Math.cos(ang) * en.speed * dt;
          en.y += Math.sin(ang) * en.speed * dt;
        }
        if (distToPlayer < 46) {
          en.attackCooldown -= dt;
          if (en.attackCooldown <= 0) {
            en.attackCooldown = 1.3;
            const hitDmg = 12 + Math.floor(Math.random() * 8);
            localPlayer.hp = Math.max(0, localPlayer.hp - hitDmg);
            playSound('hurt');
            spawnCombatText(localPlayer.x, localPlayer.y, `-${hitDmg}`, '#ef4444');
            updateVitalsUI();
            if (localPlayer.hp <= 0) handlePlayerPvPDeath();
          }
        }
      });

      if (localPlayer.swingTimer > 0) localPlayer.swingTimer--;
      if (localPlayer.chatTimer > 0) {
        localPlayer.chatTimer--;
        if (localPlayer.chatTimer <= 0) localPlayer.chatBubble = null;
      }

      remotePlayers.forEach(p => {
        if (p.chatTimer > 0) {
          p.chatTimer--;
          if (p.chatTimer <= 0) p.chatBubble = null;
        }
        if (p.swingTimer > 0) p.swingTimer--;
      });

      for (let i = slashArcs.length - 1; i >= 0; i--) {
        slashArcs[i].life--;
        if (slashArcs[i].life <= 0) slashArcs.splice(i, 1);
      }
      for (let i = bloodSparks.length - 1; i >= 0; i--) {
        const sp = bloodSparks[i];
        sp.x += sp.vx * dt;
        sp.y += sp.vy * dt;
        sp.life--;
        if (sp.life <= 0) bloodSparks.splice(i, 1);
      }
      for (let i = combatTexts.length - 1; i >= 0; i--) {
        const ct = combatTexts[i];
        ct.y -= 26 * dt;
        ct.life--;
        if (ct.life <= 0) combatTexts.splice(i, 1);
      }

      netTickTimer += dt;
      if (netTickTimer > 0.08) {
        broadcastState();
        netTickTimer = 0;
      }

      render(now * 0.001);
      requestAnimationFrame(gameLoop);
    }

    function drawHostile(ctx, en, timeSec, isTargeted) {
      ctx.save();
      ctx.translate(en.x, en.y);

      if (isTargeted) {
        ctx.strokeStyle = '#ff2a38';
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        ctx.ellipse(0, 6, en.radius + 10, (en.radius + 10) * 0.45, 0, 0, Math.PI * 2);
        ctx.stroke();
      }

      ctx.fillStyle = 'rgba(0,0,0,0.65)';
      ctx.beginPath();
      ctx.ellipse(0, 6, en.radius, en.radius * 0.45, 0, 0, Math.PI * 2);
      ctx.fill();

      const bob = Math.sin(timeSec * 6 + en.x) * 2.5;
      ctx.translate(0, bob);
      ctx.strokeStyle = '#050308';
      ctx.lineWidth = 2.2;

      if (en.kind === 'bunny') {
        ctx.fillStyle = '#f8fafc';
        ctx.beginPath();
        ctx.ellipse(0, -8, 12, 10, 0, 0, Math.PI * 2);
        ctx.fill(); ctx.stroke();
        ctx.beginPath();
        ctx.ellipse(-4, -22, 3, 9, -0.2, 0, Math.PI * 2);
        ctx.ellipse(4, -22, 3, 9, 0.2, 0, Math.PI * 2);
        ctx.fill(); ctx.stroke();
      } else {
        ctx.fillStyle = en.color;
        ctx.beginPath();
        ctx.roundRect(-12, -28, 24, 26, 4);
        ctx.fill(); ctx.stroke();
        ctx.fillStyle = '#fde68a';
        ctx.beginPath();
        ctx.arc(0, -35, 9, 0, Math.PI * 2);
        ctx.fill(); ctx.stroke();
      }

      const hpRatio = Math.max(0, en.hp / en.maxHp);
      ctx.fillStyle = '#050308';
      ctx.fillRect(-18, -en.radius - 26, 36, 6);
      ctx.fillStyle = '#ef4444';
      ctx.fillRect(-17, -en.radius - 25, 34 * hpRatio, 4);

      ctx.font = '700 10px Cinzel, serif';
      ctx.textAlign = 'center';
      ctx.fillStyle = '#fca5a5';
      ctx.shadowColor = '#000';
      ctx.shadowBlur = 3;
      ctx.fillText(en.name, 0, -en.radius - 30);
      ctx.shadowBlur = 0;

      ctx.restore();
    }

    function render(timeSec) {
      ctx.clearRect(0, 0, screenW, screenH);

      const camX = localPlayer.x - screenW / 2;
      const camY = localPlayer.y - screenH / 2;

      ctx.save();
      ctx.translate(-camX, -camY);

      ctx.fillStyle = '#0b0910';
      ctx.fillRect(0, 0, WORLD_SIZE, WORLD_SIZE);

      // Draw the 5 connected Tartaria Rooms & Hallways
      ROOMS.forEach(r => {
        ctx.fillStyle = r.safe ? '#14111c' : '#1a1014';
        ctx.strokeStyle = r.safe ? '#3d2d1f' : '#8b0000';
        ctx.lineWidth = r.safe ? 4 : 5;
        ctx.fillRect(r.x - r.w/2, r.y - r.h/2, r.w, r.h);
        ctx.strokeRect(r.x - r.w/2, r.y - r.h/2, r.w, r.h);

        // Room Name Banner
        ctx.font = '900 14px Cinzel, serif';
        ctx.textAlign = 'center';
        ctx.fillStyle = r.safe ? '#d4af37' : '#ef4444';
        ctx.fillText(r.name.toUpperCase(), r.x, r.y - r.h/2 + 30);
      });

      // Central Firepit
      const fireGrad = ctx.createRadialGradient(FIREPIT_POS.x, FIREPIT_POS.y, 20, FIREPIT_POS.x, FIREPIT_POS.y, 280);
      fireGrad.addColorStop(0, 'rgba(212, 175, 55, 0.45)');
      fireGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
      ctx.fillStyle = fireGrad;
      ctx.beginPath();
      ctx.arc(FIREPIT_POS.x, FIREPIT_POS.y, 280, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#3d2d1f';
      ctx.beginPath();
      ctx.arc(FIREPIT_POS.x, FIREPIT_POS.y, FIREPIT_POS.radius, 0, Math.PI * 2);
      ctx.fill(); ctx.stroke();

      ctx.fillStyle = '#d4af37';
      ctx.beginPath();
      ctx.arc(FIREPIT_POS.x, FIREPIT_POS.y, FIREPIT_POS.radius * 0.5, 0, Math.PI * 2);
      ctx.fill();

      // Render NPCs
      tartariaNpcs.forEach(npc => {
        ctx.fillStyle = '#8b0000';
        ctx.beginPath();
        ctx.arc(npc.x, npc.y, 16, 0, Math.PI * 2);
        ctx.fill(); ctx.stroke();

        ctx.font = '700 11px Cinzel, serif';
        ctx.textAlign = 'center';
        ctx.fillStyle = '#f3e5ab';
        ctx.fillText(npc.name, npc.x, npc.y - 22);
        ctx.font = 'italic 10px Crimson Pro, serif';
        ctx.fillStyle = '#b8975a';
        ctx.fillText(`<${npc.title}>`, npc.x, npc.y - 10);
      });

      enemies.forEach(en => {
        drawHostile(ctx, en, timeSec, en.id === localPlayer.targetEntityId);
      });

      const allPlayers = [localPlayer, ...Array.from(remotePlayers.values())];
      allPlayers.sort((a, b) => a.y - b.y);
      allPlayers.forEach(p => {
        drawOVACharacter(ctx, p, p.x, p.y, timeSec, 1.0, false);
        drawPlayerTag(ctx, p);
      });

      slashArcs.forEach(arc => {
        ctx.save();
        const alpha = arc.life / arc.maxLife;
        ctx.strokeStyle = arc.color;
        ctx.lineWidth = 6 * alpha;
        ctx.beginPath();
        ctx.arc(arc.x, arc.y - 18, arc.radius, -0.8, 0.8);
        ctx.stroke();
        ctx.restore();
      });

      bloodSparks.forEach(sp => {
        ctx.fillStyle = sp.color;
        ctx.fillRect(sp.x, sp.y, 3.5, 3.5);
      });

      combatTexts.forEach(ct => {
        ctx.font = '900 14px Cinzel, serif';
        ctx.textAlign = 'center';
        ctx.fillStyle = ct.color;
        ctx.strokeStyle = '#000';
        ctx.lineWidth = 3;
        ctx.strokeText(ct.text, ct.x, ct.y);
        ctx.fillText(ct.text, ct.x, ct.y);
      });

      ctx.restore();
    }

    function drawPlayerTag(ctx, p) {
      const subMeta = getSubraceMeta(p);
      const topY = p.y - 58 * subMeta.scale;

      ctx.save();
      ctx.textAlign = 'center';
      ctx.font = '800 12px Cinzel, serif';
      ctx.strokeStyle = '#000';
