    function drawOVACharacter(ctx, p, cx, cy, timeSec, scaleOverride = 1.0, isTargeted = false) {
      const subMeta = getSubraceMeta(p);
      const sc = subMeta.scale * scaleOverride;
      const facing = p.facing || 1;
      const isMoving = p.isMoving;
      const walkBob = isMoving ? Math.abs(Math.sin(timeSec * 11)) * -4.5 : Math.sin(timeSec * 2.8) * 1.5;
      const stride = isMoving ? Math.sin(timeSec * 11) * 6 : 0;

      ctx.save();
      ctx.translate(cx, cy);

      if (isTargeted) {
        ctx.strokeStyle = '#ff2a38';
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        ctx.ellipse(0, 4, 28 * sc, 13 * sc, 0, 0, Math.PI * 2);
        ctx.stroke();
      }

      ctx.fillStyle = 'rgba(0, 0, 0, 0.72)';
      ctx.beginPath();
      ctx.ellipse(0, 5, 19 * sc, 8.5 * sc, 0, 0, Math.PI * 2);
      ctx.fill();

      ctx.save();
      ctx.scale(facing * sc, sc);
      ctx.translate(0, walkBob);

      ctx.lineJoin = 'round';
      ctx.lineCap = 'round';

      if (subMeta.wings) {
        const flap = Math.sin(timeSec * 5) * 4;
        ctx.fillStyle = '#4a0000';
        ctx.strokeStyle = '#050308';
        ctx.lineWidth = 2.2;
        ctx.beginPath();
        ctx.moveTo(-4, -24);
        ctx.lineTo(-30, -42 + flap);
        ctx.lineTo(-24, -15);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();
      }

      const cloakWave = Math.sin(timeSec * 5 + (isMoving ? 2 : 0)) * (isMoving ? 7 : 2.5);
      ctx.fillStyle = p.armorColor || '#8b0000';
      ctx.strokeStyle = '#050308';
      ctx.lineWidth = 2.4;
      ctx.beginPath();
      ctx.moveTo(-9, -30);
      ctx.lineTo(9, -30);
      ctx.lineTo(13 - cloakWave, 2);
      ctx.lineTo(-14 - cloakWave, 3);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();

      ctx.fillStyle = '#17141f';
      ctx.strokeStyle = '#050308';
      ctx.lineWidth = 2.2;
      ctx.fillRect(-7 + stride * 0.5, -12, 6, 14);
      ctx.strokeRect(-7 + stride * 0.5, -12, 6, 14);
      ctx.fillRect(2 - stride * 0.5, -12, 6, 14);
      ctx.strokeRect(2 - stride * 0.5, -12, 6, 14);

      ctx.fillStyle = '#282330';
      ctx.strokeStyle = '#050308';
      ctx.lineWidth = 2.4;
      ctx.beginPath();
      ctx.roundRect(-10, -30, 20, 20, 3);
      ctx.fill();
      ctx.stroke();

      const headY = -39;
      const headR = 10.5;
      ctx.fillStyle = subMeta.skin;
      ctx.beginPath();
      ctx.arc(0, headY, headR, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();

      if (subMeta.snout) {
        ctx.fillStyle = subMeta.skin;
        ctx.beginPath();
        ctx.roundRect(4, headY - 2, 10, 7, 2);
        ctx.fill();
        ctx.stroke();
      }

      if (subMeta.ears) {
        ctx.fillStyle = subMeta.skin;
        ctx.beginPath();
        ctx.moveTo(-headR + 1, headY - 1);
        ctx.lineTo(-headR - 10, headY - 6);
        ctx.lineTo(-headR + 2, headY + 3);
        ctx.closePath();
        ctx.fill(); ctx.stroke();
      } else if (subMeta.catEars) {
        ctx.fillStyle = subMeta.skin;
        ctx.beginPath();
        ctx.moveTo(-8, headY - 7); ctx.lineTo(-10, headY - 17); ctx.lineTo(-2, headY - 9); ctx.closePath();
        ctx.moveTo(2, headY - 9);  ctx.lineTo(9, headY - 17);  ctx.lineTo(8, headY - 7);  ctx.closePath();
        ctx.fill(); ctx.stroke();
      } else if (subMeta.horns) {
        ctx.fillStyle = '#f3e5ab';
        ctx.beginPath();
        ctx.moveTo(-5, headY - 7); ctx.lineTo(-15, headY - 22); ctx.lineTo(-1, headY - 9); ctx.closePath();
        ctx.moveTo(5, headY - 7);  ctx.lineTo(15, headY - 22);  ctx.lineTo(1, headY - 9);  ctx.closePath();
        ctx.fill(); ctx.stroke();
      } else {
        ctx.fillStyle = p.hairColor || '#d9d2c5';
        ctx.beginPath();
        ctx.moveTo(-11, headY - 3);
        ctx.lineTo(-7, headY - 15);
        ctx.lineTo(0, headY - 11);
        ctx.lineTo(6, headY - 15);
        ctx.lineTo(11, headY - 4);
        ctx.closePath();
        ctx.fill(); ctx.stroke();
      }

      ctx.fillStyle = '#ff3838';
      ctx.fillRect(2, headY - 2, 2.5, 2.5);
      ctx.fillRect(6.5, headY - 2, 2.5, 2.5);

      const swingRot = p.swingTimer > 0 ? Math.sin(p.swingTimer * 0.35) * 1.45 : (isMoving ? Math.sin(timeSec * 11) * 0.18 : 0);
      ctx.save();
      ctx.translate(10, -20);
      ctx.rotate(swingRot);

      ctx.fillStyle = '#d4af37';
      ctx.fillRect(-5, -3, 10, 3);
      ctx.fillStyle = '#cbd5e1';
      ctx.strokeStyle = '#050308';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(-3, -3); ctx.lineTo(-2, -38); ctx.lineTo(2, -42); ctx.lineTo(3, -3);
      ctx.closePath();
      ctx.fill(); ctx.stroke();

      ctx.restore();
      ctx.restore();
      ctx.restore();
    }

