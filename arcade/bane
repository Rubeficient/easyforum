    const slotCooldowns = new Array(9).fill(0);

    function triggerSpellSlot(slotIdx) {
      initAudioEngine();
      const unlocked = Math.min(9, localPlayer.level);
      if (slotIdx + 1 > unlocked) {
        showToast(`Slot ${slotIdx + 1} unlocks at Level ${slotIdx + 1}!`);
        return;
      }

      const nowSec = performance.now() * 0.001;
      if (nowSec < slotCooldowns[slotIdx]) return;

      const spellId = localPlayer.spellBar[slotIdx] || 'strike';
      const sp = GRIMOIRE_SPELLS.find(s => s.id === spellId) || GRIMOIRE_SPELLS[0];

      if (localPlayer.mana < sp.mp) {
        showToast(`Need ${sp.mp} MP for ${sp.name}!`);
        return;
      }

      localPlayer.mana -= sp.mp;
      slotCooldowns[slotIdx] = nowSec + sp.cd;
      localPlayer.swingTimer = 18;
      localPlayer.chatBubble = sp.chant;
      localPlayer.chatTimer = 75;

      const totalPower = sp.dmg + localPlayer.dmgBonus;

      if (sp.type === 'heal') {
        playSfx('spell');
        localPlayer.hp = Math.min(localPlayer.maxHp, localPlayer.hp + totalPower);
        spawnSpellVortex(localPlayer.x, localPlayer.y, sp.color, 75, 'runes');
        spawnCombatText(localPlayer.x, localPlayer.y, `+${totalPower} ${sp.name}`, '#4ade80');
      } else if (sp.type === 'buff') {
        playSfx('spell');
        localPlayer.hp = Math.min(localPlayer.maxHp, localPlayer.hp + sp.dmg);
        localPlayer.speed = 410;
        spawnSpellVortex(localPlayer.x, localPlayer.y, sp.color, 85, 'shield');
        setTimeout(() => { recalcEquipmentStats(); }, 2400);
        showToast(`${sp.name} Active!`);
      } else if (sp.type === 'dash') {
        playSfx('slash');
        const dashX = localPlayer.x + localPlayer.facing * 130;
        resolveDungeonMovement(localPlayer, dashX, localPlayer.y);
        spawnSlashArc(localPlayer.x, localPlayer.y, localPlayer.facing, sp.color, 85);
        damageTargetsInRadius(localPlayer.x, localPlayer.y, 130, totalPower, sp.name, sp.color);
      } else if (sp.type === 'aoe') {
        playSfx('spell');
        spawnSpellVortex(localPlayer.x, localPlayer.y, sp.color, 175, 'vortex');
        damageTargetsInRadius(localPlayer.x, localPlayer.y, 180, totalPower, sp.name, sp.color);
      } else {
        // Melee or Bolt against target or front cone
        playSfx('slash');
        let target = findCurrentTarget();
        if (target && Math.hypot(target.x - localPlayer.x, target.y - localPlayer.y) <= (sp.type === 'bolt' ? 280 : 115)) {
          localPlayer.facing = target.x >= localPlayer.x ? 1 : -1;
          spawnSlashArc(target.x, target.y, localPlayer.facing, sp.color, 58);
          spawnSpellVortex(target.x, target.y, sp.color, 52, 'burst');
          applyHitToTarget(target, totalPower, sp.name, sp.color);
        } else {
          spawnSlashArc(localPlayer.x + localPlayer.facing * 35, localPlayer.y, localPlayer.facing, sp.color, 56);
          damageTargetsInRadius(localPlayer.x + localPlayer.facing * 40, localPlayer.y, 90, totalPower, sp.name, sp.color);
        }
      }

      updateVitalsUI();
      broadcastState();
    }

    function findCurrentTarget() {
      const mob = enemies.find(e => e.id === localPlayer.targetEntityId);
      if (mob) return { ...mob, isPlayer: false, ref: mob };
      const rem = remotePlayers.get(localPlayer.targetEntityId);
      if (rem) return { ...rem, isPlayer: true, ref: rem };
      return null;
    }

    function damageTargetsInRadius(cx, cy, radius, dmg, label, color) {
      // Hit Dungeon Hostiles
      for (let i = enemies.length - 1; i >= 0; i--) {
        const en = enemies[i];
        if (Math.hypot(en.x - cx, en.y - cy) <= radius) {
          en.hp -= dmg;
          spawnCombatText(en.x, en.y, `-${dmg} ${label}`, color);
          if (en.hp <= 0) handleEnemyKilled(en, i);
        }
      }

      // Full-Loot PvP Check (Only if BOTH attacker and victim are outside the Firepit Safezone)
      if (!isInsideFirepitSafezone(localPlayer.x, localPlayer.y)) {
        remotePlayers.forEach(rp => {
          if (!isInsideFirepitSafezone(rp.x, rp.y) && Math.hypot(rp.x - cx, rp.y - cy) <= radius) {
            sendPacket({
              type: 'pvp_hit',
              id: localPlayer.id,
              targetId: rp.id,
              attackerName: localPlayer.name,
              dmg: dmg
            });
            spawnCombatText(rp.x, rp.y, `-${dmg} PVP!`, '#ff2a38');
          }
        });
      }
    }

    function applyHitToTarget(targetWrapper, dmg, label, color) {
      if (targetWrapper.isPlayer) {
        if (isInsideFirepitSafezone(localPlayer.x, localPlayer.y) || isInsideFirepitSafezone(targetWrapper.ref.x, targetWrapper.ref.y)) {
          showToast('Central Firepit is a Safezone—No PvP here!');
