        const en = targetWrapper.ref;
        const isCrit = Math.random() < 0.3;
        const finalDmg = isCrit ? Math.round(dmg * 1.5) : dmg;
        en.hp -= finalDmg;
        spawnCombatText(en.x, en.y, isCrit ? `-${finalDmg} BEHEAD CRIT!` : `-${finalDmg}`, isCrit ? '#84cc16' : color);
        if (en.hp <= 0) {
