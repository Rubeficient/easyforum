    function recalcEquipmentStats() {
      const subMeta = getSubraceMeta(localPlayer);
      const classMeta = CLASS_PROGRESSION[localPlayer.coreClass] || CLASS_PROGRESSION['Rogue'];
      const lvlBonusHp = (localPlayer.level - 1) * 32;
      const lvlBonusMp = (localPlayer.level - 1) * 16;

      const activeWpn = getActiveWeapon();
      let eqAtk = (localPlayer.level - 1) * 6 + (activeWpn ? activeWpn.atk : 15);
      let eqHp = activeWpn ? (activeWpn.hp || 0) : 0;
      let eqMp = activeWpn ? (activeWpn.mp || 0) : 0;

      ['armor', 'relic'].forEach(k => {
        const it = localPlayer.equipped[k];
        if (it) {
          eqAtk += it.atk || 0;
          eqHp  += it.hp  || 0;
          eqMp  += it.mp  || 0;
        }
      });

      localPlayer.dmgBonus = eqAtk;
      localPlayer.maxHp = classMeta.hp + subMeta.hpBonus + lvlBonusHp + eqHp;
      localPlayer.maxMana = classMeta.mana + lvlBonusMp + eqMp;
      localPlayer.hp = Math.min(localPlayer.hp, localPlayer.maxHp);
      localPlayer.mana = Math.min(localPlayer.mana, localPlayer.maxMana);
      localPlayer.speed = localPlayer.baseSpeed * subMeta.speedMod;
      updateWeaponRackUI();
    }

