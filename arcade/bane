      ctx.fillStyle = 'rgba(0, 0, 0, 0.48)';

      ctx.beginPath();

      const shadowW = charData.race === 'Centaur' ? 28 * sc : 18 * sc;

      ctx.ellipse(0, 4, shadowW, 9 * sc, 0, 0, Math.PI * 2);

      ctx.fill();



      const isMoving = charData.isMoving;

      const walkCycle = isMoving ? Math.sin(time * 11) : Math.sin(time * 2.5);

      const bobY = charData.sitting ? 6 * sc : (isMoving ? Math.abs(walkCycle) * -5 * sc : walkCycle * 1.5 * sc);



      ctx.save();

      ctx.scale((charData.facing || 1) * sc, sc);

      ctx.translate(0, bobY);



      if (charData.race === 'Nephilim') {

        const wingFlap = Math.sin(time * (isMoving ? 8 : 3)) * 0.14;

        ctx.save();

        ctx.fillStyle = '#1b162a';

        ctx.strokeStyle = '#4c3a6e';

        ctx.lineWidth = 1.5;

        ctx.save();

        ctx.rotate(-0.2 + wingFlap);

        ctx.beginPath();

        ctx.moveTo(-4, -26);

        ctx.quadraticCurveTo(-34, -48, -38, -18);

        ctx.quadraticCurveTo(-24, -14, -6, -12);

        ctx.closePath();

        ctx.fill();

        ctx.stroke();

        ctx.restore();

        ctx.save();

        ctx.rotate(0.2 - wingFlap);

        ctx.beginPath();

        ctx.moveTo(4, -26);

        ctx.quadraticCurveTo(26, -45, 30, -18);

        ctx.quadraticCurveTo(18, -14, 6, -12);

        ctx.closePath();

        ctx.fill();

