    canvas.addEventListener('mousedown', (e) => {
      initAudioEngine();
      const camX = localPlayer.x - screenW / 2;
      const camY = localPlayer.y - screenH / 2;
      const clickX = e.clientX + camX;
      const clickY = e.clientY + camY;

      // 1. Check if clicking a Portcullis Gate lever
      for (const g of GATES) {
        if (Math.hypot(clickX - g.x, clickY - g.y) < 55) {
          g.isOpen = !g.isOpen;
          g.manualLock = !g.isOpen;
          playSfx('gate');
          showToast(`${g.label}: ${g.isOpen ? 'OPENED ⛩️' : 'LOCKED SHUT 🔒'}`);
          return;
        }
      }

      // 2. Check if clicking a Loot Chest / Corpse Bag
      for (let i = lootChests.length - 1; i >= 0; i--) {
        const ch = lootChests[i];
        if (Math.hypot(clickX - ch.x, clickY - ch.y) < 34) {
          if (Math.hypot(localPlayer.x - ch.x, localPlayer.y - ch.y) < 115) {
            claimChestLoot(i);
          } else {
            localPlayer.targetX = ch.x;
            localPlayer.targetY = ch.y;
          }
          return;
        }
      }

      // 3. Check if clicking an NPC Denizen
      for (const npc of TARTARIA_NPCS) {
        if (Math.hypot(clickX - npc.x, clickY - npc.y) < 38) {
          appendChat(npc.name, npc.dialog);
          showToast(`${npc.name}: ${npc.dialog}`);
          if (npc.isWerdna) {
            document.getElementById('werdna-modal').style.display = 'flex';
          }
          return;
        }
      }

      // 4. Check if clicking a Hostile Monster
      for (const en of enemies) {
        if (Math.hypot(clickX - en.x, clickY - en.y) < en.radius + 18) {
          localPlayer.targetEntityId = en.id;
          if (Math.hypot(localPlayer.x - en.x, localPlayer.y - en.y) < 110) {
            triggerSpellSlot(0);
          } else {
            localPlayer.targetX = en.x;
            localPlayer.targetY = en.y;
          }
          return;
        }
      }

      // 5. Check if clicking a Remote Player
      for (const rp of remotePlayers.values()) {
        if (Math.hypot(clickX - rp.x, clickY - rp.y) < 28) {
          localPlayer.targetEntityId = rp.id;
          showToast(`Targeted Denizen: ${rp.name}`);
          return;
        }
      }

      localPlayer.targetX = clickX;
      localPlayer.targetY = clickY;
    });

    function interactWithWorldObject() {
      for (let i = lootChests.length - 1; i >= 0; i--) {
        if (Math.hypot(localPlayer.x - lootChests[i].x, localPlayer.y - lootChests[i].y) < 115) {
          claimChestLoot(i);
          return;
        }
      }
      for (const npc of TARTARIA_NPCS) {
        if (Math.hypot(localPlayer.x - npc.x, localPlayer.y - npc.y) < 125) {
          appendChat(npc.name, npc.dialog);
          showToast(`${npc.name}: ${npc.dialog}`);
          if (npc.isWerdna) document.getElementById('werdna-modal').style.display = 'flex';
          return;
        }
      }
      toggleNearestGate();
    }

    function claimChestLoot(idx) {
      const ch = lootChests[idx];
      if (!ch) return;
      lootChests.splice(idx, 1);
      playSfx('loot');
      localPlayer.gold += ch.gold || 30;
      if (ch.item) {
        if (localPlayer.backpack.length < 8) {
          localPlayer.backpack.push({ ...ch.item });
          showToast(`Looted ${ch.item.name} & ${ch.gold}g! Press [I] to equip.`);
        } else {
          showToast(`Looted ${ch.gold}g! (Backpack full for ${ch.item.name})`);
        }
      }
      savePersistentProgress();
      updateVitalsUI();
    }

    function cycleTabTarget() {
      const candidates = [
        ...enemies.map(e => ({ id: e.id, name: e.name, x: e.x, y: e.y })),
        ...Array.from(remotePlayers.values()).map(p => ({ id: p.id, name: p.name, x: p.x, y: p.y }))
      ];
      if (candidates.length === 0) return;
      candidates.sort((a, b) =>
        Math.hypot(a.x - localPlayer.x, a.y - localPlayer.y) - Math.hypot(b.x - localPlayer.x, b.y - localPlayer.y)
      );
      const curIdx = candidates.findIndex(c => c.id === localPlayer.targetEntityId);
      const next = candidates[(curIdx + 1) % candidates.length];
      localPlayer.targetEntityId = next.id;
      showToast(`Targeted: ${next.name}`);
    }

    // =========================================================================
    // 13. JUN SUEMI CARD ART + 1991 OVA CEL CHARACTER & MONSTER RENDERER
    // =========================================================================
    function drawOVACharacter(ctx, p, cx, cy, timeSec, scaleOverride = 1.0, isTargeted = false) {
      const subMeta = getSubraceMeta(p);
      const sc = subMeta.scale * scaleOverride;
      const facing = p.facing || 1;
      const isMoving = p.isMoving;
      const walkBob = isMoving ? Math.abs(Math.sin(timeSec * 11)) * -4.5 : Math.sin(timeSec * 2.8) * 1.5;
      const stride = isMoving ? Math.sin(timeSec * 11) * 6 : 0;

      ctx.save();
      ctx.translate(cx, cy);

      if (isTargeted) {
        ctx.strokeStyle = '#ff2a38';
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        ctx.ellipse(0, 4, 28 * sc, 13 * sc, 0, 0, Math.PI * 2);
        ctx.stroke();
      }

      ctx.fillStyle = 'rgba(0, 0, 0, 0.75)';
      ctx.beginPath();
      ctx.ellipse(0, 5, 19 * sc, 8.5 * sc, 0, 0, Math.PI * 2);
      ctx.fill();

      ctx.save();
      ctx.scale(facing * sc, sc);
      ctx.translate(0, walkBob);
      ctx.lineJoin = 'round';
      ctx.lineCap = 'round';

      // Reptilian / Greater Demon Barbed Tail
      if (subMeta.tail) {
        ctx.strokeStyle = subMeta.skin;
        ctx.lineWidth = 5;
        ctx.beginPath();
        ctx.moveTo(-6, -8);
        ctx.quadraticCurveTo(-26, 2, -32, -12 + Math.sin(timeSec * 6) * 5);
        ctx.stroke();
      }

      // Bat Wings (Greater Demon / Imp)
      if (subMeta.wings) {
        const flap = Math.sin(timeSec * 6) * 5;
        ctx.fillStyle = subMeta.tail ? '#1e3a5f' : '#4a0808';
        ctx.strokeStyle = '#040306';
        ctx.lineWidth = 2.2;
        ctx.beginPath();
        ctx.moveTo(-4, -26);
        ctx.lineTo(-36, -48 + flap);
        ctx.lineTo(-28, -14);
        ctx.closePath();
        ctx.fill(); ctx.stroke();
      }

      // Billowing Cloak (Blue for Cobold King / Undead Warrior, Crimson/Custom for others)
      const cloakWave = Math.sin(timeSec * 5 + (isMoving ? 2 : 0)) * (isMoving ? 7 : 2.5);
      ctx.fillStyle = subMeta.skeleton ? '#3b82f6' : (subMeta.sunShield ? '#1d4ed8' : (p.armorColor || '#2b3d54'));
      ctx.strokeStyle = '#040306';
      ctx.lineWidth = 2.4;
      ctx.beginPath();
      ctx.moveTo(-10, -30);
      ctx.lineTo(10, -30);
      ctx.lineTo(14 - cloakWave, 3);
      ctx.lineTo(-15 - cloakWave, 3);
      ctx.closePath();
      ctx.fill(); ctx.stroke();

      // Legs
      ctx.fillStyle = subMeta.skeleton ? '#d6d3c4' : '#17141f';
      ctx.strokeStyle = '#040306';
      ctx.lineWidth = 2.2;
      ctx.fillRect(-7 + stride * 0.5, -12, 6, 14);
      ctx.strokeRect(-7 + stride * 0.5, -12, 6, 14);
      ctx.fillRect(2 - stride * 0.5, -12, 6, 14);
      ctx.strokeRect(2 - stride * 0.5, -12, 6, 14);

      // Torso / Ribcage / Shell Cuirass
      ctx.fillStyle = subMeta.shellChest ? '#b45309' : (subMeta.sunShield ? '#a16207' : '#282330');
      ctx.strokeStyle = '#040306';
      ctx.lineWidth = 2.4;
      ctx.beginPath();
      ctx.roundRect(-10, -30, 20, 20, 3);
      ctx.fill(); ctx.stroke();

      if (subMeta.skeleton) {
        // Exposed Skeletal Ribcage lines (Undead Warrior Card)
        ctx.strokeStyle = '#e5e5e5';
        ctx.lineWidth = 1.6;
        for (let r = -26; r <= -16; r += 4) {
          ctx.beginPath(); ctx.moveTo(-6, r); ctx.lineTo(6, r); ctx.stroke();
        }
      } else if (subMeta.shellChest) {
        // Fire Giant Silver Shell-Medallion on Chest
        ctx.fillStyle = '#e2e8f0';
        ctx.beginPath(); ctx.arc(0, -22, 6.5, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
      }

      // Head
      const headY = -39;
      const headR = 10.5;
      ctx.fillStyle = subMeta.skin;
      ctx.beginPath();
      ctx.arc(0, headY, headR, 0, Math.PI * 2);
      ctx.fill(); ctx.stroke();

      if (subMeta.snout) {
        ctx.fillStyle = subMeta.skin;
        ctx.beginPath();
        ctx.roundRect(4, headY - 2, 10, 7, 2);
        ctx.fill(); ctx.stroke();
      }

      if (subMeta.ears) {
        ctx.fillStyle = subMeta.skin;
        ctx.beginPath();
        ctx.moveTo(-headR + 1, headY - 1);
        ctx.lineTo(-headR - 10, headY - 7);
        ctx.lineTo(-headR + 2, headY + 3);
        ctx.closePath();
        ctx.fill(); ctx.stroke();
      } else if (subMeta.catEars) {
        ctx.fillStyle = subMeta.skin;
        ctx.beginPath();
        ctx.moveTo(-8, headY - 7); ctx.lineTo(-10, headY - 17); ctx.lineTo(-2, headY - 9); ctx.closePath();
        ctx.moveTo(2, headY - 9);  ctx.lineTo(9, headY - 17);  ctx.lineTo(8, headY - 7);  ctx.closePath();
        ctx.fill(); ctx.stroke();
      } else if (subMeta.horns) {
        ctx.fillStyle = subMeta.tail ? '#38bdf8' : '#f4dca6';
        ctx.beginPath();
        ctx.moveTo(-5, headY - 7); ctx.lineTo(-15, headY - 24); ctx.lineTo(-1, headY - 9); ctx.closePath();
        ctx.moveTo(5, headY - 7);  ctx.lineTo(15, headY - 24);  ctx.lineTo(1, headY - 9);  ctx.closePath();
        ctx.fill(); ctx.stroke();
      } else {
        ctx.fillStyle = subMeta.flamberge ? '#dc2626' : (p.hairColor || '#eab308');
        ctx.beginPath();
        ctx.moveTo(-11, headY - 3);
        ctx.lineTo(-7, headY - 15);
        ctx.lineTo(0, headY - 11);
        ctx.lineTo(6, headY - 15);
        ctx.lineTo(11, headY - 4);
        ctx.closePath();
        ctx.fill(); ctx.stroke();
      }

      // Glowing Eyes
      ctx.fillStyle = '#ff3838';
      ctx.fillRect(2, headY - 2, 2.5, 2.5);
      ctx.fillRect(6.5, headY - 2, 2.5, 2.5);

      // Left-Hand Cobold King Blazing Sun-Eye Shield!
      if (subMeta.sunShield) {
        ctx.save();
        ctx.translate(-9, -17);
        ctx.fillStyle = '#facc15';
        ctx.strokeStyle = '#040306';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.ellipse(0, 0, 9, 13, 0, 0, Math.PI * 2);
        ctx.fill(); ctx.stroke();
        // Crimson Eye in Center of Sun Shield
        ctx.fillStyle = '#dc2626';
        ctx.beginPath(); ctx.arc(0, 0, 3.2, 0, Math.PI * 2); ctx.fill();
        ctx.restore();
      }

      // Sorceress Levitating Orb / Witch Flame
      if (subMeta.orb || subMeta.witchFlame) {
        ctx.fillStyle = subMeta.orb ? '#38bdf8' : '#c084fc';
        ctx.beginPath();
        ctx.arc(-14, -36 + Math.sin(timeSec * 6) * 4, 6, 0, Math.PI * 2);
        ctx.fill(); ctx.stroke();
      }

      // Right-Hand Weapon (Flamberge, Highlander Bow, or Scimitar/Katana)
      const swingRot = p.swingTimer > 0 ? Math.sin(p.swingTimer * 0.35) * 1.45 : (isMoving ? Math.sin(timeSec * 11) * 0.18 : 0);
      ctx.save();
      ctx.translate(10, -20);
      ctx.rotate(swingRot);

      if (subMeta.bow) {
        ctx.strokeStyle = '#b45309';
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.arc(0, -10, 16, -Math.PI * 0.45, Math.PI * 0.45);
        ctx.stroke();
      } else {
        ctx.fillStyle = '#c89d54';
        ctx.fillRect(-5, -3, 10, 3);
        ctx.fillStyle = subMeta.flamberge ? '#fb923c' : '#e2e8f0';
        ctx.strokeStyle = '#040306';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(-3, -3);
        ctx.lineTo(-4, -40);
        ctx.lineTo(2, -45);
        ctx.lineTo(4, -3);
        ctx.closePath();
        ctx.fill(); ctx.stroke();
      }

      ctx.restore();
      ctx.restore();
      ctx.restore();
    }

    // Draw Card-Art Authentic Enemies in the 4 Outer Rooms
    function drawCardArtHostile(ctx, en, timeSec, isTargeted) {
      ctx.save();
      ctx.translate(en.x, en.y);

      if (isTargeted) {
        ctx.strokeStyle = '#ff2a38';
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        ctx.ellipse(0, 6, en.radius + 10, (en.radius + 10) * 0.45, 0, 0, Math.PI * 2);
        ctx.stroke();
      }

      ctx.fillStyle = 'rgba(0,0,0,0.68)';
      ctx.beginPath(); ctx.ellipse(0, 6, en.radius, en.radius * 0.45, 0, 0, Math.PI * 2); ctx.fill();

      const bob = Math.sin(timeSec * 6 + en.x) * 2.5;
      ctx.translate(0, bob);
      ctx.strokeStyle = '#040306';
      ctx.lineWidth = 2.2;

      if (en.kind === 'greater_demon') {
        // Indigo Winged Gargoyle Demon (Card 4)
        ctx.fillStyle = '#1e3a5f';
        ctx.beginPath();
        ctx.moveTo(0, -22); ctx.lineTo(-32, -44); ctx.lineTo(-22, -10);
        ctx.moveTo(0, -22); ctx.lineTo(32, -44);  ctx.lineTo(22, -10);
        ctx.fill(); ctx.stroke();
        ctx.fillStyle = '#28517a';
        ctx.beginPath(); ctx.roundRect(-14, -34, 28, 30, 5); ctx.fill(); ctx.stroke();
        ctx.fillStyle = '#38bdf8';
        ctx.beginPath();
        ctx.moveTo(-6, -34); ctx.lineTo(-14, -50); ctx.lineTo(-2, -36);
        ctx.moveTo(6, -34);  ctx.lineTo(14, -50);  ctx.lineTo(2, -36);
        ctx.fill(); ctx.stroke();
      } else if (en.kind === 'fire_giant') {
        // Flame-Haired Giant with Flamberge (Card 5)
        ctx.fillStyle = '#b45309';
        ctx.beginPath(); ctx.roundRect(-15, -36, 30, 32, 4); ctx.fill(); ctx.stroke();
        ctx.fillStyle = '#dc2626';
        ctx.beginPath(); ctx.arc(0, -42, 12, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
        // Wavy Flamberge
        ctx.fillStyle = '#fde047';
        ctx.beginPath(); ctx.moveTo(14, -18); ctx.lineTo(28, -52); ctx.lineTo(20, -14); ctx.fill(); ctx.stroke();
      } else if (en.kind === 'undead_warrior') {
        // Skeletal Knight with Blue Cloak & Shield (Card 10)
        ctx.fillStyle = '#2563eb';
        ctx.beginPath(); ctx.moveTo(-12, -30); ctx.lineTo(12, -30); ctx.lineTo(16, 2); ctx.lineTo(-16, 2); ctx.closePath(); ctx.fill(); ctx.stroke();
        ctx.fillStyle = '#e5e5e5';
        ctx.beginPath(); ctx.roundRect(-9, -28, 18, 24, 2); ctx.fill(); ctx.stroke();
        ctx.beginPath(); ctx.arc(0, -35, 8.5, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
        ctx.fillStyle = '#b45309';
        ctx.beginPath(); ctx.ellipse(-12, -16, 7, 11, 0, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
      } else {
        // Cobold King / Highlander / Sorceress
        ctx.fillStyle = en.color;
        ctx.beginPath(); ctx.roundRect(-12, -28, 24, 26, 4); ctx.fill(); ctx.stroke();
        ctx.fillStyle = '#fde68a';
        ctx.beginPath(); ctx.arc(0, -35, 9, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
        if (en.kind === 'cobold_king') {
          ctx.fillStyle = '#facc15';
          ctx.beginPath(); ctx.ellipse(-12, -15, 8, 11, 0, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
        }
      }

      const hpRatio = Math.max(0, en.hp / en.maxHp);
      ctx.fillStyle = '#040306';
      ctx.fillRect(-18, -en.radius - 28, 36, 6);
      ctx.fillStyle = '#ef4444';
      ctx.fillRect(-17, -en.radius - 27, 34 * hpRatio, 4);

      ctx.font = '700 10px Cinzel, serif';
      ctx.textAlign = 'center';
      ctx.fillStyle = '#fca5a5';
      ctx.fillText(en.name, 0, -en.radius - 32);
      ctx.restore();
    }

    const prevCanvas = document.getElementById('previewCanvas');
