<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Undercities: Neverwinter Lite - Personal Hell Shards</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      -webkit-user-select: none;
    }
    body, html {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: #050308;
      font-family: 'Cinzel', 'Georgia', serif;
      color: #dfd0e5;
    }
    canvas {
      display: block;
      width: 100vw;
      height: 100vh;
      background: #09050d;
    }

    /* Modal / Character Screen */
    #char-modal {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at center, rgba(16, 8, 24, 0.97) 0%, rgba(4, 2, 8, 0.99) 100%);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 100;
      padding: 16px;
      overflow-y: auto;
    }
    .char-card {
      background: rgba(12, 8, 18, 0.96);
      border: 2px solid #6b2d7d;
      box-shadow: 0 0 45px rgba(0, 0, 0, 0.95), 0 0 20px rgba(168, 50, 168, 0.3);
      width: 100%;
      max-width: 560px;
      padding: 24px;
      border-radius: 6px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .char-card h1 {
      font-size: 22px;
      letter-spacing: 3px;
      text-transform: uppercase;
      text-align: center;
      color: #d182df;
      border-bottom: 1px solid #3d1c4d;
      padding-bottom: 8px;
    }
    .char-card h2 {
      font-size: 12px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: #9374a8;
      text-align: center;
    }
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    label {
      font-size: 11px;
      text-transform: uppercase;
      color: #bda2cc;
      letter-spacing: 1px;
    }
    input[type="text"], select {
      background: #07040a;
      border: 1px solid #523166;
      color: #f5e6ff;
      padding: 8px 12px;
      border-radius: 4px;
      font-family: inherit;
      font-size: 13px;
      outline: none;
    }
    input[type="text"]:focus, select:focus {
      border-color: #cb51cf;
      box-shadow: 0 0 8px rgba(203, 81, 207, 0.4);
    }
    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    .btn-spawn {
      background: linear-gradient(180deg, #451c5e 0%, #200a2e 100%);
      border: 1px solid #cb51cf;
      color: #fae3ff;
      padding: 12px;
      border-radius: 4px;
      font-family: inherit;
      font-size: 14px;
      font-weight: bold;
      letter-spacing: 2px;
      text-transform: uppercase;
      cursor: pointer;
      margin-top: 6px;
      transition: all 0.2s;
    }
    .btn-spawn:hover {
      background: linear-gradient(180deg, #5b267d 0%, #2c0e3f 100%);
      box-shadow: 0 0 16px rgba(203, 81, 207, 0.5);
    }

    /* HUD Overlay */
    #hud {
      position: absolute;
      inset: 0;
      pointer-events: none;
      display: none;
    }
    .interactive {
      pointer-events: auto;
    }

    /* Top Shard Bar */
    .top-bar {
      position: absolute;
      top: 12px;
      left: 12px;
      right: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
    }
    .panel {
      background: rgba(10, 6, 16, 0.88);
      border: 1px solid #4a2d59;
      border-radius: 4px;
      padding: 6px 12px;
      font-size: 12px;
      display: flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.7);
    }
    .action-btn {
      background: #251233;
      border: 1px solid #b84cb3;
      color: #f1c2ff;
      padding: 4px 10px;
      border-radius: 3px;
      font-family: inherit;
      font-size: 11px;
      letter-spacing: 1px;
      cursor: pointer;
      text-transform: uppercase;
    }
    .action-btn:hover {
      background: #3b1b52;
    }

    /* Player Vitals Bar (Top Left) */
    .vitals-box {
      position: absolute;
      top: 54px;
      left: 12px;
      background: rgba(10, 6, 16, 0.9);
      border: 1px solid #4a2d59;
      padding: 8px 12px;
      border-radius: 4px;
      width: 210px;
      font-size: 11px;
    }
    .bar-container {
      width: 100%;
      height: 8px;
      background: #1c1024;
      border: 1px solid #3d214a;
      border-radius: 2px;
      margin-top: 3px;
      overflow: hidden;
    }
    .bar-fill {
      height: 100%;
      width: 100%;
      transition: width 0.1s linear;
    }
    #hp-fill { background: linear-gradient(90deg, #8b2626, #cf3636); }
    #mana-fill { background: linear-gradient(90deg, #26548b, #3685cf); }

    /* Action Hotbar */
    .hotbar {
      position: absolute;
      bottom: 16px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 8px;
    }
    .hotkey-slot {
      width: 52px;
      height: 52px;
      background: rgba(12, 8, 18, 0.92);
      border: 1px solid #59326b;
      border-radius: 4px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      position: relative;
      transition: transform 0.1s, border-color 0.1s;
    }
    .hotkey-slot:active {
      transform: scale(0.94);
      border-color: #e282ff;
    }
    .hotkey-num {
      position: absolute;
      top: 2px;
      left: 4px;
      font-size: 9px;
      color: #9a76ab;
    }
    .hotkey-icon {
      font-size: 18px;
    }

    /* Chat Frame */
    .chat-container {
      position: absolute;
      bottom: 76px;
      left: 12px;
      width: 320px;
      max-width: calc(100vw - 24px);
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .chat-log {
      height: 110px;
      background: rgba(6, 4, 10, 0.82);
      border: 1px solid #331d40;
      border-radius: 4px;
      padding: 8px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 4px;
      font-size: 11px;
      font-family: sans-serif;
    }
    .chat-msg {
      word-break: break-word;
      line-height: 1.3;
    }
    .chat-msg .author {
      color: #d882df;
      font-weight: bold;
      font-family: 'Cinzel', serif;
      margin-right: 4px;
    }
    .chat-input-row {
      display: flex;
      gap: 4px;
    }
    .chat-input {
      flex: 1;
      background: rgba(8, 5, 12, 0.88);
      border: 1px solid #522e66;
      border-radius: 3px;
      padding: 6px 10px;
      color: #f1e4f8;
      font-size: 11px;
      outline: none;
      font-family: sans-serif;
    }

    /* Toast Notification */
    #toast {
      position: absolute;
      top: 60px;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(14, 8, 20, 0.96);
      border: 1px solid #cb51cf;
      color: #f4c2ff;
      padding: 6px 16px;
      border-radius: 20px;
      font-size: 12px;
      letter-spacing: 1px;
      display: none;
      box-shadow: 0 0 12px rgba(0,0,0,0.85);
      z-index: 200;
    }
  </style>
</head>
<body>

  <!-- Character Creation Screen -->
  <div id="char-modal">
    <div class="char-card">
      <h1>Undercities</h1>
      <h2>Forge Your Personal Hell Shard</h2>

      <div class="form-group">
        <label for="char-name">Character Name</label>
        <input type="text" id="char-name" maxlength="16" placeholder="Enter name..." value="Malakor">
      </div>

      <div class="grid-2">
        <div class="form-group">
          <label for="char-race">Race / Sub-Race</label>
          <select id="char-race">
            <optgroup label="Human Lineage">
              <option value="Human-Torta">Human (Torta: Large Brawler Female)</option>
              <option value="Human-Edgar">Human (Edgar: Thin Tactical Scholar)</option>
              <option value="Human-Standard">Human (Standard)</option>
            </optgroup>
            <optgroup label="Underdark & Demonic">
              <option value="Demon-Succubus">Demon (Fiendish Noble)</option>
              <option value="Demon-Balor">Demon (Abyssal Terror)</option>
              <option value="Drow">Drow Elf</option>
              <option value="Duergar">Duergar Dwarf</option>
            </optgroup>
          </select>
        </div>

        <div class="form-group">
          <label for="char-class">Calling (Class)</label>
          <select id="char-class">
            <option value="Fighter">Hell Knight</option>
            <option value="Healer">Soul Cleric</option>
            <option value="Mage">Abyssal Wizard</option>
            <option value="Rogue">Shadow Assassin</option>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label for="hell-name">Your Personal Hell Shard Domain Name</label>
        <input type="text" id="hell-name" maxlength="24" value="Abyssal Bastion of Pain">
      </div>

      <button id="btn-awaken" class="btn-spawn">Descend Into Personal Hell</button>
    </div>
  </div>

  <!-- Main Game Canvas -->
  <canvas id="gameCanvas"></canvas>

  <!-- HUD Layer -->
  <div id="hud">
    <div class="top-bar">
      <div class="panel">
        <span style="color:#cb51cf;">●</span>
        <span id="shard-status">Shard: Personal Domain</span>
        <span id="player-count">(1 Online)</span>
      </div>
      <div class="panel interactive">
        <button id="btn-copy-invite" class="action-btn">🔗 Copy Shard Invite</button>
        <button id="btn-home-shard" class="action-btn" title="Return to your own Hell Shard">🏠 Home Shard</button>
      </div>
    </div>

    <!-- Vitals Bar -->
    <div class="vitals-box">
      <div id="vitals-name" style="font-weight:bold; color:#e2a8ff; font-family:'Cinzel',serif;">Malakor</div>
      <div style="font-size:10px; color:#a285b8; margin-bottom:4px;" id="vitals-subtitle">Human-Torta Hell Knight</div>
      <div>HP: <span id="hp-txt">100/100</span></div>
      <div class="bar-container"><div id="hp-fill" class="bar-fill"></div></div>
      <div style="margin-top:4px;">Mana: <span id="mana-txt">50/50</span></div>
      <div class="bar-container"><div id="mana-fill" class="bar-fill"></div></div>
    </div>

    <!-- Chat -->
    <div class="chat-container interactive">
      <div class="chat-log" id="chat-log">
        <div class="chat-msg" style="color: #9374a8;"><i>System: Welcome to your Hell Shard. Press [TAB] to target nearest threat, [1-4] for combat abilities, or click to move/attack.</i></div>
      </div>
      <div class="chat-input-row">
        <input type="text" id="chat-input" class="chat-input" placeholder="Type message or press Enter..." maxlength="100">
      </div>
    </div>

    <!-- Hotbar -->
    <div class="hotbar interactive">
      <div class="hotkey-slot" onclick="triggerAbility(1)" title="Primary Strike (Key 1)">
        <span class="hotkey-num">1</span>
        <span class="hotkey-icon">⚔️</span>
      </div>
      <div class="hotkey-slot" onclick="triggerAbility(2)" title="Signature Power (Key 2)">
        <span class="hotkey-num">2</span>
        <span class="hotkey-icon">🔮</span>
      </div>
      <div class="hotkey-slot" onclick="triggerAbility(3)" title="Shadow Sprint (Key 3)">
        <span class="hotkey-num">3</span>
        <span class="hotkey-icon">💨</span>
      </div>
      <div class="hotkey-slot" onclick="triggerAbility(4)" title="Soul Mend (Key 4)">
        <span class="hotkey-num">4</span>
        <span class="hotkey-icon">🖤</span>
      </div>
    </div>
  </div>

  <div id="toast">Invite link copied to clipboard!</div>

  <script>
    // --- WORLD & DOMAIN CONFIGURATION ---
    const WORLD_SIZE = 3600;
    const DOMAIN_CORE = { x: 1800, y: 1800, radius: 90 };

    // --- RACE & SUB-RACE ATTRIBUTES ---
    const RACES = {
      'Human-Torta': { name: 'Human (Torta)', scale: 1.35, hpBonus: 60, speedMod: 0.92, desc: 'Large brawler female with massive physical strength.' },
      'Human-Edgar': { name: 'Human (Edgar)', scale: 0.88, hpBonus: -10, speedMod: 1.08, desc: 'Thin tactical scholar with keen arcane insight.' },
      'Human-Standard': { name: 'Human', scale: 1.0, hpBonus: 0, speedMod: 1.0, desc: 'Balanced baseline mortal.' },
      'Demon-Succubus': { name: 'Demon (Succubus)', scale: 1.05, hpBonus: 20, speedMod: 1.06, desc: 'Fiendish noble gifted in shadow manipulation.' },
      'Demon-Balor': { name: 'Demon (Balor)', scale: 1.45, hpBonus: 100, speedMod: 0.88, desc: 'Towering abyssal terror clad in hellfire.' },
      'Drow': { name: 'Drow Elf', scale: 0.95, hpBonus: 10, speedMod: 1.04, desc: 'Underdark assassin of cold grace.' },
      'Duergar': { name: 'Duergar', scale: 0.85, hpBonus: 40, speedMod: 0.94, desc: 'Gray dwarf hardened by sulfur.' }
    };

    const CLASSES = {
      'Fighter': { name: 'Hell Knight', hp: 140, mana: 40, color: '#cb3636' },
      'Healer': { name: 'Soul Cleric', hp: 100, mana: 90, color: '#36cb85' },
      'Mage': { name: 'Abyssal Wizard', hp: 80, mana: 120, color: '#3685cf' },
      'Rogue': { name: 'Shadow Assassin', hp: 95, mana: 60, color: '#b836cf' }
    };

    // --- GAME STATE ---
    let localPlayer = {
      id: 'p-' + Math.random().toString(36).substring(2, 9),
      name: 'Malakor',
      race: 'Human-Torta',
      className: 'Fighter',
      domainName: 'Abyssal Bastion of Pain',
      x: DOMAIN_CORE.x + 160,
      y: DOMAIN_CORE.y + 160,
      targetX: null,
      targetY: null,
      speed: 215,
      hp: 200,
      maxHp: 200,
      mana: 40,
      maxMana: 40,
      level: 1,
      targetEntityId: null,
      actionEffect: null,
      actionTimer: 0,
      chatBubble: null,
      chatTimer: 0
    };

    const remotePlayers = new Map();
    const enemies = [];
    const combatTexts = [];

    // --- SPAWN INITIAL HELL MONSTERS (Imps, Hellhounds, Shadow Fiends) ---
    function spawnHellEnemies() {
      enemies.length = 0;
      const types = [
        { name: 'Abyssal Imp', hp: 45, maxHp: 45, radius: 14, speed: 130, color: '#cf5136', type: 'imp' },
        { name: 'Hellhound', hp: 80, maxHp: 80, radius: 18, speed: 175, color: '#cf8236', type: 'hound' },
        { name: 'Shadow Fiend', hp: 60, maxHp: 60, radius: 15, speed: 150, color: '#9136cf', type: 'fiend' }
      ];

      for (let i = 0; i < 16; i++) {
        const t = types[Math.floor(Math.random() * types.length)];
        const ang = Math.random() * Math.PI * 2;
        const dist = 320 + Math.random() * 1400;
        enemies.push({
          id: 'mob-' + i,
          name: t.name,
          x: DOMAIN_CORE.x + Math.cos(ang) * dist,
          y: DOMAIN_CORE.y + Math.sin(ang) * dist,
          hp: t.hp,
          maxHp: t.maxHp,
          radius: t.radius,
          speed: t.speed,
          color: t.color,
          type: t.type,
          targetX: null,
          targetY: null,
          attackCooldown: 0
        });
      }
    }
    spawnHellEnemies();

    // --- CAVERN PILLARS & HELLISH PROP GENERATION ---
    const hellProps = [];
    for (let i = 0; i < 350; i++) {
      const gx = Math.random() * WORLD_SIZE;
      const gy = Math.random() * WORLD_SIZE;
      if (Math.hypot(gx - DOMAIN_CORE.x, gy - DOMAIN_CORE.y) > 130) {
        hellProps.push({
          x: gx,
          y: gy,
          type: Math.random() > 0.45 ? 'spire' : 'sulfur_vent',
          size: 14 + Math.random() * 26
        });
      }
    }

    // --- CANVAS & RESIZING ---
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    let screenW = 0, screenH = 0;

    function resizeCanvas() {
      screenW = window.innerWidth;
      screenH = window.innerHeight;
      canvas.width = screenW;
      canvas.height = screenH;
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    // --- INPUT CONTROLS & LAPTOP TOUCHPAD OPTIMIZATION ---
    const keys = {};
    window.addEventListener('keydown', (e) => {
      keys[e.key.toLowerCase()] = true;
      if (['1','2','3','4'].includes(e.key)) {
        triggerAbility(parseInt(e.key));
      }
      if (e.key === 'Tab') {
        e.preventDefault();
        cycleTabTarget();
      }
      if (e.key === 'Enter') {
        const chatInput = document.getElementById('chat-input');
        if (document.activeElement === chatInput) {
          sendChat();
        } else {
          chatInput.focus();
        }
      }
    });

    window.addEventListener('keyup', (e) => {
      keys[e.key.toLowerCase()] = false;
    });

    canvas.addEventListener('mousedown', (e) => {
      const camX = localPlayer.x - screenW / 2;
      const camY = localPlayer.y - screenH / 2;
      const clickX = e.clientX + camX;
      const clickY = e.clientY + camY;

      let clickedEnemy = null;
      for (const en of enemies) {
        if (Math.hypot(clickX - en.x, clickY - en.y) < en.radius + 15) {
          clickedEnemy = en;
          break;
        }
      }

      if (clickedEnemy) {
        localPlayer.targetEntityId = clickedEnemy.id;
        if (Math.hypot(localPlayer.x - clickedEnemy.x, localPlayer.y - clickedEnemy.y) < 75) {
          executePrimaryStrike(clickedEnemy);
        } else {
          localPlayer.targetX = clickedEnemy.x;
          localPlayer.targetY = clickedEnemy.y;
        }
      } else {
        localPlayer.targetEntityId = null;
        localPlayer.targetX = clickX;
        localPlayer.targetY = clickY;
      }
    });

    // --- TAB TARGETING SYSTEM ---
    function cycleTabTarget() {
      const allTargets = [...enemies];
      if (allTargets.length === 0) return;

      allTargets.sort((a, b) => {
        const distA = Math.hypot(a.x - localPlayer.x, a.y - localPlayer.y);
        const distB = Math.hypot(b.x - localPlayer.x, b.y - localPlayer.y);
        return distA - distB;
      });

      const currentIdx = allTargets.findIndex(t => t.id === localPlayer.targetEntityId);
      const nextIdx = (currentIdx + 1) % allTargets.length;
      localPlayer.targetEntityId = allTargets[nextIdx].id;

      showToast(`Target: ${allTargets[nextIdx].name}`);
    }

    // --- MULTIPLAYER & PERSONAL HELL SHARDS ---
    const globalUrlParams = new URLSearchParams(window.location.search);
    const joinShardId = globalUrlParams.get('shard');
    const isHost = !joinShardId;

    let localBroadcastChannel = null;
    try {
      if (typeof BroadcastChannel !== 'undefined') {
        localBroadcastChannel = new BroadcastChannel('undercity_hell_v3_' + (joinShardId || 'main'));
        localBroadcastChannel.onmessage = (ev) => {
          if (ev.data && ev.data.id !== localPlayer.id) {
            handleIncomingPacket(ev.data);
          }
        };
      }
    } catch (e) {}

    const RELAY_SERVERS = [
      'wss://free.blr2.piesocket.com/v3/undercity_hell_shard?api_key=VCXCEuvhGcBDP7XhiJJUDvR1e1D3eiVjgZ9VRiaV&notify_self=0'
    ];
    let activeSocket = null;
    let socketConnected = false;

    function initNetworking() {
      const shardStatus = document.getElementById('shard-status');
      if (isHost) {
        shardStatus.textContent = `Domain: ${localPlayer.domainName}`;
        const newUrl = `${window.location.origin}${window.location.pathname}?shard=hell-shard-${localPlayer.id}`;
        window.history.replaceState(null, '', newUrl);
      } else {
        shardStatus.textContent = `Visiting Shard`;
      }

      try {
        const ws = new WebSocket(RELAY_SERVERS[0]);
        activeSocket = ws;
        ws.onopen = () => {
          socketConnected = true;
          broadcastState(true);
        };
        ws.onmessage = (e) => {
          try {
            const data = JSON.parse(e.data);
            if (data && data.id && data.id !== localPlayer.id) {
              handleIncomingPacket(data);
            }
          } catch(err) {}
        };
        ws.onerror = () => { socketConnected = false; };
      } catch(err) {
        console.warn('WebSocket relay fallback active (Local / BroadcastChannel mode)');
      }
    }

    function handleIncomingPacket(data) {
      if (!data || !data.id || data.id === localPlayer.id) return;

      if (data.type === 'state') {
        let p = remotePlayers.get(data.id);
        if (!p) {
          p = { ...data };
          remotePlayers.set(data.id, p);
          appendChat('Hell Shard', `${p.name} the ${p.race} stepped through the sulfur portal.`);
        } else {
          p.x = data.x;
          p.y = data.y;
          p.name = data.name;
          p.race = data.race;
          p.className = data.className;
          p.domainName = data.domainName;
          p.hp = data.hp;
          p.maxHp = data.maxHp;
          p.actionEffect = data.actionEffect;
          p.actionTimer = data.actionTimer;
          p.chatBubble = data.chatBubble;
          p.chatTimer = data.chatTimer;
        }
        updateRosterCount();
      } else if (data.type === 'chat') {
        appendChat(data.sender, data.text);
      }
    }

    function broadcastState(immediate = false) {
      const packet = {
        type: 'state',
        id: localPlayer.id,
        name: localPlayer.name,
        race: localPlayer.race,
        className: localPlayer.className,
        domainName: localPlayer.domainName,
        x: Math.round(localPlayer.x),
        y: Math.round(localPlayer.y),
        hp: localPlayer.hp,
        maxHp: localPlayer.maxHp,
        actionEffect: localPlayer.actionEffect,
        actionTimer: localPlayer.actionTimer,
        chatBubble: localPlayer.chatBubble,
        chatTimer: localPlayer.chatTimer
      };

      if (localBroadcastChannel) {
        try { localBroadcastChannel.postMessage(packet); } catch(e) {}
      }

      if (activeSocket && socketConnected && activeSocket.readyState === WebSocket.OPEN) {
        try { activeSocket.send(JSON.stringify(packet)); } catch(e) {}
      }
    }

    function broadcastChat(text) {
      const packet = {
        type: 'chat',
        id: localPlayer.id,
        sender: localPlayer.name,
        text: text
      };

      if (localBroadcastChannel) {
        try { localBroadcastChannel.postMessage(packet); } catch(e) {}
      }

      if (activeSocket && socketConnected && activeSocket.readyState === WebSocket.OPEN) {
        try { activeSocket.send(JSON.stringify(packet)); } catch(e) {}
      }
    }

    function updateRosterCount() {
      const el = document.getElementById('player-count');
      if (el) {
        el.textContent = `(${remotePlayers.size + 1} Online)`;
      }
    }

    // --- COMBAT ABILITIES (KEYS 1-4) ---
    function triggerAbility(slot) {
      if (slot === 1) {
        let target = enemies.find(e => e.id === localPlayer.targetEntityId);
        if (!target && enemies.length > 0) target = enemies[0];
        if (target) {
          executePrimaryStrike(target);
        } else {
          showToast('No target in sight. Press [TAB]');
        }
      } else if (slot === 2) {
        if (localPlayer.mana < 20) {
          showToast('Not enough Mana!');
          return;
        }
        localPlayer.mana -= 20;
        localPlayer.actionEffect = 'signature';
        localPlayer.actionTimer = 40;

        enemies.forEach(en => {
          if (Math.hypot(en.x - localPlayer.x, en.y - localPlayer.y) < 160) {
            en.hp -= 45;
            spawnCombatText(en.x, en.y, '-45 CRIT', '#cb51cf');
          }
        });
        showToast('Abyssal Nova unleashed!');
      } else if (slot === 3) {
        localPlayer.actionEffect = 'sprint';
        localPlayer.actionTimer = 30;
        localPlayer.speed = 420;
        setTimeout(() => { localPlayer.speed = 215; }, 2500);
        showToast('Shadow Sprint active!');
      } else if (slot === 4) {
        if (localPlayer.mana < 25) {
          showToast('Not enough Mana!');
          return;
        }
        localPlayer.mana -= 25;
        localPlayer.hp = Math.min(localPlayer.maxHp, localPlayer.hp + 50);
        localPlayer.actionEffect = 'commune';
        localPlayer.actionTimer = 35;
        spawnCombatText(localPlayer.x, localPlayer.y, '+50 HP', '#36cb85');
        showToast('Soul Mended.');
      }
      updateVitalsUI();
      broadcastState(true);
    }

    function executePrimaryStrike(target) {
      const dist = Math.hypot(localPlayer.x - target.x, localPlayer.y - target.y);
      if (dist > 85) {
        localPlayer.targetX = target.x;
        localPlayer.targetY = target.y;
        return;
      }

      localPlayer.actionEffect = 'strike';
      localPlayer.actionTimer = 25;
      const dmg = 22 + Math.floor(Math.random() * 12);
      target.hp -= dmg;
      spawnCombatText(target.x, target.y, `-${dmg}`, '#cb3636');

      if (target.hp <= 0) {
        showToast(`Defeated ${target.name}!`);
        const idx = enemies.indexOf(target);
        if (idx !== -1) enemies.splice(idx, 1);
        if (localPlayer.targetEntityId === target.id) localPlayer.targetEntityId = null;
      }
      broadcastState(true);
    }

    function spawnCombatText(x, y, text, color) {
      combatTexts.push({ x, y: y - 20, text, color, life: 55, maxLife: 55 });
    }

    function sendChat() {
      const input = document.getElementById('chat-input');
      const val = input.value.trim();
      if (!val) return;

      appendChat(localPlayer.name, val);
      localPlayer.chatBubble = val;
      localPlayer.chatTimer = 220;

      broadcastChat(val);
      broadcastState(true);

      input.value = '';
      input.blur();
    }

    function appendChat(author, text) {
      const log = document.getElementById('chat-log');
      const div = document.createElement('div');
      div.className = 'chat-msg';
      div.innerHTML = `<span class="author">${escapeHtml(author)}:</span><span>${escapeHtml(text)}</span>`;
      log.appendChild(div);
      log.scrollTop = log.scrollHeight;
    }

    function escapeHtml(str) {
      return str.replace(/[&<>"']/g, m => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
      }[m]));
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.textContent = msg;
      toast.style.display = 'block';
      clearTimeout(window._tTimer);
      window._tTimer = setTimeout(() => { toast.style.display = 'none'; }, 2600);
    }

    document.getElementById('btn-copy-invite').addEventListener('click', () => {
      navigator.clipboard.writeText(window.location.href).then(() => {
        showToast('Shard invite link copied! Send to friends.');
      });
    });

    document.getElementById('btn-home-shard').addEventListener('click', () => {
      const u = new URL(window.location.href);
      u.searchParams.delete('shard');
      window.location.href = u.toString();
    });

    document.getElementById('btn-awaken').addEventListener('click', () => {
      const nameInput = document.getElementById('char-name').value.trim();
      if (nameInput) localPlayer.name = nameInput;
      localPlayer.race = document.getElementById('char-race').value;
      localPlayer.className = document.getElementById('char-class').value;
      localPlayer.domainName = document.getElementById('hell-name').value.trim() || 'Abyssal Bastion';

      const raceMeta = RACES[localPlayer.race] || RACES['Human-Standard'];
      const classMeta = CLASSES[localPlayer.className] || CLASSES['Fighter'];
      localPlayer.maxHp = classMeta.hp + raceMeta.hpBonus;
      localPlayer.hp = localPlayer.maxHp;
      localPlayer.maxMana = classMeta.mana;
      localPlayer.mana = localPlayer.maxMana;
      localPlayer.speed = 215 * raceMeta.speedMod;

      document.getElementById('char-modal').style.display = 'none';
      document.getElementById('hud').style.display = 'block';

      document.getElementById('vitals-name').textContent = localPlayer.name;
      document.getElementById('vitals-subtitle').textContent = `${raceMeta.name} ${classMeta.name}`;

      initNetworking();
      updateVitalsUI();
      appendChat('Hell Shard', `You have opened the gates to ${localPlayer.domainName}. Combat ready.`);
    });

    function updateVitalsUI() {
      document.getElementById('hp-txt').textContent = `${Math.max(0, Math.round(localPlayer.hp))}/${localPlayer.maxHp}`;
      document.getElementById('hp-fill').style.width = `${Math.max(0, (localPlayer.hp / localPlayer.maxHp) * 100)}%`;
      document.getElementById('mana-txt').textContent = `${Math.max(0, Math.round(localPlayer.mana))}/${localPlayer.maxMana}`;
      document.getElementById('mana-fill').style.width = `${Math.max(0, (localPlayer.mana / localPlayer.maxMana) * 100)}%`;
    }

    // --- MAIN TICK & GAME LOOP ---
    let lastTime = performance.now();
    let netTickTimer = 0;

    function gameLoop(now) {
      const dt = Math.min((now - lastTime) / 1000, 0.1);
      lastTime = now;

      let moveX = 0;
      let moveY = 0;

      if (keys['w'] || keys['arrowup']) moveY -= 1;
      if (keys['s'] || keys['arrowdown']) moveY += 1;
      if (keys['a'] || keys['arrowleft']) moveX -= 1;
      if (keys['d'] || keys['arrowright']) moveX += 1;

      if (moveX !== 0 || moveY !== 0) {
        localPlayer.targetX = null;
        localPlayer.targetY = null;
        const len = Math.hypot(moveX, moveY);
        localPlayer.x += (moveX / len) * localPlayer.speed * dt;
        localPlayer.y += (moveY / len) * localPlayer.speed * dt;
      } else if (localPlayer.targetX !== null && localPlayer.targetY !== null) {
        const dx = localPlayer.targetX - localPlayer.x;
        const dy = localPlayer.targetY - localPlayer.y;
        const dist = Math.hypot(dx, dy);
        if (dist > 5) {
          localPlayer.x += (dx / dist) * localPlayer.speed * dt;
          localPlayer.y += (dy / dist) * localPlayer.speed * dt;
        } else {
          localPlayer.targetX = null;
          localPlayer.targetY = null;
        }
      }

      localPlayer.x = Math.max(50, Math.min(WORLD_SIZE - 50, localPlayer.x));
      localPlayer.y = Math.max(50, Math.min(WORLD_SIZE - 50, localPlayer.y));

      const coreDist = Math.hypot(localPlayer.x - DOMAIN_CORE.x, localPlayer.y - DOMAIN_CORE.y);
      if (coreDist < DOMAIN_CORE.radius) {
        const pushAngle = Math.atan2(localPlayer.y - DOMAIN_CORE.y, localPlayer.x - DOMAIN_CORE.x);
        localPlayer.x = DOMAIN_CORE.x + Math.cos(pushAngle) * DOMAIN_CORE.radius;
        localPlayer.y = DOMAIN_CORE.y + Math.sin(pushAngle) * DOMAIN_CORE.radius;
      }

      enemies.forEach(en => {
        const distToPlayer = Math.hypot(localPlayer.x - en.x, localPlayer.y - en.y);
        if (distToPlayer < 450) {
          const ang = Math.atan2(localPlayer.y - en.y, localPlayer.x - en.x);
          en.x += Math.cos(ang) * en.speed * dt;
          en.y += Math.sin(ang) * en.speed * dt;

          if (distToPlayer < 45) {
            en.attackCooldown -= dt;
            if (en.attackCooldown <= 0) {
              en.attackCooldown = 1.2;
              const hitDmg = 12 + Math.floor(Math.random() * 8);
              localPlayer.hp -= hitDmg;
              spawnCombatText(localPlayer.x, localPlayer.y, `-${hitDmg} HP`, '#cb3636');
              updateVitalsUI();
            }
          }
        }
      });

      if (localPlayer.actionTimer > 0) localPlayer.actionTimer--;
      if (localPlayer.chatTimer > 0) {
        localPlayer.chatTimer--;
        if (localPlayer.chatTimer <= 0) localPlayer.chatBubble = null;
      }

      remotePlayers.forEach(p => {
        if (p.chatTimer > 0) {
          p.chatTimer--;
          if (p.chatTimer <= 0) p.chatBubble = null;
        }
        if (p.actionTimer > 0) p.actionTimer--;
      });

      for (let i = combatTexts.length - 1; i >= 0; i--) {
        const ct = combatTexts[i];
        ct.y -= 22 * dt;
        ct.life--;
        if (ct.life <= 0) combatTexts.splice(i, 1);
      }

      netTickTimer += dt;
      if (netTickTimer > 0.066) {
        broadcastState();
        netTickTimer = 0;
      }

      render();
      requestAnimationFrame(gameLoop);
    }

    // --- RENDERING PIPELINE ---
    function render() {
      ctx.clearRect(0, 0, screenW, screenH);

      const camX = localPlayer.x - screenW / 2;
      const camY = localPlayer.y - screenH / 2;

      ctx.save();
      ctx.translate(-camX, -camY);

      ctx.fillStyle = '#07040a';
      ctx.fillRect(0, 0, WORLD_SIZE, WORLD_SIZE);

      ctx.strokeStyle = '#2d143b';
      ctx.lineWidth = 14;
      ctx.strokeRect(0, 0, WORLD_SIZE, WORLD_SIZE);

      ctx.fillStyle = '#100617';
      ctx.beginPath();
      ctx.arc(DOMAIN_CORE.x, DOMAIN_CORE.y, 380, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = '#52206e';
      ctx.lineWidth = 5;
      ctx.stroke();

      for (let i = 0; i < hellProps.length; i++) {
        const prop = hellProps[i];
        if (prop.x < camX - 60 || prop.x > camX + screenW + 60 || prop.y < camY - 60 || prop.y > camY + screenH + 60) continue;

        if (prop.type === 'spire') {
          ctx.fillStyle = '#140c1c';
          ctx.beginPath();
          ctx.arc(prop.x, prop.y, prop.size, 0, Math.PI * 2);
          ctx.fill();
          ctx.strokeStyle = '#38174a';
          ctx.lineWidth = 2;
          ctx.stroke();
        } else {
          ctx.fillStyle = '#1f0e15';
          ctx.beginPath();
          ctx.arc(prop.x, prop.y, prop.size * 0.75, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = '#cf5136';
          ctx.beginPath();
          ctx.arc(prop.x, prop.y, prop.size * 0.35, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      const coreAura = ctx.createRadialGradient(DOMAIN_CORE.x, DOMAIN_CORE.y, 30, DOMAIN_CORE.x, DOMAIN_CORE.y, 350);
      coreAura.addColorStop(0, 'rgba(203, 81, 207, 0.25)');
      coreAura.addColorStop(1, 'rgba(7, 4, 10, 0)');
      ctx.fillStyle = coreAura;
      ctx.beginPath();
      ctx.arc(DOMAIN_CORE.x, DOMAIN_CORE.y, 350, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#1c0d26';
      ctx.beginPath();
      ctx.arc(DOMAIN_CORE.x, DOMAIN_CORE.y, DOMAIN_CORE.radius, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = '#9e42cc';
      ctx.lineWidth = 6;
      ctx.stroke();

      ctx.fillStyle = '#f3c2ff';
      ctx.font = 'bold 12px Cinzel, serif';
      ctx.textAlign = 'center';
      ctx.fillText(localPlayer.domainName.toUpperCase(), DOMAIN_CORE.x, DOMAIN_CORE.y + 4);

      enemies.forEach(en => {
        ctx.fillStyle = 'rgba(0,0,0,0.45)';
        ctx.beginPath();
        ctx.ellipse(en.x, en.y + en.radius * 0.6, en.radius, en.radius * 0.5, 0, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = en.color;
        ctx.beginPath();
        ctx.arc(en.x, en.y, en.radius, 0, Math.PI * 2);
        ctx.fill();

        if (en.id === localPlayer.targetEntityId) {
          ctx.strokeStyle = '#f3c2ff';
          ctx.lineWidth = 2.5;
          ctx.beginPath();
          ctx.arc(en.x, en.y, en.radius + 6, 0, Math.PI * 2);
          ctx.stroke();
        }

        ctx.font = '10px sans-serif';
        ctx.fillStyle = '#ff9999';
        ctx.fillText(en.name, en.x, en.y - en.radius - 6);
      });

      remotePlayers.forEach(p => drawAvatar(p));
      drawAvatar(localPlayer);

      combatTexts.forEach(ct => {
        ctx.font = 'bold 13px Cinzel, serif';
        ctx.textAlign = 'center';
        ctx.fillStyle = ct.color;
        ctx.globalAlpha = Math.max(0, ct.life / ct.maxLife);
        ctx.shadowColor = '#000';
        ctx.shadowBlur = 4;
        ctx.fillText(ct.text, ct.x, ct.y);
        ctx.shadowBlur = 0;
        ctx.globalAlpha = 1.0;
      });

      ctx.restore();
    }

    function drawAvatar(p) {
      const raceMeta = RACES[p.race] || RACES['Human-Standard'];
      const classColor = CLASSES[p.className]?.color || '#cb51cf';
      const rad = 14 * raceMeta.scale;

      ctx.fillStyle = 'rgba(0, 0, 0, 0.5)';
      ctx.beginPath();
      ctx.ellipse(p.x, p.y + rad * 0.7, rad * 1.1, rad * 0.5, 0, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#3a214a';
      ctx.beginPath();
      ctx.arc(p.x, p.y, rad, 0, Math.PI * 2);
      ctx.fill();

      ctx.strokeStyle = classColor;
      ctx.lineWidth = 3;
      ctx.stroke();

      ctx.textAlign = 'center';
      ctx.font = '11px sans-serif';
      ctx.fillStyle = '#ffffff';
      ctx.shadowColor = 'black';
      ctx.shadowBlur = 4;
      ctx.fillText(p.name, p.x, p.y - rad - 12);

      ctx.font = '9px Cinzel, serif';
      ctx.fillStyle = '#dfa8ff';
      ctx.fillText(`<${p.race}>`, p.x, p.y - rad - 2);
      ctx.shadowBlur = 0;

      if (p.chatBubble) {
        ctx.font = '12px sans-serif';
        const txtWidth = ctx.measureText(p.chatBubble).width;
        const boxW = Math.max(txtWidth + 16, 50);
        const boxH = 24;
        const boxX = p.x - boxW / 2;
        const boxY = p.y - rad - 46;

        ctx.fillStyle = 'rgba(8, 5, 12, 0.92)';
        ctx.strokeStyle = '#cb51cf';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.roundRect(boxX, boxY, boxW, boxH, 4);
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = '#fae3ff';
        ctx.fillText(p.chatBubble, p.x, boxY + 16);
      }
    }

    requestAnimationFrame(gameLoop);
  </script>
