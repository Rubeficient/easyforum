    let bgmInterval = null;
    let bgmStep = 0;

    function initAudioEngine() {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
      if (audioCtx.state === 'suspended') audioCtx.resume();
      if (!bgmInterval) {
        const notes = [146.83, 174.61, 220.00, 233.08, 220.00, 174.61, 138.59, 146.83];
        bgmInterval = setInterval(() => {
          if (!bgmEnabled || !audioCtx || document.getElementById('char-modal').style.display !== 'none') return;
          try {
            const now = audioCtx.currentTime;
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = bgmStep % 4 === 0 ? 'triangle' : 'sine';
            const freq = notes[bgmStep % notes.length];
            osc.frequency.setValueAtTime(bgmStep % 8 === 0 ? freq * 0.5 : freq, now);
            gain.gain.setValueAtTime(0.03, now);
            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.55);
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start(now);
            osc.stop(now + 0.56);
            bgmStep++;
          } catch (e) {}
        }, 580);
      }
    }

    function playSfx(kind) {
      if (!audioCtx || !bgmEnabled) return;
      try {
        const now = audioCtx.currentTime;
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain);
        gain.connect(audioCtx.destination);

        if (kind === 'bow') {
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(480, now);
          osc.frequency.exponentialRampToValueAtTime(140, now + 0.09);
          gain.gain.setValueAtTime(0.14, now);
          gain.gain.linearRampToValueAtTime(0.01, now + 0.09);
          osc.start(now); osc.stop(now + 0.09);
        } else if (kind === 'slash') {
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(310, now);
          osc.frequency.exponentialRampToValueAtTime(65, now + 0.13);
          gain.gain.setValueAtTime(0.15, now);
          gain.gain.linearRampToValueAtTime(0.01, now + 0.13);
          osc.start(now); osc.stop(now + 0.13);
        } else if (kind === 'behead') {
          osc.type = 'square';
          osc.frequency.setValueAtTime(540, now);
          osc.frequency.exponentialRampToValueAtTime(85, now + 0.24);
          gain.gain.setValueAtTime(0.22, now);
          gain.gain.linearRampToValueAtTime(0.01, now + 0.24);
          osc.start(now); osc.stop(now + 0.24);
        } else if (kind === 'gate') {
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(95, now);
          osc.frequency.linearRampToValueAtTime(140, now + 0.22);
          gain.gain.setValueAtTime(0.18, now);
          gain.gain.linearRampToValueAtTime(0.01, now + 0.22);
          osc.start(now); osc.stop(now + 0.22);
        } else if (kind === 'spell') {
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(180, now);
          osc.frequency.exponentialRampToValueAtTime(720, now + 0.26);
          gain.gain.setValueAtTime(0.14, now);
          gain.gain.linearRampToValueAtTime(0.01, now + 0.26);
          osc.start(now); osc.stop(now + 0.26);
        } else if (kind === 'loot') {
          osc.type = 'sine';
          osc.frequency.setValueAtTime(523.25, now);
          osc.frequency.setValueAtTime(659.25, now + 0.08);
          gain.gain.setValueAtTime(0.15, now);
          gain.gain.linearRampToValueAtTime(0.01, now + 0.24);
          osc.start(now); osc.stop(now + 0.24);
        } else if (kind === 'death') {
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(130, now);
          osc.frequency.linearRampToValueAtTime(38, now + 0.65);
          gain.gain.setValueAtTime(0.24, now);
          gain.gain.linearRampToValueAtTime(0.01, now + 0.65);
          osc.start(now); osc.stop(now + 0.65);
        }
      } catch (e) {}
    }

