<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Tartaria</title>
  <script src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;800;900&family=Crimson+Pro:ital,wght@0,500;0,700;1,400&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --ink-black: #040306;
      --tartaria-bg: #07060b;
      --tartaria-gold: #cfa354;
      --tartaria-gold-bright: #f8e2a8;
      --atman-amber: #fbbf24;
      --wiz-red: #dc2626;
      --ova-ectoplasm: #84cc16;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; -webkit-user-select: none; }
    body, html { width: 100%; height: 100%; overflow: hidden; background-color: var(--ink-black); font-family: 'Crimson Pro', Georgia, serif; color: #e6dcc8; }
    canvas#gameCanvas { display: block; width: 100vw; height: 100vh; background: var(--tartaria-bg); cursor: crosshair; }

    #crt-overlay {
      position: fixed; inset: 0; pointer-events: none; z-index: 90;
      background: linear-gradient(rgba(14,12,18,0) 50%, rgba(0,0,0,0.25) 50%), radial-gradient(circle at center, transparent 58%, rgba(2,1,5,0.82) 100%);
      background-size: 100% 3px, 100% 100%;
    }
    .tartaria-window {
      background: linear-gradient(180deg, rgba(18,16,26,0.93) 0%, rgba(7,6,12,0.97) 100%);
      border: 1.5px solid var(--tartaria-gold); outline: 2px solid #000;
      box-shadow: 0 6px 20px rgba(0,0,0,0.85), inset 0 0 0 1px rgba(255,230,160,0.12), inset 0 0 22px rgba(0,0,0,0.9);
      border-radius: 3px;
    }

    /* Character Creation Modal */
    #char-modal {
      position: absolute; inset: 0;
      background: radial-gradient(circle at 50% 25%, rgba(45,22,32,0.96) 0%, rgba(4,3,7,0.99) 85%);
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      z-index: 100; padding: 12px; overflow-y: auto;
    }
    .char-card { width: 100%; max-width: 900px; padding: 18px 22px; display: grid; grid-template-columns: 1.28fr 0.72fr; gap: 16px; }
    @media (max-width: 740px) { .char-card { grid-template-columns: 1fr; } }
    .title-banner { grid-column: 1 / -1; text-align: center; border-bottom: 2px solid #3a2818; padding-bottom: 10px; }
    .wiz-logo-wrap { position: relative; display: inline-block; padding: 0 46px; }
    .wiz-logo-sword {
      position: absolute; top: 52%; left: 0; right: 0; height: 4px;
      background: linear-gradient(90deg, #ef4444 0%, #dc2626 85%, #facc15 100%);
      box-shadow: 0 2px 0 #000; z-index: 1;
    }
    .wiz-logo-sword::after { content: ''; position: absolute; right: 12px; top: -9px; width: 4px; height: 22px; background: #ef4444; box-shadow: 1px 1px 0 #000; }
    .title-banner h1 {
      position: relative; z-index: 2; font-family: 'Cinzel', serif; font-size: 32px; font-weight: 900;
      letter-spacing: 7px; text-transform: uppercase; color: #ef4444;
      text-shadow: 2px 2px 0 #000, -1px -1px 0 #000, 0 0 18px rgba(220,38,38,0.75);
    }
    .title-banner h2 { font-family: 'Cinzel', serif; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: var(--tartaria-gold-bright); margin-top: 4px; }
    .save-banner {
      grid-column: 1 / -1; background: rgba(20,45,25,0.7); border: 1px solid #4ade80; color: #bbf7d0;
      padding: 6px 12px; font-size: 12px; font-family: 'Cinzel', serif; display: none; justify-content: space-between; align-items: center;
    }
    .form-col { display: flex; flex-direction: column; gap: 9px; }
    .preview-col {
      display: flex; flex-direction: column; align-items: center; justify-content: space-between;
      background: #07080d; border: 2px solid #3a2818; box-shadow: inset 0 0 28px rgba(0,0,0,0.95); padding: 10px;
    }
    #previewCanvas { width: 240px; height: 215px; background: radial-gradient(circle at 50% 65%, #232a3b 0%, #050508 78%); border: 1px solid #2d2016; }
    .lore-box { font-size: 12px; line-height: 1.35; color: #d8c8b4; font-style: italic; text-align: center; padding: 6px 8px; background: rgba(12,10,16,0.92); border-left: 3px solid var(--tartaria-gold); width: 100%; }
    .form-group { display: flex; flex-direction: column; gap: 3px; }
    label { font-family: 'Cinzel', serif; font-size: 10px; font-weight: 800; text-transform: uppercase; color: var(--tartaria-gold); letter-spacing: 1px; }
    input[type="text"], select { background: #050408; border: 1.5px solid #4a3520; color: #f3ebd6; padding: 6px 10px; border-radius: 2px; font-family: 'Crimson Pro', serif; font-size: 14px; font-weight: 600; outline: none; }
    input[type="text"]:focus, select:focus { border-color: var(--tartaria-gold-bright); }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .name-row { display: flex; gap: 6px; }
    .name-row input { flex: 1; }
    .swatch-row { display: flex; gap: 6px; margin-top: 2px; }
    .swatch { width: 22px; height: 22px; border: 2px solid #000; outline: 1px solid #574129; cursor: pointer; }
    .swatch.active { transform: scale(1.18); outline: 2px solid var(--tartaria-gold-bright); }
    .btn-spawn {
      grid-column: 1 / -1; background: linear-gradient(180deg, #991b1b 0%, #450a0a 100%);
      border: 2px solid var(--tartaria-gold-bright); outline: 2px solid #000; color: #fff4db; padding: 11px;
      font-family: 'Cinzel', serif; font-size: 14px; font-weight: 900; letter-spacing: 2px; text-transform: uppercase;
      cursor: pointer; text-shadow: 2px 2px 0 #000; box-shadow: 3px 3px 0 #000;
    }
    .btn-spawn:hover { filter: brightness(1.15); }

    /* =========================================================================
       HUD LAYOUT:
       - Top-Left: Player Profile + Party Mates Portraits
       - Right-Side: Auto-Map + 3-Weapon Rack (Prime 1, Side 2, Backup 3) & Stance
       - Bottom-Center: 1-9 Specials Bar
       ========================================================================= */
    #hud { position: fixed; inset: 0; pointer-events: none; display: none; z-index: 50; }
    .interactive { pointer-events: auto; }

    .top-ribbon {
      position: absolute; top: 0; left: 0; right: 0; height: 34px;
      background: linear-gradient(180deg, rgba(12,10,18,0.96) 0%, rgba(6,5,10,0.92) 100%);
      border-bottom: 1.5px solid var(--tartaria-gold); box-shadow: 0 3px 12px rgba(0,0,0,0.85);
      display: flex; justify-content: space-between; align-items: center; padding: 0 12px;
      font-family: 'Cinzel', serif; font-size: 10.5px; z-index: 60;
    }
    .ribbon-left, .ribbon-right { display: flex; align-items: center; gap: 6px; }
    .action-btn {
      background: linear-gradient(180deg, #241b29 0%, #120d16 100%); border: 1px solid var(--tartaria-gold);
      color: var(--tartaria-gold-bright); padding: 3px 8px; font-family: 'Cinzel', serif; font-size: 9px;
      font-weight: 700; letter-spacing: 0.7px; cursor: pointer; text-transform: uppercase; border-radius: 2px;
    }
    .action-btn:hover { background: #382833; border-color: #fff; }

    /* TOP-LEFT DOCK: Player Profile + Party Mates Portraits */
    #top-left-party-dock {
      position: absolute; top: 40px; left: 10px; width: 252px;
      display: flex; flex-direction: column; gap: 6px;
    }
    .profile-card { padding: 8px 10px; font-size: 10px; backdrop-filter: blur(4px); }
    .profile-header { display: flex; align-items: center; gap: 8px; margin-bottom: 4px; }
    .portrait-badge {
      width: 36px; height: 36px; border-radius: 50%;
      background: radial-gradient(circle at 50% 40%, #4c1d24 0%, #09070d 100%);
      border: 2px solid var(--tartaria-gold-bright); display: flex; align-items: center; justify-content: center;
      font-family: 'Cinzel', serif; font-weight: 900; font-size: 15px; color: #fde047; flex-shrink: 0;
    }
    .bar-row { margin-top: 3px; }
    .bar-label { display: flex; justify-content: space-between; font-size: 8.5px; font-family: 'JetBrains Mono', monospace; }
    .bar-container { width: 100%; height: 6px; background: #050408; border: 1px solid #3d2d1f; margin-top: 1px; overflow: hidden; border-radius: 1px; }
    .bar-fill { height: 100%; width: 100%; transition: width 0.12s linear; }
    #hp-fill { background: linear-gradient(90deg, #991b1b 0%, #ef4444 100%); }
    #mana-fill { background: linear-gradient(90deg, #1e40af 0%, #38bdf8 100%); }
    #atman-fill { background: linear-gradient(90deg, #b45309 0%, #fbbf24 60%, #fef08a 100%); }
    #xp-fill { background: linear-gradient(90deg, #854d0e 0%, #f4dca6 100%); }

    #party-mates-box { padding: 6px 8px; font-size: 9.5px; display: flex; flex-direction: column; gap: 4px; }
    .party-member {
      display: flex; align-items: center; justify-content: space-between; gap: 6px;
      background: rgba(5,4,9,0.85); border: 1px solid #3a2a18; padding: 4px 6px; border-radius: 2px;
    }
    .mate-avatar {
      width: 24px; height: 24px; border-radius: 50%; border: 1.5px solid #38bdf8; background: #111827;
      display: flex; align-items: center; justify-content: center; font-family: 'Cinzel', serif; font-size: 10px; font-weight: 800; color: #38bdf8; flex-shrink: 0;
    }
    .party-warp-btn { background: #1e293b; border: 1px solid #64748b; color: #e2e8f0; font-family: 'Cinzel', serif; font-size: 8px; padding: 2px 5px; cursor: pointer; }
    .party-warp-btn:hover { border-color: var(--tartaria-gold-bright); color: var(--tartaria-gold-bright); }

    /* RIGHT-SIDE DOCK: Auto-Map + 3-Weapon Rack (Prime 1, Side 2, Backup 3) & Stance */
    #right-dock {
      position: absolute; top: 40px; right: 10px; width: 214px;
      display: flex; flex-direction: column; gap: 6px;
    }
    #minimap-box { padding: 6px; display: flex; flex-direction: column; align-items: center; gap: 3px; }
    #minimapCanvas { width: 196px; height: 112px; background: #050408; border: 1px solid #4a3520; cursor: pointer; }

    #weapon-stance-dock { padding: 8px; display: flex; flex-direction: column; gap: 5px; }
    .stance-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; }
    .stance-btn {
      background: #0b0912; border: 1px solid #4a3520; color: #a89984; padding: 4px 2px;
      font-family: 'Cinzel', serif; font-size: 8px; font-weight: 800; text-align: center; cursor: pointer; border-radius: 2px;
    }
    .stance-btn.active {
      background: linear-gradient(180deg, #5c1919 0%, #2a0a0a 100%); border-color: var(--tartaria-gold-bright);
      color: #fff; box-shadow: 0 0 8px rgba(220,38,38,0.5);
    }
    .weapon-slot-card {
      display: flex; align-items: center; justify-content: space-between;
      background: rgba(6,5,10,0.9); border: 1.5px solid #42301b; padding: 5px 7px; border-radius: 3px; cursor: pointer;
    }
    .weapon-slot-card:hover { border-color: #cbd5e1; }
    .weapon-slot-card.active {
      background: linear-gradient(90deg, rgba(95,52,18,0.72) 0%, rgba(16,12,22,0.95) 100%);
      border-color: var(--tartaria-gold-bright); box-shadow: 0 0 12px rgba(248,226,168,0.3);
    }
    .wpn-key-badge { font-family: 'JetBrains Mono', monospace; font-size: 8.5px; font-weight: 800; color: #000; background: var(--tartaria-gold); padding: 1px 4px; border-radius: 2px; margin-right: 5px; }
    .wpn-dmg-tag { font-family: 'Cinzel', serif; font-size: 7.5px; font-weight: 900; padding: 1px 4px; border-radius: 2px; border: 1px solid #000; }
    .tag-slash  { background: #7f1d1d; color: #fca5a5; }
    .tag-blunt  { background: #78350f; color: #fde047; }
    .tag-pierce { background: #1e3a8a; color: #93c5fd; }

    /* Top-Center Boss Health Bar */
    #boss-bar-wrap {
      position: absolute; top: 40px; left: 50%; transform: translateX(-50%);
      width: 420px; max-width: calc(100vw - 500px); padding: 6px 12px;
      display: none; flex-direction: column; gap: 3px; z-index: 70; pointer-events: none;
    }
    #boss-bar-title { font-family: 'Cinzel', serif; font-size: 11px; font-weight: 900; color: #fca5a5; letter-spacing: 1.5px; text-align: center; text-shadow: 2px 2px 0 #000; }
    .boss-hp-track { width: 100%; height: 10px; background: #090508; border: 1.5px solid #cfa354; overflow: hidden; }
    #boss-hp-fill { width: 100%; height: 100%; background: linear-gradient(90deg, #7f1d1d 0%, #ef4444 50%, #f97316 100%); transition: width 0.1s linear; }

    /* Bottom-Left Compact Chat */
    .chat-container {
      position: absolute; bottom: 68px; left: 10px; width: 290px; max-width: calc(100vw - 24px);
      display: flex; flex-direction: column; gap: 3px; opacity: 0.86; transition: opacity 0.2s;
    }
    .chat-container:hover, .chat-container:focus-within { opacity: 1.0; }
    .chat-log { height: 78px; padding: 5px 8px; overflow-y: auto; display: flex; flex-direction: column; gap: 2px; font-size: 11px; background: rgba(8,7,14,0.78); }
    .chat-msg { word-break: break-word; line-height: 1.22; text-shadow: 1px 1px 0 #000; }
    .chat-msg .author { color: var(--tartaria-gold-bright); font-weight: 700; font-family: 'Cinzel', serif; margin-right: 4px; }
    .chat-input-row { display: flex; gap: 4px; }
    .chat-input { flex: 1; background: rgba(5,4,8,0.92); border: 1.5px solid #4a3520; padding: 4px 8px; color: #f3ebd6; font-size: 11.5px; font-family: 'Crimson Pro', serif; outline: none; }

    /* Bottom-Center 1-9 Specials Dock */
    .bottom-action-dock {
      position: absolute; bottom: 8px; left: 50%; transform: translateX(-50%);
      display: flex; align-items: center; gap: 6px; padding: 4px 8px;
      background: rgba(8,7,13,0.94); border: 1.5px solid var(--tartaria-gold); box-shadow: 0 4px 18px rgba(0,0,0,0.95); border-radius: 4px;
    }
    .special-orb-btn {
      width: 46px; height: 46px; border-radius: 50%;
      background: radial-gradient(circle at 35% 35%, #f59e0b 0%, #78350f 70%, #1c1917 100%);
      border: 2px solid var(--tartaria-gold-bright); color: #fff; display: flex; flex-direction: column;
      align-items: center; justify-content: center; cursor: pointer; box-shadow: 0 0 12px rgba(251,191,36,0.4);
      font-family: 'Cinzel', serif; font-size: 7.5px; font-weight: 900; text-shadow: 1px 1px 0 #000;
    }
    .special-orb-btn:hover { filter: brightness(1.2); }
    .hotbar { display: flex; gap: 4px; }
    .hotkey-slot {
      width: 46px; height: 46px; background: linear-gradient(180deg, #1b1724 0%, #09080d 100%);
      border: 1.5px solid #6b532e; display: flex; flex-direction: column; align-items: center; justify-content: center;
      cursor: pointer; position: relative; border-radius: 2px; overflow: hidden;
    }
    .hotkey-slot.locked { opacity: 0.38; border-color: #2e241d; cursor: not-allowed; }
    .hotkey-slot:not(.locked):hover { border-color: var(--tartaria-gold-bright); box-shadow: inset 0 0 8px rgba(248,226,168,0.25); }
    .hotkey-num { position: absolute; top: 1px; left: 3px; font-family: 'JetBrains Mono', monospace; font-size: 8px; font-weight: 700; color: var(--tartaria-gold); }
    .hotkey-mp { position: absolute; top: 1px; right: 3px; font-family: 'JetBrains Mono', monospace; font-size: 7px; color: #38bdf8; }
    .hotkey-icon { font-size: 15px; margin-top: 3px; }
    .hotkey-label { font-family: 'Cinzel', serif; font-size: 6.5px; color: #dfd0ba; text-transform: uppercase; margin-top: 1px; text-align: center; max-width: 42px; overflow: hidden; white-space: nowrap; }
    .cd-overlay { position: absolute; bottom: 0; left: 0; right: 0; height: 0%; background: rgba(0,0,0,0.72); pointer-events: none; }

    /* Interactive Multi-Item Chest Loot & Appraisal Modal */
    #loot-modal {
      position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
      width: 92%; max-width: 500px; background: rgba(12,10,18,0.95); backdrop-filter: blur(8px);
      border: 2px solid var(--tartaria-gold-bright); outline: 2px solid #000;
      box-shadow: 0 14px 45px rgba(0,0,0,0.95); padding: 14px 18px;
      display: none; flex-direction: column; gap: 9px; z-index: 165;
    }
    .loot-item-row {
      display: flex; justify-content: space-between; align-items: center; gap: 8px;
      background: rgba(5,4,8,0.92); border: 1px solid #4a3520; padding: 7px 10px; border-radius: 2px;
    }
    .rarity-common    { color: #e2e8f0; }
    .rarity-rare      { color: #38bdf8; }
    .rarity-epic      { color: #facc15; }
    .rarity-legendary { color: #f87171; text-shadow: 0 0 8px rgba(248,113,113,0.45); }

    #werdna-modal {
      position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
      width: 92%; max-width: 520px; background: #f5f0e1; color: #111; border: 4px solid #111;
      outline: 3px solid var(--tartaria-gold); box-shadow: 0 18px 55px rgba(0,0,0,0.95);
      padding: 18px; display: none; flex-direction: column; align-items: center; gap: 10px; z-index: 180;
    }
    #werdna-modal p { font-family: 'Crimson Pro', Georgia, serif; font-size: 14.5px; font-weight: 700; line-height: 1.35; text-align: justify; color: #1a1615; }

    #inventory-modal, #grimoire-modal, #ascend-modal {
      position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
      width: 92%; max-width: 620px; background: rgba(10,8,15,0.94); backdrop-filter: blur(8px);
      border: 2px solid var(--tartaria-gold); outline: 2px solid #000; box-shadow: 0 12px 45px rgba(0,0,0,0.95);
      padding: 16px 20px; display: none; flex-direction: column; gap: 11px; z-index: 150;
    }
    .equip-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .equip-box { background: rgba(5,4,8,0.85); border: 1px solid #574129; padding: 7px; text-align: center; cursor: pointer; }
    .equip-box:hover { border-color: var(--tartaria-gold-bright); }
    .equip-box small { display: block; font-family: 'Cinzel', serif; font-size: 8.5px; color: #9c8462; text-transform: uppercase; }
    .equip-box strong { display: block; font-family: 'Cinzel', serif; font-size: 11px; color: var(--tartaria-gold-bright); margin-top: 2px; }
    .equip-box span { font-size: 9.5px; color: #4ade80; }
    .bag-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
    .bag-slot { min-height: 64px; background: rgba(5,4,8,0.82); border: 1px solid #3a2a18; padding: 6px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; cursor: pointer; }
    .bag-slot:hover { border-color: var(--tartaria-gold-bright); }
    .bag-slot .item-name { font-family: 'Cinzel', serif; font-size: 10px; font-weight: 700; }
    .bag-slot .item-stat { font-size: 9px; color: #a89984; }

    .spell-list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; max-height: 260px; overflow-y: auto; }
    .spell-card { background: #060509; border: 1px solid #4a3520; padding: 8px 10px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; }
    .spell-card:hover { border-color: var(--tartaria-gold-bright); }

    #souls-banner {
      position: absolute; top: 22%; left: 0; right: 0;
      background: linear-gradient(90deg, transparent 0%, rgba(10,4,6,0.92) 25%, rgba(10,4,6,0.92) 75%, transparent 100%);
      border-top: 1px solid rgba(200,157,84,0.45); border-bottom: 1px solid rgba(200,157,84,0.45);
      padding: 12px 0; text-align: center; font-family: 'Cinzel', serif; font-size: 22px; font-weight: 900;
      letter-spacing: 5px; color: #fbbf24; text-shadow: 0 0 18px rgba(251,191,36,0.75), 2px 2px 0 #000;
      display: none; z-index: 190; pointer-events: none;
    }
    #toast {
      position: absolute; top: 80px; left: 50%; transform: translateX(-50%);
      padding: 5px 16px; font-family: 'Cinzel', serif; font-size: 11px; font-weight: 800;
      color: var(--tartaria-gold-bright); letter-spacing: 1.2px; display: none; z-index: 200; text-shadow: 1px 1px 0 #000;
    }
  </style>
</head>
<body>

  <div id="crt-overlay"></div>
  <div id="souls-banner">SECTOR CARVED INTO STONE</div>

  <!-- Top-Center Boss Health Bar -->
  <div id="boss-bar-wrap" class="tartaria-window">
    <div id="boss-bar-title">☠️ PETRIFIED STATUE OF FATHER ABESHU</div>
    <div class="boss-hp-track"><div id="boss-hp-fill"></div></div>
  </div>

  <!-- Werdna 1981 Manual Art Portrait Modal -->
  <div id="werdna-modal">
    <p>"Come, enter the World of Wizardry if you dare. I am sure I know you. You lead a small band of foolhardy adventurers that dares challenge me. Ha! My dark legions laugh at your exploits in my domain. But wait. You have yet to meet me and face the ultimate terrors of my wicked magic. You can still run away, fools! Ha, ha, ha!"</p>
    <canvas id="werdnaCanvas" width="260" height="230" style="border:2px solid #111; background:#f5f0e1;"></canvas>
    <button class="action-btn" onclick="document.getElementById('werdna-modal').style.display='none'" style="background:#7c0a0a; color:#fff; padding:6px 18px;">Defy Werdna [Close]</button>
  </div>

  <!-- Interactive Multi-Item Chest Loot & Wizardry Appraisal Modal -->
  <div id="loot-modal" class="interactive">
    <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #4a3520; padding-bottom:6px;">
      <span id="loot-modal-title" style="font-family:'Cinzel',serif; font-size:14px; font-weight:900; color:var(--tartaria-gold-bright);">🎁 RELIQUARY COFFER</span>
