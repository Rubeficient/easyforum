        `Active Bonus: ATK +${localPlayer.dmgBonus} | MaxHP ${localPlayer.maxHp} | MaxMP ${localPlayer.maxMana}`;

      const grid = document.getElementById('bag-grid');
      grid.innerHTML = '';
      for (let i = 0; i < 8; i++) {
        const it = localPlayer.backpack[i];
        const cell = document.createElement('div');
        cell.className = 'bag-slot';
        if (it) {
          const rClass = `rarity-${it.rarity || 'rare'}`;
          cell.innerHTML = `
            <span class="item-name ${rClass}">${it.name}</span>
            <span class="item-stat">${it.dmgType ? '[' + it.dmgType + ']' : '[GEAR]'} +${it.atk || 0} ATK +${it.hp || 0} HP</span>
          `;
          cell.onclick = () => {
            equipItemDirectly(it);
            localPlayer.backpack.splice(i, 1);
            renderInventoryUI();
          };
        } else {
          cell.innerHTML = `<span style="font-size:9.5px; color:#57493a;">Empty Slot</span>`;
        }
        grid.appendChild(cell);
      }
      updateVitalsUI();
    }

