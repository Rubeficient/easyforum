    function triggerSpellSlot(slotIdx) {
      initAudioEngine();
      const unlocked = Math.min(9, localPlayer.level);
      if (slotIdx + 1 > unlocked) {
        showToast(`Slot ${slotIdx + 1} unlocks at Level ${slotIdx + 1}!`);
        return;
      }

      const nowSec = performance.now() * 0.001;
      if (nowSec < slotCooldowns[slotIdx]) return;

      const spellId = localPlayer.spellBar[slotIdx] || 'strike';
      const sp = GRIMOIRE_SPELLS.find(s => s.id === spellId) || GRIMOIRE_SPELLS[0];

      if (localPlayer.mana < sp.mp) {
        showToast(`Need ${sp.mp} MP for ${sp.name}!`);
        return;
      }

      localPlayer.mana -= sp.mp;
      slotCooldowns[slotIdx] = nowSec + sp.cd;
      localPlayer.swingTimer = 18;
      localPlayer.chatBubble = sp.chant;
      localPlayer.chatTimer = 75;

      const totalPower = sp.dmg + localPlayer.dmgBonus;

      if (sp.type === 'heal') {
        playSfx('spell');
        localPlayer.hp = Math.min(localPlayer.maxHp, localPlayer.hp + totalPower);
        spawnSpellVortex(localPlayer.x, localPlayer.y, sp.color, 75);
        spawnCombatText(localPlayer.x, localPlayer.y, `+${totalPower} ${sp.name}`, '#4ade80');
      } else if (sp.type === 'buff') {
        playSfx('spell');
        localPlayer.hp = Math.min(localPlayer.maxHp, localPlayer.hp + sp.dmg);
        localPlayer.speed = 415;
        spawnSpellVortex(localPlayer.x, localPlayer.y, sp.color, 85);
        setTimeout(() => { recalcEquipmentStats(); }, 2400);
        showToast(`${sp.name} Active!`);
      } else if (sp.type === 'dash') {
        playSfx('slash');
        const dashX = localPlayer.x + localPlayer.facing * 135;
        resolveDungeonMovement(localPlayer, dashX, localPlayer.y);
        spawnSlashArc(localPlayer.x, localPlayer.y, localPlayer.facing, sp.color, 88);
        damageTargetsInRadius(localPlayer.x, localPlayer.y, 135, totalPower, sp.name, sp.color);
      } else if (sp.type === 'aoe') {
        playSfx('spell');
        spawnSpellVortex(localPlayer.x, localPlayer.y, sp.color, 180);
        damageTargetsInRadius(localPlayer.x, localPlayer.y, 185, totalPower, sp.name, sp.color);
      } else {
        playSfx('slash');
        let target = findCurrentTarget();
        if (target && Math.hypot(target.x - localPlayer.x, target.y - localPlayer.y) <= (sp.type === 'bolt' ? 290 : 120)) {
          localPlayer.facing = target.x >= localPlayer.x ? 1 : -1;
          spawnSlashArc(target.x, target.y, localPlayer.facing, sp.color, 60);
          spawnSpellVortex(target.x, target.y, sp.color, 52);
          applyHitToTarget(target, totalPower, sp.name, sp.color);
        } else {
          spawnSlashArc(localPlayer.x + localPlayer.facing * 35, localPlayer.y, localPlayer.facing, sp.color, 58);
          damageTargetsInRadius(localPlayer.x + localPlayer.facing * 40, localPlayer.y, 95, totalPower, sp.name, sp.color);
        }
      }

      updateVitalsUI();
      broadcastState();
    }

    function findCurrentTarget() {
      const mob = enemies.find(e => e.id === localPlayer.targetEntityId);
      if (mob) return { ...mob, isPlayer: false, ref: mob };
      const rem = remotePlayers.get(localPlayer.targetEntityId);
      if (rem) return { ...rem, isPlayer: true, ref: rem };
      return null;
