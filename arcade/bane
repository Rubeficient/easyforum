        spawnGrassParticles(localPlayer.x, localPlayer.y + 4, 1, '#65a30d');

      }



      if (localPlayer.emoteTimer > 0) localPlayer.emoteTimer = Math.max(0, localPlayer.emoteTimer - dt);

      if (localPlayer.swingTimer > 0) localPlayer.swingTimer = Math.max(0, localPlayer.swingTimer - dt);

      if (localPlayer.spellTimer > 0) localPlayer.spellTimer = Math.max(0, localPlayer.spellTimer - dt);

      if (localPlayer.sprintTimer > 0) localPlayer.sprintTimer = Math.max(0, localPlayer.sprintTimer - dt);

      if (localPlayer.spawnBeamTimer > 0) localPlayer.spawnBeamTimer = Math.max(0, localPlayer.spawnBeamTimer - dt);

      if (clickMarker && clickMarker.timer > 0) clickMarker.timer = Math.max(0, clickMarker.timer - dt);



      const distToTree = Math.hypot(localPlayer.x - TREE_X, localPlayer.y - TREE_Y);

      const inSanctuary = distToTree < SANCTUARY_RADIUS;

      const regenMult = (localPlayer.sitting ? 2.5 : 1.0) * (inSanctuary ? 1.5 : 1.0);

      localPlayer.mp = Math.min(localPlayer.maxMp, localPlayer.mp + 4.5 * regenMult * dt);

      localPlayer.st = Math.min(localPlayer.maxSt, localPlayer.st + 6.0 * regenMult * dt);

      updateSelfBarsUI();



      LIFE_ORBS.forEach(orb => {

