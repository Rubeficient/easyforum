    const keys = {};
    window.addEventListener('keydown', (e) => {
      if (document.activeElement === document.getElementById('chat-input')) {
        if (e.key === 'Enter') sendChat();
        return;
      }
      keys[e.key.toLowerCase()] = true;

      if (e.code === 'Space') {
        e.preventDefault();
        triggerSpellSlot(0); // Spacebar fires primary ranged volley!
      } else if (['1','2','3','4','5','6','7','8','9'].includes(e.key)) {
        triggerSpellSlot(parseInt(e.key) - 1);
      } else if (e.key.toLowerCase() === 'f') {
        document.getElementById('btn-autoaim').click();
      } else if (e.key.toLowerCase() === 'i') {
        toggleInventory();
      } else if (e.key.toLowerCase() === 'g') {
        toggleGrimoire();
      } else if (e.key.toLowerCase() === 'e') {
        interactWithWorldObject();
      } else if (e.key === 'Escape') {
        toggleInventory(false);
        toggleGrimoire(false);
        document.getElementById('werdna-modal').style.display = 'none';
      } else if (e.key === 'Tab') {
        e.preventDefault();
        cycleTabTarget();
      } else if (e.key === 'Enter') {
        document.getElementById('chat-input').focus();
      }
    });

    window.addEventListener('keyup', (e) => {
      keys[e.key.toLowerCase()] = false;
    });

    canvas.addEventListener('mousedown', (e) => {
      initAudioEngine();
      mouseScreenX = e.clientX;
      mouseScreenY = e.clientY;
      const camX = localPlayer.x - screenW / 2;
      const camY = localPlayer.y - screenH / 2;
      const clickX = e.clientX + camX;
      const clickY = e.clientY + camY;

      // 1. Check if clicking a Portcullis Gate
      for (const g of GATES) {
        if (Math.hypot(clickX - g.x, clickY - g.y) < 55) {
          g.isOpen = !g.isOpen;
          g.manualLock = !g.isOpen;
          playSfx('gate');
          showToast(`${g.label}: ${g.isOpen ? 'OPENED ⛩️' : 'LOCKED SHUT 🔒'}`);
          return;
        }
      }

      // 2. Check if clicking a Loot Chest
      for (let i = lootChests.length - 1; i >= 0; i--) {
        const ch = lootChests[i];
        if (Math.hypot(clickX - ch.x, clickY - ch.y) < 36) {
          if (Math.hypot(localPlayer.x - ch.x, localPlayer.y - ch.y) < 125) {
            claimChestLoot(i);
          } else {
            localPlayer.targetX = ch.x;
            localPlayer.targetY = ch.y;
          }
          return;
        }
      }

      // 3. Check if clicking an NPC
      for (const npc of TARTARIA_NPCS) {
        if (Math.hypot(clickX - npc.x, clickY - npc.y) < 38) {
          appendChat(npc.name, npc.dialog);
          showToast(`${npc.name}: ${npc.dialog}`);
          return;
        }
      }

      // 4. Check if clicking an Enemy or Boss -> Lock Target & Fire Ranged Shot immediately!
      for (const en of enemies) {
        if (Math.hypot(clickX - en.x, clickY - en.y) < en.radius + 22) {
          localPlayer.targetEntityId = en.id;
          triggerSpellSlot(0);
          return;
        }
      }

      // 5. Left-click in open space: move toward click AND fire if holding Shift
      if (e.shiftKey || e.button === 2) {
        triggerSpellSlot(0);
      } else {
        localPlayer.targetX = clickX;
        localPlayer.targetY = clickY;
      }
    });

    canvas.addEventListener('contextmenu', (e) => {
      e.preventDefault();
      triggerSpellSlot(0); // Right-click fires ranged attack toward cursor!
    });

    function interactWithWorldObject() {
      for (let i = lootChests.length - 1; i >= 0; i--) {
        if (Math.hypot(localPlayer.x - lootChests[i].x, localPlayer.y - lootChests[i].y) < 125) {
          claimChestLoot(i);
          return;
        }
      }
      for (const npc of TARTARIA_NPCS) {
        if (Math.hypot(localPlayer.x - npc.x, localPlayer.y - npc.y) < 125) {
          appendChat(npc.name, npc.dialog);
          showToast(`${npc.name}: ${npc.dialog}`);
          return;
        }
      }
      toggleNearestGate();
    }

    function claimChestLoot(idx) {
      const ch = lootChests[idx];
      if (!ch) return;
      lootChests.splice(idx, 1);
      playSfx('loot');
      localPlayer.gold += ch.gold || 40;
      if (ch.item) {
        if (localPlayer.backpack.length < 8) {
          localPlayer.backpack.push({ ...ch.item });
          showToast(`Looted ${ch.item.name} & ${ch.gold}g! Press [I] to equip.`);
        } else {
          showToast(`Looted ${ch.gold}g! (Backpack full for ${ch.item.name})`);
        }
      }
      savePersistentProgress();
      updateVitalsUI();
    }

    function cycleTabTarget() {
      const candidates = [
        ...enemies.map(e => ({ id: e.id, name: e.name, x: e.x, y: e.y })),
        ...Array.from(remotePlayers.values()).map(p => ({ id: p.id, name: p.name, x: p.x, y: p.x }))
      ];
      if (candidates.length === 0) return;
      candidates.sort((a, b) =>
        Math.hypot(a.x - localPlayer.x, a.y - localPlayer.y) - Math.hypot(b.x - localPlayer.x, b.y - localPlayer.y)
      );
      const curIdx = candidates.findIndex(c => c.id === localPlayer.targetEntityId);
      const next = candidates[(curIdx + 1) % candidates.length];
      localPlayer.targetEntityId = next.id;
      showToast(`Targeted: ${next.name}`);
    }

    // =========================================================================
    // 13. HIGH-DETAIL 2.5D OVA CHARACTER, BOSS & PROJECTILE RENDERER
    // =========================================================================
    function drawOVACharacter(ctx, p, cx, cy, timeSec, scaleOverride = 1.0, isTargeted = false) {
      const subMeta = getSubraceMeta(p);
      const sc = subMeta.scale * scaleOverride;
      const facing = p.facing || 1;
      const isMoving = p.isMoving;
      const walkBob = isMoving ? Math.abs(Math.sin(timeSec * 11)) * -4.5 : Math.sin(timeSec * 2.8) * 1.5;
      const stride = isMoving ? Math.sin(timeSec * 11) * 6 : 0;

      ctx.save();
      ctx.translate(cx, cy);

      if (isTargeted) {
        ctx.strokeStyle = '#ff2a38';
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        ctx.ellipse(0, 4, 28 * sc, 13 * sc, 0, 0, Math.PI * 2);
        ctx.stroke();
      }

      // Soft ambient drop shadow
      ctx.fillStyle = 'rgba(0, 0, 0, 0.78)';
      ctx.beginPath();
      ctx.ellipse(0, 6, 20 * sc, 9 * sc, 0, 0, Math.PI * 2);
      ctx.fill();

      ctx.save();
      ctx.scale(facing * sc, sc);
      ctx.translate(0, walkBob);
      ctx.lineJoin = 'round';
      ctx.lineCap = 'round';

      if (subMeta.tail) {
        ctx.strokeStyle = subMeta.skin;
        ctx.lineWidth = 5;
        ctx.beginPath();
        ctx.moveTo(-6, -8);
        ctx.quadraticCurveTo(-26, 2, -32, -12 + Math.sin(timeSec * 6) * 5);
        ctx.stroke();
      }

      if (subMeta.wings) {
        const flap = Math.sin(timeSec * 6) * 5;
        ctx.fillStyle = subMeta.tail ? '#1e3a5f' : '#4a0808';
        ctx.strokeStyle = '#040306';
        ctx.lineWidth = 2.2;
        ctx.beginPath();
        ctx.moveTo(-4, -26);
        ctx.lineTo(-38, -48 + flap);
        ctx.lineTo(-28, -14);
        ctx.closePath();
        ctx.fill(); ctx.stroke();
      }

      // Multi-fold Flowing Cloak with highlight edge
      const cloakWave = Math.sin(timeSec * 5 + (isMoving ? 2 : 0)) * (isMoving ? 7 : 2.5);
      ctx.fillStyle = subMeta.skeleton ? '#2563eb' : (subMeta.sunShield ? '#1d4ed8' : (p.armorColor || '#2b3d54'));
      ctx.strokeStyle = '#040306';
      ctx.lineWidth = 2.4;
      ctx.beginPath();
      ctx.moveTo(-10, -31);
      ctx.lineTo(10, -31);
      ctx.lineTo(15 - cloakWave, 4);
      ctx.lineTo(-16 - cloakWave, 4);
      ctx.closePath();
      ctx.fill(); ctx.stroke();

      // Articulated Boots & Greaves
      ctx.fillStyle = subMeta.skeleton ? '#d6d3c4' : '#17141f';
      ctx.strokeStyle = '#040306';
      ctx.lineWidth = 2.2;
      ctx.fillRect(-7 + stride * 0.5, -12, 6, 14);
      ctx.strokeRect(-7 + stride * 0.5, -12, 6, 14);
      ctx.fillRect(2 - stride * 0.5, -12, 6, 14);
      ctx.strokeRect(2 - stride * 0.5, -12, 6, 14);

      // Metallic Shaded Torso Armor + Pauldrons
      const torsoGrad = ctx.createLinearGradient(-10, -30, 10, -10);
      torsoGrad.addColorStop(0, subMeta.shellChest ? '#d97706' : (subMeta.bow ? '#be185d' : '#3b3347'));
      torsoGrad.addColorStop(1, '#14111a');
      ctx.fillStyle = torsoGrad;
      ctx.strokeStyle = '#040306';
      ctx.lineWidth = 2.4;
      ctx.beginPath();
      ctx.roundRect(-11, -31, 22, 21, 3);
      ctx.fill(); ctx.stroke();

      // Shoulder Pauldrons
      ctx.fillStyle = '#cfa354';
      ctx.beginPath();
      ctx.ellipse(-11, -28, 5, 4, -0.3, 0, Math.PI * 2);
      ctx.ellipse(11, -28, 5, 4, 0.3, 0, Math.PI * 2);
      ctx.fill(); ctx.stroke();

      if (subMeta.skeleton) {
        ctx.strokeStyle = '#e5e5e5';
        ctx.lineWidth = 1.6;
        for (let r = -26; r <= -16; r += 4) {
          ctx.beginPath(); ctx.moveTo(-6, r); ctx.lineTo(6, r); ctx.stroke();
        }
      } else if (subMeta.shellChest) {
        ctx.fillStyle = '#e2e8f0';
        ctx.beginPath(); ctx.arc(0, -22, 6.5, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
      }

      // Head & Visage
      const headY = -40;
      const headR = 10.5;
      ctx.fillStyle = subMeta.skin;
      ctx.beginPath();
      ctx.arc(0, headY, headR, 0, Math.PI * 2);
      ctx.fill(); ctx.stroke();

      if (subMeta.snout) {
        ctx.fillStyle = subMeta.skin;
        ctx.beginPath();
        ctx.roundRect(4, headY - 2, 10, 7, 2);
        ctx.fill(); ctx.stroke();
      }

      if (subMeta.ears) {
        ctx.fillStyle = subMeta.skin;
        ctx.beginPath();
        ctx.moveTo(-headR + 1, headY - 1);
        ctx.lineTo(-headR - 11, headY - 7);
        ctx.lineTo(-headR + 2, headY + 3);
        ctx.closePath();
        ctx.fill(); ctx.stroke();
      } else if (subMeta.catEars) {
        ctx.fillStyle = subMeta.skin;
        ctx.beginPath();
        ctx.moveTo(-8, headY - 7); ctx.lineTo(-10, headY - 18); ctx.lineTo(-2, headY - 9); ctx.closePath();
        ctx.moveTo(2, headY - 9);  ctx.lineTo(9, headY - 18);  ctx.lineTo(8, headY - 7);  ctx.closePath();
        ctx.fill(); ctx.stroke();
      } else if (subMeta.horns) {
        ctx.fillStyle = subMeta.tail ? '#38bdf8' : '#f4dca6';
        ctx.beginPath();
        ctx.moveTo(-5, headY - 7); ctx.lineTo(-16, headY - 24); ctx.lineTo(-1, headY - 9); ctx.closePath();
        ctx.moveTo(5, headY - 7);  ctx.lineTo(16, headY - 24);  ctx.lineTo(1, headY - 9);  ctx.closePath();
        ctx.fill(); ctx.stroke();
      } else {
        ctx.fillStyle = subMeta.flamberge ? '#dc2626' : (p.hairColor || '#eab308');
        ctx.beginPath();
        ctx.moveTo(-11, headY - 3);
        ctx.lineTo(-7, headY - 16);
        ctx.lineTo(0, headY - 12);
        ctx.lineTo(6, headY - 16);
        ctx.lineTo(11, headY - 4);
        ctx.closePath();
        ctx.fill(); ctx.stroke();
      }

      ctx.fillStyle = '#ff3838';
      ctx.fillRect(2, headY - 2, 2.5, 2.5);
      ctx.fillRect(6.5, headY - 2, 2.5, 2.5);

      if (subMeta.sunShield) {
        ctx.save();
        ctx.translate(-10, -17);
        ctx.fillStyle = '#facc15';
        ctx.strokeStyle = '#040306';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.ellipse(0, 0, 9, 13, 0, 0, Math.PI * 2);
        ctx.fill(); ctx.stroke();
        ctx.fillStyle = '#dc2626';
        ctx.beginPath(); ctx.arc(0, 0, 3.5, 0, Math.PI * 2); ctx.fill();
        ctx.restore();
      }

      if (subMeta.orb || subMeta.witchFlame) {
        ctx.fillStyle = subMeta.orb ? '#38bdf8' : '#c084fc';
        ctx.beginPath();
        ctx.arc(-14, -36 + Math.sin(timeSec * 6) * 4, 6, 0, Math.PI * 2);
        ctx.fill(); ctx.stroke();
      }

      // Main-Hand Weapon (Recurve Bow with String & Arrow, or Flamberge/Katana)
      const swingRot = p.swingTimer > 0 ? Math.sin(p.swingTimer * 0.35) * 1.25 : (isMoving ? Math.sin(timeSec * 11) * 0.15 : 0);
      ctx.save();
      ctx.translate(10, -20);
      ctx.rotate(swingRot);

      if (subMeta.bow) {
        ctx.strokeStyle = '#d97706';
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.arc(0, 0, 16, -Math.PI * 0.48, Math.PI * 0.48);
        ctx.stroke();
        // Taut Bowstring + Nocked Arrow
        ctx.strokeStyle = '#e2e8f0';
        ctx.lineWidth = 1.2;
        ctx.beginPath();
        ctx.moveTo(1, -15); ctx.lineTo(-4, 0); ctx.lineTo(1, 15);
        ctx.stroke();
        ctx.strokeStyle = '#fde047';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(-4, 0); ctx.lineTo(18, 0);
        ctx.stroke();
      } else {
        ctx.fillStyle = '#cfa354';
        ctx.fillRect(-5, -3, 10, 3);
        ctx.fillStyle = subMeta.flamberge ? '#fb923c' : '#e2e8f0';
        ctx.strokeStyle = '#040306';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(-3, -3);
        ctx.lineTo(-4, -40);
        ctx.lineTo(2, -45);
        ctx.lineTo(4, -3);
        ctx.closePath();
        ctx.fill(); ctx.stroke();
      }

      ctx.restore();
      ctx.restore();
      ctx.restore();
    }

    function drawCardArtHostile(ctx, en, timeSec, isTargeted) {
      const sc = en.isBoss ? 1.85 : 1.0;
      ctx.save();
      ctx.translate(en.x, en.y);

      if (en.isBoss) {
        // Pulsing Boss Aura Ring on Floor
        ctx.strokeStyle = 'rgba(239, 68, 68, 0.55)';
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.ellipse(0, 8, en.radius * 1.4, en.radius * 0.65, 0, 0, Math.PI * 2);
        ctx.stroke();
      }

      if (isTargeted) {
        ctx.strokeStyle = '#fde047';
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        ctx.ellipse(0, 6, en.radius + 12, (en.radius + 12) * 0.48, 0, 0, Math.PI * 2);
        ctx.stroke();
      }

      ctx.fillStyle = 'rgba(0,0,0,0.72)';
      ctx.beginPath(); ctx.ellipse(0, 6, en.radius, en.radius * 0.45, 0, 0, Math.PI * 2); ctx.fill();

      const bob = Math.sin(timeSec * 6 + en.x) * 2.5;
      ctx.save();
      ctx.scale(sc, sc);
      ctx.translate(0, bob);
      ctx.strokeStyle = '#040306';
      ctx.lineWidth = 2.2;

      if (en.kind === 'greater_demon') {
        ctx.fillStyle = '#1e3a5f';
        ctx.beginPath();
        ctx.moveTo(0, -22); ctx.lineTo(-34, -46); ctx.lineTo(-24, -10);
        ctx.moveTo(0, -22); ctx.lineTo(34, -46);  ctx.lineTo(24, -10);
        ctx.fill(); ctx.stroke();
        ctx.fillStyle = '#28517a';
        ctx.beginPath(); ctx.roundRect(-14, -34, 28, 30, 5); ctx.fill(); ctx.stroke();
        ctx.fillStyle = '#38bdf8';
        ctx.beginPath();
        ctx.moveTo(-6, -34); ctx.lineTo(-15, -52); ctx.lineTo(-2, -36);
        ctx.moveTo(6, -34);  ctx.lineTo(15, -52);  ctx.lineTo(2, -36);
        ctx.fill(); ctx.stroke();
      } else if (en.kind === 'fire_giant') {
        ctx.fillStyle = '#b45309';
        ctx.beginPath(); ctx.roundRect(-15, -36, 30, 32, 4); ctx.fill(); ctx.stroke();
        ctx.fillStyle = '#e2e8f0';
        ctx.beginPath(); ctx.arc(0, -22, 7, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
        ctx.fillStyle = '#dc2626';
        ctx.beginPath(); ctx.arc(0, -42, 12, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
        ctx.fillStyle = '#fde047';
        ctx.beginPath(); ctx.moveTo(14, -18); ctx.lineTo(29, -54); ctx.lineTo(20, -14); ctx.fill(); ctx.stroke();
      } else if (en.kind === 'werdna_boss') {
        // Werdna 1981 Magenta Robes & White Beard
        ctx.fillStyle = '#c81e56';
        ctx.beginPath(); ctx.moveTo(-18, 2); ctx.lineTo(-12, -34); ctx.lineTo(12, -34); ctx.lineTo(18, 2); ctx.closePath(); ctx.fill(); ctx.stroke();
        ctx.fillStyle = '#eab308';
        ctx.beginPath(); ctx.arc(0, -40, 10, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
        ctx.fillStyle = '#f8fafc';
        ctx.beginPath(); ctx.moveTo(-7, -36); ctx.lineTo(0, -6); ctx.lineTo(7, -36); ctx.closePath(); ctx.fill(); ctx.stroke();
      } else if (en.kind === 'undead_warrior') {
        ctx.fillStyle = '#2563eb';
        ctx.beginPath(); ctx.moveTo(-12, -30); ctx.lineTo(12, -30); ctx.lineTo(16, 2); ctx.lineTo(-16, 2); ctx.closePath(); ctx.fill(); ctx.stroke();
        ctx.fillStyle = '#e5e5e5';
        ctx.beginPath(); ctx.roundRect(-9, -28, 18, 24, 2); ctx.fill(); ctx.stroke();
        ctx.beginPath(); ctx.arc(0, -35, 8.5, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
        ctx.fillStyle = '#b45309';
        ctx.beginPath(); ctx.ellipse(-12, -16, 7, 11, 0, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
      } else {
        ctx.fillStyle = en.color;
        ctx.beginPath(); ctx.roundRect(-12, -28, 24, 26, 4); ctx.fill(); ctx.stroke();
        ctx.fillStyle = '#fde68a';
        ctx.beginPath(); ctx.arc(0, -35, 9, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
        if (en.kind === 'cobold_king') {
          ctx.fillStyle = '#facc15';
          ctx.beginPath(); ctx.ellipse(-12, -15, 8, 12, 0, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
        }
      }
      ctx.restore();

      const hpRatio = Math.max(0, en.hp / en.maxHp);
      const barW = en.isBoss ? 68 : 38;
      const topOffset = en.isBoss ? -88 : -en.radius - 28;
      ctx.fillStyle = '#040306';
      ctx.fillRect(-barW / 2, topOffset, barW, 7);
      ctx.fillStyle = en.isBoss ? '#f97316' : '#ef4444';
      ctx.fillRect(-barW / 2 + 1, topOffset + 1, (barW - 2) * hpRatio, 5);

      ctx.font = en.isBoss ? '900 12px Cinzel, serif' : '700 10px Cinzel, serif';
      ctx.textAlign = 'center';
      ctx.fillStyle = en.isBoss ? '#fde047' : '#fca5a5';
      ctx.fillText(en.name, 0, topOffset - 4);
      ctx.restore();
    }

    const prevCanvas = document.getElementById('previewCanvas');
    const prevCtx = prevCanvas.getContext('2d');
    let previewSwing = 0;
    prevCanvas.addEventListener('mousedown', () => { previewSwing = 20; });

    function updatePreview(now) {
