    function computeFinalStats() {

      const rBase = RACES[ccState.race].baseStats;

      const cBonus = CLASSES[ccState.charClass].statBonuses;

      const totals = {

        str: rBase.str + cBonus.str + ccState.allocated.str,

        dex: rBase.dex + cBonus.dex + ccState.allocated.dex,

        con: rBase.con + cBonus.con + ccState.allocated.con,

        int: rBase.int + cBonus.int + ccState.allocated.int,

        spi: rBase.spi + cBonus.spi + ccState.allocated.spi

      };

      ccState.selectedRunes.forEach(rId => {

        const rune = RUNES.find(r => r.id === rId);

        if (rune) {

          totals.str += rune.mods.str;

          totals.dex += rune.mods.dex;

          totals.con += rune.mods.con;

          totals.int += rune.mods.int;

          totals.spi += rune.mods.spi;

        }

      });

      return totals;

    }



