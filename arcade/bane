      { id: 'west',   name: 'West Shadow Warren',       x: 700,  y: 1800, w: 800,  h: 900,  safe: false }
    ];

    const ARMOR_PALETTE = ['#8b0000', '#1b263b', '#1e3320', '#4a2e18', '#321c42', '#212129'];
    const HAIR_PALETTE  = ['#e2d9c8', '#111014', '#a82424', '#d4af37', '#422e1c', '#3d6860'];

    const RACE_TREE = {
