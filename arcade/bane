      const subMeta = getSubraceMeta(localPlayer);
      const classMeta = CLASS_PROGRESSION[localPlayer.coreClass] || CLASS_PROGRESSION['Fighter'];
      const lvlBonusHp = (localPlayer.level - 1) * 32;
      const lvlBonusMp = (localPlayer.level - 1) * 16;

      const activeWep = getActiveWeapon();
      let eqAtk = (localPlayer.level - 1) * 6 + (activeWep.atk || 10);
      let eqHp = (activeWep.hp || 0);
      let eqMp = (activeWep.mp || 0);

      ['armor', 'relic'].forEach(k => {
        const it = localPlayer.equipped[k];
        if (it) {
          eqAtk += it.atk || 0;
          eqHp  += it.hp  || 0;
          eqMp  += it.mp  || 0;
