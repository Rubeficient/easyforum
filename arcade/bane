          const k = btn.dataset.stat;

          const delta = parseInt(btn.dataset.dir, 10);

          if (delta > 0 && ccState.pointsRemaining >= delta) {

            ccState.allocated[k] += delta;

            ccState.pointsRemaining -= delta;

          } else if (delta < 0 && ccState.allocated[k] >= Math.abs(delta)) {

            ccState.allocated[k] += delta;

            ccState.pointsRemaining -= delta;

