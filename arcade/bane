    // =========================================================================
    // 12. WEAPON STANCE AUTO-ATTACKS vs. 1-9 SPECIALS + DAMAGE TYPE RESISTANCE!
    // =========================================================================
    const slotCooldowns = new Array(9).fill(0);
    const slotMaxCooldowns = new Array(9).fill(1);
    let mouseScreenX = window.innerWidth / 2;
    let mouseScreenY = window.innerHeight / 2;

    // Calculate Damage Multiplier based on Attack Damage Type vs. Enemy Weakness!
    function evaluateDamageVsEnemy(rawDmg, atkType, enemy) {
      const weak = enemy.weakness || 'SLASH';
      if (atkType === weak) {
        // Crushing Weakness Hit (175% Damage!)
        return {
          finalDmg: Math.round(rawDmg * 1.75),
          status: 'WEAKNESS',
          color: '#84cc16',
          label: `💥 -${Math.round(rawDmg * 1.75)} ${atkType} WEAKNESS!`
        };
      }
      // ARCANE spells do 60% against physical-weak enemies so magic is never completely useless,
      // but wrong physical weapon stances do only 15% glancing damage!
      if (atkType === 'ARCANE') {
        const d = Math.max(4, Math.round(rawDmg * 0.55));
        return {
          finalDmg: d,
          status: 'PARTIAL',
          color: '#c084fc',
          label: `-${d} (Weak: ${weak})`
        };
      }
      const glanced = Math.max(2, Math.round(rawDmg * 0.16));
      return {
        finalDmg: glanced,
        status: 'RESISTED',
        color: '#94a3b8',
        label: `🛡️ -${glanced} RESISTED! [Need ${weak}]`
      };
    }

    // Right-Side Weapon Stance Auto-Attack Execution
    function executeWeaponStanceAttack(targetEnemy) {
      const wep = getActiveWeapon();
      const baseDmg = 22 + localPlayer.dmgBonus;
      const angle = targetEnemy
        ? Math.atan2(targetEnemy.y - localPlayer.y, targetEnemy.x - localPlayer.x)
        : getAimAngle();

      localPlayer.facing = Math.cos(angle) >= 0 ? 1 : -1;
      localPlayer.aimAngle = angle;
      localPlayer.swingTimer = 16;

      if (wep.range === 'ranged' || wep.dmgType === 'PIERCE') {
        playSfx('bow');
        spawnProjectile({
          ownerId: localPlayer.id,
          isEnemy: false,
          x: localPlayer.x + Math.cos(angle) * 18,
          y: localPlayer.y - 18 + Math.sin(angle) * 18,
          angle,
          speed: 650,
          dmg: baseDmg,
          dmgType: wep.dmgType || 'PIERCE',
          color: '#4ade80',
          projType: 'arrow',
          radius: 7
        });
      } else {
        // Melee Cleave (Prime SLASH or Side BLUNT)
        const arcColor = wep.dmgType === 'BLUNT' ? '#facc15' : '#f87171';
        spawnSlashArc(localPlayer.x + localPlayer.facing * 28, localPlayer.y, localPlayer.facing, arcColor, 54);

        let hitAny = false;
        for (let i = enemies.length - 1; i >= 0; i--) {
          const en = enemies[i];
          if (Math.hypot(en.x - localPlayer.x, en.y - localPlayer.y) <= en.radius + 95) {
            hitAny = true;
            const res = evaluateDamageVsEnemy(baseDmg, wep.dmgType || 'SLASH', en);
            en.hp -= res.finalDmg;
            en.hitFlash = 6;
            playSfx(res.status === 'RESISTED' ? 'clank' : (res.status === 'WEAKNESS' ? 'crushing' : 'slash'));
            spawnCombatText(en.x, en.y, res.label, res.color);

            if (en.hp <= 0) {
              if (res.status === 'WEAKNESS') spawnOvaDecapitation(en.x, en.y, localPlayer.facing);
              handleEnemyKilled(en, i);
            }
          }
        }
        if (!hitAny) playSfx('slash');
      }
    }

