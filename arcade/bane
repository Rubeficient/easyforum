<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Bane of Shadows: The Tree of Life</title>
  <script src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js"></script>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      -webkit-user-select: none;
    }
    body, html {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: #0d0f12;
      font-family: 'Cinzel', 'Georgia', serif;
      color: #e5d8b8;
    }
    canvas {
      display: block;
      width: 100vw;
      height: 100vh;
      background: #111a14;
    }

    /* Modal / Character Screen */
    #char-modal {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at center, rgba(18, 22, 20, 0.96) 0%, rgba(6, 8, 7, 0.99) 100%);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 100;
      padding: 16px;
    }
    .char-card {
      background: rgba(14, 18, 16, 0.95);
      border: 2px solid #5a4625;
      box-shadow: 0 0 35px rgba(0, 0, 0, 0.9), 0 0 15px rgba(184, 134, 11, 0.2);
      width: 100%;
      max-width: 520px;
      padding: 24px;
      border-radius: 6px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .char-card h1 {
      font-size: 22px;
      letter-spacing: 3px;
      text-transform: uppercase;
      text-align: center;
      color: #dfb76c;
      border-bottom: 1px solid #3d2f19;
      padding-bottom: 8px;
    }
    .char-card h2 {
      font-size: 13px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: #8c826e;
      text-align: center;
    }
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    label {
      font-size: 12px;
      text-transform: uppercase;
      color: #c0ab80;
      letter-spacing: 1px;
    }
    input[type="text"], select {
      background: #090c0a;
      border: 1px solid #4a3c20;
      color: #f1e4c3;
      padding: 8px 12px;
      border-radius: 4px;
      font-family: inherit;
      font-size: 14px;
      outline: none;
    }
    input[type="text"]:focus, select:focus {
      border-color: #cfa851;
      box-shadow: 0 0 8px rgba(207, 168, 81, 0.3);
    }
    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .btn-spawn {
      background: linear-gradient(180deg, #382c16 0%, #1c1407 100%);
      border: 1px solid #cfa851;
      color: #f8e5b9;
      padding: 12px;
      border-radius: 4px;
      font-family: inherit;
      font-size: 14px;
      font-weight: bold;
      letter-spacing: 2px;
      text-transform: uppercase;
      cursor: pointer;
      margin-top: 8px;
      transition: all 0.2s;
    }
    .btn-spawn:hover {
      background: linear-gradient(180deg, #4f3f1e 0%, #291d0a 100%);
      box-shadow: 0 0 14px rgba(207, 168, 81, 0.4);
    }

    /* HUD Overlay */
    #hud {
      position: absolute;
      inset: 0;
      pointer-events: none;
      display: none;
    }
    .interactive {
      pointer-events: auto;
    }

    /* Top Shard Bar */
    .top-bar {
      position: absolute;
      top: 12px;
      left: 12px;
      right: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
    }
    .panel {
      background: rgba(10, 14, 12, 0.85);
      border: 1px solid #42331c;
      border-radius: 4px;
      padding: 6px 12px;
      font-size: 12px;
      display: flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.7);
    }
    .invite-btn {
      background: #241c0d;
      border: 1px solid #b3883b;
      color: #dfb76c;
      padding: 4px 10px;
      border-radius: 3px;
      font-family: inherit;
      font-size: 11px;
      letter-spacing: 1px;
      cursor: pointer;
      text-transform: uppercase;
    }
    .invite-btn:hover {
      background: #382b13;
    }

    /* Action Hotbar */
    .hotbar {
      position: absolute;
      bottom: 16px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 8px;
    }
    .hotkey-slot {
      width: 48px;
      height: 48px;
      background: rgba(12, 16, 14, 0.9);
      border: 1px solid #5a4521;
      border-radius: 4px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      position: relative;
      transition: transform 0.1s, border-color 0.1s;
    }
    .hotkey-slot:active {
      transform: scale(0.94);
      border-color: #dfb76c;
    }
    .hotkey-num {
      position: absolute;
      top: 2px;
      left: 4px;
      font-size: 10px;
      color: #796c52;
    }
    .hotkey-icon {
      font-size: 18px;
    }

    /* Chat Frame */
    .chat-container {
      position: absolute;
      bottom: 76px;
      left: 16px;
      width: 320px;
      max-width: calc(100vw - 32px);
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .chat-log {
      height: 120px;
      background: rgba(8, 12, 10, 0.75);
      border: 1px solid #2e2414;
      border-radius: 4px;
      padding: 8px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 4px;
      font-size: 12px;
      font-family: sans-serif;
    }
    .chat-msg {
      word-break: break-word;
      line-height: 1.3;
    }
    .chat-msg .author {
      color: #dfb76c;
      font-weight: bold;
      font-family: 'Cinzel', serif;
      margin-right: 4px;
    }
    .chat-input-row {
      display: flex;
      gap: 4px;
    }
    .chat-input {
      flex: 1;
      background: rgba(8, 12, 10, 0.85);
      border: 1px solid #4a3b22;
      border-radius: 3px;
      padding: 6px 10px;
      color: #e5d8b8;
      font-size: 12px;
      outline: none;
      font-family: sans-serif;
    }

    /* Toast Notification */
    #toast {
      position: absolute;
      top: 55px;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(14, 18, 16, 0.95);
      border: 1px solid #dfb76c;
      color: #dfb76c;
      padding: 6px 16px;
      border-radius: 20px;
      font-size: 12px;
      letter-spacing: 1px;
      display: none;
      box-shadow: 0 0 10px rgba(0,0,0,0.8);
      z-index: 200;
    }
  </style>
</head>
<body>

  <!-- Character Creation Screen -->
  <div id="char-modal">
    <div class="char-card">
      <h1>The Tree of Life</h1>
      <h2>Shadowbane Realm Genesis</h2>

      <div class="form-group">
        <label for="char-name">Character Name</label>
        <input type="text" id="char-name" maxlength="16" placeholder="Enter name..." value="Aethon">
      </div>

      <div class="grid-2">
        <div class="form-group">
          <label for="char-race">Race</label>
          <select id="char-race">
            <option value="Human">Human</option>
            <option value="Aelfborn">Aelfborn</option>
            <option value="Dwarf">Dwarf</option>
            <option value="Irekei">Irekei</option>
            <option value="Minotaur">Minotaur</option>
            <option value="Centaur">Centaur</option>
            <option value="Nephilim">Nephilim</option>
          </select>
        </div>

        <div class="form-group">
          <label for="char-class">Class</label>
          <select id="char-class">
            <option value="Fighter">Fighter</option>
            <option value="Healer">Healer</option>
            <option value="Mage">Mage</option>
            <option value="Rogue">Rogue</option>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label for="char-sigil">Starting Creation Rune</label>
        <select id="char-sigil">
          <option value="Ancient Blood">Ancient Blood (+Constitution)</option>
          <option value="Windwalker">Windwalker (+Dexterity)</option>
          <option value="Warlock's Brand">Warlock's Brand (+Intelligence)</option>
          <option value="Titan's Grip">Titan's Grip (+Strength)</option>
        </select>
      </div>

      <button id="btn-awaken" class="btn-spawn">Awaken At The Tree</button>
    </div>
  </div>

  <!-- Main Game Canvas -->
  <canvas id="gameCanvas"></canvas>

  <!-- HUD Layer -->
  <div id="hud">
    <div class="top-bar">
      <div class="panel">
        <span style="color:#6ea87a;">●</span>
        <span id="shard-status">Shard: Local</span>
        <span id="player-count">(1 Online)</span>
      </div>
      <div class="panel interactive">
        <button id="btn-copy-invite" class="invite-btn">🔗 Copy Invite Link</button>
      </div>
    </div>

    <!-- Chat -->
    <div class="chat-container interactive">
      <div class="chat-log" id="chat-log">
        <div class="chat-msg" style="color: #928362;"><i>System: Approach the Tree of Life. Move with WASD, Arrow keys, or Left Click.</i></div>
      </div>
      <div class="chat-input-row">
        <input type="text" id="chat-input" class="chat-input" placeholder="Press Enter to chat..." maxlength="100">
      </div>
    </div>

    <!-- Hotbar -->
    <div class="hotbar interactive">
      <div class="hotkey-slot" onclick="triggerAbility(1)" title="Strike">
        <span class="hotkey-num">1</span>
        <span class="hotkey-icon">⚔️</span>
      </div>
      <div class="hotkey-slot" onclick="triggerAbility(2)" title="Class Power">
        <span class="hotkey-num">2</span>
        <span class="hotkey-icon">✨</span>
      </div>
      <div class="hotkey-slot" onclick="triggerAbility(3)" title="Sprint">
        <span class="hotkey-num">3</span>
        <span class="hotkey-icon">💨</span>
      </div>
      <div class="hotkey-slot" onclick="triggerAbility(4)" title="Commune">
        <span class="hotkey-num">4</span>
        <span class="hotkey-icon">🌿</span>
      </div>
    </div>
  </div>

  <div id="toast">Invite link copied to clipboard!</div>

  <script>
    // --- WORLD CONFIGURATION ---
    const WORLD_SIZE = 3200;
    const TREE_POS = { x: 1600, y: 1600 };
    const TREE_RADIUS = 70;

    // --- COLOR MAPPINGS ---
    const RACE_PALETTES = {
      'Human': { body: '#cfa980', detail: '#4a3319', scale: 1.0 },
      'Aelfborn': { body: '#a2c4b8', detail: '#1a3d36', scale: 0.95 },
      'Dwarf': { body: '#d49b6a', detail: '#57220e', scale: 0.8 },
      'Irekei': { body: '#b0593b', detail: '#1f130e', scale: 1.0 },
      'Minotaur': { body: '#4a3321', detail: '#c49a45', scale: 1.35 },
      'Centaur': { body: '#734b28', detail: '#2b190a', scale: 1.25 },
      'Nephilim': { body: '#2a2033', detail: '#7b32a8', scale: 1.15 }
    };

    const CLASS_COLORS = {
      'Fighter': '#b83b3b',
      'Healer': '#3bb87d',
      'Mage': '#3b7db8',
      'Rogue': '#8b3bb8'
    };

    // --- GAME STATE ---
    let localPlayer = {
      id: 'p-' + Math.random().toString(36).substring(2, 9),
      name: 'Aethon',
      race: 'Human',
      className: 'Fighter',
      rune: 'Ancient Blood',
      x: TREE_POS.x + (Math.random() * 80 - 40),
      y: TREE_POS.y + 120 + (Math.random() * 40),
      targetX: null,
      targetY: null,
      speed: 210,
      radius: 16,
      actionEffect: null,
      actionTimer: 0,
      chatBubble: null,
      chatTimer: 0
    };

    const remotePlayers = new Map();
    const floatingSpells = [];

    // --- TALL GRASS GENERATION ---
    const grassTufts = [];
    for (let i = 0; i < 900; i++) {
      const gx = Math.random() * WORLD_SIZE;
      const gy = Math.random() * WORLD_SIZE;
      const distToTree = Math.hypot(gx - TREE_POS.x, gy - TREE_POS.y);
      if (distToTree > 90) {
        grassTufts.push({
          x: gx,
          y: gy,
          height: 10 + Math.random() * 14,
          tilt: (Math.random() - 0.5) * 8
        });
      }
    }

    // --- CANVAS & RESIZING ---
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    let screenW = 0, screenH = 0;

    function resizeCanvas() {
      screenW = window.innerWidth;
      screenH = window.innerHeight;
      canvas.width = screenW;
      canvas.height = screenH;
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    // --- INPUT CONTROLS ---
    const keys = {};
    window.addEventListener('keydown', (e) => {
      keys[e.key.toLowerCase()] = true;
      if (['1','2','3','4'].includes(e.key)) {
        triggerAbility(parseInt(e.key));
      }
      if (e.key === 'Enter') {
        const chatInput = document.getElementById('chat-input');
        if (document.activeElement === chatInput) {
          sendChat();
        } else {
          chatInput.focus();
        }
      }
    });

    window.addEventListener('keyup', (e) => {
      keys[e.key.toLowerCase()] = false;
    });

    canvas.addEventListener('mousedown', (e) => {
      if (e.button === 0) { // Left click to move
        const camX = localPlayer.x - screenW / 2;
        const camY = localPlayer.y - screenH / 2;
        localPlayer.targetX = e.clientX + camX;
        localPlayer.targetY = e.clientY + camY;
      }
    });

    // --- NETWORKING LAYER (PEERJS WEBRTC P2P) ---
    const urlParams = new URLSearchParams(window.location.search);
    const joinShardId = urlParams.get('shard');
    const isHost = !joinShardId;

    let peer = null;
    const connections = [];

    function initNetworking() {
      // Deterministic Shard Master ID pattern for stable room rendezvous
      const myPeerId = isHost 
        ? 'bane-shard-' + Math.random().toString(36).substring(2, 8) 
        : undefined;

      peer = new Peer(myPeerId);

      peer.on('open', (id) => {
        const shardStatus = document.getElementById('shard-status');
        if (isHost) {
          shardStatus.textContent = 'Host: ' + id.replace('bane-shard-', '');
          const newUrl = `${window.location.origin}${window.location.pathname}?shard=${id}`;
          window.history.replaceState(null, '', newUrl);
        } else {
          shardStatus.textContent = 'Joined: ' + joinShardId.replace('bane-shard-', '');
          const conn = peer.connect(joinShardId, { reliable: true });
          setupConnection(conn);
        }
      });

      peer.on('connection', (conn) => {
        setupConnection(conn);
      });

      peer.on('error', (err) => {
        console.warn('P2P Notice:', err.type);
        appendChat('System', 'P2P Notice: ' + err.type);
      });
    }

    function setupConnection(conn) {
      conn.on('open', () => {
        connections.push(conn);
        updateRosterCount();
        // Immediately announce self to newly connected peer
        broadcastState(true);
      });

      conn.on('data', (data) => {
        handleIncomingPacket(data, conn);
      });

      conn.on('close', () => {
        const idx = connections.indexOf(conn);
        if (idx !== -1) connections.splice(idx, 1);
        if (conn.remotePlayerId) {
          remotePlayers.delete(conn.remotePlayerId);
        }
        updateRosterCount();
      });
    }

    function handleIncomingPacket(data, sourceConn) {
      if (!data || !data.type) return;

      if (data.type === 'state') {
        sourceConn.remotePlayerId = data.player.id;
        let p = remotePlayers.get(data.player.id);
        if (!p) {
          p = { ...data.player };
          remotePlayers.set(data.player.id, p);
          appendChat('Realm', `${p.name} the ${p.race} has appeared.`);
        } else {
          p.x = data.player.x;
          p.y = data.player.y;
          p.name = data.player.name;
          p.race = data.player.race;
          p.className = data.player.className;
          p.rune = data.player.rune;
          p.actionEffect = data.player.actionEffect;
          p.actionTimer = data.player.actionTimer;
          p.chatBubble = data.player.chatBubble;
          p.chatTimer = data.player.chatTimer;
        }
        updateRosterCount();

        // Host re-broadcasts to all other connected peers (star topology)
        if (isHost) {
          connections.forEach(c => {
            if (c !== sourceConn && c.open) {
              c.send(data);
            }
          });
        }
      } else if (data.type === 'chat') {
        appendChat(data.sender, data.text);
        if (isHost) {
          connections.forEach(c => {
            if (c !== sourceConn && c.open) {
              c.send(data);
            }
          });
        }
      }
    }

    function broadcastState(immediate = false) {
      if (connections.length === 0) return;
      const packet = {
        type: 'state',
        player: {
          id: localPlayer.id,
          name: localPlayer.name,
          race: localPlayer.race,
          className: localPlayer.className,
          rune: localPlayer.rune,
          x: Math.round(localPlayer.x),
          y: Math.round(localPlayer.y),
          actionEffect: localPlayer.actionEffect,
          actionTimer: localPlayer.actionTimer,
          chatBubble: localPlayer.chatBubble,
          chatTimer: localPlayer.chatTimer
        }
      };

      connections.forEach(c => {
        if (c.open) c.send(packet);
      });
    }

    function broadcastChat(text) {
      const packet = {
        type: 'chat',
        sender: localPlayer.name,
        text: text
      };
      connections.forEach(c => {
        if (c.open) c.send(packet);
      });
    }

    function updateRosterCount() {
      const el = document.getElementById('player-count');
      if (el) {
        el.textContent = `(${remotePlayers.size + 1} Online)`;
      }
    }

    // --- GAME ACTIONS & ABILITIES ---
    function triggerAbility(slot) {
      let effectName = '';
      if (slot === 1) effectName = 'strike';
      else if (slot === 2) effectName = 'signature';
      else if (slot === 3) effectName = 'sprint';
      else if (slot === 4) effectName = 'commune';

      localPlayer.actionEffect = effectName;
      localPlayer.actionTimer = 35;

      if (slot === 3) {
        localPlayer.speed = 340;
        setTimeout(() => { localPlayer.speed = 210; }, 2500);
      }

      floatingSpells.push({
        x: localPlayer.x,
        y: localPlayer.y,
        type: effectName,
        life: 40,
        maxLife: 40
      });

      broadcastState(true);
    }

    function sendChat() {
      const input = document.getElementById('chat-input');
      const val = input.value.trim();
      if (!val) return;

      appendChat(localPlayer.name, val);
      localPlayer.chatBubble = val;
      localPlayer.chatTimer = 220;

      broadcastChat(val);
      broadcastState(true);

      input.value = '';
      input.blur();
    }

    function appendChat(author, text) {
      const log = document.getElementById('chat-log');
      const div = document.createElement('div');
      div.className = 'chat-msg';
      div.innerHTML = `<span class="author">${escapeHtml(author)}:</span><span>${escapeHtml(text)}</span>`;
      log.appendChild(div);
      log.scrollTop = log.scrollHeight;
    }

    function escapeHtml(str) {
      return str.replace(/[&<>"']/g, m => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
      }[m]));
    }

    // --- COPY INVITE BUTTON ---
    document.getElementById('btn-copy-invite').addEventListener('click', () => {
      const url = window.location.href;
      navigator.clipboard.writeText(url).then(() => {
        const toast = document.getElementById('toast');
        toast.style.display = 'block';
        setTimeout(() => { toast.style.display = 'none'; }, 2400);
      });
    });

    // --- AWAKEN / SPAWN LOGIC ---
    document.getElementById('btn-awaken').addEventListener('click', () => {
      const nameInput = document.getElementById('char-name').value.trim();
      if (nameInput) localPlayer.name = nameInput;
      localPlayer.race = document.getElementById('char-race').value;
      localPlayer.className = document.getElementById('char-class').value;
      localPlayer.rune = document.getElementById('char-sigil').value;

      document.getElementById('char-modal').style.display = 'none';
      document.getElementById('hud').style.display = 'block';

      initNetworking();
      appendChat('Tree of Life', `Welcome, ${localPlayer.name}. Walk the tall grass and commune with your brethren.`);
    });

    // --- MAIN TICK & PHYSICS ---
    let lastTime = performance.now();
    let netTickTimer = 0;

    function gameLoop(now) {
      const dt = Math.min((now - lastTime) / 1000, 0.1);
      lastTime = now;

      // Local player movement
      let moveX = 0;
      let moveY = 0;

      if (keys['w'] || keys['arrowup']) moveY -= 1;
      if (keys['s'] || keys['arrowdown']) moveY += 1;
      if (keys['a'] || keys['arrowleft']) moveX -= 1;
      if (keys['d'] || keys['arrowright']) moveX += 1;

      if (moveX !== 0 || moveY !== 0) {
        // Keyboard overrides click-to-move
        localPlayer.targetX = null;
        localPlayer.targetY = null;
        const len = Math.hypot(moveX, moveY);
        localPlayer.x += (moveX / len) * localPlayer.speed * dt;
        localPlayer.y += (moveY / len) * localPlayer.speed * dt;
      } else if (localPlayer.targetX !== null && localPlayer.targetY !== null) {
        const dx = localPlayer.targetX - localPlayer.x;
        const dy = localPlayer.targetY - localPlayer.y;
        const dist = Math.hypot(dx, dy);
        if (dist > 5) {
          localPlayer.x += (dx / dist) * localPlayer.speed * dt;
          localPlayer.y += (dy / dist) * localPlayer.speed * dt;
        } else {
          localPlayer.targetX = null;
          localPlayer.targetY = null;
        }
      }

      // World bounds constraint
      localPlayer.x = Math.max(40, Math.min(WORLD_SIZE - 40, localPlayer.x));
      localPlayer.y = Math.max(40, Math.min(WORLD_SIZE - 40, localPlayer.y));

      // Tree Trunk Solid Collision
      const trunkDist = Math.hypot(localPlayer.x - TREE_POS.x, localPlayer.y - TREE_POS.y);
      if (trunkDist < TREE_RADIUS) {
        const pushAngle = Math.atan2(localPlayer.y - TREE_POS.y, localPlayer.x - TREE_POS.x);
        localPlayer.x = TREE_POS.x + Math.cos(pushAngle) * TREE_RADIUS;
        localPlayer.y = TREE_POS.y + Math.sin(pushAngle) * TREE_RADIUS;
      }

      // Timers decay
      if (localPlayer.actionTimer > 0) localPlayer.actionTimer--;
      if (localPlayer.chatTimer > 0) {
        localPlayer.chatTimer--;
        if (localPlayer.chatTimer <= 0) localPlayer.chatBubble = null;
      }

      // Remote player timers decay
      remotePlayers.forEach(p => {
        if (p.chatTimer > 0) {
          p.chatTimer--;
          if (p.chatTimer <= 0) p.chatBubble = null;
        }
        if (p.actionTimer > 0) p.actionTimer--;
      });

      // Network sync pulse (15 Hz)
      netTickTimer += dt;
      if (netTickTimer > 0.066) {
        broadcastState();
        netTickTimer = 0;
      }

      render();
      requestAnimationFrame(gameLoop);
    }

    // --- RENDERING PIPELINE ---
    function render() {
      ctx.clearRect(0, 0, screenW, screenH);

      const camX = localPlayer.x - screenW / 2;
      const camY = localPlayer.y - screenH / 2;

      ctx.save();
      ctx.translate(-camX, -camY);

      // 1. Draw World Ground & Grid
      ctx.fillStyle = '#141d17';
      ctx.fillRect(0, 0, WORLD_SIZE, WORLD_SIZE);

      // Meadow Border
      ctx.strokeStyle = '#27382c';
      ctx.lineWidth = 6;
      ctx.strokeRect(0, 0, WORLD_SIZE, WORLD_SIZE);

      // 2. Draw Tall Grass
      const nowMs = performance.now() * 0.002;
      ctx.lineWidth = 2;
      for (let i = 0; i < grassTufts.length; i++) {
        const g = grassTufts[i];
        if (g.x < camX - 50 || g.x > camX + screenW + 50 || g.y < camY - 50 || g.y > camY + screenH + 50) {
          continue; // Frustum cull
        }
        const sway = Math.sin(nowMs + g.x * 0.05) * 4;
        ctx.strokeStyle = '#213626';
        ctx.beginPath();
        ctx.moveTo(g.x, g.y);
        ctx.quadraticCurveTo(g.x + g.tilt + sway, g.y - g.height * 0.5, g.x + g.tilt * 1.5 + sway, g.y - g.height);
        ctx.stroke();
      }

      // 3. Draw The Tree of Life (Roots & Aura)
      const distToTree = Math.hypot(localPlayer.x - TREE_POS.x, localPlayer.y - TREE_POS.y);
      const isUnderCanopy = distToTree < 260;

      // Glow aura
      const auraGrad = ctx.createRadialGradient(TREE_POS.x, TREE_POS.y, 40, TREE_POS.x, TREE_POS.y, 300);
      auraGrad.addColorStop(0, 'rgba(92, 179, 114, 0.25)');
      auraGrad.addColorStop(1, 'rgba(20, 29, 23, 0)');
      ctx.fillStyle = auraGrad;
      ctx.beginPath();
      ctx.arc(TREE_POS.x, TREE_POS.y, 300, 0, Math.PI * 2);
      ctx.fill();

      // Giant Roots
      ctx.strokeStyle = '#291e14';
      ctx.lineWidth = 14;
      for (let r = 0; r < 6; r++) {
        const angle = (r * Math.PI) / 3;
        ctx.beginPath();
        ctx.moveTo(TREE_POS.x, TREE_POS.y);
        ctx.lineTo(TREE_POS.x + Math.cos(angle) * 160, TREE_POS.y + Math.sin(angle) * 160);
        ctx.stroke();
      }

      // Trunk
      ctx.fillStyle = '#1c150f';
      ctx.beginPath();
      ctx.arc(TREE_POS.x, TREE_POS.y, TREE_RADIUS, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = '#3d2e1f';
      ctx.lineWidth = 5;
      ctx.stroke();

      // Tree Core Runes
      ctx.fillStyle = '#5cb372';
      ctx.font = 'bold 12px Cinzel, serif';
      ctx.textAlign = 'center';
      ctx.fillText('THE TREE OF LIFE', TREE_POS.x, TREE_POS.y + 4);

      // 4. Draw Remote Players
      remotePlayers.forEach(p => {
        drawAvatar(p);
      });

      // 5. Draw Local Player
      drawAvatar(localPlayer);

      // 6. Draw Spells / Action Rings
      for (let i = floatingSpells.length - 1; i >= 0; i--) {
        const sp = floatingSpells[i];
        sp.life--;
        const ratio = sp.life / sp.maxLife;

        ctx.strokeStyle = sp.type === 'commune' ? '#5cb372' : (sp.type === 'signature' ? '#dfb76c' : '#c94d4d');
        ctx.lineWidth = 3 * ratio;
        ctx.beginPath();
        ctx.arc(sp.x, sp.y, (1 - ratio) * 80 + 10, 0, Math.PI * 2);
        ctx.stroke();

        if (sp.life <= 0) floatingSpells.splice(i, 1);
      }

      // 7. Canopy Layer (Semi-transparent when player is underneath)
      ctx.fillStyle = isUnderCanopy ? 'rgba(18, 48, 28, 0.45)' : 'rgba(18, 48, 28, 0.88)';
      ctx.beginPath();
      ctx.arc(TREE_POS.x, TREE_POS.y, 240, 0, Math.PI * 2);
      ctx.fill();

      ctx.restore();
    }

    function drawAvatar(p) {
      const pal = RACE_PALETTES[p.race] || RACE_PALETTES['Human'];
      const classBorder = CLASS_COLORS[p.className] || '#cfa851';
      const rad = 14 * pal.scale;

      // Shadow
      ctx.fillStyle = 'rgba(0, 0, 0, 0.4)';
      ctx.beginPath();
      ctx.ellipse(p.x, p.y + rad * 0.7, rad * 1.1, rad * 0.5, 0, 0, Math.PI * 2);
      ctx.fill();

      // Unique Race Silhouettes
      if (p.race === 'Centaur') {
        // Quadruped flank
        ctx.fillStyle = pal.detail;
        ctx.beginPath();
        ctx.ellipse(p.x, p.y + rad * 0.4, rad * 1.5, rad * 0.7, 0, 0, Math.PI * 2);
        ctx.fill();
      } else if (p.race === 'Nephilim') {
        // Wings
        ctx.fillStyle = pal.detail;
        ctx.beginPath();
        ctx.moveTo(p.x - rad * 1.8, p.y - rad * 0.5);
        ctx.lineTo(p.x, p.y);
        ctx.lineTo(p.x + rad * 1.8, p.y - rad * 0.5);
        ctx.fill();
      }

      // Torso / Body Core
      ctx.fillStyle = pal.body;
      ctx.beginPath();
      ctx.arc(p.x, p.y, rad, 0, Math.PI * 2);
      ctx.fill();

      // Class Crest Ring
      ctx.strokeStyle = classBorder;
      ctx.lineWidth = 3;
      ctx.stroke();

      // Horns for Minotaur
      if (p.race === 'Minotaur') {
        ctx.strokeStyle = pal.detail;
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(p.x - rad, p.y - 2);
        ctx.lineTo(p.x - rad - 6, p.y - rad);
        ctx.moveTo(p.x + rad, p.y - 2);
        ctx.lineTo(p.x + rad + 6, p.y - rad);
        ctx.stroke();
      }

      // Overhead Name & Rune Tag
      ctx.textAlign = 'center';
      ctx.font = '11px sans-serif';
      ctx.fillStyle = '#ffffff';
      ctx.shadowColor = 'black';
      ctx.shadowBlur = 4;
      ctx.fillText(p.name, p.x, p.y - rad - 12);

      ctx.font = '9px Cinzel, serif';
      ctx.fillStyle = '#cfb583';
      ctx.fillText(`<${p.race} ${p.className}>`, p.x, p.y - rad - 2);
      ctx.shadowBlur = 0;

      // Floating Chat Bubble
      if (p.chatBubble) {
        ctx.font = '12px sans-serif';
        const txtWidth = ctx.measureText(p.chatBubble).width;
        const boxW = Math.max(txtWidth + 16, 50);
        const boxH = 24;
        const boxX = p.x - boxW / 2;
        const boxY = p.y - rad - 46;

        ctx.fillStyle = 'rgba(8, 12, 10, 0.9)';
        ctx.strokeStyle = '#cfa851';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.roundRect(boxX, boxY, boxW, boxH, 4);
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = '#e8d9ba';
        ctx.fillText(p.chatBubble, p.x, boxY + 16);
      }
    }

    // Start loop immediately
    requestAnimationFrame(gameLoop);
  </script>
</body>
</html>
