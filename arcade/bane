    const mapCanvas = document.getElementById('minimapCanvas');
    const mapCtx = mapCanvas.getContext('2d');

    function renderCartographyMap() {
      mapCtx.clearRect(0, 0, mapCanvas.width, mapCanvas.height);
      const myGx = Math.floor(localPlayer.x / TILE_SIZE);
      const myGy = Math.floor(localPlayer.y / TILE_SIZE);

      const cellPx = 22;
      const centerX = mapCanvas.width / 2;
      const centerY = mapCanvas.height / 2;

      worldSectors.forEach(sec => {
        const dx = sec.gx - myGx;
        const dy = sec.gy - myGy;
        const rx = centerX + dx * cellPx - cellPx / 2;
        const ry = centerY + dy * cellPx - cellPx / 2;

        if (rx < -cellPx || rx > mapCanvas.width || ry < -cellPx || ry > mapCanvas.height) return;

        mapCtx.fillStyle = sec.safe ? '#166534' : (sec.isBossRoom ? '#7f1d1d' : '#1e293b');
        mapCtx.strokeStyle = sec.gx === myGx && sec.gy === myGy ? '#fde047' : '#cfa354';
        mapCtx.lineWidth = sec.gx === myGx && sec.gy === myGy ? 2 : 1;
        mapCtx.fillRect(rx + 1, ry + 1, cellPx - 2, cellPx - 2);
        mapCtx.strokeRect(rx + 1, ry + 1, cellPx - 2, cellPx - 2);

        if (sec.isBossRoom) {
          mapCtx.fillStyle = '#fca5a5';
          mapCtx.font = '9px sans-serif';
          mapCtx.textAlign = 'center';
          mapCtx.fillText('☠', rx + cellPx / 2, ry + cellPx / 2 + 3);
        } else if (sec.safe) {
          mapCtx.fillStyle = '#fde047';
          mapCtx.font = '9px sans-serif';
          mapCtx.textAlign = 'center';
          mapCtx.fillText('🔥', rx + cellPx / 2, ry + cellPx / 2 + 3);
        }
      });

      remotePlayers.forEach(rp => {
        const dx = (rp.x - localPlayer.x) / TILE_SIZE;
        const dy = (rp.y - localPlayer.y) / TILE_SIZE;
        mapCtx.fillStyle = '#38bdf8';
        mapCtx.beginPath();
        mapCtx.arc(centerX + dx * cellPx, centerY + dy * cellPx, 3, 0, Math.PI * 2);
        mapCtx.fill();
      });

      mapCtx.fillStyle = '#ffffff';
      mapCtx.beginPath();
      mapCtx.arc(centerX, centerY, 3.5, 0, Math.PI * 2);
      mapCtx.fill();
    }

    const prevCanvas = document.getElementById('previewCanvas');
    const prevCtx = prevCanvas.getContext('2d');
    let previewSwing = 0;
    prevCanvas.addEventListener('mousedown', () => { previewSwing = 18; });

    function updatePreview(now) {
      if (document.getElementById('char-modal').style.display !== 'none') {
        prevCtx.clearRect(0, 0, prevCanvas.width, prevCanvas.height);
        prevCtx.fillStyle = '#141824';
        prevCtx.strokeStyle = '#040306';
        prevCtx.lineWidth = 2.5;
        prevCtx.beginPath();
        prevCtx.ellipse(120, 174, 54, 15, 0, 0, Math.PI * 2);
        prevCtx.fill(); prevCtx.stroke();

        if (previewSwing > 0) previewSwing--;
        const dummy = {
          raceCategory: document.getElementById('char-race').value,
          subraceKey: document.getElementById('char-subrace').value,
          coreClass: document.getElementById('char-class').value,
          armorColor: localPlayer.armorColor,
          hairColor: localPlayer.hairColor,
          facing: 1,
          isMoving: false,
          swingTimer: previewSwing
        };
        drawOVACharacter(prevCtx, dummy, 120, 166, now * 0.001, 1.55, false);
      }
    }

    // =========================================================================
    // 15. CHAT, HUD BUTTONS & AWAKEN HANDLER
    // =========================================================================
    function sendChat() {
      const input = document.getElementById('chat-input');
      const val = input.value.trim();
      if (!val) { input.blur(); return; }
      appendChat(localPlayer.name, val);
      localPlayer.chatBubble = val;
      localPlayer.chatTimer = 240;
      sendPacket({ type: 'chat', id: localPlayer.id, sender: localPlayer.name, text: val });
      broadcastState();
      input.value = '';
      input.blur();
    }

    function appendChat(author, text) {
      const log = document.getElementById('chat-log');
      const div = document.createElement('div');
      div.className = 'chat-msg';
      div.innerHTML = `<span class="author">${escapeHtml(author)}:</span><span>${escapeHtml(text)}</span>`;
      log.appendChild(div);
      log.scrollTop = log.scrollHeight;
    }

    function escapeHtml(str) {
      return String(str).replace(/[&<>"']/g, m => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
      }[m]));
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.textContent = msg;
      toast.style.display = 'block';
      clearTimeout(window._tTimer);
      window._tTimer = setTimeout(() => { toast.style.display = 'none'; }, 2800);
    }

    document.getElementById('btn-crt').addEventListener('click', (e) => {
      const crt = document.getElementById('crt-overlay');
      const hidden = crt.style.display === 'none';
      crt.style.display = hidden ? 'block' : 'none';
      e.currentTarget.style.opacity = hidden ? '1' : '0.45';
    });

    document.getElementById('btn-invite').addEventListener('click', () => {
      const inviteUrl = `${window.location.origin}${window.location.pathname}?shard=${localPlayer.shardCode}`;
      navigator.clipboard?.writeText(inviteUrl);
      showToast(`Copied 4-Player Shard Invite (${localPlayer.shardCode})!`);
    });

    document.getElementById('btn-awaken').addEventListener('click', () => {
      initAudioEngine();
      const nameInput = document.getElementById('char-name').value.trim();
      if (nameInput) localPlayer.name = nameInput;
      const shardInput = document.getElementById('shard-code-input').value.trim() || 'MAIN';
      localPlayer.raceCategory = document.getElementById('char-race').value;
      localPlayer.subraceKey = document.getElementById('char-subrace').value;
      localPlayer.coreClass = document.getElementById('char-class').value;
      localPlayer.regionalSect = document.getElementById('char-sect').value;

      const subMeta = getSubraceMeta(localPlayer);
      localPlayer.raceLabel = subMeta.name;
      recalcEquipmentStats();
      localPlayer.hp = localPlayer.maxHp;
      localPlayer.mana = localPlayer.maxMana;
      savePersistentProgress();

      document.getElementById('char-modal').style.display = 'none';
      document.getElementById('hud').style.display = 'block';
      document.getElementById('vitals-name').textContent = localPlayer.name;
      document.getElementById('vitals-lvl').textContent = `LV.${localPlayer.level}`;
      document.getElementById('vitals-race').textContent = `${localPlayer.raceCategory} • ${subMeta.name}`;

      renderHotbarUI();
      initFourPlayerMesh(shardInput);
      updatePartyRosterUI();
      updateVitalsUI();
      checkClassAscensionPrompt();
      triggerSoulsBanner('TARTARIA — COVENANT OF ATMAN');
    });

    function updateVitalsUI() {
      document.getElementById('vitals-class').textContent = getActiveClassTitle(localPlayer);
      document.getElementById('gold-hud').textContent = `${localPlayer.gold}g`;
      document.getElementById('hp-txt').textContent = `${Math.max(0, Math.round(localPlayer.hp))}/${localPlayer.maxHp}`;
      document.getElementById('hp-fill').style.width = `${Math.max(0, (localPlayer.hp / localPlayer.maxHp) * 100)}%`;
      document.getElementById('mana-txt').textContent = `${Math.max(0, Math.round(localPlayer.mana))}/${localPlayer.maxMana}`;
      document.getElementById('mana-fill').style.width = `${Math.max(0, (localPlayer.mana / localPlayer.maxMana) * 100)}%`;
      document.getElementById('atman-txt').textContent = `${Math.round(localPlayer.atman)}/${localPlayer.maxAtman}`;
      document.getElementById('atman-fill').style.width = `${Math.min(100, (localPlayer.atman / localPlayer.maxAtman) * 100)}%`;
      document.getElementById('xp-txt').textContent = `${localPlayer.xp}/${localPlayer.nextXp}`;
      document.getElementById('xp-fill').style.width = `${Math.min(100, (localPlayer.xp / localPlayer.nextXp) * 100)}%`;
    }

    // =========================================================================
    // 16. MAIN 60 FPS GAME LOOP
    // =========================================================================
    let lastTime = performance.now();
    let netTickTimer = 0;

    function gameLoop(now) {
      const dt = Math.min((now - lastTime) / 1000, 0.1);
      lastTime = now;
      const nowSec = now * 0.001;

      updatePreview(now);
      updateGatesAutoProximity(dt);

      // Update Hotbar Cooldown Sweeps
      for (let i = 0; i < 9; i++) {
        const cdEl = document.getElementById(`cd-slot-${i}`);
        if (cdEl) {
          const rem = Math.max(0, slotCooldowns[i] - nowSec);
          const pct = rem > 0 ? Math.min(100, (rem / (slotMaxCooldowns[i] || 1)) * 100) : 0;
          cdEl.style.height = `${pct}%`;
        }
      }

      let moveX = 0, moveY = 0;
      if (keys['w'] || keys['arrowup']) moveY -= 1;
      if (keys['s'] || keys['arrowdown']) moveY += 1;
      if (keys['a'] || keys['arrowleft']) moveX -= 1;
      if (keys['d'] || keys['arrowright']) moveX += 1;

      if (moveX !== 0 || moveY !== 0) {
        localPlayer.targetX = null;
        localPlayer.targetY = null;
        const len = Math.hypot(moveX, moveY);
        const nx = localPlayer.x + (moveX / len) * localPlayer.speed * dt;
        const ny = localPlayer.y + (moveY / len) * localPlayer.speed * dt;
        resolveDungeonMovement(localPlayer, nx, ny, true);
        if (Math.abs(moveX) > 0.05) localPlayer.facing = moveX > 0 ? 1 : -1;
        localPlayer.isMoving = true;
      } else if (localPlayer.targetX !== null && localPlayer.targetY !== null) {
        const dx = localPlayer.targetX - localPlayer.x;
        const dy = localPlayer.targetY - localPlayer.y;
        const dist = Math.hypot(dx, dy);
        if (dist > 8) {
          const nx = localPlayer.x + (dx / dist) * localPlayer.speed * dt;
          const ny = localPlayer.y + (dy / dist) * localPlayer.speed * dt;
          resolveDungeonMovement(localPlayer, nx, ny, true);
          if (Math.abs(dx) > 2) localPlayer.facing = dx > 0 ? 1 : -1;
          localPlayer.isMoving = true;
        } else {
          localPlayer.targetX = null;
          localPlayer.targetY = null;
          localPlayer.isMoving = false;
        }
      } else {
        localPlayer.isMoving = false;
      }

      // Whenever player enters a new sector, pre-carve its 4 N/S/E/W neighbors so gates always open into visible rooms!
      const curGx = Math.floor(localPlayer.x / TILE_SIZE);
      const curGy = Math.floor(localPlayer.y / TILE_SIZE);
      const activeSector = getOrGenerateSector(curGx, curGy, localPlayer.name, true);
      [[0, -1], [0, 1], [-1, 0], [1, 0]].forEach(([dx, dy]) => {
        const nKey = sectorKey(curGx + dx, curGy + dy);
        if (!worldSectors.has(nKey)) {
          getOrGenerateSector(curGx + dx, curGy + dy, localPlayer.name, false);
        }
      });

      const inSafezone = isInsideFirepitSafezone(localPlayer.x, localPlayer.y);
      if (activeSector) {
        document.getElementById('shard-status').textContent = activeSector.name;
        document.getElementById('sector-discoverer-txt').textContent = `Mapped by: ${activeSector.mappedBy}`;
      }

      const pvpBadge = document.getElementById('pvp-badge');
      if (inSafezone) {
        pvpBadge.textContent = '[SAFEZONE]';
        pvpBadge.style.color = '#4ade80';
        localPlayer.hp = Math.min(localPlayer.maxHp, localPlayer.hp + 15 * dt);
        localPlayer.mana = Math.min(localPlayer.maxMana, localPlayer.mana + 18 * dt);
      } else {
        pvpBadge.textContent = `[⚔️ TIER ${activeSector ? activeSector.depth : 1} PVP]`;
        pvpBadge.style.color = '#ef4444';
        localPlayer.mana = Math.min(localPlayer.maxMana, localPlayer.mana + 5 * dt);
      }

      for (let i = atmanMotes.length - 1; i >= 0; i--) {
        const am = atmanMotes[i];
        const dist = Math.hypot(localPlayer.x - am.x, (localPlayer.y - 18) - am.y);
        if (dist < 240) {
          const ang = Math.atan2((localPlayer.y - 18) - am.y, localPlayer.x - am.x);
          am.x += Math.cos(ang) * 340 * dt;
          am.y += Math.sin(ang) * 340 * dt;
        }
        if (dist < 24) {
          localPlayer.atman = Math.min(localPlayer.maxAtman, localPlayer.atman + am.val);
          spawnCombatText(localPlayer.x, localPlayer.y - 34, `+${am.val} ATMAN`, '#fde047');
          atmanMotes.splice(i, 1);
        }
      }

      updateVitalsUI();
      renderCartographyMap();

      // Update Projectiles
      for (let i = projectiles.length - 1; i >= 0; i--) {
        const pj = projectiles[i];
        pj.x += pj.vx * dt;
        pj.y += pj.vy * dt;
        pj.life -= dt;

        let hitWall = !getWalkableSectorAt(pj.x, pj.y, false);
        if (!hitWall) {
          for (const pil of SOLID_PILLARS) {
            if (Math.hypot(pj.x - pil.x, pj.y - pil.y) < pil.r) { hitWall = true; break; }
          }
        }

        if (hitWall || pj.life <= 0) {
          if (pj.explosive) spawnSpellVortex(pj.x, pj.y, pj.color, 65);
          projectiles.splice(i, 1);
          continue;
        }

        if (pj.isEnemy) {
          if (!inSafezone && localPlayer.dodgeTimer <= 0 && Math.hypot(pj.x - localPlayer.x, pj.y - (localPlayer.y - 16)) < 22 + pj.radius) {
            localPlayer.hp = Math.max(0, localPlayer.hp - pj.dmg);
            localPlayer.hitFlash = 7;
            playSfx('slash');
            spawnCombatText(localPlayer.x, localPlayer.y, `-${pj.dmg}`, '#ef4444');
            projectiles.splice(i, 1);
            if (localPlayer.hp <= 0) handleFullLootDeath();
            continue;
          }
        } else if (!pj.isRemote) {
          let hitMob = false;
          for (let m = enemies.length - 1; m >= 0; m--) {
            const en = enemies[m];
            if (Math.hypot(pj.x - en.x, pj.y - (en.y - 16)) < en.radius + pj.radius + 6) {
              const isCrit = Math.random() < 0.26;
              const finalDmg = isCrit ? Math.round(pj.dmg * 1.45) : pj.dmg;
              en.hp -= finalDmg;
              en.hitFlash = 6;
              spawnCombatText(en.x, en.y, isCrit ? `-${finalDmg} CRIT!` : `-${finalDmg}`, isCrit ? '#84cc16' : pj.color);
              if (pj.explosive) spawnSpellVortex(en.x, en.y, pj.color, 85);
              else spawnSlashArc(en.x, en.y, pj.vx >= 0 ? 1 : -1, pj.color, 36);

              if (en.hp <= 0) {
                spawnOvaDecapitation(en.x, en.y, pj.vx >= 0 ? 1 : -1);
                handleEnemyKilled(en, m);
              }
              hitMob = true;
              break;
            }
          }
          if (hitMob) {
            projectiles.splice(i, 1);
            continue;
          }

          if (!inSafezone) {
            for (const rp of remotePlayers.values()) {
              if (!isInsideFirepitSafezone(rp.x, rp.y) && Math.hypot(pj.x - rp.x, pj.y - (rp.y - 16)) < 24) {
                sendPacket({
                  type: 'pvp_hit',
                  id: localPlayer.id,
                  targetId: rp.id,
                  attackerName: localPlayer.name,
                  dmg: pj.dmg
                });
                spawnCombatText(rp.x, rp.y, `-${pj.dmg} PVP!`, '#ff2a38');
                projectiles.splice(i, 1);
                break;
              }
            }
          }
        }
      }

      // Update Enemies & Bosses
      let activeBoss = null;
      enemies.forEach(en => {
        if (en.hitFlash > 0) en.hitFlash--;
        const distToPlayer = Math.hypot(localPlayer.x - en.x, localPlayer.y - en.y);
        if (en.isBoss && distToPlayer < 680) activeBoss = en;

        if (distToPlayer < 520 && distToPlayer > 38 && !inSafezone) {
          const ang = Math.atan2(localPlayer.y - en.y, localPlayer.x - en.x);
          const nx = en.x + Math.cos(ang) * en.speed * dt;
          const ny = en.y + Math.sin(ang) * en.speed * dt;
          if (!isInsideFirepitSafezone(nx, ny)) {
            resolveDungeonMovement(en, nx, ny, false);
          }

          if (en.isBoss || en.ranged) {
            en.shootCooldown = (en.shootCooldown || 1.8) - dt;
            if (en.shootCooldown <= 0) {
              en.shootCooldown = en.isBoss ? 1.4 : 2.3;
              const tierDmg = 12 + (en.tier || 1) * 3;
              if (en.isBoss) {
                const count = en.pattern === 'zhad_cymatic' ? 10 : (en.pattern === 'tiltowait_ring' ? 8 : 4);
                for (let b = 0; b < count; b++) {
                  const spreadAng = count >= 8
                    ? (b / count) * Math.PI * 2
                    : ang + (b - (count - 1) / 2) * 0.28;
                  spawnProjectile({
                    ownerId: en.id, isEnemy: true,
                    x: en.x, y: en.y - 20,
                    angle: spreadAng, speed: 340,
                    dmg: tierDmg + 6, color: en.color, projType: 'orb', radius: 9, life: 2.0
                  });
                }
              } else {
                spawnProjectile({
                  ownerId: en.id, isEnemy: true,
                  x: en.x, y: en.y - 16,
                  angle: ang, speed: 330,
                  dmg: tierDmg, color: en.color, projType: 'arrow', radius: 6, life: 1.5
                });
              }
            }
          }
        }
      });

      const bossWrap = document.getElementById('boss-bar-wrap');
      if (activeBoss) {
        bossWrap.style.display = 'flex';
        document.getElementById('boss-bar-title').textContent = `☠️ ${activeBoss.name} (${Math.max(0, Math.round(activeBoss.hp))} / ${activeBoss.maxHp} HP)`;
        document.getElementById('boss-hp-fill').style.width = `${Math.max(0, (activeBoss.hp / activeBoss.maxHp) * 100)}%`;
      } else {
        bossWrap.style.display = 'none';
      }

      if (localPlayer.swingTimer > 0) localPlayer.swingTimer--;
      if (localPlayer.dodgeTimer > 0) localPlayer.dodgeTimer--;
      if (localPlayer.hitFlash > 0) localPlayer.hitFlash--;
      if (screenShake > 0) screenShake = Math.max(0, screenShake - 40 * dt);
      if (localPlayer.chatTimer > 0) {
        localPlayer.chatTimer--;
        if (localPlayer.chatTimer <= 0) localPlayer.chatBubble = null;
      }

      remotePlayers.forEach(p => {
        if (p.chatTimer > 0) {
          p.chatTimer--;
          if (p.chatTimer <= 0) p.chatBubble = null;
        }
        if (p.swingTimer > 0) p.swingTimer--;
      });

      for (let i = dodgeAfterimages.length - 1; i >= 0; i--) {
        dodgeAfterimages[i].life--;
        if (dodgeAfterimages[i].life <= 0) dodgeAfterimages.splice(i, 1);
      }
      for (let i = spellVortexes.length - 1; i >= 0; i--) {
        spellVortexes[i].life--;
        if (spellVortexes[i].life <= 0) spellVortexes.splice(i, 1);
      }
      for (let i = slashArcs.length - 1; i >= 0; i--) {
        slashArcs[i].life--;
        if (slashArcs[i].life <= 0) slashArcs.splice(i, 1);
      }
      for (let i = bloodSparks.length - 1; i >= 0; i--) {
        const sp = bloodSparks[i];
        sp.x += sp.vx * dt;
        sp.y += sp.vy * dt;
        sp.life--;
        if (sp.life <= 0) bloodSparks.splice(i, 1);
      }
      for (let i = flyingHeads.length - 1; i >= 0; i--) {
        const fh = flyingHeads[i];
        fh.x += fh.vx * dt;
        fh.y += fh.vy * dt;
        fh.vy += 420 * dt;
        fh.rot += fh.vRot * dt;
        fh.life--;
        if (fh.life <= 0) flyingHeads.splice(i, 1);
      }
      for (let i = combatTexts.length - 1; i >= 0; i--) {
        const ct = combatTexts[i];
        ct.y -= 26 * dt;
        ct.life--;
        if (ct.life <= 0) combatTexts.splice(i, 1);
      }

      netTickTimer += dt;
      if (netTickTimer > 0.08) {
        broadcastState();
        netTickTimer = 0;
      }

      renderWorld(nowSec);
      requestAnimationFrame(gameLoop);
    }

    function renderWorld(timeSec) {
      ctx.clearRect(0, 0, screenW, screenH);

      const shakeX = screenShake > 0 ? (Math.random() - 0.5) * screenShake : 0;
      const shakeY = screenShake > 0 ? (Math.random() - 0.5) * screenShake : 0;
      const camX = localPlayer.x - screenW / 2 + shakeX;
      const camY = localPlayer.y - screenH / 2 + shakeY;

      ctx.save();
      ctx.translate(-camX, -camY);

      ctx.fillStyle = '#040307';
      ctx.fillRect(camX, camY, screenW, screenH);

      // PASS 1A: Draw Outer 2.5D Wall Extrusions & Shadows First
      worldSectors.forEach(sec => {
        sec.rects.forEach(r => {
          if (r.x + r.w < camX - 120 || r.x > camX + screenW + 120 ||
              r.y + r.h < camY - 120 || r.y > camY + screenH + 120) return;

          ctx.fillStyle = '#0c0e14';
          ctx.fillRect(r.x - 10, r.y - 24, r.w + 20, r.h + 34);
          ctx.fillStyle = sec.isBossRoom ? '#3b151c' : '#263042';
          ctx.fillRect(r.x - 6, r.y - 20, r.w + 12, 22);
        });
      });

      // PASS 1B: Draw Seamless Flagstone Floors on Top (Eliminates border lines across corridors!)
      worldSectors.forEach(sec => {
        sec.rects.forEach(r => {
          if (r.x + r.w < camX - 120 || r.x > camX + screenW + 120 ||
              r.y + r.h < camY - 120 || r.y > camY + screenH + 120) return;

          ctx.fillStyle = floorPatterns[sec.floor] || '#191d26';
          ctx.fillRect(r.x, r.y, r.w, r.h);

          if (r.isMain) {
            ctx.strokeStyle = sec.safe ? 'rgba(207, 163, 84, 0.45)' : (sec.isBossRoom ? 'rgba(220, 38, 38, 0.55)' : 'rgba(71, 85, 105, 0.4)');
            ctx.lineWidth = 3;
            ctx.strokeRect(r.x, r.y, r.w, r.h);
          }
        });

        const scx = sec.gx * TILE_SIZE + TILE_SIZE / 2;
        const scy = sec.gy * TILE_SIZE + 145;
        ctx.font = '900 13px Cinzel, serif';
        ctx.textAlign = 'center';
        ctx.fillStyle = sec.safe ? 'rgba(248, 226, 168, 0.65)' : (sec.isBossRoom ? 'rgba(252, 165, 165, 0.75)' : 'rgba(203, 213, 225, 0.5)');
        ctx.fillText(sec.name.toUpperCase(), scx, scy);
      });

      // 2. Draw Persistent Floor Decals
      floorDecals.forEach(dc => {
        ctx.fillStyle = dc.color;
        ctx.beginPath();
        ctx.ellipse(dc.x, dc.y, dc.r, dc.r * 0.55, 0, 0, Math.PI * 2);
        ctx.fill();
      });

      // 3. Draw OVA Tavern Table & Tankards in Sector (0,0) NW Corner (260, 300)
      ctx.save();
      ctx.translate(260, 300);
      ctx.fillStyle = '#452715';
      ctx.strokeStyle = '#040306';
      ctx.lineWidth = 2.5;
      ctx.fillRect(-45, -18, 90, 36);
      ctx.strokeRect(-45, -18, 90, 36);
      ctx.fillStyle = '#a16207';
      ctx.fillRect(-20, -10, 9, 12);
      ctx.fillRect(12, -6, 9, 12);
      ctx.fillStyle = '#f8fafc';
      ctx.fillRect(-20, -12, 9, 4);
      ctx.fillRect(12, -8, 9, 4);
      ctx.restore();

      // 4. Draw Flickering Wall Torches
      WALL_TORCHES.forEach((wt, idx) => {
        if (Math.abs(wt.x - localPlayer.x) > screenW || Math.abs(wt.y - localPlayer.y) > screenH) return;
        const flick = Math.sin(timeSec * 10 + idx) * 14;
        const grad = ctx.createRadialGradient(wt.x, wt.y, 6, wt.x, wt.y, 180 + flick);
        grad.addColorStop(0, 'rgba(251, 146, 60, 0.34)');
        grad.addColorStop(1, 'rgba(0, 0, 0, 0)');
        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.arc(wt.x, wt.y, 180 + flick, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = '#f97316';
        ctx.beginPath();
        ctx.arc(wt.x, wt.y, 6, 0, Math.PI * 2);
        ctx.fill();
      });

      // 5. Draw Interactive Iron Portcullis Gates with Retracting Bar Animation & Glowing Pass-Through Carpet
      GATES.forEach(g => {
        if (Math.abs(g.x - localPlayer.x) > screenW || Math.abs(g.y - localPlayer.y) > screenH) return;
        ctx.save();
        ctx.translate(g.x, g.y);

        const openRatio = g.openAnim || (g.isOpen ? 1 : 0);

        ctx.fillStyle = '#334155';
        ctx.strokeStyle = '#040306';
        ctx.lineWidth = 3;
        if (g.horiz) {
          // Flanking Arch Bastions
          ctx.fillRect(-155, -20, 32, 40); ctx.strokeRect(-155, -20, 32, 40);
          ctx.fillRect(123, -20, 32, 40);  ctx.strokeRect(123, -20, 32, 40);

          if (openRatio < 0.85) {
            ctx.fillStyle = 'rgba(15, 23, 42, 0.88)';
            ctx.fillRect(-122, -10, 244 * (1 - openRatio), 20);
            ctx.strokeStyle = '#94a3b8';
            ctx.lineWidth = 3;
            for (let bx = -110; bx <= 110; bx += 20) {
              ctx.beginPath(); ctx.moveTo(bx, -12); ctx.lineTo(bx, 12 * (1 - openRatio)); ctx.stroke();
            }
          } else {
            // Glowing Emerald Pass-Through Carpet
            ctx.fillStyle = 'rgba(34, 197, 94, 0.14)';
            ctx.fillRect(-118, -14, 236, 28);
            ctx.strokeStyle = 'rgba(74, 222, 128, 0.65)';
            ctx.lineWidth = 2;
            ctx.strokeRect(-118, -14, 236, 28);
          }
        } else {
          ctx.fillRect(-20, -155, 40, 32); ctx.strokeRect(-20, -155, 40, 32);
          ctx.fillRect(-20, 123, 40, 32);  ctx.strokeRect(-20, 123, 40, 32);

          if (openRatio < 0.85) {
            ctx.fillStyle = 'rgba(15, 23, 42, 0.88)';
            ctx.fillRect(-10, -122, 20, 244 * (1 - openRatio));
            ctx.strokeStyle = '#94a3b8';
            ctx.lineWidth = 3;
            for (let by = -110; by <= 110; by += 20) {
              ctx.beginPath(); ctx.moveTo(-12, by); ctx.lineTo(12 * (1 - openRatio), by); ctx.stroke();
            }
          } else {
            ctx.fillStyle = 'rgba(34, 197, 94, 0.14)';
            ctx.fillRect(-14, -118, 28, 236);
            ctx.strokeStyle = 'rgba(74, 222, 128, 0.65)';
            ctx.lineWidth = 2;
            ctx.strokeRect(-14, -118, 28, 236);
          }
        }

        ctx.font = '800 9.5px Cinzel, serif';
        ctx.textAlign = 'center';
        ctx.fillStyle = g.isOpen ? '#4ade80' : '#facc15';
        ctx.fillText(`${g.label} [${g.isOpen ? 'OPEN — WALK THROUGH' : 'APPROACH TO OPEN'}]`, 0, -26);
        ctx.restore();
      });

      // 6. Draw Central Firepit Safezone Sanctuary (500, 500)
      ctx.save();
      ctx.strokeStyle = 'rgba(74, 222, 128, 0.28)';
      ctx.lineWidth = 3;
      ctx.setLineDash([12, 8]);
      ctx.beginPath();
      ctx.arc(FIREPIT_POS.x, FIREPIT_POS.y, FIREPIT_POS.safeRadius, 0, Math.PI * 2);
      ctx.stroke();
      ctx.setLineDash([]);

      const flicker = Math.sin(timeSec * 9) * 18;
      const fireGrad = ctx.createRadialGradient(
        FIREPIT_POS.x, FIREPIT_POS.y, 16,
        FIREPIT_POS.x, FIREPIT_POS.y, 350 + flicker
      );
      fireGrad.addColorStop(0, 'rgba(251, 146, 60, 0.58)');
      fireGrad.addColorStop(0.5, 'rgba(185, 28, 28, 0.22)');
      fireGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
      ctx.fillStyle = fireGrad;
      ctx.beginPath();
      ctx.arc(FIREPIT_POS.x, FIREPIT_POS.y, 350 + flicker, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#1f1924';
      ctx.strokeStyle = '#cfa354';
      ctx.lineWidth = 4;
      ctx.beginPath();
      ctx.arc(FIREPIT_POS.x, FIREPIT_POS.y, FIREPIT_POS.radius, 0, Math.PI * 2);
      ctx.fill(); ctx.stroke();

      for (let f = 0; f < 7; f++) {
        const ang = (f / 7) * Math.PI * 2 + timeSec * 2;
        const r = 24 + Math.sin(timeSec * 8 + f) * 10;
        ctx.fillStyle = f % 2 === 0 ? '#f97316' : '#facc15';
        ctx.beginPath();
        ctx.arc(FIREPIT_POS.x + Math.cos(ang) * r * 0.5, FIREPIT_POS.y + Math.sin(ang) * r * 0.5, 14, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.strokeStyle = '#e2e8f0';
      ctx.lineWidth = 4;
      ctx.beginPath();
      ctx.moveTo(FIREPIT_POS.x, FIREPIT_POS.y + 8);
      ctx.lineTo(FIREPIT_POS.x + 6, FIREPIT_POS.y - 48);
      ctx.stroke();
      ctx.restore();

      // 7. Draw 2.5D Shaded Columns & Pillars of Zhad
      SOLID_PILLARS.forEach(pil => {
        if (Math.abs(pil.x - localPlayer.x) > screenW || Math.abs(pil.y - localPlayer.y) > screenH) return;
        ctx.fillStyle = 'rgba(0,0,0,0.6)';
        ctx.beginPath(); ctx.ellipse(pil.x + 8, pil.y + 10, pil.r, pil.r * 0.6, 0, 0, Math.PI * 2); ctx.fill();

        const pGrad = ctx.createRadialGradient(pil.x - 10, pil.y - 10, 4, pil.x, pil.y, pil.r);
        pGrad.addColorStop(0, pil.isZhadPillar ? '#d97706' : '#475569');
        pGrad.addColorStop(1, '#1e293b');
        ctx.fillStyle = pGrad;
        ctx.strokeStyle = pil.isZhadPillar ? '#fde047' : '#040306';
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.arc(pil.x, pil.y, pil.r, 0, Math.PI * 2);
        ctx.fill(); ctx.stroke();
      });

      // 8. Draw Loot Chests & Golden Atman Motes
      lootChests.forEach(ch => {
        ctx.save();
        ctx.translate(ch.x, ch.y);
        ctx.fillStyle = ch.isCorpse ? '#7f1d1d' : '#5c3a18';
        ctx.strokeStyle = '#f4dca6';
        ctx.lineWidth = 2;
        ctx.fillRect(-16, -12, 32, 24);
        ctx.strokeRect(-16, -12, 32, 24);
        ctx.fillStyle = '#facc15';
        ctx.fillRect(-4, -3, 8, 6);

        ctx.font = '700 10px Cinzel, serif';
        ctx.textAlign = 'center';
        ctx.fillStyle = ch.isCorpse ? '#fca5a5' : '#fde68a';
        ctx.fillText(ch.label, 0, -16);
        ctx.restore();
      });

      atmanMotes.forEach(am => {
        ctx.save();
        ctx.translate(am.x, am.y);
        ctx.fillStyle = '#fde047';
        ctx.shadowColor = '#fbbf24';
        ctx.shadowBlur = 10;
        ctx.beginPath();
        ctx.arc(0, 0, 6, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      });

      // 9. Draw Tartaria NPCs
      TARTARIA_NPCS.forEach(npc => {
        ctx.save();
        ctx.translate(npc.x, npc.y);
        ctx.fillStyle = 'rgba(0,0,0,0.65)';
        ctx.beginPath(); ctx.ellipse(0, 6, 18, 8, 0, 0, Math.PI * 2); ctx.fill();

        ctx.fillStyle = npc.color;
        ctx.strokeStyle = '#040306';
        ctx.lineWidth = 2.5;
        ctx.beginPath(); ctx.roundRect(-12, -30, 24, 30, 4); ctx.fill(); ctx.stroke();
        ctx.fillStyle = '#e5dccb';
        ctx.beginPath(); ctx.arc(0, -38, 10, 0, Math.PI * 2); ctx.fill(); ctx.stroke();

        ctx.font = '800 11px Cinzel, serif';
        ctx.textAlign = 'center';
        ctx.fillStyle = '#f4dca6';
        ctx.fillText(`💬 ${npc.name}`, 0, -56);
        ctx.font = 'italic 10px Crimson Pro, serif';
        ctx.fillStyle = '#cfa354';
        ctx.fillText(`<${npc.title}>`, 0, -45);
        ctx.restore();
      });

      // 10. Draw Hostiles & Bosses
      enemies.forEach(en => {
        if (Math.abs(en.x - localPlayer.x) > screenW || Math.abs(en.y - localPlayer.y) > screenH) return;
        drawCardArtHostile(ctx, en, timeSec, en.id === localPlayer.targetEntityId);
      });

      // 11. Draw Projectiles
      projectiles.forEach(pj => {
        ctx.save();
        ctx.translate(pj.x, pj.y);
        ctx.rotate(pj.angle);

        if (pj.projType === 'arrow') {
          ctx.strokeStyle = pj.color;
          ctx.lineWidth = 3;
          ctx.beginPath(); ctx.moveTo(-14, 0); ctx.lineTo(12, 0); ctx.stroke();
          ctx.fillStyle = '#fff';
          ctx.beginPath(); ctx.moveTo(15, 0); ctx.lineTo(8, -5); ctx.lineTo(8, 5); ctx.closePath(); ctx.fill();
        } else if (pj.projType === 'kunai') {
          ctx.rotate(timeSec * 18);
          ctx.strokeStyle = pj.color;
          ctx.lineWidth = 2.5;
          ctx.beginPath();
          ctx.moveTo(-9, 0); ctx.lineTo(9, 0);
          ctx.moveTo(0, -9); ctx.lineTo(0, 9);
          ctx.stroke();
        } else {
          const rad = pj.radius || 8;
          ctx.fillStyle = pj.color;
          ctx.beginPath(); ctx.arc(0, 0, rad, 0, Math.PI * 2); ctx.fill();
          ctx.fillStyle = '#fff';
          ctx.beginPath(); ctx.arc(0, 0, rad * 0.45, 0, Math.PI * 2); ctx.fill();
        }
        ctx.restore();
      });

      // 12. Draw Cymatic Spell Vortexes
      spellVortexes.forEach(vx => {
        ctx.save();
        ctx.translate(vx.x, vx.y);
        const progress = 1 - vx.life / vx.maxLife;
        const alpha = vx.life / vx.maxLife;
        ctx.strokeStyle = vx.color;
        ctx.globalAlpha = alpha;
        ctx.lineWidth = 3.5;

        const curR = vx.radius * (0.25 + progress * 0.75);
        ctx.beginPath();
        ctx.arc(0, 0, curR, 0, Math.PI * 2);
        ctx.stroke();

        ctx.rotate(timeSec * 4);
        ctx.strokeRect(-curR * 0.55, -curR * 0.55, curR * 1.1, curR * 1.1);
        ctx.restore();
      });

      // 13. Draw Dodge-Roll Ghost Afterimages
      dodgeAfterimages.forEach(ghost => {
        drawOVACharacter(ctx, ghost.pRef, ghost.x, ghost.y, timeSec, 1.0, false, ghost.life / 20);
      });

      // 14. Draw Players
      const allPlayers = [localPlayer, ...Array.from(remotePlayers.values())];
      allPlayers.sort((a, b) => a.y - b.y);
      allPlayers.forEach(p => {
        drawOVACharacter(ctx, p, p.x, p.y, timeSec, 1.0, p.id === localPlayer.targetEntityId, 1.0);
        drawPlayerTag(ctx, p);
      });

      // 15. Draw OVA Decapitated Flying Skulls & Green Ectoplasm
      flyingHeads.forEach(fh => {
        ctx.save();
        ctx.translate(fh.x, fh.y);
        ctx.rotate(fh.rot);
        ctx.fillStyle = '#a16207';
        ctx.strokeStyle = '#040306';
        ctx.lineWidth = 2;
        ctx.beginPath(); ctx.arc(0, 0, 11, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
        ctx.fillStyle = '#fff';
        ctx.fillRect(-6, -4, 4, 4);
        ctx.fillRect(2, -4, 4, 4);
        ctx.fillRect(-6, 3, 12, 4);
        ctx.restore();
      });

      slashArcs.forEach(arc => {
        ctx.save();
        const alpha = arc.life / arc.maxLife;
        ctx.strokeStyle = arc.color;
        ctx.lineWidth = 5 * alpha;
        ctx.beginPath();
        ctx.arc(arc.x, arc.y - 18, arc.radius, -0.85, 0.85);
        ctx.stroke();
        ctx.restore();
      });

      bloodSparks.forEach(sp => {
        ctx.fillStyle = sp.color;
        ctx.fillRect(sp.x, sp.y, 4, 4);
      });

      combatTexts.forEach(ct => {
        ctx.font = '900 14px Cinzel, serif';
        ctx.textAlign = 'center';
        ctx.fillStyle = ct.color;
        ctx.strokeStyle = '#000';
        ctx.lineWidth = 3;
        ctx.strokeText(ct.text, ct.x, ct.y);
        ctx.fillText(ct.text, ct.x, ct.y);
      });

      ctx.restore();
    }

    function drawPlayerTag(ctx, p) {
      const subMeta = getSubraceMeta(p);
      const topY = p.y - 60 * subMeta.scale;

      ctx.save();
      ctx.textAlign = 'center';
      ctx.font = '800 11.5px Cinzel, serif';
      ctx.strokeStyle = '#000';
      ctx.lineWidth = 3;
      ctx.strokeText(`[S${p.slotNum || 1}] ${p.name} (Lv.${p.level || 1})`, p.x, topY);
      ctx.fillStyle = p.id === localPlayer.id ? '#f4dca6' : '#38bdf8';
      ctx.fillText(`[S${p.slotNum || 1}] ${p.name} (Lv.${p.level || 1})`, p.x, topY);

      ctx.font = 'italic 10.5px Crimson Pro, serif';
      ctx.fillStyle = '#cfa354';
      ctx.fillText(`<${p.raceLabel || subMeta.name} • ${getActiveClassTitle(p)}>`, p.x, topY + 11);

      if (p.chatBubble) {
        ctx.font = '700 12.5px Crimson Pro, serif';
        const txtW = ctx.measureText(p.chatBubble).width;
        const boxW = Math.max(txtW + 18, 54);
        const boxH = 24;
        const boxX = p.x - boxW / 2;
        const boxY = topY - 36;

        ctx.fillStyle = 'rgba(10, 8, 15, 0.95)';
        ctx.strokeStyle = '#cfa354';
        ctx.lineWidth = 1.5;
        ctx.fillRect(boxX, boxY, boxW, boxH);
        ctx.strokeRect(boxX, boxY, boxW, boxH);

        ctx.fillStyle = '#fff4db';
        ctx.fillText(p.chatBubble, p.x, boxY + 16);
      }
      ctx.restore();
    }

    requestAnimationFrame(gameLoop);
  </script>
</body>
</html>
