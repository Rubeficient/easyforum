  "compilerOptions": {
    "composite": true, "target": "ES2022", "lib": ["ES2022"],
    "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "skipLibCheck": true, "emitDeclarationOnly": true,
    "outDir": "node_modules/.tmp/worker", "types": ["@cloudflare/workers-types"]
  },
  "include": ["worker"]
